    // =====================================================================================================
    // PLAITS CORE: ports of the Mutable Instruments Plaits engines (MIT licence, (c) Emilie Gillet).
    // Every oscillator slot that is set to "Plaits" owns one instance (voice * 6 + slot) of every engine state.
    // Engines render blocks of 12 samples exactly like the original, then plaitsStep() plays them back.
    // =====================================================================================================
    const int   PL_N        = 48;           // instances: 8 voices x 6 slots
    const int   PL_BLOCK    = 12;           // kBlockSize
    const float plPi        = 3.14159265358979f;
    const float plA0        = (440.0f / 8.0f) / 47872.34f;   // a0 of dsp.h (corrected sample rate)

    float[576]  plOut;                // PL_N * PL_BLOCK rendered samples (out)
    float[576]  plAux;                // aux output of the engines
    int[48]     plPos;                // next sample to play of the block, per instance
    int[48]     plEngine;             // engine + 1 the instance is initialised for (0 = none)
    int[48]     plTrigPending;        // rising edge to deliver with the next block
    int[48]     plGate;               // gate held
    float[48]   plLimPeak;            // limiter state of the post processor
    int64[48]   plRng;                // per instance random state, 32 bit LCG (the original has one global state)

    // ---------------- tables of stmlib/dsp/units.cc ----------------
//@LUT lut_pitch_ratio_high
//@LUT lut_pitch_ratio_low

    float plSemitonesToRatio (float semitones)
    {
        float pitch = semitones + 128.0f;
        int   pi    = int (pitch);
        float pf    = pitch - float (pi);
        return lut_pitch_ratio_high.at (pi) * lut_pitch_ratio_low.at (int (pf * 256.0f));
    }

    float plNoteToFrequency (float midiNote)
    {
        float n = clamp (midiNote - 9.0f, -128.0f, 127.0f);
        return plA0 * 0.25f * plSemitonesToRatio (n);
    }

    // ---------------- stmlib/utils/random.h (one generator per instance) ----------------
    int64 plRandWord (int inst)
    {
        int64 s = (plRng.at (inst) * 1664525 + 1013904223) & 4294967295i64;
        plRng.at (inst) = s;
        return s;
    }

    float plRandFloat (int inst)   { return float (plRandWord (inst)) / 4294967296.0f; }

    int plRandSample (int inst)    // GetSample(): signed 16 bit
    {
        int v = int ((plRandWord (inst) >> 16) & 65535);
        return v >= 32768 ? v - 65536 : v;
    }

    // ---------------- stmlib/dsp/dsp.h ----------------
    float plInterpolate (const float[] table, float index, float size)
    {
        index *= size;
        int   i = int (index);
        float f = index - float (i);
        float a = table.at (i);
        float b = table.at (i + 1);
        return a + (b - a) * f;
    }

    float plInterpolateHermite (const float[] table, float index, float size)
    {
        index *= size;
        int   i   = int (index);
        float f   = index - float (i);
        float xm1 = table.at (i - 1);
        float x0  = table.at (i);
        float x1  = table.at (i + 1);
        float x2  = table.at (i + 2);
        float c   = (x1 - xm1) * 0.5f;
        float v   = x0 - x1;
        float w   = c + v;
        float a   = w + v + (x2 - x0) * 0.5f;
        float bn  = w + a;
        return (((a * f) - bn) * f + c) * f + x0;
    }

    float plInterpolateWrap (const float[] table, float index, float size)
    {
        index -= float (int (index));
        index *= size;
        int   i = int (index);
        float f = index - float (i);
        float a = table.at (i);
        float b = table.at (i + 1);
        return a + (b - a) * f;
    }

    float plSmoothStep (float v)       { return v * v * (3.0f - 2.0f * v); }
    float plCrossfade (float a, float b, float f)  { return a + (b - a) * f; }
    float plSoftLimit (float x)        { return x * (27.0f + x * x) / (27.0f + 9.0f * x * x); }
    float plSoftClip (float x)         { return x < -3.0f ? -1.0f : (x > 3.0f ? 1.0f : plSoftLimit (x)); }
    float plSqrt (float x)             { return sqrt (x); }

    // ---------------- stmlib/dsp/polyblep.h ----------------
    float plThisBlep (float t)             { return 0.5f * t * t; }
    float plNextBlep (float t)             { t = 1.0f - t; return -0.5f * t * t; }
    float plNextIntegratedBlep (float t)   { float t1 = 0.5f * t; float t2 = t1 * t1; float t4 = t2 * t2; return 0.1875f - t1 + 1.5f * t2 - t4; }
    float plThisIntegratedBlep (float t)   { return plNextIntegratedBlep (1.0f - t); }

    // ---------------- stmlib/dsp/filter.h ----------------
    // frequency approximations: 0 exact, 1 accurate, 2 fast, 3 dirty
    float plTan (int approx, float f)
    {
        if (approx == 0)
        {
            f = f < 0.497f ? f : 0.497f;
            return tan (plPi * f);
        }
        if (approx == 3)
        {
            let a = 3.736e-01f * plPi * plPi * plPi;
            return f * (plPi + a * f * f);
        }
        if (approx == 2)
        {
            let a = 3.260e-01f * plPi * plPi * plPi;
            let b = 1.823e-01f * plPi * plPi * plPi * plPi * plPi;
            float f2 = f * f;
            return f * (plPi + f2 * (a + b * f2));
        }
        let a = 3.333314036e-01f * plPi * plPi * plPi;
        let b = 1.333923995e-01f * plPi * plPi * plPi * plPi * plPi;
        let c = 5.33740603e-02f * plPi * plPi * plPi * plPi * plPi * plPi * plPi;
        let d = 2.900525e-03f * plPi * plPi * plPi * plPi * plPi * plPi * plPi * plPi * plPi;
        let e = 9.5168091e-03f * plPi * plPi * plPi * plPi * plPi * plPi * plPi * plPi * plPi * plPi * plPi;
        float f2 = f * f;
        return f * (plPi + f2 * (a + f2 * (b + f2 * (c + f2 * (d + f2 * e)))));
    }

    struct PlOnePole { float g; float gi; float state; }

    void plOnePoleInit (PlOnePole& p)                    { p.g = plTan (3, 0.01f); p.gi = 1.0f / (1.0f + p.g); p.state = 0.0f; }
    void plOnePoleSetF (PlOnePole& p, int approx, float f) { p.g = plTan (approx, f); p.gi = 1.0f / (1.0f + p.g); }
    float plOnePoleLP (PlOnePole& p, float in)           { float lp = (p.g * in + p.state) * p.gi; p.state = p.g * (in - lp) + lp; return lp; }
    float plOnePoleHP (PlOnePole& p, float in)           { float lp = (p.g * in + p.state) * p.gi; p.state = p.g * (in - lp) + lp; return in - lp; }

    struct PlSvf { float g; float r; float h; float s1; float s2; }

    void plSvfReset (PlSvf& s)   { s.s1 = 0.0f; s.s2 = 0.0f; }
    void plSvfSetGR (PlSvf& s, float g, float r)         { s.g = g; s.r = r; s.h = 1.0f / (1.0f + s.r * s.g + s.g * s.g); }
    void plSvfSetGQ (PlSvf& s, float g, float q)         { s.g = g; s.r = 1.0f / q; s.h = 1.0f / (1.0f + s.r * s.g + s.g * s.g); }
    void plSvfSetFQ (PlSvf& s, int approx, float f, float q) { s.g = plTan (approx, f); s.r = 1.0f / q; s.h = 1.0f / (1.0f + s.r * s.g + s.g * s.g); }
    void plSvfInit (PlSvf& s)    { plSvfSetFQ (s, 3, 0.01f, 100.0f); plSvfReset (s); }

    // modes: 0 low pass, 1 band pass, 2 band pass normalised, 3 high pass
    float plSvfProcess (PlSvf& s, int mode, float in)
    {
        float hp = (in - s.r * s.s1 - s.g * s.s1 - s.s2) * s.h;
        float bp = s.g * hp + s.s1;
        s.s1 = s.g * hp + bp;
        float lp = s.g * bp + s.s2;
        s.s2 = s.g * bp + lp;
        if (mode == 0) return lp;
        if (mode == 1) return bp;
        if (mode == 2) return bp * s.r;
        return hp;
    }

    struct PlDcBlocker { float pole; float x; float y; }

    void plDcInit (PlDcBlocker& d, float pole)  { d.pole = pole; d.x = 0.0f; d.y = 0.0f; }
    float plDcProcess (PlDcBlocker& d, float in) { float oldX = d.x; d.x = in; d.y = d.y * d.pole + d.x - oldX; return d.y; }
