    // ---------------- engine 7: Chiptune (plaits/dsp/engine2/chiptune_engine.cc; no envelope, as in the module) ----------------
    struct PlSqOsc { float masterPhase; float slavePhase; float nextSample; bool high; float masterFreq; float slaveFreq; }
    struct PlNesTri { float phase; float nextSample; int step; bool ascending; float freq; }

    struct PlChiptune
    {
        PlSqOsc[5] voice; PlNesTri bass; PlG3Chords chords;
        int arpMode; int arpRange; int arpNote; int arpOctave; int arpDir; int pattern;
    }

    PlChiptune[48] plChiptune;

    void plSqInit (PlSqOsc& o) { o.masterPhase = 0.0f; o.slavePhase = 0.0f; o.nextSample = 0.0f; o.high = false; o.masterFreq = 0.0f; o.slaveFreq = 0.01f; }

    // SuperSquareOscillator::Render (assigning)
    void plSqRender (PlSqOsc& o, float frequency, float shape, float[12]& out)
    {
        float masterFrequency = frequency;
        frequency *= shape < 0.5f ? (0.51f + 0.98f * shape) : 1.0f + 16.0f * (shape - 0.5f) * (shape - 0.5f);
        if (masterFrequency >= 0.25f) masterFrequency = 0.25f;
        if (frequency >= 0.25f) frequency = 0.25f;

        float mInc = (masterFrequency - o.masterFreq) / 12.0f;  float mV = o.masterFreq;
        float sInc = (frequency - o.slaveFreq) / 12.0f;         float sV = o.slaveFreq;
        float nextSample = o.nextSample;

        for (int n = 0; n < 12; ++n)
        {
            bool reset = false;
            bool transitionDuringReset = false;
            float resetTime = 0.0f;
            float thisSample = nextSample;
            nextSample = 0.0f;

            mV += mInc; sV += sInc;
            float masterF = mV;
            float slaveF = sV;
            o.masterPhase += masterF;
            if (o.masterPhase >= 1.0f)
            {
                o.masterPhase -= 1.0f;
                resetTime = o.masterPhase / masterF;
                float slavePhaseAtReset = o.slavePhase + (1.0f - resetTime) * slaveF;
                reset = true;
                if (slavePhaseAtReset >= 1.0f) { slavePhaseAtReset -= 1.0f; transitionDuringReset = true; }
                if (!o.high && slavePhaseAtReset >= 0.5f) transitionDuringReset = true;
                float value = slavePhaseAtReset < 0.5f ? 0.0f : 1.0f;
                thisSample -= value * plThisBlep (resetTime);
                nextSample -= value * plNextBlep (resetTime);
            }

            o.slavePhase += slaveF;
            while (transitionDuringReset || ! reset)
            {
                if (! o.high)
                {
                    if (o.slavePhase < 0.5f) break;
                    float t = (o.slavePhase - 0.5f) / slaveF;
                    thisSample += plThisBlep (t);
                    nextSample += plNextBlep (t);
                    o.high = true;
                }
                if (o.high)
                {
                    if (o.slavePhase < 1.0f) break;
                    o.slavePhase -= 1.0f;
                    float t = o.slavePhase / slaveF;
                    thisSample -= plThisBlep (t);
                    nextSample -= plNextBlep (t);
                    o.high = false;
                }
            }

            if (reset) { o.slavePhase = resetTime * slaveF; o.high = false; }
            nextSample += o.slavePhase < 0.5f ? 0.0f : 1.0f;
            out.at (n) = 2.0f * thisSample - 1.0f;
        }
        o.nextSample = nextSample; o.masterFreq = mV; o.slaveFreq = sV;
    }

    void plNesInit (PlNesTri& o) { o.phase = 0.0f; o.step = 0; o.ascending = true; o.nextSample = 0.0f; o.freq = 0.001f; }

    // NESTriangleOscillator<5>::Render
    void plNesRender (PlNesTri& o, float frequency, float[12]& out)
    {
        let numSteps = 32;
        let half = 16;
        let top = 31;
        let numStepsF = 32.0f;
        let scale = 4.0f / 30.0f;

        frequency = min (frequency, 0.25f);
        float fInc = (frequency - o.freq) / 12.0f;  float fV = o.freq;
        float nextSample = o.nextSample;

        for (int n = 0; n < 12; ++n)
        {
            fV += fInc;
            float f = fV;
            o.phase += f;

            float fadeToTri = clamp ((f - 0.5f / numStepsF) * 2.0f * numStepsF, 0.0f, 1.0f);
            float nesGain = 1.0f - fadeToTri;
            float triGain = fadeToTri * 2.0f / scale;

            float thisSample = nextSample;
            nextSample = 0.0f;

            if (o.ascending && o.phase >= 0.5f)
            {
                float discontinuity = 4.0f * f * triGain;
                if (discontinuity != 0.0f)
                {
                    float t = (o.phase - 0.5f) / f;
                    thisSample -= plThisIntegratedBlep (t) * discontinuity;
                    nextSample -= plNextIntegratedBlep (t) * discontinuity;
                }
                o.ascending = false;
            }

            int nextStep = int (o.phase * numStepsF);
            if (nextStep != o.step)
            {
                bool wrap = false;
                if (nextStep >= numSteps) { o.phase -= 1.0f; nextStep -= numSteps; wrap = true; }

                float discontinuity = nextStep < half ? 1.0f : -1.0f;
                if (nextStep == 0 || nextStep == half) discontinuity = 0.0f;
                discontinuity *= nesGain;
                if (discontinuity != 0.0f)
                {
                    float frac = o.phase * numStepsF - float (nextStep);
                    float t = frac / (f * numStepsF);
                    thisSample += plThisBlep (t) * discontinuity;
                    nextSample += plNextBlep (t) * discontinuity;
                }

                if (wrap)
                {
                    float d2 = 4.0f * f * triGain;
                    if (d2 != 0.0f)
                    {
                        float t = o.phase / f;
                        thisSample += plThisIntegratedBlep (t) * d2;
                        nextSample += plNextIntegratedBlep (t) * d2;
                    }
                    o.ascending = true;
                }
            }
            o.step = nextStep;

            nextSample += nesGain * float (o.step < half ? o.step : top - o.step);
            nextSample += triGain * (o.phase < 0.5f ? 2.0f * o.phase : 2.0f - 2.0f * o.phase);
            out.at (n) = thisSample * scale - 1.0f;
        }
        o.nextSample = nextSample; o.freq = fV;
    }

    void plInit_7 (int inst)
    {
        plNesInit (plChiptune.at (inst).bass);
        for (int i = 0; i < 5; ++i) plSqInit (plChiptune.at (inst).voice.at (i));
        plG3ChordsInit (plChiptune.at (inst).chords);
        plG3ChordsSort (plChiptune.at (inst).chords);
        plChiptune.at (inst).arpMode = 0; plChiptune.at (inst).arpRange = 1;
        plChiptune.at (inst).arpNote = 0; plChiptune.at (inst).arpOctave = 0; plChiptune.at (inst).arpDir = 1;
        plChiptune.at (inst).pattern = 0;
    }

    // Arpeggiator::Clock
    void plChipArpClock (int inst, int numNotes)
    {
        int mode = plChiptune.at (inst).arpMode;
        int range = plChiptune.at (inst).arpRange;

        if (numNotes == 1 && range == 1)
        {
            plChiptune.at (inst).arpNote = 0; plChiptune.at (inst).arpOctave = 0;
            return;
        }
        if (mode == 3)
        {
            while (true)
            {
                int64 w = plRandWord (inst);
                int octave = int ((w >> 4) % int64 (range));
                int n = int ((w >> 20) % int64 (numNotes));
                if (octave != plChiptune.at (inst).arpOctave || n != plChiptune.at (inst).arpNote)
                {
                    plChiptune.at (inst).arpOctave = octave;
                    plChiptune.at (inst).arpNote = n;
                    break;
                }
            }
            return;
        }
        if (mode == 0) plChiptune.at (inst).arpDir = 1;
        if (mode == 1) plChiptune.at (inst).arpDir = -1;

        int dir = plChiptune.at (inst).arpDir;
        int n = plChiptune.at (inst).arpNote + dir;
        int oct = plChiptune.at (inst).arpOctave;

        bool done = false;
        while (! done)
        {
            done = true;
            if (n >= numNotes || n < 0)
            {
                oct += dir;
                n = dir > 0 ? 0 : numNotes - 1;
            }
            if (oct >= range || oct < 0)
            {
                oct = dir > 0 ? 0 : range - 1;
                if (mode == 2)
                {
                    dir = -dir;
                    n = dir > 0 ? 1 : numNotes - 2;
                    oct = dir > 0 ? 0 : range - 1;
                    done = false;
                }
            }
        }
        plChiptune.at (inst).arpNote = n; plChiptune.at (inst).arpOctave = oct; plChiptune.at (inst).arpDir = dir;
    }

    void plRender_7 (int inst, int trig, float note, float harm, float timb, float morph, float accent)
    {
        float f0 = plNoteToFrequency (note);
        float shape = morph * 0.995f;
        bool clocked = (trig & 2) == 0;
        float rootTransposition = 1.0f;

        float[12] out;
        float[12] aux;

        if (clocked)
        {
            if ((trig & 1) != 0)
            {
                plG3SetChord (plChiptune.at (inst).chords, harm);
                plG3ChordsSort (plChiptune.at (inst).chords);
                int pattern = plG3Quantize (plChiptune.at (inst).pattern, timb, 12, 0.075f);
                plChiptune.at (inst).pattern = pattern;
                plChiptune.at (inst).arpMode = pattern / 3;
                plChiptune.at (inst).arpRange = 1 << (pattern % 3);
                plChipArpClock (inst, plG3ChordNotes.at (plChiptune.at (inst).chords.index));
            }
            float octave = float (1 << plChiptune.at (inst).arpOctave);
            float noteF0 = f0 * plChiptune.at (inst).chords.sorted.at (plChiptune.at (inst).arpNote) * octave;
            rootTransposition = octave;
            plSqRender (plChiptune.at (inst).voice.at (0), noteF0, shape, out);
        }
        else
        {
            float[5] ratios;
            float[5] amps;
            plG3SetChord (plChiptune.at (inst).chords, harm);
            plG3ChordInversion (plChiptune.at (inst).chords, timb, ratios, amps);
            for (int j = 1; j < 5; j += 2) amps.at (j) = -amps.at (j);

            for (int v = 0; v < 5; ++v)
            {
                plSqRender (plChiptune.at (inst).voice.at (v), f0 * ratios.at (v), shape, aux);
                for (int j = 0; j < 12; ++j)
                    out.at (j) = (v == 0 ? 0.0f : out.at (j)) + aux.at (j) * amps.at (v);
            }
        }

        plNesRender (plChiptune.at (inst).bass, f0 * 0.5f * rootTransposition, aux);

        for (int i = 0; i < 12; ++i)
        {
            plOut.at (inst * 12 + i) = out.at (i);
            plAux.at (inst * 12 + i) = aux.at (i);
        }
    }
