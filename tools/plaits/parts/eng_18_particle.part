    // ---------------- engine 18: Particle (plaits/dsp/engine/particle_engine.cc, noise/particle.h) ----------------
    struct PlG4Part { float preGain; PlSvf filter; }
    struct PlG4ParticleEng { PlG4Part[6] part; PlG4Diff diff; PlSvf post; }

    PlG4ParticleEng[48] plG4Particle;

    void plInit_18 (int inst)
    {
        for (int i = 0; i < 6; ++i)
        {
            plG4Particle.at (inst).part.at (i).preGain = 0.0f;
            plSvfInit (plG4Particle.at (inst).part.at (i).filter);
        }
        plG4DiffInit (inst, plG4Particle.at (inst).diff);
        plSvfInit (plG4Particle.at (inst).post);
    }

    void plG4ParticleRender (int inst, PlG4Part& p, bool sync, float density, float gain, float frequency, float spread, float q, float[12]& out, float[12]& aux)
    {
        float u = plRandFloat (inst);
        if (sync)
            u = density;
        bool canRandomize = true;

        for (int n = 0; n < 12; ++n)
        {
            float s = 0.0f;
            if (u <= density)
            {
                s = u * gain;
                if (canRandomize)
                {
                    float u2 = 2.0f * plRandFloat (inst) - 1.0f;
                    float f = min (plSemitonesToRatio (spread * u2) * frequency, 0.25f);
                    p.preGain = 0.5f / sqrt (q * f * sqrt (density));
                    plSvfSetFQ (p.filter, 3, f, q);
                    canRandomize = false;
                }
            }
            aux.at (n) += s;
            out.at (n) += plSvfProcess (p.filter, 1, p.preGain * s);
            u = plRandFloat (inst);
        }
    }

    void plRender_18 (int inst, int trig, float note, float harm, float timb, float morph, float accent)
    {
        float f0 = plNoteToFrequency (note);
        float densitySqrt = plNoteToFrequency (60.0f + timb * timb * 72.0f);
        float density = densitySqrt * densitySqrt * (1.0f / 6.0f);
        float gain = 1.0f / density;
        float qSqrt = plSemitonesToRatio (morph >= 0.5f ? (morph - 0.5f) * 120.0f : 0.0f);
        float q = 0.5f + qSqrt * qSqrt;
        float spread = 48.0f * harm * harm;
        float rawDiffSqrt = 2.0f * abs (morph - 0.5f);
        float rawDiff = rawDiffSqrt * rawDiffSqrt;
        float diffusion = morph < 0.5f ? rawDiff : 0.0f;
        bool sync = (trig & 1) != 0;

        float[12] out;
        float[12] aux;
        for (int i = 0; i < 12; ++i) { out.at (i) = 0.0f; aux.at (i) = 0.0f; }

        for (int i = 0; i < 6; ++i)
            plG4ParticleRender (inst, plG4Particle.at (inst).part.at (i), sync, density, gain, f0, spread, q, out, aux);

        plSvfSetFQ (plG4Particle.at (inst).post, 3, min (f0, 0.49f), 0.5f);
        for (int i = 0; i < 12; ++i)
            out.at (i) = plSvfProcess (plG4Particle.at (inst).post, 0, out.at (i));

        plG4DiffProcess (inst, plG4Particle.at (inst).diff, 0.8f * diffusion * diffusion, 0.5f * diffusion + 0.25f, out);

        for (int i = 0; i < 12; ++i)
        {
            plOut.at (inst * 12 + i) = out.at (i);
            plAux.at (inst * 12 + i) = aux.at (i);
        }
    }
