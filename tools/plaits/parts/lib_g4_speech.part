    // ---------------- plaits/dsp/speech/*: naive, SAM and LPC10 synths ----------------
//@LUT lut_sine
//@LUT lpc_data
//@LUT lut_lpc_excitation_pulse

    // ----- naive speech synth -----
    struct PlSpNaive { float phase; float nextSample; float lpState; float hpState; float freq; int clickDuration; PlSvf[5] filter; PlSvf coloration; }

    void plSpNaiveInit (PlSpNaive& s)
    {
        s.phase = 0.5f; s.nextSample = 0.0f; s.lpState = 1.0f; s.hpState = 0.0f; s.freq = 0.001f;
        s.clickDuration = 0;
        for (int i = 0; i < 5; ++i)
            plSvfInit (s.filter.at (i));
        plSvfInit (s.coloration);
        plSvfSetFQ (s.coloration, 3, 800.0f / 48000.0f, 0.5f);
    }

    void plSpNaiveRender (PlSpNaive& s, bool click, float frequency, float phoneme, float reg, float[12]& excitation, float[12]& outBuf)
    {
        if (click)
            s.clickDuration = int (48000.0f * 0.05f);
        s.clickDuration -= min (s.clickDuration, 12);
        if (s.clickDuration != 0)
            frequency *= 0.5f;

        // impulse train oscillator
        frequency = clamp (frequency, 0.000001f, 0.25f);
        float fmV = s.freq;
        float fmI = (frequency - s.freq) / 12.0f;
        float nextSample = s.nextSample;
        for (int n = 0; n < 12; ++n)
        {
            float thisSample = nextSample;
            nextSample = 0.0f;
            fmV += fmI;
            float f = fmV;
            s.phase += f;
            if (s.phase >= 1.0f)
            {
                s.phase -= 1.0f;
                float t = s.phase / f;
                thisSample -= plThisBlep (t);
                nextSample -= plNextBlep (t);
            }
            nextSample += s.phase;
            s.lpState += 0.25f * ((s.hpState - thisSample) - s.lpState);
            excitation.at (n) = 4.0f * s.lpState;
            s.hpState = thisSample;
        }
        s.freq = fmV;
        s.nextSample = nextSample;

        for (int n = 0; n < 12; ++n)
            excitation.at (n) = plSvfProcess (s.coloration, 1, excitation.at (n)) * 4.0f;

        float p = phoneme * 3.999f;
        float r = reg * 3.999f;
        int pi = int (p);  float pf = p - float (pi);
        int ri = int (r);  float rf = r - float (ri);

        for (int n = 0; n < 12; ++n)
            outBuf.at (n) = 0.0f;

        for (int i = 0; i < 5; ++i)
        {
            float f00 = float (spNaivePhonemes.at (((pi * 5 + ri) * 5 + i) * 2));
            float f01 = float (spNaivePhonemes.at (((pi * 5 + ri + 1) * 5 + i) * 2));
            float f10 = float (spNaivePhonemes.at ((((pi + 1) * 5 + ri) * 5 + i) * 2));
            float f11 = float (spNaivePhonemes.at ((((pi + 1) * 5 + ri + 1) * 5 + i) * 2));
            float a00 = float (spNaivePhonemes.at (((pi * 5 + ri) * 5 + i) * 2 + 1));
            float a01 = float (spNaivePhonemes.at (((pi * 5 + ri + 1) * 5 + i) * 2 + 1));
            float a10 = float (spNaivePhonemes.at ((((pi + 1) * 5 + ri) * 5 + i) * 2 + 1));
            float a11 = float (spNaivePhonemes.at ((((pi + 1) * 5 + ri + 1) * 5 + i) * 2 + 1));

            float p0rF = f00 + (f01 - f00) * rf;
            float p1rF = f10 + (f11 - f10) * rf;
            float fr = p0rF + (p1rF - p0rF) * pf;
            float p0rA = a00 + (a01 - a00) * rf;
            float p1rA = a10 + (a11 - a10) * rf;
            float a = (p0rA + (p1rA - p0rA) * pf) / 256.0f;

            if (fr >= 160.0f)
                fr = 160.0f;
            fr = plA0 * plSemitonesToRatio (fr - 33.0f);
            if (s.clickDuration != 0 && i == 0)
                fr *= 0.5f;
            plSvfSetFQ (s.filter.at (i), 3, fr, 20.0f);
            for (int n = 0; n < 12; ++n)
                outBuf.at (n) += a * plSvfProcess (s.filter.at (i), 1, excitation.at (n));
        }
    }

    // ----- SAM speech synth -----
    struct PlSpSam { float phase; float freq; float pulseNext; float pulseLp; int64[3] fph; int consonantSamples; float consonantIndex; }

    void plSpSamInit (PlSpSam& s)
    {
        s.phase = 0.0f; s.freq = 0.0f; s.pulseNext = 0.0f; s.pulseLp = 0.0f;
        s.fph.at (0) = 0; s.fph.at (1) = 0; s.fph.at (2) = 0;
        s.consonantSamples = 0; s.consonantIndex = 0.0f;
    }

    const float[16] spSamAmp = (0.03125000f, 0.03756299f, 0.04515131f, 0.05427259f, 0.06523652f, 0.07841532f, 0.09425646f, 0.11329776f,
                                0.13618570f, 0.16369736f, 0.19676682f, 0.23651683f, 0.28429697f, 0.34172946f, 0.41076422f, 0.49374509f);

    void plSpSamRender (PlSpSam& s, bool consonant, float frequency, float vowel, float formantShift, float[12]& excitation, float[12]& outBuf)
    {
        if (frequency >= 0.0625f)
            frequency = 0.0625f;

        if (consonant)
        {
            s.consonantSamples = int (48000.0f * 0.05f);
            int r = int ((vowel + 3.0f * frequency + 7.0f * formantShift) * 8.0f);
            s.consonantIndex = float (r % 8);
        }
        s.consonantSamples -= min (s.consonantSamples, 12);

        float phoneme = s.consonantSamples != 0 ? (s.consonantIndex + 9.0f) : vowel * (9.0f - 1.0001f);

        int64[3] ff;
        float[3] fa;
        int pi = int (phoneme);
        float pf = phoneme - float (pi);
        float shift = 1.0f + formantShift * 2.5f;
        for (int i = 0; i < 3; ++i)
        {
            float f1 = float (spSamPhonemes.at (pi * 6 + i * 2));
            float f2 = float (spSamPhonemes.at ((pi + 1) * 6 + i * 2));
            float f = f1 + (f2 - f1) * pf;
            f *= 8.0f * shift * 4294967296.0f / 48000.0f;
            ff.at (i) = int64 (f);
            float a1 = spSamAmp.at (spSamPhonemes.at (pi * 6 + i * 2 + 1));
            float a2 = spSamAmp.at (spSamPhonemes.at ((pi + 1) * 6 + i * 2 + 1));
            fa.at (i) = a1 + (a2 - a1) * pf;
        }

        float fmV = s.freq;
        float fmI = (frequency - s.freq) / 12.0f;
        float pulseNext = s.pulseNext;

        for (int n = 0; n < 12; ++n)
        {
            float pulseThis = pulseNext;
            pulseNext = 0.0f;
            fmV += fmI;
            float f = fmV;
            s.phase += f;

            if (s.phase >= 1.0f)
            {
                s.phase -= 1.0f;
                float t = s.phase / f;
                s.fph.at (0) = int64 (t * float (ff.at (0)));
                s.fph.at (1) = int64 (t * float (ff.at (1)));
                s.fph.at (2) = int64 (t * float (ff.at (2)));
                pulseThis -= plThisBlep (t);
                pulseNext -= plNextBlep (t);
            }
            else
            {
                s.fph.at (0) = (s.fph.at (0) + ff.at (0)) & 4294967295i64;
                s.fph.at (1) = (s.fph.at (1) + ff.at (1)) & 4294967295i64;
                s.fph.at (2) = (s.fph.at (2) + ff.at (2)) & 4294967295i64;
            }
            pulseNext += s.phase;

            float d = pulseThis - 0.5f - s.pulseLp;
            s.pulseLp += min (16.0f * f, 1.0f) * d;
            excitation.at (n) = d;

            float v = 0.0f;
            v += lut_sine.at (int (s.fph.at (0) >> 23)) * fa.at (0);
            v += lut_sine.at (int (s.fph.at (1) >> 23)) * fa.at (1);
            v += lut_sine.at (int (s.fph.at (2) >> 23)) * fa.at (2);
            v *= (1.0f - s.phase);
            outBuf.at (n) = v;
        }
        s.freq = fmV;
        s.pulseNext = pulseNext;
    }

    // ----- LPC10 synth + controller (word banks are decoded at build time, see gen_speech.py) -----
    struct PlSpLpc
    {
        float phase; float frequency; float noiseEnergy; float pulseEnergy; float nextSample; int pulseIndex;
        float[10] k; float[11] s;
        float clockPhase; float[2] sample; float[2] nextSampleC; float gain;
        int playbackFrame; int lastPlaybackFrame; int remaining; int loadedBank;
    }

    void plSpLpcInit (PlSpLpc& l)
    {
        l.phase = 0.0f; l.frequency = 0.0125f; l.noiseEnergy = 0.0f; l.pulseEnergy = 0.0f; l.nextSample = 0.0f; l.pulseIndex = 0;
        for (int i = 0; i < 10; ++i) l.k.at (i) = 0.0f;
        for (int i = 0; i < 11; ++i) l.s.at (i) = 0.0f;
        l.clockPhase = 0.0f;
        l.sample.at (0) = 0.0f; l.sample.at (1) = 0.0f; l.nextSampleC.at (0) = 0.0f; l.nextSampleC.at (1) = 0.0f;
        l.gain = 0.0f;
        l.playbackFrame = -1; l.lastPlaybackFrame = -1; l.remaining = 0; l.loadedBank = -1;
    }

    // field k of frame idx: bank < 0 -> the built in vowel/consonant table
    int plSpFrame (int bank, int idx, int k)
    {
        if (bank < 0)
            return lpcPhonemes.at (idx * 12 + k);
        return lpcFrames.at ((lpcBankBase.at (bank) + idx) * 12 + k);
    }

    float plSpBlend (int a, int b, float blend, float scale)
    {
        float af = float (a) / scale;
        float bf = float (b) / scale;
        return af + (bf - af) * blend;
    }

    void plSpLpcPlayFrame (PlSpLpc& l, int bank, float frame, bool interpolate)
    {
        int fi = int (frame);
        float ff = frame - float (fi);
        if (! interpolate)
            ff = 0.0f;
        int i1 = fi;
        int i2 = fi + 1;
        int per1 = plSpFrame (bank, i1, 1);
        int per2 = plSpFrame (bank, i2, 1);
        int en1 = plSpFrame (bank, i1, 0);
        int en2 = plSpFrame (bank, i2, 0);

        float frequency1 = per1 == 0 ? l.frequency : 1.0f / float (per1);
        float frequency2 = per2 == 0 ? l.frequency : 1.0f / float (per2);
        l.frequency = frequency1 + (frequency2 - frequency1) * ff;

        float energy1 = float (en1) / 256.0f;
        float energy2 = float (en2) / 256.0f;
        float noise1 = per1 == 0 ? energy1 : 0.0f;
        float noise2 = per2 == 0 ? energy2 : 0.0f;
        l.noiseEnergy = noise1 + (noise2 - noise1) * ff;
        float pulse1 = per1 != 0 ? energy1 : 0.0f;
        float pulse2 = per2 != 0 ? energy2 : 0.0f;
        l.pulseEnergy = pulse1 + (pulse2 - pulse1) * ff;

        for (int j = 0; j < 10; ++j)
            l.k.at (j) = plSpBlend (plSpFrame (bank, i1, 2 + j), plSpFrame (bank, i2, 2 + j), ff, j < 2 ? 32768.0f : 128.0f);
    }

    // one sample of LPCSpeechSynth::Render; res[0] = excitation, res[1] = outBuf
    void plSpLpcSynth (int inst, PlSpLpc& l, float prosody, float pitchShift, float[2]& res)
    {
        float baseF0 = 100.0f / 8000.0f;
        float d = l.frequency - baseF0;
        float f = clamp ((baseF0 + d * prosody) * pitchShift, 0.0f, 0.5f);

        l.phase += f;
        float thisSample = l.nextSample;
        float nextSample = 0.0f;

        if (l.phase >= 1.0f)
        {
            l.phase -= 1.0f;
            float resetTime = l.phase / f;
            int resetSample = int (32.0f * resetTime);
            float disc = 0.0f;
            if (l.pulseIndex < 640)
            {
                l.pulseIndex -= resetSample;
                int s8 = lut_lpc_excitation_pulse.at (l.pulseIndex);
                disc = float (s8) / 128.0f * l.pulseEnergy;
            }
            thisSample += -disc * plThisBlep (resetTime);
            nextSample += -disc * plNextBlep (resetTime);
            l.pulseIndex = resetSample;
        }

        float[11] e;
        e.at (10) = plRandSample (inst) > 0 ? l.noiseEnergy : -l.noiseEnergy;
        if (l.pulseIndex < 640)
        {
            int s8 = lut_lpc_excitation_pulse.at (l.pulseIndex);
            nextSample += float (s8) / 128.0f * l.pulseEnergy;
            l.pulseIndex += 32;
        }
        e.at (10) += thisSample;
        e.at (10) *= 1.5f;

        for (int i = 9; i >= 0; --i)
            e.at (i) = e.at (i + 1) - l.k.at (i) * l.s.at (i);

        e.at (0) = clamp (e.at (0), -2.0f, 2.0f);

        for (int i = 9; i >= 1; --i)
            l.s.at (i) = l.s.at (i - 1) + l.k.at (i - 1) * e.at (i - 1);
        l.s.at (0) = e.at (0);

        l.nextSample = nextSample;
        res.at (0) = e.at (10);
        res.at (1) = e.at (0);
    }

    // LPCSpeechSynthController::Render
    void plSpLpcRender (int inst, PlSpLpc& l, bool freeRunning, bool trigger, int bank, float frequency, float prosody, float speed,
                        float address, float formantShift, float gain, float[12]& excitation, float[12]& outBuf)
    {
        float rateRatio = plSemitonesToRatio ((formantShift - 0.5f) * 36.0f);
        float rate = rateRatio / 6.0f;
        float pitchShift = frequency / (rateRatio * 100.0f / 47872.34f);
        float timeStretch = plSemitonesToRatio (-speed * 24.0f + (formantShift < 0.4f ? (formantShift - 0.4f) * -45.0f
                                                    : (formantShift > 0.6f ? (formantShift - 0.6f) * -45.0f : 0.0f)));

        if (bank != -1)
        {
            if (bank != l.loadedBank && bank < 5)
            {
                l.loadedBank = bank;
                l.playbackFrame = -1;
                l.lastPlaybackFrame = -1;
            }
        }

        int numFrames = bank == -1 ? 5 : lpcBankNumFrames.at (bank);

        if (trigger)
        {
            if (bank == -1)
            {
                int r = int ((address + 3.0f * formantShift + 7.0f * frequency) * 8.0f);
                l.playbackFrame = (r % 10) + 5;
                l.lastPlaybackFrame = l.playbackFrame + 1;
            }
            else
            {
                int nw = lpcBankNumWords.at (bank);
                int word = int (address * float (nw));
                if (word >= nw)
                    word = nw - 1;
                l.playbackFrame = lpcWordBounds.at (bank * 33 + word);
                l.lastPlaybackFrame = lpcWordBounds.at (bank * 33 + word + 1) - 1;
            }
            l.remaining = 0;
        }

        if (l.playbackFrame == -1 && l.remaining == 0)
        {
            plSpLpcPlayFrame (l, bank, address * (float (numFrames) - 1.0001f), true);
        }
        else
        {
            if (l.remaining == 0)
            {
                plSpLpcPlayFrame (l, bank, float (l.playbackFrame), false);
                l.remaining = int (48000.0f / 40.0f * timeStretch);
                ++l.playbackFrame;
                if (l.playbackFrame >= l.lastPlaybackFrame)
                {
                    bool backToScan = bank == -1 || freeRunning;
                    l.playbackFrame = backToScan ? -1 : l.lastPlaybackFrame;
                }
            }
            l.remaining -= min (12, l.remaining);
        }

        float gV = l.gain;
        float gI = (gain - l.gain) / 12.0f;

        for (int n = 0; n < 12; ++n)
        {
            float this0 = l.nextSampleC.at (0);
            float this1 = l.nextSampleC.at (1);
            l.nextSampleC.at (0) = 0.0f;
            l.nextSampleC.at (1) = 0.0f;

            l.clockPhase += rate;
            if (l.clockPhase >= 1.0f)
            {
                l.clockPhase -= 1.0f;
                float resetTime = l.clockPhase / rate;
                float[2] ns;
                plSpLpcSynth (inst, l, prosody, pitchShift, ns);
                float disc0 = ns.at (0) - l.sample.at (0);
                float disc1 = ns.at (1) - l.sample.at (1);
                this0 += disc0 * plThisBlep (resetTime);
                l.nextSampleC.at (0) += disc0 * plNextBlep (resetTime);
                this1 += disc1 * plThisBlep (resetTime);
                l.nextSampleC.at (1) += disc1 * plNextBlep (resetTime);
                l.sample.at (0) = ns.at (0);
                l.sample.at (1) = ns.at (1);
            }
            l.nextSampleC.at (0) += l.sample.at (0);
            l.nextSampleC.at (1) += l.sample.at (1);
            gV += gI;
            excitation.at (n) = this0 * gV;
            outBuf.at (n) = this1 * gV;
        }
        l.gain = gV;
    }
