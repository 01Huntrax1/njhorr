    // ---------------- engine 15: Speech (plaits/dsp/engine/speech_engine.cc) ----------------
    struct PlG4Speech { PlSpNaive naive; PlSpSam sam; PlSpLpc lpc; int quant; }

    PlG4Speech[48] plG4Speech;

    void plInit_15 (int inst)
    {
        plSpSamInit (plG4Speech.at (inst).sam);
        plSpNaiveInit (plG4Speech.at (inst).naive);
        plSpLpcInit (plG4Speech.at (inst).lpc);
        plG4Speech.at (inst).quant = 0;
    }

    void plRender_15 (int inst, int trig, float note, float harm, float timb, float morph, float accent)
    {
        float f0 = plNoteToFrequency (note);
        float group = harm * 6.0f;
        float[12] out;
        float[12] aux;
        float[12] temp0;
        float[12] temp1;
        bool rising = trig == 1;

        if (group <= 2.0f)
        {
            float blend = group;
            if (group <= 1.0f)
                plSpNaiveRender (plG4Speech.at (inst).naive, rising, f0, morph, timb, aux, out);
            else
            {
                plSpLpcRender (inst, plG4Speech.at (inst).lpc, false, (trig & 1) != 0, -1, f0, 0.0f, 0.0f, morph, timb, 1.0f, aux, out);
                blend = 2.0f - blend;
            }

            plSpSamRender (plG4Speech.at (inst).sam, rising, f0, morph, timb, temp0, temp1);

            blend *= blend * (3.0f - 2.0f * blend);
            blend *= blend * (3.0f - 2.0f * blend);
            for (int i = 0; i < 12; ++i)
            {
                aux.at (i) += (temp0.at (i) - aux.at (i)) * blend;
                out.at (i) += (temp1.at (i) - out.at (i)) * blend;
            }
        }
        else
        {
            // HysteresisQuantizer2 (6 steps, 0.1, not symmetric)
            float value = (group - 2.0f) * 0.275f * 6.0f - 0.5f;
            float sgn = value > float (plG4Speech.at (inst).quant) ? -1.0f : 1.0f;
            int q = clamp (int (value + sgn * 0.1f + 0.5f), 0, 5);
            plG4Speech.at (inst).quant = q;
            int wordBank = q - 1;
            bool replay = wordBank >= 0;

            plSpLpcRender (inst, plG4Speech.at (inst).lpc, false, (trig & 1) != 0, wordBank, f0, 0.0f, 0.0f, morph, timb, replay ? accent : 1.0f, aux, out);
        }

        for (int i = 0; i < 12; ++i)
        {
            plOut.at (inst * 12 + i) = out.at (i);
            plAux.at (inst * 12 + i) = aux.at (i);
        }
    }
