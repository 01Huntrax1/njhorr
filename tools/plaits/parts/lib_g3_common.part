//@LUT lut_sine
    // ---------------- shared by the engines String machine, Chiptune, Chord, Swarm (group G3) ----------------
    // plaits/dsp/oscillator/string_synth_oscillator.h
    struct PlG3Sso { float phase; float nextSample; int segment; float freq; float g8; float g4; float g2; float g1; }

    void plG3SsoInit (PlG3Sso& o)
    {
        o.phase = 0.0f; o.nextSample = 0.0f; o.segment = 0; o.freq = 0.001f;
        o.g8 = 0.0f; o.g4 = 0.0f; o.g2 = 0.0f; o.g1 = 0.0f;
    }

    // reg: 7 (+1) harmonics amplitudes of the registration
    void plG3SsoRender (PlG3Sso& o, float frequency, float[8]& ureg, float gain, float[12]& out)
    {
        frequency *= 8.0f;
        int shift = 0;
        while (frequency > 0.5f) { shift += 2; frequency *= 0.5f; }
        if (shift >= 8) return;

        float[7] reg;
        for (int i = 0; i < 7 - shift; ++i) reg.at (i + shift) = ureg.at (i);

        float fInc  = (frequency - o.freq) / 12.0f;                                                float fV  = o.freq;
        float t8    = (reg.at (0) + 2.0f * reg.at (1)) * gain;
        float t4    = (reg.at (2) - reg.at (1) + 2.0f * reg.at (3)) * gain;
        float t2    = (reg.at (4) - reg.at (3) + 2.0f * reg.at (5)) * gain;
        float t1    = (reg.at (6) - reg.at (5)) * gain;
        float i8 = (t8 - o.g8) / 12.0f; float v8 = o.g8;
        float i4 = (t4 - o.g4) / 12.0f; float v4 = o.g4;
        float i2 = (t2 - o.g2) / 12.0f; float v2 = o.g2;
        float i1 = (t1 - o.g1) / 12.0f; float v1 = o.g1;

        float phase = o.phase;
        float nextSample = o.nextSample;
        int   segment = o.segment;

        for (int n = 0; n < 12; ++n)
        {
            float thisSample = nextSample;
            nextSample = 0.0f;

            fV += fInc; v8 += i8; v4 += i4; v2 += i2; v1 += i1;
            float f = fV;

            phase += f;
            int nextSegment = int (phase);
            if (nextSegment != segment)
            {
                float discontinuity = 0.0f;
                if (nextSegment == 8)
                {
                    phase -= 8.0f;
                    nextSegment -= 8;
                    discontinuity -= v8;
                }
                if ((nextSegment & 3) == 0) discontinuity -= v4;
                if ((nextSegment & 1) == 0) discontinuity -= v2;
                discontinuity -= v1;
                if (discontinuity != 0.0f)
                {
                    float fraction = phase - float (nextSegment);
                    float t = fraction / f;
                    thisSample += plThisBlep (t) * discontinuity;
                    nextSample += plNextBlep (t) * discontinuity;
                }
            }
            segment = nextSegment;

            nextSample += (phase - 4.0f) * v8 * 0.125f;
            nextSample += (phase - float (segment & 4) - 2.0f) * v4 * 0.25f;
            nextSample += (phase - float (segment & 6) - 1.0f) * v2 * 0.5f;
            nextSample += (phase - float (segment & 7) - 0.5f) * v1;
            out.at (n) += 2.0f * thisSample;
        }

        o.nextSample = nextSample; o.phase = phase; o.segment = segment;
        o.freq = fV; o.g8 = v8; o.g4 = v4; o.g2 = v2; o.g1 = v1;
    }

    // ---------------- plaits/dsp/chords/chord_bank.h (non JON_CHORDS) ----------------
    const float[44] plG3ChordSemis = (0.00f, 0.01f, 11.99f, 12.00f,   0.00f, 7.00f, 7.01f, 12.00f,   0.00f, 5.00f, 7.00f, 12.00f,
                                      0.00f, 3.00f, 7.00f, 12.00f,    0.00f, 3.00f, 7.00f, 10.00f,   0.00f, 3.00f, 10.00f, 14.00f,
                                      0.00f, 3.00f, 10.00f, 17.00f,   0.00f, 2.00f, 9.00f, 16.00f,   0.00f, 4.00f, 11.00f, 14.00f,
                                      0.00f, 4.00f, 7.00f, 11.00f,    0.00f, 4.00f, 7.00f, 12.00f);
    const int[11] plG3ChordNotes = (1, 2, 3, 3, 4, 4, 4, 4, 4, 4, 3);

    struct PlG3Chords { int index; float[4] sorted; }

    // HysteresisQuantizer2 (11 steps, 0.075, not symmetric)
    int plG3Quantize (int prev, float value, int numSteps, float hysteresis)
    {
        value *= float (numSteps);
        value += -0.5f;
        float sgn = value > float (prev) ? -1.0f : 1.0f;
        return clamp (int (value + sgn * hysteresis + 0.5f), 0, numSteps - 1);
    }

    float plG3ChordRatio (PlG3Chords& c, int note)  { return plSemitonesToRatio (plG3ChordSemis.at (c.index * 4 + note)); }

    void plG3ChordsInit (PlG3Chords& c)
    {
        c.index = 0;
        for (int i = 0; i < 4; ++i) c.sorted.at (i) = 0.0f;
    }

    void plG3ChordsSort (PlG3Chords& c)
    {
        for (int i = 0; i < 4; ++i)
        {
            float r = plG3ChordRatio (c, i);
            while (r > 2.0f) r *= 0.5f;
            c.sorted.at (i) = r;
        }
        for (int a = 0; a < 3; ++a)
            for (int b = 0; b < 3 - a; ++b)
                if (c.sorted.at (b) > c.sorted.at (b + 1))
                {
                    float t = c.sorted.at (b); c.sorted.at (b) = c.sorted.at (b + 1); c.sorted.at (b + 1) = t;
                }
    }

    void plG3SetChord (PlG3Chords& c, float parameter)  { c.index = plG3Quantize (c.index, parameter * 1.02f, 11, 0.075f); }

    int plG3ChordInversion (PlG3Chords& c, float inversion, float[5]& ratios, float[5]& amplitudes)
    {
        inversion = inversion * 20.0f;
        int   inversionIntegral = int (inversion);
        float inversionFractional = inversion - float (inversionIntegral);

        int numRotations = inversionIntegral / 4;
        int rotatedNote  = inversionIntegral % 4;
        let kBaseGain = 0.25f;
        int mask = 0;

        for (int i = 0; i < 4; ++i)
        {
            float transposition = 0.25f * float (1 << ((3 + inversionIntegral - i) / 4));
            int targetVoice   = (i - numRotations + 5) % 5;
            int previousVoice = (targetVoice - 1 + 5) % 5;
            float base = plG3ChordRatio (c, i);

            if (i == rotatedNote)
            {
                ratios.at (targetVoice) = base * transposition;
                ratios.at (previousVoice) = ratios.at (targetVoice) * 2.0f;
                amplitudes.at (previousVoice) = kBaseGain * inversionFractional;
                amplitudes.at (targetVoice) = kBaseGain * (1.0f - inversionFractional);
            }
            else if (i < rotatedNote)
            {
                ratios.at (previousVoice) = base * transposition;
                amplitudes.at (previousVoice) = kBaseGain;
            }
            else
            {
                ratios.at (targetVoice) = base * transposition;
                amplitudes.at (targetVoice) = kBaseGain;
            }

            if (i == 0)
            {
                if (i >= rotatedNote) mask |= 1 << targetVoice;
                if (i <= rotatedNote) mask |= 1 << previousVoice;
            }
        }
        return mask;
    }
