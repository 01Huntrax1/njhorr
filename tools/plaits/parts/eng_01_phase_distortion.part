//@LUT lut_fm_frequency_quantizer
    // ---------------- engine 1: Phase distortion (plaits/dsp/engine2/phase_distortion_engine.cc) ----------------
    struct PlPd { PlVso shaper; PlVso modulator; }

    PlPd[48] plPd;

    void plInit_1 (int inst)
    {
        plVsoInit (plPd.at (inst).modulator);
        plVsoInit (plPd.at (inst).shaper);
    }

    void plRender_1 (int inst, int trig, float note, float harm, float timb, float morph, float accent)
    {
        float f0 = 0.5f * plNoteToFrequency (note);
        float modF = min (0.25f, f0 * plSemitonesToRatio (plInterpolate (lut_fm_frequency_quantizer, harm, 128.0f)));
        float pw = 0.5f + morph * 0.49f;
        float amount = 8.0f * timb * timb * (1.0f - modF * 3.8f);

        float[24] synced;
        float[24] freeRun;
        plG1VsoRender24 (plPd.at (inst).shaper, true, true, f0, modF, pw, 0.0f, amount, synced);
        plG1VsoRender24 (plPd.at (inst).modulator, false, true, f0, modF, pw, 0.0f, amount, freeRun);

        for (int i = 0; i < 12; ++i)
        {
            plOut.at (inst * 12 + i) = 0.5f * plG1Sine (synced.at (2 * i) + 0.25f) + 0.5f * plG1Sine (synced.at (2 * i + 1) + 0.25f);
            plAux.at (inst * 12 + i) = 0.5f * plG1Sine (freeRun.at (2 * i) + 0.25f) + 0.5f * plG1Sine (freeRun.at (2 * i + 1) + 0.25f);
        }
    }
