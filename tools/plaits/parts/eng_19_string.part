    // ---------------- engine 19: String (plaits/dsp/engine/string_engine.cc, string_voice, string; sustain mode unused) ----------------
//@LUT lut_svf_shift
    struct PlStrV
    {
        float[1024] line; int wp;           // string delay line
        float[256]  stretch; int swp;       // dispersion all-pass line
        PlSvf damp; PlDcBlocker dc;
        float delay; float dispNoise; float curved; float srcPhase; float out0; float out1;
        PlSvf exc; int remaining;
    }

    struct PlStr
    {
        PlStrV[3] v;
        float[3] f0;
        float[16] fd; int fwp;
        int active;
    }

    PlStr[48] plStr;

    void plStrVInit (PlStrV& s)
    {
        plSvfInit (s.exc);
        s.remaining = 0;
        s.delay = 100.0f;
        for (int i = 0; i < 1024; ++i) s.line.at (i) = 0.0f;
        for (int i = 0; i < 256; ++i)  s.stretch.at (i) = 0.0f;
        s.wp = 0; s.swp = 0;
        plSvfInit (s.damp);
        plDcInit (s.dc, 1.0f - 20.0f / 48000.0f);
        s.dispNoise = 0.0f; s.curved = 0.0f; s.out0 = 0.0f; s.out1 = 0.0f; s.srcPhase = 0.0f;
    }

    void plStrInit (PlStr& d)
    {
        for (int i = 0; i < 3; ++i) { plStrVInit (d.v.at (i)); d.f0.at (i) = 0.01f; }
        d.active = 2;
        for (int i = 0; i < 16; ++i) d.fd.at (i) = 0.0f;
        d.fwp = 0;
    }

    void plInit_19 (int inst)  { plStrInit (plStr.at (inst)); }

    void plStrWrite (PlStrV& s, float x)
    {
        s.line.at (s.wp) = x;
        s.wp = (s.wp - 1 + 1024) % 1024;
    }

    float plStrRead (PlStrV& s, float delay)
    {
        int   di = int (delay);
        float df = delay - float (di);
        float a = s.line.at ((s.wp + di) % 1024);
        float b = s.line.at ((s.wp + di + 1) % 1024);
        return a + (b - a) * df;
    }

    float plStrReadHermite (PlStrV& s, float delay)
    {
        int   di = int (delay);
        float df = delay - float (di);
        int   t  = s.wp + di + 1024;
        float xm1 = s.line.at ((t - 1) % 1024);
        float x0  = s.line.at (t % 1024);
        float x1  = s.line.at ((t + 1) % 1024);
        float x2  = s.line.at ((t + 2) % 1024);
        float c = (x1 - xm1) * 0.5f;
        float v = x0 - x1;
        float w = c + v;
        float a = w + v + (x2 - x0) * 0.5f;
        float bNeg = w + a;
        return (((a * df) - bNeg) * df + c) * df + x0;
    }

    float plStrAllpass (PlStrV& s, float sample, int delay, float coefficient)
    {
        float read = s.stretch.at ((s.swp + delay) % 256);
        float write = sample + coefficient * read;
        s.stretch.at (s.swp) = write;
        s.swp = (s.swp - 1 + 256) % 256;
        return -write * coefficient + read;
    }

    void plStrProcess (int inst, PlStrV& s, float f0, float nonLinearity, float brightness, float damping, float[12]& in, float[12]& out)
    {
        bool dispersion = nonLinearity > 0.0f;
        float nl = dispersion ? nonLinearity : -nonLinearity;

        float delay = 1.0f / f0;
        delay = clamp (delay, 4.0f, 1020.0f);

        float srcRatio = delay * f0;
        if (srcRatio >= 0.9999f)
        {
            s.srcPhase = 1.0f;
            srcRatio = 1.0f;
        }

        float dampingCutoff = min (12.0f + damping * damping * 60.0f + brightness * 24.0f, 84.0f);
        float dampingF = min (f0 * plSemitonesToRatio (dampingCutoff), 0.499f);

        if (damping >= 0.95f)
        {
            float toInfinite = 20.0f * (damping - 0.95f);
            brightness += toInfinite * (1.0f - brightness);
            dampingF += toInfinite * (0.4999f - dampingF);
            dampingCutoff += toInfinite * (128.0f - dampingCutoff);
        }

        plSvfSetFQ (s.damp, 2, dampingF, 0.5f);

        float dampingCompensation = plInterpolate (lut_svf_shift, dampingCutoff, 1.0f);

        float delayTarget = delay * dampingCompensation;
        float delayInc = (delayTarget - s.delay) / 12.0f;
        float delayV = s.delay;

        float stretchPoint = nl * (2.0f - nl) * 0.225f;
        float stretchCorrection = (160.0f / 48000.0f) * delay;
        stretchCorrection = clamp (stretchCorrection, 1.0f, 2.1f);

        float noiseAmountSqrt = nl > 0.75f ? 4.0f * (nl - 0.75f) : 0.0f;
        float noiseAmount = noiseAmountSqrt * noiseAmountSqrt * 0.1f;
        float noiseFilter = 0.06f + 0.94f * brightness * brightness;

        float bridgeCurvingSqrt = nl;
        float bridgeCurving = bridgeCurvingSqrt * bridgeCurvingSqrt * 0.01f;

        float apGain = -0.618f * nl / (0.15f + abs (nl));

        for (int n = 0; n < 12; ++n)
        {
            s.srcPhase += srcRatio;
            if (s.srcPhase > 1.0f)
            {
                s.srcPhase -= 1.0f;

                delayV += delayInc;
                float dl = delayV;
                float x = 0.0f;

                if (dispersion)
                {
                    float noise = plRandFloat (inst) - 0.5f;
                    s.dispNoise += noiseFilter * (noise - s.dispNoise);
                    dl *= 1.0f + s.dispNoise * noiseAmount;
                }
                else
                {
                    dl *= 1.0f - s.curved * bridgeCurving;
                }

                if (dispersion)
                {
                    float apDelay = dl * stretchPoint;
                    float mainDelay = dl - apDelay * (0.408f - stretchPoint * 0.308f) * stretchCorrection;
                    if (apDelay >= 4.0f && mainDelay >= 4.0f)
                    {
                        x = plStrRead (s, mainDelay);
                        x = plStrAllpass (s, x, int (apDelay), apGain);
                    }
                    else
                    {
                        x = plStrReadHermite (s, dl);
                    }
                }
                else
                {
                    x = plStrReadHermite (s, dl);
                }

                if (! dispersion)
                {
                    float value = abs (x) - 0.025f;
                    float sign = x > 0.0f ? 1.0f : -1.5f;
                    s.curved = (abs (value) + value) * sign;
                }

                x += in.at (n);
                x = clamp (x, -20.0f, 20.0f);

                x = plDcProcess (s.dc, x);
                x = plSvfProcess (s.damp, 0, x);
                plStrWrite (s, x);

                s.out1 = s.out0;
                s.out0 = x;
            }

            out.at (n) += s.out1 + (s.out0 - s.out1) * s.srcPhase;
        }

        s.delay = delayV;
    }

    void plStrRender (int inst, PlStr& d, int trig, float note, float harm, float timb, float morph, float accent)
    {
        bool rising = (trig & 1) != 0;

        if (rising)
        {
            // f0_delay_.Read (14)
            d.f0.at (d.active) = d.fd.at ((d.fwp + 14) % 16) + (d.fd.at ((d.fwp + 15) % 16) - d.fd.at ((d.fwp + 14) % 16)) * 0.0f;
            d.active = (d.active + 1) % 3;
        }

        float f0 = plNoteToFrequency (note);
        d.f0.at (d.active) = f0;
        d.fd.at (d.fwp) = f0;
        d.fwp = (d.fwp - 1 + 16) % 16;

        float[12] out;
        float[12] aux;
        float[12] temp;
        for (int i = 0; i < 12; ++i) { out.at (i) = 0.0f; aux.at (i) = 0.0f; }

        float structure  = harm;
        float brightness0 = timb * timb;
        float damping0   = morph;

        for (int vi = 0; vi < 3; ++vi)
        {
            bool trigger = rising && vi == d.active;
            float vf0 = d.f0.at (vi);
            float brightness = brightness0;
            float damping = damping0;

            brightness += 0.25f * accent * (1.0f - brightness);
            damping    += 0.25f * accent * (1.0f - damping);

            if (trigger)
            {
                float range = 72.0f;
                float f = 4.0f * vf0;
                float cutoff = min (f * plSemitonesToRatio ((brightness * (2.0f - brightness) - 0.5f) * range), 0.499f);
                float q = 0.5f;
                d.v.at (vi).remaining = int (1.0f / vf0);
                plSvfSetFQ (d.v.at (vi).exc, 3, cutoff, q);
            }

            if (d.v.at (vi).remaining != 0)
            {
                int noiseSamples = min (d.v.at (vi).remaining, 12);
                d.v.at (vi).remaining -= noiseSamples;
                for (int i = 0; i < 12; ++i)
                    temp.at (i) = i < noiseSamples ? 2.0f * plRandFloat (inst) - 1.0f : 0.0f;
            }
            else
            {
                for (int i = 0; i < 12; ++i) temp.at (i) = 0.0f;
            }

            for (int i = 0; i < 12; ++i) temp.at (i) = plSvfProcess (d.v.at (vi).exc, 0, temp.at (i));
            for (int i = 0; i < 12; ++i) aux.at (i) += temp.at (i);

            float nonLinearity = structure < 0.24f
                ? (structure - 0.24f) * 4.166f
                : (structure > 0.26f ? (structure - 0.26f) * 1.35135f : 0.0f);

            plStrProcess (inst, d.v.at (vi), vf0, nonLinearity, brightness, damping, temp, out);
        }

        for (int i = 0; i < 12; ++i)
        {
            plOut.at (inst * 12 + i) = out.at (i);
            plAux.at (inst * 12 + i) = aux.at (i);
        }
    }

    void plRender_19 (int inst, int trig, float note, float harm, float timb, float morph, float accent)
    {
        plStrRender (inst, plStr.at (inst), trig, note, harm, timb, morph, accent);
    }
