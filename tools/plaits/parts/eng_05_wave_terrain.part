    // ---------------- engine 5: Wave terrain (plaits/dsp/engine2/wave_terrain_engine.cc, without user terrain: 8 terrains) ----------------
//@LUT lut_sine
//@LUT wav_integrated_waves

    struct PlWt { float x; float y; float epsilon; float amplitude; float offset; float terrain; }

    PlWt[48] plWt;

    void plInit_5 (int inst)
    {
        plWt.at (inst).x = 1.0f;  plWt.at (inst).y = 0.0f;  plWt.at (inst).epsilon = 0.0f;  plWt.at (inst).amplitude = 0.0f;
        plWt.at (inst).offset = 0.0f;  plWt.at (inst).terrain = 0.0f;
    }

    float plWtSine (float phase)  { return plInterpolateWrap (lut_sine, phase, 512.0f); }
    float plWtSquash (float x, float a)  { x *= a; return x / (1.0f + abs (x)); }

    float plWtLookup (float x, float y, int bank)
    {
        float sample = (y + 1.0f) * 0.5f * 128.0f;
        float wt = (x + 1.0f) * 0.5f * 63.0f;
        int si = int (sample);
        float sf = sample - float (si);
        int wi = int (wt);
        float wf = wt - float (wi);
        int base = bank * 64 * 132 + wi * 132 + si;

        float[2] xy;
        for (int k = 0; k < 2; ++k)
        {
            float a = float (plWavInt.at (base + k * 132));
            float b = float (plWavInt.at (base + k * 132 + 1));
            float c = float (plWavInt.at (base + k * 132 + 2));
            xy.at (k) = (b - a) + (c - b - b + a) * sf;
        }
        return (xy.at (0) + (xy.at (1) - xy.at (0)) * wf) * (1.0f / 1024.0f);
    }

    float plWtTerrain (float x, float y, int t)
    {
        float k = 4.0f;
        if (t == 0) return (plWtSquash (plWtSine (k + x * 1.273f), 2.0f) - plWtSine (k + y * (x + 1.571f) * 0.637f)) * 0.57f;
        if (t == 1) { float xy = x * y; return plWtSine (k + plWtSine (k + (x + y) * 0.637f) / (0.2f + xy * xy) * 0.159f); }
        if (t == 2) { float xy = x * y; return plWtSine (k + plWtSine (k + 2.387f * xy) / (0.350f + xy * xy) * 0.159f); }
        if (t == 3) { float xy = x * y; float xys = (x - 0.25f) * (y + 0.25f); return plWtSine (k + xy / (2.0f + abs (5.0f * xys)) * 6.366f); }
        if (t == 4) return plWtSine (0.159f / (0.170f + abs (y - 0.25f)) + 0.477f / (0.350f + abs ((x + 0.5f) * (y + 1.5f))) + k);
        if (t >= 5 && t <= 7) return plWtLookup (x, y, 2 - (t - 5));
        return 0.0f;
    }

    void plRender_5 (int inst, int trig, float note, float harm, float timb, float morph, float accent)
    {
        float f0 = plNoteToFrequency (note);
        float attenuation = max (1.0f - 8.0f * f0, 0.0f);
        float radius = 0.1f + 0.9f * timb * attenuation * (2.0f - attenuation);

        // FastSineOscillator::RenderQuadrature, frequency f0 / 2, 24 samples
        float freq = f0 * 0.5f;
        float amp = radius;
        if (freq >= 0.25f) { freq = 0.25f; amp = 0.0f; }
        else amp *= 1.0f - freq * 4.0f;

        float fp = freq * plPi;
        float epsTarget = fp * (2.0f - (2.0f * 0.96f / 6.0f) * fp * fp);
        float eps = plWt.at (inst).epsilon;
        float epsInc = (epsTarget - eps) / 24.0f;
        float am = plWt.at (inst).amplitude;
        float amInc = (amp - am) / 24.0f;
        float x = plWt.at (inst).x;
        float y = plWt.at (inst).y;
        float norm = x * x + y * y;
        if (norm <= 0.5f || norm >= 2.0f)
        {
            float scale = 1.0f / sqrt (norm);
            x *= scale;  y *= scale;
        }

        float[24] px;
        float[24] py;
        for (int i = 0; i < 24; ++i)
        {
            eps += epsInc;
            x += eps * y;
            y -= eps * x;
            am += amInc;
            px.at (i) = x * am;
            py.at (i) = y * am;
        }
        plWt.at (inst).x = x;  plWt.at (inst).y = y;  plWt.at (inst).epsilon = eps;  plWt.at (inst).amplitude = am;

        float offTarget = 1.9f * morph - 1.0f;
        float offset = plWt.at (inst).offset;
        float offInc = (offTarget - offset) / 12.0f;
        float terTarget = min (harm * 1.05f, 1.0f) * (8.0f - 1.0001f);
        float terrain = plWt.at (inst).terrain;
        float terInc = (terTarget - terrain) / 12.0f;

        int ij = 0;
        for (int i = 0; i < 12; ++i)
        {
            offset += offInc;
            terrain += terInc;
            int zi = int (terrain);
            float zf = terrain - float (zi);

            float outS = 0.0f;
            float auxS = 0.0f;

            for (int j = 0; j < 2; ++j)
            {
                float xx = px.at (ij) * (1.0f - abs (offset)) + offset;
                float yy = py.at (ij);
                ++ij;
                float z0 = plWtTerrain (xx, yy, zi);
                float z1 = plWtTerrain (xx, yy, zi + 1);
                float z = z0 + (z1 - z0) * zf;
                outS += z;
                auxS += yy + z;
            }

            plOut.at (inst * 12 + i) = 0.5f * outS;
            plAux.at (inst * 12 + i) = plWtSine (1.0f + 0.5f * 0.5f * auxS);
        }

        plWt.at (inst).offset = offset;
        plWt.at (inst).terrain = terrain;
    }
