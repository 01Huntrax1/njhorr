    // ---------------- engine 16: Swarm (plaits/dsp/engine/swarm_engine.cc) ----------------
    struct PlSwarmVoice
    {
        float rank;
        float from; float interval; float envPhase; float fm; float amplitude; float prevSizeRatio; float filterCoef;   // GrainEnvelope
        float sawPhase; float sawNext; float sawFreq; float sawGain;                                                  // AdditiveSawOscillator
        float sx; float sy; float seps; float samp;                                                                  // FastSineOscillator
    }

    PlSwarmVoice[384] plSwarm;       // 8 per instance

    void plSwarmVoiceInit (PlSwarmVoice& v, float rank)
    {
        {
            v.rank = rank;
            v.from = 0.0f; v.interval = 1.0f; v.envPhase = 1.0f; v.fm = 0.0f; v.amplitude = 0.5f; v.prevSizeRatio = 0.0f; v.filterCoef = 0.0f;
            v.sawPhase = 0.0f; v.sawNext = 0.0f; v.sawFreq = 0.01f; v.sawGain = 0.0f;
            v.sx = 1.0f; v.sy = 0.0f; v.seps = 0.0f; v.samp = 0.0f;
        }
    }

    void plInit_16 (int inst)
    {
        for (int i = 0; i < 8; ++i) plSwarmVoiceInit (plSwarm.at (inst * 8 + i), (float (i) - 3.0f) / 3.0f);
    }

    void plSwarmVoiceRender (PlSwarmVoice& v, int inst, float f0, float density, bool burstMode, bool startBurst, float spread, float sizeRatio, float[12]& out, float[12]& aux)
    {
        {
            // envelope_.Step
            bool randomize = false;
            if (startBurst)
            {
                v.envPhase = 0.5f; v.fm = 16.0f; randomize = true;
            }
            else
            {
                v.envPhase += density * v.fm;
                if (v.envPhase >= 1.0f)
                {
                    v.envPhase -= float (int (v.envPhase));
                    randomize = true;
                }
            }
            if (randomize)
            {
                v.from += v.interval;
                v.interval = plRandFloat (inst) - v.from;
                if (burstMode) v.fm *= 0.8f + 0.2f * plRandFloat (inst);
                else           v.fm = 0.5f + 1.5f * plRandFloat (inst);
            }

            // envelope_.amplitude
            float targetAmplitude = 1.0f;
            if (sizeRatio >= 1.0f)
            {
                float ph = clamp ((v.envPhase - 0.5f) * sizeRatio, -1.0f, 1.0f);
                float e = plInterpolateWrap (lut_sine, 0.5f * ph + 1.25f, 512.0f);
                targetAmplitude = 0.5f * (e + 1.0f);
            }
            if ((sizeRatio >= 1.0f) != (v.prevSizeRatio >= 1.0f)) v.filterCoef = 0.5f;
            v.filterCoef *= 0.95f;
            v.prevSizeRatio = sizeRatio;
            v.amplitude += (0.5f - v.filterCoef) * (targetAmplitude - v.amplitude);

            float amplitude = v.amplitude * (1.0f / 8.0f);
            // envelope_.frequency
            float expoAmount = sizeRatio < 1.0f ? 2.0f * (v.from + v.interval * v.envPhase) - 1.0f : v.from;

            float vf0 = f0 * plSemitonesToRatio (48.0f * expoAmount * spread * v.rank);
            float linearAmount = v.rank * (v.rank + 0.01f) * spread * 0.25f;
            vf0 *= 1.0f + linearAmount;

            // AdditiveSawOscillator::Render
            {
                float freq = vf0 >= 0.25f ? 0.25f : vf0;
                float fInc = (freq - v.sawFreq) / 12.0f;       float fV = v.sawFreq;
                float gInc = (amplitude - v.sawGain) / 12.0f;  float gV = v.sawGain;
                float nextSample = v.sawNext;
                float phase = v.sawPhase;
                for (int n = 0; n < 12; ++n)
                {
                    float thisSample = nextSample;
                    nextSample = 0.0f;
                    fV += fInc; gV += gInc;
                    phase += fV;
                    if (phase >= 1.0f)
                    {
                        phase -= 1.0f;
                        float t = phase / fV;
                        thisSample -= plThisBlep (t);
                        nextSample -= plNextBlep (t);
                    }
                    nextSample += phase;
                    out.at (n) += (2.0f * thisSample - 1.0f) * gV;
                }
                v.sawPhase = phase; v.sawNext = nextSample; v.sawFreq = fV; v.sawGain = gV;
            }

            // FastSineOscillator::Render (additive)
            {
                float freq = vf0; float amp = amplitude;
                if (freq >= 0.25f) { freq = 0.25f; amp = 0.0f; }
                else               { amp *= 1.0f - freq * 4.0f; }
                float fPi = freq * plPi;
                float epsT = fPi * (2.0f - (2.0f * 0.96f / 6.0f) * fPi * fPi);
                float eInc = (epsT - v.seps) / 12.0f;  float eV = v.seps;
                float aInc = (amp - v.samp) / 12.0f;   float aV = v.samp;
                float x = v.sx; float y = v.sy;
                float norm = x * x + y * y;
                if (norm <= 0.5f || norm >= 2.0f)
                {
                    float scale = 1.0f / sqrt (norm);
                    x *= scale; y *= scale;
                }
                for (int n = 0; n < 12; ++n)
                {
                    eV += eInc; aV += aInc;
                    x += eV * y;
                    y -= eV * x;
                    aux.at (n) += aV * x;
                }
                v.sx = x; v.sy = y; v.seps = eV; v.samp = aV;
            }

        }
    }

    void plRender_16 (int inst, int trig, float note, float harm, float timb, float morph, float accent)
    {
        float f0 = plNoteToFrequency (note);
        float density = plNoteToFrequency (timb * 120.0f) * 0.025f * 12.0f;
        float spread = harm * harm * harm;
        float sizeRatio = 0.25f * plSemitonesToRatio ((1.0f - morph) * 84.0f);
        bool burstMode  = (trig & 2) == 0;
        bool startBurst = (trig & 1) != 0;

        float[12] out;
        float[12] aux;

        for (int vi = 0; vi < 8; ++vi)
        {
            plSwarmVoiceRender (plSwarm.at (inst * 8 + vi), inst, f0, density, burstMode, startBurst, spread, sizeRatio, out, aux);
            sizeRatio *= 0.97f;
        }

        for (int i = 0; i < 12; ++i)
        {
            plOut.at (inst * 12 + i) = out.at (i);
            plAux.at (inst * 12 + i) = aux.at (i);
        }
    }
