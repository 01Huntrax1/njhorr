    // ---------------- plaits/dsp/noise/clocked_noise.h ----------------
    struct PlG4Clk { float phase; float sample; float nextSample; float frequency; }

    void plG4ClkInit (PlG4Clk& c)  { c.phase = 0.0f; c.sample = 0.0f; c.nextSample = 0.0f; c.frequency = 0.001f; }

    void plG4ClkRender (int inst, PlG4Clk& c, bool sync, float frequency, float[12]& out)
    {
        frequency = clamp (frequency, 0.0f, 1.0f);
        float fmV  = c.frequency;
        float fmI  = (frequency - c.frequency) / 12.0f;
        float nextSample = c.nextSample;
        float sample = c.sample;

        if (sync)
            c.phase = 1.0f;

        for (int n = 0; n < 12; ++n)
        {
            float thisSample = nextSample;
            nextSample = 0.0f;
            fmV += fmI;
            float f = fmV;
            float rawSample = plRandFloat (inst) * 2.0f - 1.0f;
            float rawAmount = clamp (4.0f * (f - 0.25f), 0.0f, 1.0f);
            c.phase += f;

            if (c.phase >= 1.0f)
            {
                c.phase -= 1.0f;
                float t = c.phase / f;
                float newSample = rawSample;
                float disc = newSample - sample;
                thisSample += disc * plThisBlep (t);
                nextSample += disc * plNextBlep (t);
                sample = newSample;
            }

            nextSample += sample;
            out.at (n) = thisSample + rawAmount * (rawSample - thisSample);
        }

        c.frequency = fmV;
        c.nextSample = nextSample;
        c.sample = sample;
    }
