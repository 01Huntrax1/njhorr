    // ---------------- engine 17: Noise (plaits/dsp/engine/noise_engine.cc) ----------------
    struct PlG4Noise { PlG4Clk clk0; PlG4Clk clk1; PlSvf lpHp; PlSvf bp0; PlSvf bp1; float pf0; float pf1; float pq; float pmode; }

    PlG4Noise[48] plG4Noise;

    float plG4SvfLPtoHP (PlSvf& s, float in, float mode)
    {
        float hpGain = min (-mode * 2.0f + 1.0f, 0.0f);
        float bpGain = 1.0f - 2.0f * abs (mode - 0.5f);
        float lpGain = max (1.0f - mode * 2.0f, 0.0f);
        float hp = (in - s.r * s.s1 - s.g * s.s1 - s.s2) * s.h;
        float bp = s.g * hp + s.s1;
        s.s1 = s.g * hp + bp;
        float lp = s.g * bp + s.s2;
        s.s2 = s.g * bp + lp;
        return hpGain * hp + bpGain * bp + lpGain * lp;
    }

    void plInit_17 (int inst)
    {
        plG4ClkInit (plG4Noise.at (inst).clk0);
        plG4ClkInit (plG4Noise.at (inst).clk1);
        plSvfInit (plG4Noise.at (inst).lpHp);
        plSvfInit (plG4Noise.at (inst).bp0);
        plSvfInit (plG4Noise.at (inst).bp1);
        plG4Noise.at (inst).pf0 = 0.0f;
        plG4Noise.at (inst).pf1 = 0.0f;
        plG4Noise.at (inst).pq = 0.0f;
        plG4Noise.at (inst).pmode = 0.0f;
    }

    void plRender_17 (int inst, int trig, float note, float harm, float timb, float morph, float accent)
    {
        float f0 = plNoteToFrequency (note);
        float f1 = plNoteToFrequency (note + harm * 48.0f - 24.0f);
        float clockLowest = -24.0f;
        float clockF = plNoteToFrequency (timb * (128.0f - clockLowest) + clockLowest);
        float q = 0.5f * plSemitonesToRatio (morph * 120.0f);
        bool sync = (trig & 1) != 0;

        float[12] aux;
        float[12] temp;
        plG4ClkRender (inst, plG4Noise.at (inst).clk0, sync, clockF, aux);
        plG4ClkRender (inst, plG4Noise.at (inst).clk1, sync, clockF * f1 / f0, temp);

        float f0V = plG4Noise.at (inst).pf0;  float f0I = (f0 - f0V) / 12.0f;
        float f1V = plG4Noise.at (inst).pf1;  float f1I = (f1 - f1V) / 12.0f;
        float qV  = plG4Noise.at (inst).pq;   float qI  = (q - qV) / 12.0f;
        float mV  = plG4Noise.at (inst).pmode; float mI = (harm - mV) / 12.0f;

        for (int i = 0; i < 12; ++i)
        {
            f0V += f0I;  f1V += f1I;  qV += qI;  mV += mI;
            float gain = 1.0f / sqrt ((0.5f + qV) * 40.0f * f0V);
            plSvfSetFQ (plG4Noise.at (inst).lpHp, 1, f0V, qV);
            plSvfSetFQ (plG4Noise.at (inst).bp0, 1, f0V, qV);
            plSvfSetFQ (plG4Noise.at (inst).bp1, 1, f1V, qV);

            float input1 = aux.at (i) * gain;
            float input2 = temp.at (i) * gain;

            float lpHpOut = plG4SvfLPtoHP (plG4Noise.at (inst).lpHp, input1, mV);

            plOut.at (inst * 12 + i) = lpHpOut;
            plAux.at (inst * 12 + i) = plSvfProcess (plG4Noise.at (inst).bp0, 1, input1) + plSvfProcess (plG4Noise.at (inst).bp1, 1, input2);
        }

        plG4Noise.at (inst).pf0 = f0V;  plG4Noise.at (inst).pf1 = f1V;  plG4Noise.at (inst).pq = qV;  plG4Noise.at (inst).pmode = mV;
    }
