//@LUT lut_ws_inverse_tan
//@LUT lut_ws_inverse_sin
//@LUT lut_ws_linear
//@LUT lut_ws_bump
//@LUT lut_ws_double_bump
//@LUT lut_fold
//@LUT lut_fold_2
    // ---------------- engine 9: Waveshaping (plaits/dsp/engine/waveshaping_engine.cc) ----------------
    struct PlWs { PlG1Osc slope; PlG1Osc tri; float prevShape; float prevWf; float prevOvertone; }

    PlWs[48] plWs;

    void plInit_9 (int inst)
    {
        plG1OscInit (plWs.at (inst).slope);
        plG1OscInit (plWs.at (inst).tri);
        plWs.at (inst).prevShape = 0.0f; plWs.at (inst).prevWf = 0.0f; plWs.at (inst).prevOvertone = 0.0f;
    }

    float plWsTame (float f0, float harmonics, float order)
    {
        f0 *= harmonics;
        float maxF = 0.5f / order;
        float maxAmount = clamp (1.0f - (f0 - maxF) / (0.5f - maxF), 0.0f, 1.0f);
        return maxAmount * maxAmount * maxAmount;
    }

    float plWsTable (int t, int i)
    {
        float v = 0.0f;
        if (t == 0) v = float (lut_ws_inverse_tan.at (i));
        else if (t == 1) v = float (lut_ws_inverse_sin.at (i));
        else if (t == 2) v = float (lut_ws_linear.at (i));
        else if (t == 3) v = float (lut_ws_bump.at (i));
        else v = float (lut_ws_double_bump.at (i));
        return v / 32768.0f;
    }

    void plRender_9 (int inst, int trig, float note, float harm, float timb, float morph, float accent)
    {
        float f0 = plNoteToFrequency (note);
        float pw = morph * 0.45f + 0.5f;

        float[12] out;
        float[12] aux;
        plG1OscSlope (plWs.at (inst).slope, false, f0, pw, out);
        plG1OscSlope (plWs.at (inst).tri, true, f0, 0.5f, aux);

        float slope = 3.0f + abs (morph - 0.5f) * 5.0f;
        float shapeAmount = abs (harm - 0.5f) * 2.0f;
        float shapeAtt = plWsTame (f0, slope, 16.0f);
        float wfGain = timb;
        float wfAtt = plWsTame (f0, slope * (3.0f + shapeAmount * shapeAtt * 5.0f), 12.0f);

        float shapeT = 0.5f + (harm - 0.5f) * shapeAtt;
        float wfT = 0.03f + 0.46f * wfGain * wfAtt;
        float ot = timb * (2.0f - timb);
        float otT = ot * (2.0f - ot);

        float shInc = (shapeT - plWs.at (inst).prevShape) / 12.0f;       float shV = plWs.at (inst).prevShape;
        float wfInc = (wfT - plWs.at (inst).prevWf) / 12.0f;             float wfV = plWs.at (inst).prevWf;
        float otInc = (otT - plWs.at (inst).prevOvertone) / 12.0f;       float otV = plWs.at (inst).prevOvertone;

        for (int i = 0; i < 12; ++i)
        {
            shV += shInc;
            float shape = shV * 3.9999f;
            int   si = int (shape);
            float sf = shape - float (si);

            float wsIndex = 127.0f * out.at (i) + 128.0f;
            int   wi = int (wsIndex);
            float wfr = wsIndex - float (wi);
            wi = wi & 255;

            float x0 = plWsTable (si, wi);
            float x1 = plWsTable (si, wi + 1);
            float x = x0 + (x1 - x0) * wfr;
            float y0 = plWsTable (si + 1, wi);
            float y1 = plWsTable (si + 1, wi + 1);
            float y = y0 + (y1 - y0) * wfr;

            float mix = x + (y - x) * sf;
            wfV += wfInc;
            float index = mix * wfV + 0.5f;
            float fold  = plG1HermiteOff1 (lut_fold, index, 512.0f);
            float fold2 = -plG1HermiteOff1 (lut_fold_2, index, 512.0f);

            float sine = plG1Sine (aux.at (i) * 0.25f + 0.5f);
            otV += otInc;
            plOut.at (inst * 12 + i) = fold;
            plAux.at (inst * 12 + i) = sine + (fold2 - sine) * otV;
        }

        plWs.at (inst).prevShape = shV; plWs.at (inst).prevWf = wfV; plWs.at (inst).prevOvertone = otV;
    }
