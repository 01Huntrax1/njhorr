    // ---------------- plaits/dsp/oscillator: VariableShapeOscillator, VariableSawOscillator ----------------
    const float plMaxFrequency = 0.25f;

    struct PlVso
    {
        float masterPhase; float slavePhase; float nextSample; float previousPw; bool high;
        float masterFreq; float slaveFreq; float pw; float waveshape; float phaseMod;
    }

    void plVsoInit (PlVso& o)
    {
        o.masterPhase = 0.0f; o.slavePhase = 0.0f; o.nextSample = 0.0f; o.previousPw = 0.5f; o.high = false;
        o.masterFreq = 0.0f; o.slaveFreq = 0.01f; o.pw = 0.5f; o.waveshape = 0.0f; o.phaseMod = 0.0f;
    }

    float plVsoNaive (float phase, float pw, float slopeUp, float slopeDown, float triangleAmount, float squareAmount)
    {
        float saw      = phase;
        float square   = phase < pw ? 0.0f : 1.0f;
        float triangle = phase < pw ? phase * slopeUp : 1.0f - (phase - pw) * slopeDown;
        saw += (square - saw) * squareAmount;
        saw += (triangle - saw) * triangleAmount;
        return saw;
    }

    // enableSync / outputPhase are the template flags of the original
    void plVsoRender (PlVso& o, bool enableSync, bool outputPhase, float masterFrequency, float frequency, float pw,
                      float waveshape, float phaseModAmount, float[12]& out)
    {
        masterFrequency = min (masterFrequency, plMaxFrequency);
        frequency       = min (frequency, plMaxFrequency);

        if (frequency >= 0.25f)
            pw = 0.5f;
        else
            pw = clamp (pw, frequency * 2.0f, 1.0f - 2.0f * frequency);

        float masterInc = (masterFrequency - o.masterFreq) / 12.0f;  float masterV = o.masterFreq;
        float fmInc     = (frequency - o.slaveFreq) / 12.0f;         float fmV     = o.slaveFreq;
        float pwInc     = (pw - o.pw) / 12.0f;                       float pwV     = o.pw;
        float wsInc     = (waveshape - o.waveshape) / 12.0f;         float wsV     = o.waveshape;
        float pmInc     = (phaseModAmount - o.phaseMod) / 12.0f;     float pmV     = o.phaseMod;

        float nextSample = o.nextSample;

        for (int n = 0; n < 12; ++n)
        {
            bool  reset = false;
            bool  transitionDuringReset = false;
            float resetTime = 0.0f;

            float thisSample = nextSample;
            nextSample = 0.0f;

            masterV += masterInc; fmV += fmInc; pwV += pwInc; wsV += wsInc;
            float masterFrequencyN = masterV;
            float slaveFrequency   = fmV;
            float pwN              = pwV;
            float waveshapeN       = wsV;

            float squareAmount   = max (waveshapeN - 0.5f, 0.0f) * 2.0f;
            float triangleAmount = max (1.0f - waveshapeN * 2.0f, 0.0f);
            float slopeUp        = 1.0f / pwN;
            float slopeDown      = 1.0f / (1.0f - pwN);

            if (enableSync)
            {
                o.masterPhase += masterFrequencyN;

                if (o.masterPhase >= 1.0f)
                {
                    o.masterPhase -= 1.0f;
                    resetTime = o.masterPhase / masterFrequencyN;

                    float slavePhaseAtReset = o.slavePhase + (1.0f - resetTime) * slaveFrequency;
                    reset = true;

                    if (slavePhaseAtReset >= 1.0f)
                    {
                        slavePhaseAtReset -= 1.0f;
                        transitionDuringReset = true;
                    }

                    if (! o.high && slavePhaseAtReset >= pwN)
                        transitionDuringReset = true;

                    float value = plVsoNaive (slavePhaseAtReset, pwN, slopeUp, slopeDown, triangleAmount, squareAmount);
                    thisSample -= value * plThisBlep (resetTime);
                    nextSample -= value * plNextBlep (resetTime);
                }
            }
            else if (outputPhase)
            {
                o.masterPhase += masterFrequencyN;

                if (o.masterPhase >= 1.0f)
                    o.masterPhase -= 1.0f;
            }

            o.slavePhase += slaveFrequency;

            while (transitionDuringReset || ! reset)
            {
                if (! o.high)
                {
                    if (o.slavePhase < pwN)
                        break;

                    float t = (o.slavePhase - pwN) / (o.previousPw - pwN + slaveFrequency);
                    float triangleStep = (slopeUp + slopeDown) * slaveFrequency;
                    triangleStep *= triangleAmount;

                    thisSample += squareAmount * plThisBlep (t);
                    nextSample += squareAmount * plNextBlep (t);
                    thisSample -= triangleStep * plThisIntegratedBlep (t);
                    nextSample -= triangleStep * plNextIntegratedBlep (t);
                    o.high = true;
                }

                if (o.high)
                {
                    if (o.slavePhase < 1.0f)
                        break;

                    o.slavePhase -= 1.0f;
                    float t = o.slavePhase / slaveFrequency;
                    float triangleStep = (slopeUp + slopeDown) * slaveFrequency;
                    triangleStep *= triangleAmount;

                    thisSample -= (1.0f - triangleAmount) * plThisBlep (t);
                    nextSample -= (1.0f - triangleAmount) * plNextBlep (t);
                    thisSample += triangleStep * plThisIntegratedBlep (t);
                    nextSample += triangleStep * plNextIntegratedBlep (t);
                    o.high = false;
                }
            }

            if (enableSync && reset)
            {
                o.slavePhase = resetTime * slaveFrequency;
                o.high = false;
            }

            nextSample += plVsoNaive (o.slavePhase, pwN, slopeUp, slopeDown, triangleAmount, squareAmount);
            o.previousPw = pwN;

            if (outputPhase)
            {
                float phasor = o.masterPhase;

                if (enableSync)
                {
                    float w = 4.0f * (1.0f - o.masterPhase) * o.masterPhase;
                    thisSample *= w * (2.0f - w);
                    float p2 = phasor * phasor;
                    phasor += (p2 * p2 - phasor) * abs (pwN - 0.5f) * 2.0f;
                }

                pmV += pmInc;
                out.at (n) = phasor + pmV * thisSample;
            }
            else
            {
                out.at (n) = 2.0f * thisSample - 1.0f;
            }
        }

        o.masterFreq = masterV; o.slaveFreq = fmV; o.pw = pwV; o.waveshape = wsV; o.phaseMod = pmV;
        o.nextSample = nextSample;
    }

    struct PlVsaw { float phase; float nextSample; float previousPw; bool high; float frequency; float pw; float waveshape; }

    const float plVsawNotchDepth = 0.2f;

    void plVsawInit (PlVsaw& o)
    {
        o.phase = 0.0f; o.nextSample = 0.0f; o.previousPw = 0.5f; o.high = false;
        o.frequency = 0.01f; o.pw = 0.5f; o.waveshape = 0.0f;
    }

    float plVsawNaive (float phase, float pw, float slopeUp, float slopeDown, float triangleAmount, float notchAmount)
    {
        float notchSaw = phase < pw ? phase : 1.0f + plVsawNotchDepth;
        float triangle = phase < pw ? phase * slopeUp : 1.0f - (phase - pw) * slopeDown;
        return notchSaw * notchAmount + triangle * triangleAmount;
    }

    void plVsawRender (PlVsaw& o, float frequency, float pw, float waveshape, float[12]& out)
    {
        frequency = min (frequency, plMaxFrequency);

        if (frequency >= 0.25f)
            pw = 0.5f;
        else
            pw = clamp (pw, frequency * 2.0f, 1.0f - 2.0f * frequency);

        float fmInc = (frequency - o.frequency) / 12.0f;  float fmV = o.frequency;
        float pwInc = (pw - o.pw) / 12.0f;                float pwV = o.pw;
        float wsInc = (waveshape - o.waveshape) / 12.0f;  float wsV = o.waveshape;
        float nextSample = o.nextSample;

        for (int n = 0; n < 12; ++n)
        {
            float thisSample = nextSample;
            nextSample = 0.0f;

            fmV += fmInc; pwV += pwInc; wsV += wsInc;
            float f   = fmV;
            float pwN = pwV;
            float triangleAmount = wsV;
            float notchAmount    = 1.0f - wsV;
            float slopeUp        = 1.0f / pwN;
            float slopeDown      = 1.0f / (1.0f - pwN);

            o.phase += f;

            if (! o.high && o.phase >= pwN)
            {
                float triangleStep = (slopeUp + slopeDown) * f * triangleAmount;
                float notch = (plVsawNotchDepth + 1.0f - pwN) * notchAmount;
                float t = (o.phase - pwN) / (o.previousPw - pwN + f);
                thisSample += notch * plThisBlep (t);
                nextSample += notch * plNextBlep (t);
                thisSample -= triangleStep * plThisIntegratedBlep (t);
                nextSample -= triangleStep * plNextIntegratedBlep (t);
                o.high = true;
            }
            else if (o.phase >= 1.0f)
            {
                o.phase -= 1.0f;
                float triangleStep = (slopeUp + slopeDown) * f * triangleAmount;
                float notch = (plVsawNotchDepth + 1.0f) * notchAmount;
                float t = o.phase / f;
                thisSample -= notch * plThisBlep (t);
                nextSample -= notch * plNextBlep (t);
                thisSample += triangleStep * plThisIntegratedBlep (t);
                nextSample += triangleStep * plNextIntegratedBlep (t);
                o.high = false;
            }

            nextSample += plVsawNaive (o.phase, pwN, slopeUp, slopeDown, triangleAmount, notchAmount);
            o.previousPw = pwN;
            out.at (n) = (2.0f * thisSample - 1.0f) / (1.0f + plVsawNotchDepth);
        }

        o.frequency = fmV; o.pw = pwV; o.waveshape = wsV;
        o.nextSample = nextSample;
    }
