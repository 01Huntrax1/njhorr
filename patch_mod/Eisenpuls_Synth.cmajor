    event param2  (float v) { voiceMode   = v; }
    event param4  (float v) { legatoOn    = v; }
    event param3  (float v) { glideMs     = v; }
    event param18 (float v) { genBase.at (0) = v; genSet.at (0) = 1; modp0 (clamp (v + genNorm.at (0) * 1000.0f, 0.0f, 2000.0f)); }
    event param19 (float v) { genBase.at (1) = v; genSet.at (1) = 1; modp1 (clamp (v + genNorm.at (1) * 1995.0f, 10.0f, 4000.0f)); }
    event param20 (float v) { genBase.at (2) = v; genSet.at (2) = 1; modp2 (clamp (v + genNorm.at (2) * 0.5f, 0.0f, 1.0f)); }
    event param21 (float v) { genBase.at (3) = v; genSet.at (3) = 1; modp3 (clamp (v + genNorm.at (3) * 1997.5f, 5.0f, 4000.0f)); }
    event param22 (float v) { genBase.at (4) = v; genSet.at (4) = 1; modp4 (clamp (v + genNorm.at (4) * 0.5f, 0.0f, 1.0f)); }
    event param28 (float v) { genBase.at (5) = v; genSet.at (5) = 1; modp5 (clamp (v + genNorm.at (5) * 0.5f, 0.0f, 1.0f)); }
    event param29 (float v)
    {
        float p = clamp (v, -1.0f, 1.0f);
        panParam = p;
        float ang = (p + 1.0f) * 0.25f * float (pi);
        panL = float (cos (ang)) * 1.4142f;
        panR = float (sin (ang)) * 1.4142f;
    }
    event param36 (float v) { genBase.at (6) = v; genSet.at (6) = 1; modp6 (clamp (v + genNorm.at (6) * 0.5f, 0.0f, 1.0f)); }

    event param45 (float v) { genBase.at (7) = v; genSet.at (7) = 1; modp7 (clamp (v + genNorm.at (7) * 24.0f, -24.0f, 24.0f)); }
    event param46 (float v) { genBase.at (8) = v; genSet.at (8) = 1; modp8 (clamp (v + genNorm.at (8) * 995.0f, 10.0f, 2000.0f)); }
    event param63 (float v) { genBase.at (9) = v; genSet.at (9) = 1; modp9 (clamp (v + genNorm.at (9) * 100.0f, -100.0f, 100.0f)); }

    event param175 (float v) { genBase.at (10) = v; genSet.at (10) = 1; modp10 (clamp (v + genNorm.at (10) * 1.0f, 0.0f, 2.0f)); }

    event param189 (float v) { genBase.at (11) = v; genSet.at (11) = 1; modp11 (clamp (v + genNorm.at (11) * 1.0f, -1.0f, 1.0f)); }
    event param190 (float v) { genBase.at (12) = v; genSet.at (12) = 1; modp12 (clamp (v + genNorm.at (12) * 1.0f, 0.0f, 2.0f)); }

    event param221 (float v) { dcOn        = v; }
    event param222 (float v) { genBase.at (13) = v; genSet.at (13) = 1; modp13 (clamp (v + genNorm.at (13) * 97.5f, 5.0f, 200.0f)); }

    // Wavetable 2 parameter handlers
    // Wavetable 3 parameter handlers
    // Mod LFO handlers (wave, rate)
    event param247 (float v) { mLfoWave.at (0) = v; }
