    // ---------------- WAVETABLE UNISON (per wavetable: voices, detune, random phase) ----------------

    // ---------------- SYNTH SAMPLE LOADER TYPE ----------------
    // INSPIRATOR4-DSP
    struct InsImportChunk
    {
        int        offset;
        int        count;
        int        total;
        int        bars;
        float[256] data;
    }

    // LFO2-TYPES-BEGIN
    struct LfoTableChunk
    {
        int        lfo;
        int        frame;
        int        frames;
        float[256] data;
    }

    // LFO2-TYPES-END
    struct LfoShapeChunk
    {
        int        lfo;
        float[256] data;
    }



    // ---------------- SAMPLE MEMORY TYPE (autosave / restore) ----------------
    // memory index = part * 4 + slot (24 memories)


    // ---------------- STATE ----------------
    float voiceMode    = 0.0f;
    float legatoOn     = 1.0f;   // LEGATO: in Mono mode a note played over a held one does not restart the oscillators
    float glideMs      = 0.0f;
    float ampAttack    = 2.0f;
    float ampDecay     = 500.0f;
    float ampSustain   = 0.8f;
    float ampRelease   = 250.0f;
    float velSens      = 0.6f;
    float driveAmt     = 0.1f;
    int       fxMon = -1;      // FX-VIZ: effect slot shown by the editor (-1 none)
    float[24] vzB0;
    float[24] vzA1;
    float[24] vzA2;
    float[128] vzZ;
    float[48] vzEnv;
    float[64] vzPkt;
    float[4]  vzP;
    float     vzK = 0.001f;
    int       vzIdx = 99;
    int       vzCount = 0;
    int       vzGap = 0;
    int[68]   mrSrc;    // MODMAT: source of every cable (see build_matrix.py)
    float[68] mrGain;
    float[320] eS;       // MOD-PLUGIN: Eurorack state, outputs, MIDI
    float[48]  eOut;
    bool[128]  eHeld;
    int        eNLast = 60;
    int        eNLow = 60;
    int        eNHigh = 60;
    int        eCount = 0;
    float      eVel = 0.0f;
    float      eBend = 0.0f;
    float<2>   eAcc;
    float<2>[19] mrOut;   // MOD-PLUGIN: output of every node (1 Synth, 2 Audio In, 3.. module 1..16)
    int[20]   eType;    // EURO: Eurorack rack (see build_euro.py)
    int[20]   eMode;
    int[20]   eRst;
    int[80]   eSrc;
    float[80] eGain;
    float[160] eK;
    float panParam     = 0.0f;
    float panL         = 1.0f;
    float panR         = 1.0f;
    float masterLevel  = 0.8f;

    float pitchEgInt   = 0.0f;
    float pitchEgDec   = 150.0f;

    float masterTune   = 0.0f;

    // Pitch split state

    // Synth sample engine state

    // Sampler 2 engine state

    // Dedicated wavetable oscillator state

    // Wavetable 2 oscillator state

    // Wavetable 3 oscillator state

    // Supersaw state

    // Sample memory bank (1 memory x 96000 samples) -- Sampler 1

    // Sampler 2 memory bank (1 memory x 96000 samples)

    // Wavetable memory bank (1 memory x 96000 samples)

    // Wavetable 2 memory bank (1 memory x 96000 samples)

    // Wavetable 3 memory bank (1 memory x 96000 samples)
    // ---------------- FX RACK STATE ----------------
    int[2048] fxType;  // padded to a power of two (cheap index wrap)
    float[2048] fxOn;  // padded to a power of two (cheap index wrap)
    float[2048] fxMix;  // padded to a power of two (cheap index wrap)
    int[2048] fxMode;  // padded to a power of two (cheap index wrap)
    // FX-PEQ: band table (10 values per band, 24 bands per slot, normalised), biquad sections (64 per slot, 5 coefficients, 4 states), combs (4 values per band)
    float[195840] peqB;
    float[261120] peqC;
    float[208896] peqZ;
    int[52224] peqCh;
    int[2048] peqN;
    float[78336] peqK;
    float[2048] fxEnvSus;  // FX-FENV: sustain level (0..1) and release (0..1 on an exponential 5 ms - 5 s map) of the filter effect envelope, per slot
    float[2048] fxEnvRel;
    float[2048] fxEnvLv;   // envelope level, stage (0 idle, 1 attack, 2 decay, 3 sustain, 4 release), the note counter it has seen, cutoff coefficient cache
    int[2048] fxEnvSt;
    int[2048] fxEnvSeen;
    float[2048] fxEnvGc;
    float[2048] fxFcS;     // FX-FENV2: smoothed cutoff (Hz) of the filter effect
    int[2048] fxEnvCt;
    int           fxNoteSeq = 0;   // counts accepted note-ons
    bool          fxHeld = false;  // any note is held (not yet released)
    int           fxLastNote = 60; // FX-KEYTRACK: last played note
    int[2048] fxSync;  // FX-SYNC: 0 = free, 1..18 = tempo division (the LFO divisions, one per slot)
    float         insOn = 0.0f;
    float64       fxBeat = 0.0;     // FX-SYNC: quarter notes, locked to the host position, advanced with the tempo
    float[512]    fxGate;           // FX-SYNC: 24 trance gate patterns x 16 steps
    float[8704] fxQ;   // FX-WET: per slot 8 floats: low cut, high cut, width, sat, low cut coefficient, high cut coefficient, active flag
    float[8704] fxX;   // FX-WET: filter states (8 per slot)
    float[8704] fxE;    // FX-EX: per slot 8 floats: 4 values, active flag, dirty flag, type of the last coefficient calculation
    float[8704] fxEc;   // FX-EX: coefficients per slot (4 per tool, duck release, pan increment, shelf coefficients)
