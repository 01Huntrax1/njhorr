    output event float fxViz;   // FX-VIZ: live data of the effect slot the editor shows
    output event int seqPos;   // MOD-SEQPOS: sequencer * 16 + current step (playhead of the editor)

    // Drawn LFO shapes: one 256-point table per LFO (-1..1)
    input event InsImportChunk insImport;
    // LFO2-EP-BEGIN
    // Wavetable LFO: one frame (256 points) of one LFO per event; frames = number of frames of that LFO
    input event LfoTableChunk lfoTableLoad;

    // LFO2-EP-END
    input event LfoShapeChunk lfoShapeLoad;
    input event BankChunk wtBankLoad;
    input event LfoShapeChunk frqShapeLoad;   // drawn curve of a Freq modulator (256 points, 0..1)
    input event BankChunk irLoad;        // convolution reverb impulse response (bank = rack 0..2)  // FX-CONV
    input event BankChunk eqLoad;        // FX-PEQ: bands of a Parametric EQ slot (bank = global slot 0..47, 240 values)
    input event BankChunk modLoad;       // per-mode edits of the resonators: bank = slot * 3 + set (0 = Physical A, 1 = Physical B, 2 = Resonator stage)  // MODED
    input event BankChunk tblLoad;       // Wavefilter / Wavedistortion tables: bank 0..5 filter table of OSC 1..6, 6..11 shaper table
    input event BankChunk smpBankLoad;
    input event BankChunk sfBankLoad;    // SoundFont source: bank = slot, preamble + zone table + audio  // SF

    // Dedicated loader for the synth sample oscillator (loads into the selected Synth Sample Memory)

    // Dedicated loader for Sampler 2 (loads into the selected Sample 2 Memory, its own bank)

    // Dedicated loader for the standalone Wavetable oscillator (loads into the selected Wavetable Memory)

    // Dedicated loader for Wavetable 2 (own memory bank)

    // Dedicated loader for Wavetable 3 (own memory bank)

    // ---------------- SAMPLE MEMORY (AUTOSAVE) ENDPOINTS ----------------

