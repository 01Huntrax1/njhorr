    // LFO2-EV-BEGIN
    event lfoTableLoad (LfoTableChunk c)
    {
        int m = clamp (c.lfo, 0, 9);
        int f = clamp (c.frame, 0, 15);
        lfoWtN.at (m) = clamp (c.frames, 1, 16);

        for (int i = 0; i < 256; ++i)
            lfoWt.at ((m * 16 + f) * 256 + i) = clamp (c.data.at (i), -1.0f, 1.0f);
    }

    // LFO2-EV-END
    event lfoShapeLoad (LfoShapeChunk c)
    {
        int m = clamp (c.lfo, 0, 9);

        for (int i = 0; i < 256; ++i)
            lfoTab.at (m * 256 + i) = clamp (c.data.at (i), -1.0f, 1.0f);
    }

    event tempoIn (std::timeline::Tempo t)
    {
        if (t.bpm > 1.0f && t.bpm != hostBpm)
        {
            hostBpm = t.bpm;

            for (int fs = 0; fs < 816; ++fs)
                fxDirty.at (fs) = true;
        }
    }

    // the host jumped / started: lock the effect beat clock to its position
    event positionIn (std::timeline::Position p) { fxBeat = p.quarterNote; ins_position (p.quarterNote, p.barStartQuarterNote); }

    // Mixer EQ handlers: channel 0 (Osc)
    // channel 1 (Sub)
    // channel 2 (Noise)
    // channel 3 (Supersaw)
    // channel 4 (Sampler 1)
    // channel 5 (Sampler 2)
    // channel 6 (Wavetable 1)
    // channel 7 (Wavetable 2)
    // channel 8 (Wavetable 3)
    // Wavetable unison handlers
    // ---------------- VOICES ----------------
    struct SeqS   // MOD-SEQ: state of one sequencer
    {
        float ph;     // position inside the step (0..1)
        float idx;    // current step
        float dir;    // +1 / -1 (ping-pong)
        float v;      // output 0..1 (after glide)
    }

    struct Voice
    {
        int     noteNumber;
        int     stage;        // amp envelope: 0 off, 1 attack, 2 decay/sustain, 3 release
        int     age;
        float   curFreq;
        float   targetFreq;
        float64[8]  synPos;   // sampler read position per slot
        float64[128] wtUPh;   // wavetable unison phases: slot * 16 + unison voice
        float[32]   wtDcS;    // wavetable warp DC blocker: slot * 4 + {xL, yL, xR, yR}
        float[8]    fmPrev;   // last output of every slot (FM source)
        float[8]    tzPh;     // through-zero FM: integrated modulator phase per slot (cycles)
        float[8]    pdPh;     // phase of every slot as seen by the phase distortion matrix (cycles)
        float[8]    fenv;     // filter envelope level per slot
        int[8]      fstage;   // filter envelope stage per slot
        float[16] menv;       // mod envelope levels
        float64[16] lfoPh;    // per-voice LFO phases (modes Trig / Env)
        float[16] lfoV;       // per-voice LFO outputs
        float[16] lfoAge;     // seconds since note-on, -1 before the first update
        float[16] frqT;       // Freq modulators: seconds since note-on
        float[16] frqV;       // Freq modulators: output (units of 4 octaves)
        SeqS[16]  seqS;       // MOD-SEQ: per-voice sequencers (Retrig on)
        float[16] lfoSh;      // per-voice sample & hold values
        float[16] lfoSm;      // per-voice smoothing state
        float[16] lfoJ;       // LFO2: per-voice jitter draw
        int[16]   mstage;     // mod envelope stages (0 off, 1 attack, 2 decay/sustain, 3 release)
        float[32] exT;        // ENV2: stage timer
        float[32] exQ;        // ENV2: progress of the stage (0..1)
        float[32] exL;        // ENV2: level at the start of the stage
        int[32]   exSub;      // ENV2: sub stage (attack: 0 delay / rise, 1 hold)
        int[32]   exPrev;     // ENV2: stage seen on the previous sample (0 = restart)
        int[16]   vmNode;     // MSEG-DSP: target node (held node in stage 2)
        int[16]   rS;         // RND-DSP: random state
        float[16] rV;         // RND-DSP: output (-1..1)
        float[16] rPrev;      // RND-DSP: previous value
        float[16] rTgt;       // RND-DSP: next value
        float[16] rPh;        // RND-DSP: phase 0..1
        int[16]   vmFlag;     // MSEG-DSP: 0 not released, 1 release through nodes, 2 fallback release, 3 done
        float[16] vmT;        // MSEG-DSP: seconds in the current segment
        float[16] vmFrom;     // MSEG-DSP: level at the segment start
        float   env;
        float   penv;
        float   velGain;
        float   velRaw;
        float   modRand;      // per-note random value for the mod matrix
        float[256]  fx;       // filter states: slot * 32 + channel * 16 + stage state
        float[24576] fdl;     // comb filter delay lines: slot * 4096 + channel * 2048 + position
        float[1024] wfs;      // Wavefilter band states: (slot * 2 + channel) * 64 + band * 2 + {ic1, ic2}
        float[512]  wfg;      // Wavefilter band gains in use: (slot * 2 + channel) * 32 + band
        float[512]  wft;      // Wavefilter band gains wanted (recomputed every 8 samples)
        int[16]     wfc;      // Wavefilter sample counters: slot * 2 + channel
        float[4096] phs;      // physical modelling states: slot * 176 + ...; 2048.. unison drift, 2240.. Juno sub counters
        // WG-VOICE-BEGIN
        float[131072] wgd;    // Waveguide source: delay lines, slot * 16384
        float[2048]   wgs;    // Waveguide source: state, slot * 192
        // WG-VOICE-END
        // JP-VOICE-BEGIN
        float[512]    jps;    // JP-8080 source: state, slot * 64
        // JP-VOICE-END
        // GR-VOICE-BEGIN
        float[1024]   grs;    // Granular source: grains, slot * 96
        // GR-VOICE-END
        // AD-VOICE-BEGIN
        float[4096]   ads;    // Additive source: partials, slot * 512
        // AD-VOICE-END
        // DK-VOICE-BEGIN
        float[2048]   dks;    // Modal Drum source: modes, slot * 192
        // DK-VOICE-END
        // SP-VOICE-BEGIN
        float[4096]   sps;    // Spectral source: partials, slot * 512
        // SP-VOICE-END
        // SF-VOICE-BEGIN
        float[1024]   sfl;    // SoundFont source: layers, slot * 96
        // SF-VOICE-END
        // BP-VOICE-BEGIN
        float[2048]   bps;    // Bagpipe source: state, slot * 192
        float[131072] bpd;    // Bagpipe source: delay lines, slot * 18432
        // BP-VOICE-END
        int     fdlW;         // comb delay write position
        bool    active;
    }


    Voice[8] voices;

    // LFO state
    float64 flfPhase = 0.0;   // flange filter sweep phase

    // Noise
    int noiseState = 12345;

    // Delay

    // Sample-rate reducer

    // ---------------- INIT ----------------
    void init()
    {
        // LFO sync divisions in beats (quarter notes) per cycle
        divBeats.at (0)  = 32.0f;    divBeats.at (1)  = 16.0f;    divBeats.at (2)  = 8.0f;
        divBeats.at (3)  = 4.0f;     divBeats.at (4)  = 3.0f;     divBeats.at (5)  = 2.0f;
        divBeats.at (6)  = 1.3333f;  divBeats.at (7)  = 1.5f;     divBeats.at (8)  = 1.0f;
        divBeats.at (9)  = 0.6667f;  divBeats.at (10) = 0.75f;    divBeats.at (11) = 0.5f;
        divBeats.at (12) = 0.3333f;  divBeats.at (13) = 0.375f;   divBeats.at (14) = 0.25f;
        divBeats.at (15) = 0.1667f;  divBeats.at (16) = 0.125f;   divBeats.at (17) = 0.0833f;
        for (int ld = 0; ld < 10; ++ld)
            mLfoDiv.at (ld) = 8.0f;

        // ENV2-INIT-BEGIN
        for (int ie = 0; ie < 32; ++ie)
        {
            xeAC.at (ie) = 0.0f;
            xeDC.at (ie) = 0.0f;
            xeDelay.at (ie) = 0.0f;
            xeHold.at (ie) = 0.0f;
            xeKey.at (ie) = 0.0f;
            xeLoop.at (ie) = 0.0f;
            xeLvl.at (ie) = 1.0f;
            xeRC.at (ie) = 0.0f;
            xeVel.at (ie) = 0.0f;
            xeSimple.at (ie) = true;
        }
        // ENV2-INIT-END
        // LFO2-INIT-BEGIN
        for (int il = 0; il < 10; ++il)
        {
            mLfoCubic.at (il) = 1.0f;
            mLfoDepth.at (il) = 1.0f;
            mLfoFine.at (il) = 0.0f;
            mLfoJit.at (il) = 0.0f;
            mLfoKey.at (il) = 0.0f;
            mLfoOct.at (il) = 4.0f;
            mLfoSemi.at (il) = 12.0f;
            mLfoSkew.at (il) = 0.0f;
            mLfoSpread.at (il) = 0.0f;
            mLfoSteps.at (il) = 0.0f;
            mLfoTpos.at (il) = 0.0f;
            lfoWtN.at (il) = 5;

            for (int ip = 0; ip < 256; ++ip)
            {
                float fph = float (ip) / 256.0f;
                int   wb  = il * 4096 + ip;
                lfoWt.at (wb)        = float (sin (float (twoPi) * fph));
                lfoWt.at (wb + 256)  = 4.0f * abs (fph - 0.5f) - 1.0f;
                lfoWt.at (wb + 512)  = 2.0f * fph - 1.0f;
                lfoWt.at (wb + 768)  = fph < 0.5f ? 1.0f : -1.0f;
                lfoWt.at (wb + 1024) = fph < 0.25f ? 1.0f : -1.0f;
            }
        }
        // LFO2-INIT-END
        fxGateInit();
        ins_setupTables();   // INSPIRATOR-DSP

        for (int ei = 0; ei < 32; ++ei)   // FX-FENV defaults
        {
            fxEnvSus.at (ei) = 1.0f;
            fxEnvRel.at (ei) = 0.3f;
        }

        // MOD-ARP303 defaults (same as the parameter defaults)
        a3Note.at (2) = 12.0f;
        a3Note.at (5) = 10.0f;
        a3Note.at (7) = 7.0f;
        a3Note.at (9) = 12.0f;
        a3Note.at (12) = 3.0f;
        a3Note.at (13) = 5.0f;
        a3Acc.at (2) = 1.0f;
        a3Acc.at (9) = 1.0f;
        a3Acc.at (13) = 1.0f;
        a3Slide.at (3) = 1.0f;
        a3Slide.at (7) = 1.0f;
        a3Slide.at (12) = 1.0f;
        a3Gate.at (0) = 1.0f;
        a3Gate.at (1) = 1.0f;
        a3Gate.at (2) = 1.0f;
        a3Gate.at (3) = 1.0f;
        a3Gate.at (4) = 1.0f;
        a3Gate.at (6) = 1.0f;
        a3Gate.at (7) = 1.0f;
        a3Gate.at (8) = 1.0f;
