    event frqShapeLoad (LfoShapeChunk c)
    {
        int m = clamp (c.lfo, 0, 9);

        for (int i = 0; i < 256; ++i)
            frqTab.at (m * 256 + i) = clamp (c.data.at (i), 0.0f, 1.0f);
    }

    // Mod matrix handlers (source, destination, amount)
    event param307 (float v) { mmSrcI.at (0) = clamp (int (v + 0.5f), 0, 52); mmScan(); }
    event param308 (float v) { mmDstI.at (0) = clamp (int (v + 0.5f), 0, 5667); mmScan(); }
    event param309 (float v) { mmAmt.at (0)  = v; }
    event param310 (float v) { mmSrcI.at (1) = clamp (int (v + 0.5f), 0, 52); mmScan(); }
    event param311 (float v) { mmDstI.at (1) = clamp (int (v + 0.5f), 0, 5667); mmScan(); }
    event param312 (float v) { mmAmt.at (1)  = v; }
    event param313 (float v) { mmSrcI.at (2) = clamp (int (v + 0.5f), 0, 52); mmScan(); }
