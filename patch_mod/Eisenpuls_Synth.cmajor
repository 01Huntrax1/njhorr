        sqMl.at (428) = 1.0f;
        sqMl.at (46) = 5.0f;
        sqMl.at (430) = 1.0f;
        sqMl.at (431) = 1.0f;
        sqMl.at (432) = 1.0f;
        sqMl.at (433) = 1.0f;
        sqMl.at (50) = 12.0f;
        sqMl.at (435) = 1.0f;
        sqMl.at (52) = 7.0f;
        sqMl.at (436) = 1.0f;
        sqMl.at (437) = 1.0f;
        sqMl.at (54) = 12.0f;
        sqMl.at (439) = 1.0f;
        sqMl.at (440) = 1.0f;
        sqMl.at (441) = 1.0f;
        sqMl.at (58) = 10.0f;
        sqMl.at (443) = 1.0f;
        sqMl.at (60) = 7.0f;
        sqMl.at (444) = 1.0f;
        sqMl.at (62) = 5.0f;
        sqMl.at (446) = 1.0f;
        sqMl.at (447) = 1.0f;

        for (int sm = 0; sm < 10; ++sm)   // MOD-SEQ
        {
            seqLen.at (sm)  = 8.0f;
            seqRate.at (sm) = 4.0f;
            seqDiv.at (sm)  = 11.0f;
            seqPol.at (sm)  = 1.0f;
            seqLoop.at (sm) = 1.0f;   // MOD-SEQ2
            seqG.at (sm)    = SeqS (0.0f, 0.0f, 1.0f, 0.5f);
            for (int sk = 0; sk < 16; ++sk)   // default pattern (same as the parameter defaults)
                seqStep.at (sm * 16 + sk) = seqDefault (sk);
        }

        for (int fm = 0; fm < 10; ++fm)
        {
            frqRate.at (fm)   = 300.0f;
            frqRetrig.at (fm) = 1.0f;

            for (int fi = 0; fi < 256; ++fi)
            {
                float fx = float (fi) / 255.0f;
                frqTab.at (fm * 256 + fi) = (1.0f - fx) * (1.0f - fx);
            }
        }

        // Wavefilter bank centres and the built-in filter / shaper tables
        for (int wb = 0; wb < 24; ++wb)
        {
            float fl = 4.907f + 0.4f * float (wb);
            wfL.at (wb) = fl;
            wfG.at (wb) = float (tan (float64 (30.0f * float (pow (2.0f, 0.4f * float (wb)))) * pi * processor.period));
        }

        for (int tb = 0; tb < 12; ++tb)
            tblDefault (tb);

        // slot defaults (the annotated parameter inits) and wavetable unison tables
        for (int io = 0; io < 6; ++io)
        {
            for (int ik = 0; ik < 64; ++ik)
                op.at (io * 64 + ik) = 0.0f;

            op.at (io * 64 + 1)  = 0.0f;
            op.at (io * 64 + 7)  = 1.0f;
            op.at (io * 64 + 49) = 1.0f;
            op.at (io * 64 + 50) = 8.0f;
            // RESO-INIT-BEGIN
            op.at (io * 64 + 56) = 0.0f;
            op.at (io * 64 + 57) = 0.0f;
            op.at (io * 64 + 58) = 1.0f;
            op.at (io * 64 + 59) = 0.5f;
            op.at (io * 64 + 60) = 0.3f;
            op.at (io * 64 + 61) = 0.0f;
            op.at (io * 64 + 62) = 0.0f;
            op.at (io * 64 + 63) = 0.5f;
            // RESO-INIT-END
            // PHYS-INIT-BEGIN
            phyP.at (io * 32 + 0) = 0.25f;
            phyP.at (io * 32 + 1) = 0.6f;
            phyP.at (io * 32 + 2) = 60.0f;
            phyP.at (io * 32 + 3) = 0.0f;
            phyP.at (io * 32 + 4) = 2.5f;
            phyP.at (io * 32 + 5) = 0.5f;
            phyP.at (io * 32 + 6) = 0.3f;
            phyP.at (io * 32 + 7) = 0.0f;
            phyP.at (io * 32 + 8) = 3.0f;
            phyP.at (io * 32 + 9) = 1.5f;
            phyP.at (io * 32 + 10) = 0.5f;
            phyP.at (io * 32 + 11) = 0.3f;
            phyP.at (io * 32 + 12) = 0.0f;
            phyP.at (io * 32 + 13) = 12.0f;
            phyP.at (io * 32 + 14) = 0.35f;
            phyP.at (io * 32 + 15) = 0.0f;
            phyP.at (io * 32 + 16) = 0.8f;
            phyP.at (io * 32 + 17) = 0.0f;
            phyP.at (io * 32 + 18) = 0.5f;
            phyP.at (io * 32 + 19) = 0.0f;
            phyP.at (io * 32 + 20) = 1.5f;
            phyP.at (io * 32 + 21) = 0.5f;
            phyP.at (io * 32 + 22) = 0.0f;
            phyP.at (io * 32 + 23) = 1.0f;
            phyP.at (io * 32 + 24) = 0.2f;
            phyP.at (io * 32 + 25) = 0.3f;
            phyP.at (io * 32 + 26) = 0.0f;
            phyP.at (io * 32 + 27) = 0.0f;
            phyP.at (io * 32 + 28) = 0.0f;
            phyP.at (io * 32 + 29) = 0.0f;
            phyP.at (io * 32 + 30) = 0.0f;
            // PHYS-INIT-END
            // TER-INIT-BEGIN
            terP.at (io * 16 + 0) = 0.0f;
            terP.at (io * 16 + 1) = 0.0f;
            terP.at (io * 16 + 2) = 0.6f;
            terP.at (io * 16 + 3) = 0.6f;
            terP.at (io * 16 + 4) = 0.0f;
            terP.at (io * 16 + 5) = 1.0f;
            terP.at (io * 16 + 6) = 0.0f;
            terP.at (io * 16 + 7) = 0.0f;
            terP.at (io * 16 + 8) = 1.0f;
            terP.at (io * 16 + 9) = 0.0f;
            terP.at (io * 16 + 10) = 1.0f;
            terP.at (io * 16 + 11) = 0.0f;
            terP.at (io * 16 + 12) = 0.3f;
            terP.at (io * 16 + 13) = 0.0f;
            terP.at (io * 16 + 14) = 16.0f;
            terP.at (io * 16 + 15) = 0.0f;
            // TER-INIT-END
            // WG-INIT-BEGIN
            wgP.at (io * 16 + 0) = 0.0f;
            wgP.at (io * 16 + 1) = 0.5f;
            wgP.at (io * 16 + 2) = 0.6f;
            wgP.at (io * 16 + 3) = 0.6f;
            wgP.at (io * 16 + 4) = 0.3f;
            wgP.at (io * 16 + 5) = 0.2f;
            wgP.at (io * 16 + 6) = 0.0f;
            wgP.at (io * 16 + 7) = 0.0f;
            wgP.at (io * 16 + 8) = 0.2f;
            wgP.at (io * 16 + 9) = 0.0f;
            wgP.at (io * 16 + 10) = 0.0f;
            wgP.at (io * 16 + 11) = 0.4f;
            wgP.at (io * 16 + 12) = 0.5f;
            wgP.at (io * 16 + 13) = 0.0f;
            wgP.at (io * 16 + 14) = 0.0f;
            wgP.at (io * 16 + 15) = 0.3f;
            // WG-INIT-END
            // JP-INIT-BEGIN
            jpP.at (io * 16 + 0) = 6.0f;
            jpP.at (io * 16 + 1) = 0.5f;
            jpP.at (io * 16 + 2) = 0.0f;
            jpP.at (io * 16 + 3) = 1.0f;
            jpP.at (io * 16 + 4) = 0.4f;
            jpP.at (io * 16 + 5) = 0.7f;
            jpP.at (io * 16 + 6) = 0.7f;
            jpP.at (io * 16 + 7) = 0.5f;
            jpP.at (io * 16 + 8) = 0.3f;
            jpP.at (io * 16 + 9) = 0.5f;
            jpP.at (io * 16 + 10) = 0.2f;
            jpP.at (io * 16 + 11) = 0.5f;
            jpP.at (io * 16 + 12) = 0.3f;
            jpP.at (io * 16 + 13) = 0.0f;
            jpP.at (io * 16 + 14) = 0.0f;
            jpP.at (io * 16 + 15) = 0.0f;
            // JP-INIT-END
            // GR-INIT-BEGIN
            grP.at (io * 16 + 0) = 0.3f;
            grP.at (io * 16 + 1) = 0.5f;
            grP.at (io * 16 + 2) = 0.5f;
            grP.at (io * 16 + 3) = 0.1f;
            grP.at (io * 16 + 4) = 0.0f;
            grP.at (io * 16 + 5) = 0.5f;
            grP.at (io * 16 + 6) = 0.0f;
            grP.at (io * 16 + 7) = 0.0f;
            grP.at (io * 16 + 8) = 0.0f;
            grP.at (io * 16 + 9) = 0.3f;
            grP.at (io * 16 + 10) = 0.0f;
            grP.at (io * 16 + 11) = 0.0f;
            // GR-INIT-END
            // AD-INIT-BEGIN
            adP.at (io * 16 + 0) = 0.0f;
            adP.at (io * 16 + 1) = 3.0f;
            adP.at (io * 16 + 2) = 0.0f;
            adP.at (io * 16 + 3) = 32.0f;
            adP.at (io * 16 + 4) = 0.0f;
            adP.at (io * 16 + 5) = 0.0f;
            adP.at (io * 16 + 6) = 0.0f;
            adP.at (io * 16 + 7) = 0.4f;
            adP.at (io * 16 + 8) = 0.0f;
            adP.at (io * 16 + 9) = 0.0f;
            adP.at (io * 16 + 10) = 2.0f;
            adP.at (io * 16 + 11) = 0.0f;
            adP.at (io * 16 + 12) = 0.0f;
            adP.at (io * 16 + 13) = 0.3f;
            adP.at (io * 16 + 14) = 0.5f;
            // AD-INIT-END
            // KICK-INIT-BEGIN
            kickP.at (io * 16 + 0) = 0.0f;
            kickP.at (io * 16 + 1) = 2.5f;
            kickP.at (io * 16 + 2) = 60.0f;
            kickP.at (io * 16 + 3) = 0.5f;
            kickP.at (io * 16 + 4) = 450.0f;
            kickP.at (io * 16 + 5) = 0.3f;
            kickP.at (io * 16 + 6) = 0.35f;
            kickP.at (io * 16 + 7) = 0.5f;
            kickP.at (io * 16 + 8) = 0.0f;
            kickP.at (io * 16 + 9) = 0.2f;
            kickP.at (io * 16 + 10) = 1.0f;
            kickP.at (io * 16 + 11) = 0.0f;
            kickP.at (io * 16 + 12) = 0.3f;
            kickP.at (io * 16 + 13) = 0.0f;
            kickP.at (io * 16 + 14) = 6.0f;
            kickP.at (io * 16 + 15) = 0.5f;
            // KICK-INIT-END
            // DK-INIT-BEGIN
            dkP.at (io * 16 + 0) = 0.5f;
            dkP.at (io * 16 + 1) = 0.6f;
            dkP.at (io * 16 + 2) = 0.25f;
            dkP.at (io * 16 + 3) = 0.5f;
            dkP.at (io * 16 + 4) = 0.3f;
            dkP.at (io * 16 + 5) = 0.6f;
            dkP.at (io * 16 + 6) = 0.0f;
            dkP.at (io * 16 + 7) = 0.4f;
            dkP.at (io * 16 + 8) = 0.5f;
            dkP.at (io * 16 + 9) = 0.0f;
            dkP.at (io * 16 + 10) = 0.5f;
            dkP.at (io * 16 + 11) = 0.0f;
            dkP.at (io * 16 + 12) = 0.3f;
            dkP.at (io * 16 + 13) = 0.5f;
            dkP.at (io * 16 + 14) = 0.0f;
            dkP.at (io * 16 + 15) = 0.5f;
            // DK-INIT-END
            // SP-INIT-BEGIN
            spP.at (io * 16 + 0) = 0.0f;
            spP.at (io * 16 + 1) = 0.0f;
            spP.at (io * 16 + 2) = 0.5f;
            spP.at (io * 16 + 3) = 0.0f;
            spP.at (io * 16 + 4) = 0.0f;
            spP.at (io * 16 + 5) = 0.3f;
            spP.at (io * 16 + 6) = 0.0f;
            spP.at (io * 16 + 7) = 0.0f;
            spP.at (io * 16 + 8) = 1.0f;
            spP.at (io * 16 + 9) = 0.0f;
            spP.at (io * 16 + 10) = 0.0f;
            spP.at (io * 16 + 11) = 0.0f;
            spP.at (io * 16 + 12) = 0.0f;
            spP.at (io * 16 + 13) = 0.0f;
            spP.at (io * 16 + 14) = 0.5f;
            spP.at (io * 16 + 15) = 0.0f;
            // SP-INIT-END
            // SF-INIT-BEGIN
            sfP.at (io * 16 + 0) = 0.0f;
            sfP.at (io * 16 + 1) = 0.5f;
            sfP.at (io * 16 + 2) = 0.0f;
            sfP.at (io * 16 + 3) = 0.0f;
            sfP.at (io * 16 + 4) = 0.0f;
            sfP.at (io * 16 + 5) = 0.0f;
            sfP.at (io * 16 + 6) = 0.0f;
            sfP.at (io * 16 + 7) = 1.0f;
            sfP.at (io * 16 + 8) = 0.0f;
            sfP.at (io * 16 + 9) = 0.0f;
            // SF-INIT-END
            // BP-INIT-BEGIN
            bpP.at (io * 16 + 0) = 2.0f;
            bpP.at (io * 16 + 1) = 3.0f;
            bpP.at (io * 16 + 2) = 0.0f;
            bpP.at (io * 16 + 3) = 0.0f;
            bpP.at (io * 16 + 4) = 0.22f;
            bpP.at (io * 16 + 5) = 0.5f;
            bpP.at (io * 16 + 6) = 0.18f;
            bpP.at (io * 16 + 7) = 0.05f;
            bpP.at (io * 16 + 8) = 0.4f;
            bpP.at (io * 16 + 9) = 0.3f;
            bpP.at (io * 16 + 10) = 0.5f;
            bpP.at (io * 16 + 11) = 1.0f;
            bpP.at (io * 16 + 12) = 9.0f;
            bpP.at (io * 16 + 13) = 0.4f;
            bpP.at (io * 16 + 14) = 0.0f;
            bpP.at (io * 16 + 15) = 0.0f;
            // BP-INIT-END
            // SM-INIT-BEGIN
            smP.at (io * 16 + 0) = 1.0f;
            smP.at (io * 16 + 1) = 0.0f;
            smP.at (io * 16 + 2) = 1.0f;
            smP.at (io * 16 + 3) = 0.0f;
            smP.at (io * 16 + 4) = 0.0f;
            smP.at (io * 16 + 5) = 0.0f;
            smP.at (io * 16 + 6) = 1.0f;
            smP.at (io * 16 + 7) = 0.0f;
            smP.at (io * 16 + 8) = 0.0f;
            smP.at (io * 16 + 9) = 1.0f;
            smP.at (io * 16 + 10) = 1.0f;
            // SM-INIT-END
            // WT2-INIT-BEGIN
            wtP.at (io * 16 + 0) = 0.0f;
            wtP.at (io * 16 + 1) = 0.5f;
            wtP.at (io * 16 + 2) = 0.0f;
            wtP.at (io * 16 + 3) = 1.0f;
            // WT2-INIT-END
            op.at (io * 64 + 11) = 3.0f;
            op.at (io * 64 + 12) = 60.0f;
            op.at (io * 64 + 13) = 1.0f;
            op.at (io * 64 + 14) = 0.25f;
            op.at (io * 64 + 15) = 1.0f;
            op.at (io * 64 + 16) = 0.75f;
            op.at (io * 64 + 19) = 0.5f;
            op.at (io * 64 + 21) = 0.5f;
            op.at (io * 64 + 24) = 0.0f;
            op.at (io * 64 + 25) = 0.5f;
            op.at (io * 64 + 26) = 0.0f;
            op.at (io * 64 + 27) = 0.0f;
            op.at (io * 64 + 30) = 1.0f;
            op.at (io * 64 + 32) = 8000.0f;
            op.at (io * 64 + 33) = 0.25f;
            op.at (io * 64 + 35) = 0.5f;
            op.at (io * 64 + 39) = 300.0f;
            op.at (io * 64 + 41) = 250.0f;
            op.at (io * 64 + 43) = 0.3f;
            op.at (io * 64 + 44) = 1.0f;
            updateWtUni (io);
        }
        op.at (1) = 0.8f;

        // mod page defaults (match the annotated init values)
        for (int mi = 0; mi < 10; ++mi)
        {
            mLfoWave.at (mi)    = 0.0f;
            mLfoRate.at (mi)    = 1.0f;
            mLfoPhase.at (mi)   = 0.0;
            mLfoSh.at (mi)      = 0.0f;
            mLfoV.at (mi)       = 0.0f;
            mEnvA.at (mi)       = 10.0f;
            mEnvD.at (mi)       = 300.0f;
            mEnvS.at (mi)       = 0.5f;
            mEnvR.at (mi)       = 300.0f;
            msMode.at (mi)      = 0;
            msN.at (mi)         = 3;
            msSus.at (mi)       = 2;
            msLoopOn.at (mi)    = 0;
            msLoopS.at (mi)     = 1;
            msLoopE.at (mi)     = 2;
            rMode.at (mi)       = 0;
            rRate.at (mi)       = 4.0f;
            rSync.at (mi)       = 0;
            rDiv.at (mi)        = 8.0f;
            rSmooth.at (mi)     = 0.0f;
            rDist.at (mi)       = 0;
            rUni.at (mi)        = 0;
            rSeed.at (mi)       = 0;
            envMax.at (mi)      = 0.0f;
            envMaxNext.at (mi)  = 0.0f;
            mmSrcI.at (mi)      = 0;
            mmDstI.at (mi)      = 0;
            mmAmt.at (mi)       = 0.0f;
        }

        // reverb delay line lengths (tuned at 44.1 kHz, scaled to the actual sample rate)
        float rs = float (processor.frequency) / 44100.0f;

        combLen.at (0) = clamp (int (1116.0f * rs), 16, 8191);
        combLen.at (1) = clamp (int (1188.0f * rs), 16, 8191);
        combLen.at (2) = clamp (int (1277.0f * rs), 16, 8191);
        combLen.at (3) = clamp (int (1356.0f * rs), 16, 8191);
        combLen.at (4) = clamp (int (1139.0f * rs), 16, 8191);
        combLen.at (5) = clamp (int (1211.0f * rs), 16, 8191);
        combLen.at (6) = clamp (int (1300.0f * rs), 16, 8191);
        combLen.at (7) = clamp (int (1379.0f * rs), 16, 8191);

        apLen.at (0) = clamp (int (556.0f * rs), 16, 4095);
        apLen.at (1) = clamp (int (441.0f * rs), 16, 4095);
        apLen.at (2) = clamp (int (579.0f * rs), 16, 4095);
        apLen.at (3) = clamp (int (464.0f * rs), 16, 4095);

        for (int mi = 0; mi < 68; ++mi)   // MODMAT: start values (Synth and Audio In to Out, all cable gains 1)
        {
            mrSrc.at (mi)  = mi == 64 ? 1 : (mi == 65 ? 2 : 0);
            mrGain.at (mi) = 1.0f;
        }

        for (int ei = 0; ei < 20; ++ei)   // EURO: start values
            eRst.at (ei) = 1;

        for (int ei = 0; ei < 160; ++ei)
            eK.at (ei) = 0.5f;

        for (int ei = 0; ei < 80; ++ei)
            eGain.at (ei) = 1.0f;

        fxInit();
        for (int ei = 0; ei < 20; ++ei)
            fxMix.at (10 + ei) = 0.5f;

        cvInit();
        modEdInit();

        for (int lm = 0; lm < 10; ++lm)
            for (int li = 0; li < 256; ++li)
                lfoTab.at (lm * 256 + li) = float (sin (float (twoPi) * float (li) / 256.0f));
    }

    // ================================================================================================================
    // FX RACKS: three racks (Main, Bus 1, Bus 2) of 10 slots; every slot holds any effect and the slots of a rack are
    // processed in the order set by its "FX Order 1-10". Slot s of rack rk is the global slot rk * 10 + s.
    //
    // The slot parameters P1-P6 are normalised 0..1; what they mean depends on the effect type (the UI shows the
    // real names and units). The same table lives in patch/index.js (FX_TYPES), keep both in step:
    //
    //   1 Distortion  mode: Soft Tube Hard Fold Sine Crunch   P1 Drive    P2 Tone       P3 Output
    //   2 Bit Crush                                           P1 Bits     P2 Rate
    //   3 Delay       mode: Digital Tape Dual                 P1 Time     P2 Feedback   P3 Damp       P4 Ping-Pong
    //   4 Chorus      mode: Classic Dimension Vibrato         P1 Rate     P2 Depth      P3 Feedback
    //   5 Flanger                                             P1 Rate     P2 Depth      P3 Feedback
    //   6 Phaser      mode: 2 4 6 8 stages                    P1 Rate     P2 Depth      P3 Feedback
    //   7 Tremolo     mode: Sin Tri Sqr SawDn SawUp           P1 Rate     P2 Depth      P3 Stereo
    //   8 Reverb      mode: Hall Room Plate Cathedral         P1 Size     P2 Damp       P3 Pre-Delay  P4 Width
    //   9 Filter      mode: the 30 types of the Filter page   P1 Cutoff   P2 Reso       P3 Drive
    //  10 EQ                                                  P1 Low      P2 Mid        P3 Mid Freq   P4 High   P5 Mid Q
    //  11 Compressor  mode: Peak RMS                          P1 Thresh   P2 Ratio      P3 Attack     P4 Release  P5 Makeup
    //
    // Every slot has a private 196608-float arena (delay lines etc.), 40 float / 24 int / 4 phase state slots and
    // 16 derived values (fxD, recomputed lazily when a parameter changed).
    // ================================================================================================================

    // log-style mapping of a 0..1 value onto lo..hi
    float fxExpMap (float n, float lo, float hi)
    {
        return lo * float (pow (hi / lo, clamp (n, 0.0f, 1.0f)));
    }

    // ---- FX-SYNC ----
    // 24 trance gate patterns of 16 steps (bit k of 'on' = step k open, bit k of 'soft' = step k at 45 %)
    void fxGateSet (int p, int on, int soft)
    {
        for (int k = 0; k < 16; ++k)
        {
            float v = 0.0f;

            if (((on >> k) & 1) != 0)
                v = ((soft >> k) & 1) != 0 ? 0.45f : 1.0f;

            fxGate.at (p * 16 + k) = v;
        }
    }

    void fxGateInit()
    {
        fxGateSet (0, 21845, 0);
        fxGateSet (1, 4369, 0);
        fxGateSet (2, 17476, 0);
        fxGateSet (3, 65535, 43690);
        fxGateSet (4, 18761, 0);
        fxGateSet (5, 9289, 0);
        fxGateSet (6, 44461, 0);
        fxGateSet (7, 10537, 0);
        fxGateSet (8, 15, 0);
        fxGateSet (9, 257, 0);
        fxGateSet (10, 55133, 0);
        fxGateSet (11, 28013, 0);
        fxGateSet (12, 13107, 0);
        fxGateSet (13, 48059, 43690);
        fxGateSet (14, 62737, 0);
        fxGateSet (15, 13141, 0);
        fxGateSet (16, 20753, 0);
        fxGateSet (17, 17733, 0);
        fxGateSet (18, 61167, 0);
        fxGateSet (19, 1089, 0);
        fxGateSet (20, 21845, 17476);
        fxGateSet (21, 21157, 0);
        fxGateSet (22, 37449, 0);
        fxGateSet (23, 65535, 0);
    }

    // Phase 0..1 of the modulation of an effect: free running at its rate, or locked to the beat clock with the slot's division
    float64 fxPhase (int s, int pb, int db)
    {
        int dv = fxSync.at (s);

        if (dv > 0)
        {
            float64 b = fxBeat / float64 (divBeats.at (clamp (dv - 1, 0, 17)));
            return b - floor (b);
        }

        float64 ph = fxPh.at (pb) + float64 (fxD.at (db)) * processor.period;
        if (ph >= 1.0) ph -= 1.0;
        fxPh.at (pb) = ph;
        return ph;
    }

    // linear interpolated read of a circular buffer of n floats at base
    float fxTapN (int base, int n, float pos)
    {
        float p = pos;
        if (p < 0.0f) p += float (n);
        if (p >= float (n)) p -= float (n);
        int i0 = clamp (int (p), 0, n - 1);
        int i1 = i0 + 1;
        if (i1 >= n) i1 = 0;
        float fr = p - float (i0);
        return fxArena.at (base + i0) * (1.0f - fr) + fxArena.at (base + i1) * fr;
    }

    // value of the gate pattern at phase p (0..1 over the 16 steps); swing delays the odd steps by a fraction of a step
    float fxGateAt (int pat, float p, float swing)
    {
        float u  = p * 16.0f;
        int   si = clamp (int (u), 0, 15);
        float f  = u - float (si);

        if ((si & 1) == 1 && f < swing)
            si -= 1;

        return fxGate.at (pat * 16 + si);
    }


    // ================= FX-PEQ: Parametric EQ (FX type 13) =================
    // Band values (normalised, 10 per band at peqB[(slot * 24 + band) * 10 + k]):
    //   0 on, 1 type / 16, 2 frequency (0..1 = 20 Hz .. 20 kHz, log), 3 gain / 24 dB (-1..1), 4 Q (0..1 = 0.1 .. 30, log), 5 harmonics / 16, 6 harmonic falloff (0..1), 7 harmonic set / 4 (0 all, 1 odd, 2 even),
    //   8 channel / 4 (0 stereo, 1 left, 2 right, 3 mid, 4 side), 9 spare
    // Types: 0 bell, 1 low shelf, 2 high shelf, 3 low cut 12, 4 low cut 24, 5 high cut 12, 6 high cut 24, 7 band pass, 8 notch, 9 tilt, 10 all-pass, 11 comb (feed-forward), 12 comb (feedback),
    //        13 low cut 48, 14 high cut 48.   Harmonics (extra bells at 2f, 3f ... with falling gain) are available for bell, band pass, notch.
    // Slot parameters: P1 output (+-18 dB), P2 gain scale (0..200 %), P3 frequency shift (+-1 octave), P4 Q scale (x0.25 .. x4)

    // one RBJ biquad section of a slot: kind 0 peak, 1 low shelf, 2 high shelf, 3 high pass, 4 low pass, 5 band pass (gain = peak gain), 6 notch, 7 all-pass
    int peqAddSec (int s, int n, int kind, float f, float gDb, float q, int ch)
    {
        if (n >= 64)
            return n;

        float sr  = float (processor.frequency);
        float ff  = clamp (f, 10.0f, sr * 0.45f);
        float w0  = float (twoPi) * ff / sr;
        float cw  = float (cos (w0));
        float sw  = float (sin (w0));
        float al  = sw / (2.0f * clamp (q, 0.05f, 40.0f));
        float A   = float (pow (10.0f, gDb / 40.0f));
        float b0  = 1.0f;
        float b1  = 0.0f;
        float b2  = 0.0f;
        float a0  = 1.0f;
        float a1  = 0.0f;
        float a2  = 0.0f;

        if (kind == 0)
        {
            b0 = 1.0f + al * A;  b1 = -2.0f * cw;  b2 = 1.0f - al * A;
            a0 = 1.0f + al / A;  a1 = -2.0f * cw;  a2 = 1.0f - al / A;
        }
        else if (kind == 1)
        {
            float t = 2.0f * float (sqrt (A)) * al;
            b0 = A * ((A + 1.0f) - (A - 1.0f) * cw + t);
            b1 = 2.0f * A * ((A - 1.0f) - (A + 1.0f) * cw);
            b2 = A * ((A + 1.0f) - (A - 1.0f) * cw - t);
            a0 = (A + 1.0f) + (A - 1.0f) * cw + t;
            a1 = -2.0f * ((A - 1.0f) + (A + 1.0f) * cw);
            a2 = (A + 1.0f) + (A - 1.0f) * cw - t;
        }
        else if (kind == 2)
        {
            float t = 2.0f * float (sqrt (A)) * al;
            b0 = A * ((A + 1.0f) + (A - 1.0f) * cw + t);
            b1 = -2.0f * A * ((A - 1.0f) + (A + 1.0f) * cw);
            b2 = A * ((A + 1.0f) + (A - 1.0f) * cw - t);
            a0 = (A + 1.0f) - (A - 1.0f) * cw + t;
            a1 = 2.0f * ((A - 1.0f) - (A + 1.0f) * cw);
            a2 = (A + 1.0f) - (A - 1.0f) * cw - t;
        }
        else if (kind == 3)
        {
            b0 = (1.0f + cw) * 0.5f;  b1 = -(1.0f + cw);  b2 = b0;
            a0 = 1.0f + al;  a1 = -2.0f * cw;  a2 = 1.0f - al;
        }
        else if (kind == 4)
        {
            b0 = (1.0f - cw) * 0.5f;  b1 = 1.0f - cw;  b2 = b0;
            a0 = 1.0f + al;  a1 = -2.0f * cw;  a2 = 1.0f - al;
        }
        else if (kind == 5)
        {
            float gl = float (pow (10.0f, gDb / 20.0f));
            b0 = al * gl;  b1 = 0.0f;  b2 = -al * gl;
            a0 = 1.0f + al;  a1 = -2.0f * cw;  a2 = 1.0f - al;
        }
        else if (kind == 6)
        {
            b0 = 1.0f;  b1 = -2.0f * cw;  b2 = 1.0f;
            a0 = 1.0f + al;  a1 = -2.0f * cw;  a2 = 1.0f - al;
        }
        else if (kind >= 8 && kind <= 11)   // EQTYPES: first order sections (the biquad keeps b2 = a2 = 0)
        {
            float K = float (tan (w0 * 0.5f));
            float V = float (pow (10.0f, gDb / 20.0f));
            a0 = 1.0f + K;  a1 = K - 1.0f;
            if (kind == 8)       { b0 = K;  b1 = K; }
            else if (kind == 9)  { b0 = 1.0f;  b1 = -1.0f; }
            else if (kind == 10) { b0 = 1.0f + V * K;  b1 = V * K - 1.0f; }
            else                 { b0 = V + K;  b1 = K - V; }
        }
        else
        {
            b0 = 1.0f - al;  b1 = -2.0f * cw;  b2 = 1.0f + al;
            a0 = 1.0f + al;  a1 = -2.0f * cw;  a2 = 1.0f - al;
        }

        int ci = (s * 64 + n) * 5;
        float ia = 1.0f / a0;
        peqC.at (ci)     = b0 * ia;
        peqC.at (ci + 1) = b1 * ia;
        peqC.at (ci + 2) = b2 * ia;
        peqC.at (ci + 3) = a1 * ia;
        peqC.at (ci + 4) = a2 * ia;
        peqCh.at (s * 64 + n) = ch;
        return n + 1;
    }

    // turns the bands and the four slot parameters of an EQ slot into sections and combs (runs when a parameter or the bands changed)
    void fxPeqDerive (int s)
    {
        float sr     = float (processor.frequency);
        int   pb     = s * 6;
        float outDb  = (clamp (fxP.at (pb), 0.0f, 1.0f) - 0.5f) * 36.0f;
        float gScale = clamp (fxP.at (pb + 1), 0.0f, 1.0f) * 2.0f;
        float fShift = float (pow (2.0f, (clamp (fxP.at (pb + 2), 0.0f, 1.0f) - 0.5f) * 2.0f));
        float qScale = 0.25f * float (pow (16.0f, clamp (fxP.at (pb + 3), 0.0f, 1.0f)));
        int   n      = 0;

        fxD.at (s * 16) = float (pow (10.0f, outDb / 20.0f));

        for (int b = 0; b < 24; ++b)
        {
            int ek = (s * 24 + b) * 4;
            peqK.at (ek) = 0.0f;
        }

        for (int b = 0; b < 24; ++b)
        {
            int   bi   = (s * 24 + b) * 10;

            if (peqB.at (bi) < 0.5f)
                continue;

            int   ty   = clamp (int (peqB.at (bi + 1) * 16.0f + 0.5f), 0, 24);
            float f    = clamp (20.0f * float (pow (1000.0f, clamp (peqB.at (bi + 2), 0.0f, 1.0f))) * fShift, 10.0f, sr * 0.45f);
            float g    = clamp (peqB.at (bi + 3) * 24.0f * gScale, -36.0f, 36.0f);
            float q    = clamp (0.1f * float (pow (300.0f, clamp (peqB.at (bi + 4), 0.0f, 1.0f))) * qScale, 0.05f, 40.0f);
            int   harm = clamp (int (peqB.at (bi + 5) * 16.0f + 0.5f), 0, 16);
            float fall = 0.4f + 0.6f * clamp (peqB.at (bi + 6), 0.0f, 1.0f);
            int   hset = clamp (int (peqB.at (bi + 7) * 4.0f + 0.5f), 0, 2);
            int   ch   = clamp (int (peqB.at (bi + 8) * 4.0f + 0.5f), 0, 4);

            if (ty == 0)       n = peqAddSec (s, n, 0, f, g, q, ch);
            else if (ty == 1)  n = peqAddSec (s, n, 1, f, g, q, ch);
            else if (ty == 2)  n = peqAddSec (s, n, 2, f, g, q, ch);
            else if (ty == 3)  n = peqAddSec (s, n, 3, f, 0.0f, q, ch);
            else if (ty == 4)  { float qq = q * 1.4142f; n = peqAddSec (s, n, 3, f, 0.0f, qq * 0.5412f, ch); n = peqAddSec (s, n, 3, f, 0.0f, qq * 1.3066f, ch); }
            else if (ty == 5)  n = peqAddSec (s, n, 4, f, 0.0f, q, ch);
            else if (ty == 6)  { float qq = q * 1.4142f; n = peqAddSec (s, n, 4, f, 0.0f, qq * 0.5412f, ch); n = peqAddSec (s, n, 4, f, 0.0f, qq * 1.3066f, ch); }
            else if (ty == 7)  n = peqAddSec (s, n, 5, f, g, q, ch);
            else if (ty == 8)  n = peqAddSec (s, n, 6, f, 0.0f, q, ch);
            else if (ty == 9)  { n = peqAddSec (s, n, 1, f, -g * 0.5f, 0.5f, ch); n = peqAddSec (s, n, 2, f, g * 0.5f, 0.5f, ch); }
            else if (ty == 10) n = peqAddSec (s, n, 7, f, 0.0f, q, ch);
            else if (ty == 13) { float qq = q * 1.4142f; n = peqAddSec (s, n, 3, f, 0.0f, qq * 0.5098f, ch); n = peqAddSec (s, n, 3, f, 0.0f, qq * 0.6013f, ch); n = peqAddSec (s, n, 3, f, 0.0f, qq * 0.9f, ch); n = peqAddSec (s, n, 3, f, 0.0f, qq * 2.5629f, ch); }
            else if (ty == 14) { float qq = q * 1.4142f; n = peqAddSec (s, n, 4, f, 0.0f, qq * 0.5098f, ch); n = peqAddSec (s, n, 4, f, 0.0f, qq * 0.6013f, ch); n = peqAddSec (s, n, 4, f, 0.0f, qq * 0.9f, ch); n = peqAddSec (s, n, 4, f, 0.0f, qq * 2.5629f, ch); }
            else if (ty == 15) n = peqAddSec (s, n, 9, f, 0.0f, q, ch);
            else if (ty == 16) n = peqAddSec (s, n, 8, f, 0.0f, q, ch);
            else if (ty == 17) n = peqAddSec (s, n, 10, f, g, q, ch);
            else if (ty == 18) n = peqAddSec (s, n, 11, f, g, q, ch);
            else if (ty == 19) { n = peqAddSec (s, n, 1, f, g * 0.5f, q, ch); n = peqAddSec (s, n, 1, f, g * 0.5f, q, ch); }
            else if (ty == 20) { n = peqAddSec (s, n, 2, f, g * 0.5f, q, ch); n = peqAddSec (s, n, 2, f, g * 0.5f, q, ch); }
            else if (ty == 21) { n = peqAddSec (s, n, 6, f, 0.0f, q, ch); n = peqAddSec (s, n, 6, f, 0.0f, q, ch); }
            else if (ty == 22) { n = peqAddSec (s, n, 5, f, g * 0.5f, q, ch); n = peqAddSec (s, n, 5, f, g * 0.5f, q, ch); }
            else if (ty == 23)
            {
                float r = clamp (float (pow (2.0f, 0.5f / q)), 1.01f, 8.0f);
                n = peqAddSec (s, n, 3, max (f / r, 10.0f), 0.0f, 0.7071f, ch);
                n = peqAddSec (s, n, 4, min (f * r, sr * 0.45f), 0.0f, 0.7071f, ch);
            }
            else if (ty == 24)
            {
                float fg = g;
                n = peqAddSec (s, n, 0, f, fg, q, ch);
                if (f * 2.5f < sr * 0.45f) n = peqAddSec (s, n, 0, f * 2.5f, fg * 0.8f, q, ch);
                if (f * 3.6f < sr * 0.45f) n = peqAddSec (s, n, 0, f * 3.6f, fg * 0.64f, q, ch);
            }
            else
            {
                // comb: feed-forward (11) or feedback (12) at multiples of the frequency, the gain sets how deep / strong
                int   ek  = (s * 24 + b) * 4;
                float amt = 1.0f - float (pow (10.0f, -abs (g) / 20.0f));
                peqK.at (ek)     = (g < 0.0f ? -amt : amt) * (ty == 12 ? 0.97f : 1.0f);
                peqK.at (ek + 1) = clamp (sr / f, 2.0f, 4000.0f);
                peqK.at (ek + 2) = ty == 12 ? 1.0f : 0.0f;
                peqK.at (ek + 3) = float (ch);
            }

            if ((ty == 0 || ty == 7 || ty == 8) && harm > 0)
            {
                float hg = g;

                for (int h = 1; h <= harm; ++h)
                {
                    int k = h + 1;

                    if (hset == 1) k = 2 * h + 1;
                    if (hset == 2) k = 2 * h;

                    hg = hg * fall;
                    float hf = f * float (k);

                    if (hf > sr * 0.45f)
                        break;

                    if (ty == 8)
                        n = peqAddSec (s, n, 6, hf, 0.0f, q, ch);
                    else
                        n = peqAddSec (s, n, ty == 7 ? 5 : 0, hf, hg, q, ch);
                }
            }
        }

        peqN.at (s) = n;
    }

    float<2> fxPeq (int s, float<2> x)
    {
        int   n = peqN.at (s);
        float l = x[0];
        float r = x[1];

        for (int i = 0; i < n; ++i)
        {
            int   si = s * 64 + i;
            int   ci = si * 5;
            int   zi = si * 4;
            int   ch = peqCh.at (si);
            float b0 = peqC.at (ci);
            float b1 = peqC.at (ci + 1);
            float b2 = peqC.at (ci + 2);
            float a1 = peqC.at (ci + 3);
            float a2 = peqC.at (ci + 4);

            if (ch >= 3)
            {
                float m  = (l + r) * 0.5f;
                float sd = (l - r) * 0.5f;
                float v  = ch == 3 ? m : sd;
                int   zz = ch == 3 ? zi : zi + 2;
                float y  = b0 * v + peqZ.at (zz);
                peqZ.at (zz)     = b1 * v - a1 * y + peqZ.at (zz + 1);
                peqZ.at (zz + 1) = b2 * v - a2 * y;

                if (ch == 3) m = y; else sd = y;

                l = m + sd;
                r = m - sd;
            }
            else
            {
                if (ch != 2)
                {
                    float y = b0 * l + peqZ.at (zi);
                    peqZ.at (zi)     = b1 * l - a1 * y + peqZ.at (zi + 1);
                    peqZ.at (zi + 1) = b2 * l - a2 * y;
                    l = y;
                }

                if (ch != 1)
                {
                    float y = b0 * r + peqZ.at (zi + 2);
                    peqZ.at (zi + 2) = b1 * r - a1 * y + peqZ.at (zi + 3);
                    peqZ.at (zi + 3) = b2 * r - a2 * y;
                    r = y;
                }
            }
        }

        // combs: a delay line of 4096 samples per channel in the slot's arena, the write position of band b in fxI
        int ab = fxAb (s);

        for (int b = 0; b < 24; ++b)
        {
            int   ek = (s * 24 + b) * 4;
            float cg = peqK.at (ek);

            if (cg == 0.0f)
                continue;

            int   wp = fxI.at (s * 24 + b);
            int   cb = ab + b * 8192;
            float dl = peqK.at (ek + 1);
            float fb = peqK.at (ek + 2);
            int   ch = int (peqK.at (ek + 3));
            float rp = float (wp) - dl;
            float cl = fxTapN (cb, 4096, rp);
            float cr = fxTapN (cb + 4096, 4096, rp);
            float yl = l;
            float yr = r;

            if (ch != 2) yl = l + cg * cl;
            if (ch != 1) yr = r + cg * cr;

            fxArena.at (cb + wp)        = fb > 0.5f ? yl : l;
            fxArena.at (cb + 4096 + wp) = fb > 0.5f ? yr : r;
            wp += 1;
            if (wp >= 4096) wp = 0;
            fxI.at (s * 24 + b) = wp;
            l = yl;
            r = yr;
        }

        float og = fxD.at (s * 16);
        return float<2> (l * og, r * og);
    }

    event eqLoad (BankChunk c)
    {
        int b = clamp (c.bank, 0, 47);

        if (c.total <= 0)
        {
            for (int i = 0; i < 240; ++i)
                peqB.at (b * 240 + i) = 0.0f;
        }
        else
        {
            for (int i = 0; i < min (c.count, 256); ++i)
            {
                int pos = c.offset + i;

                if (pos >= 0 && pos < 240)
                    peqB.at (b * 240 + pos) = clamp (c.data.at (i), -2.0f, 2.0f);   // EQTYPES: the type is type / 16
            }
        }

        fxDirty.at (b) = true;
    }

    // Clears the delay lines and filter memories of one slot
    void fxResetSlot (int s)
    {
        int ab = fxAb (s);

        int al = s < 48 ? 196608 : 16384;

        for (int i = 0; i < al; ++i)
            fxArena.at (ab + i) = 0.0f;

        for (int i = 0; i < 40; ++i)
            fxF.at (s * 40 + i) = 0.0f;

        fxFcS.at (s) = 0.0f;   // FX-FENV2

        for (int i = 0; i < 8; ++i)   // FX-WET
            fxX.at (s * 8 + i) = 0.0f;

        for (int i = 0; i < 16; ++i)   // FX-EX
            fxW.at (s * 16 + i) = 0.0f;

        for (int i = 0; i < 1024; ++i)   // FX-CLOUDSEED
            csV.at (s * 1024 + i) = 0.0f;

        for (int i = 0; i < 256; ++i)   // FX-MUTABLE
            mgG.at (s * 256 + i) = 0.0f;

        for (int i = 0; i < 128; ++i)
            wpV.at (s * 128 + i) = 0.0f;

        for (int i = 0; i < 40; ++i)   // FX-AW
            awS.at (s * 40 + i) = 0.0;

        for (int i = 0; i < 48; ++i)   // FX-AW-MACK
            awT.at (s * 48 + i) = 0.0;

        awS.at (s * 40 + 8)  = -1.0;       // Console 7: gain chase starts at the target
        awS.at (s * 40 + 26) = 3.14159265358979;   // ToTape: sweep, rate, next maximum
        awS.at (s * 40 + 27) = 0.5;
        awS.at (s * 40 + 28) = 0.5;
        fxI.at (s * 24 + 21) = 0;

        for (int i = 0; i < 24; ++i)
            fxI.at (s * 24 + i) = 0;

        for (int i = 0; i < 4; ++i)
            fxPh.at (s * 4 + i) = 0.0;

        for (int i = 0; i < 256; ++i)       // FX-PEQ: filter memories of the equaliser sections
            peqZ.at (s * 256 + i) = 0.0f;
    }

    // FX-SLOTS: global slot numbers: 0..29 = slots 1-10 of the racks (rk * 10 + k), 30..47 = slots 11-16 (30 + rk * 6 + j)
    int fxAb (int s)            { return s < 48 ? s * 196608 : 9437184 + (s - 48) * 16384; }   // OSCFX3-DSP
    int fxRk (int s)            { return s < 30 ? s / 10 : (s - 30) / 6; }
    int fxG (int rk, int ls)    { return ls < 10 ? rk * 10 + ls : 30 + rk * 6 + (ls - 10); }

    // Selects the effect of a slot (its memory is cleared only when the type really changes)
    void fxSetType (int s, int t)
    {
        int nt = clamp (t, 0, 37);

        if (nt != fxType.at (s))
        {
            fxType.at (s) = nt;
            fxResetSlot (s);
        }

        fxDirty.at (s) = true;
        cvUpdateOwner (fxRk (s));
    }

    // Rebuilds the processing order from the 16 "FX Order" values of a rack (rack-local slot numbers 0..15); an order that is not a permutation
    // of the 16 slots (for example while the UI is still sending the values one by one) is ignored
    void fxRebuildSeq (int rk)
    {
        int[16] used;
        bool    valid = true;
        int     ob    = rk * 16;

        for (int k = 0; k < 16; ++k)
        {
            int s = clamp (fxOrder.at (ob + k), 0, 15);

            if (used.at (s) != 0)
                valid = false;

            used.at (s) = 1;
        }

        if (valid)
        {
            for (int k = 0; k < 16; ++k)
                fxSeq.at (ob + k) = clamp (fxOrder.at (ob + k), 0, 15);
        }
    }

    // RBJ biquad of one EQ band (kind 0 low shelf, 1 peaking bell, 2 high shelf), written to fxD[o .. o+4]
    void fxBiquad (int o, int kind, float gDb, float f, float q)
    {
        float cb0 = 1.0f;
        float cb1 = 0.0f;
        float cb2 = 0.0f;
        float ca1 = 0.0f;
        float ca2 = 0.0f;

        if (abs (gDb) > 0.01f)
        {
            float sr  = float (processor.frequency);
            float ff  = clamp (f, 20.0f, sr * 0.45f);
            float w0  = float (twoPi) * ff / sr;
            float cw  = float (cos (w0));
            float sw  = float (sin (w0));
            float aa  = float (pow (10.0f, gDb / 40.0f));
            float sqA = float (sqrt (aa));

            if (kind == 0)
            {
                float al = sw * 0.5f * 1.4142f;
                float a0 = (aa + 1.0f) + (aa - 1.0f) * cw + 2.0f * sqA * al;
                cb0 = (aa * ((aa + 1.0f) - (aa - 1.0f) * cw + 2.0f * sqA * al)) / a0;
                cb1 = (2.0f * aa * ((aa - 1.0f) - (aa + 1.0f) * cw)) / a0;
                cb2 = (aa * ((aa + 1.0f) - (aa - 1.0f) * cw - 2.0f * sqA * al)) / a0;
                ca1 = (-2.0f * ((aa - 1.0f) + (aa + 1.0f) * cw)) / a0;
                ca2 = ((aa + 1.0f) + (aa - 1.0f) * cw - 2.0f * sqA * al) / a0;
            }
            else if (kind == 2)
            {
                float al = sw * 0.5f * 1.4142f;
                float a0 = (aa + 1.0f) - (aa - 1.0f) * cw + 2.0f * sqA * al;
                cb0 = (aa * ((aa + 1.0f) + (aa - 1.0f) * cw + 2.0f * sqA * al)) / a0;
                cb1 = (-2.0f * aa * ((aa - 1.0f) + (aa + 1.0f) * cw)) / a0;
                cb2 = (aa * ((aa + 1.0f) + (aa - 1.0f) * cw - 2.0f * sqA * al)) / a0;
                ca1 = (2.0f * ((aa - 1.0f) - (aa + 1.0f) * cw)) / a0;
                ca2 = ((aa + 1.0f) - (aa - 1.0f) * cw - 2.0f * sqA * al) / a0;
            }
            else
            {
                float qq = max (q, 0.1f);
                float al = sw / (2.0f * qq);
                float a0 = 1.0f + al / aa;
                cb0 = (1.0f + al * aa) / a0;
                cb1 = (-2.0f * cw) / a0;
                cb2 = (1.0f - al * aa) / a0;
                ca1 = (-2.0f * cw) / a0;
                ca2 = (1.0f - al / aa) / a0;
            }
        }

        fxD.at (o)     = cb0;
        fxD.at (o + 1) = cb1;
        fxD.at (o + 2) = cb2;
        fxD.at (o + 3) = ca1;
        fxD.at (o + 4) = ca2;
    }

    // Turns the normalised slot parameters into the values the effect code needs (runs when a parameter changed)
    void fxDerive (int s)
    {
        int   ty = fxType.at (s);
        int   db = s * 16;
        int   pb = s * 6;
        float sr = float (processor.frequency);
        float dt = float (processor.period);
        float p1 = clamp (fxP.at (pb),     0.0f, 1.0f);
        float p2 = clamp (fxP.at (pb + 1), 0.0f, 1.0f);
        float p3 = clamp (fxP.at (pb + 2), 0.0f, 1.0f);
        float p4 = clamp (fxP.at (pb + 3), 0.0f, 1.0f);
        float p5 = clamp (fxP.at (pb + 4), 0.0f, 1.0f);

        if (ty == 1)
        {
            // distortion: drive, tone low-pass coefficient, output gain
            fxD.at (db)     = p1;
            fxD.at (db + 1) = clamp (float (twoPi) * fxExpMap (p2, 500.0f, 20000.0f) * dt, 0.0f, 1.0f);
            fxD.at (db + 2) = p3 * 2.0f;
            fxD.at (db + 3) = (clamp (fxP.at (pb + 3), 0.0f, 1.0f) - 0.5f) * 1.2f;                                   // bias
            fxD.at (db + 4) = clamp (float (twoPi) * fxExpMap (p5, 10.0f, 800.0f) * dt, 0.0f, 1.0f);                // low cut
            fxD.at (db + 5) = clamp (fxP.at (pb + 5), 0.0f, 1.0f) * 1.5f;                                            // presence
        }
        else if (ty == 2)
        {
            // bit crush: bits, hold length, quantiser steps
            fxD.at (db)     = 16.0f - 12.0f * p1;
            fxD.at (db + 1) = 1.0f + rint (p2 * 31.0f);
            fxD.at (db + 2) = float (pow (2.0f, fxD.at (db) - 1.0f));
            fxD.at (db + 3) = p3;      // dither
            fxD.at (db + 4) = p4;      // jitter
        }
        else if (ty == 3)
        {
            // delay: time (samples), feedback, damping coefficient, ping-pong
            fxD.at (db)     = clamp (fxExpMap (p1, 10.0f, 1000.0f) * 0.001f * sr, 2.0f, 98000.0f);
            fxD.at (db + 1) = 0.95f * p2;

            float dh = fxExpMap (p3, 500.0f, 18000.0f);
            if (fxMode.at (s) == 1)
                dh = min (dh, 6500.0f);

            fxD.at (db + 2) = clamp (float (twoPi) * dh * dt, 0.0f, 1.0f);
            fxD.at (db + 3) = p4;
            fxD.at (db + 4) = p5 * 0.004f * sr;                                                           // time modulation (samples)
            fxD.at (db + 5) = clamp (float (twoPi) * fxExpMap (clamp (fxP.at (pb + 5), 0.0f, 1.0f), 20.0f, 1000.0f) * dt, 0.0f, 1.0f);   // feedback low cut
        }
        else if (ty == 4)
        {
            fxD.at (db)     = fxExpMap (p1, 0.05f, 5.0f);
            fxD.at (db + 1) = p2;
            fxD.at (db + 2) = 0.9f * p3;
            fxD.at (db + 6) = p4 * 2.0f;      // width of the wet signal
        }
        else if (ty == 5)
        {
            fxD.at (db)     = fxExpMap (p1, 0.05f, 5.0f);
            fxD.at (db + 1) = p2;
            fxD.at (db + 2) = (fxMode.at (s) == 1 ? -0.95f : 0.95f) * p3;     // mode 1: negative feedback
            fxD.at (db + 6) = p4 * 2.0f;
        }
        else if (ty == 6)
        {
            fxD.at (db)     = fxExpMap (p1, 0.05f, 8.0f);
            fxD.at (db + 1) = p2;
            fxD.at (db + 2) = 0.9f * p3;
            fxD.at (db + 6) = p4 * 2.0f;
        }
        else if (ty == 7)
        {
            fxD.at (db)     = fxExpMap (p1, 0.1f, 20.0f);
            fxD.at (db + 1) = p2;
            fxD.at (db + 2) = p3;
            fxD.at (db + 3) = clamp (p4 * 24.0f, 0.0f, 23.99f);                                     // gate pattern
            fxD.at (db + 4) = clamp (1.0f - float (exp (-dt / fxExpMap (p5, 0.0003f, 0.04f))), 0.0f, 1.0f);   // gate / random smoothing
            fxD.at (db + 5) = clamp (fxP.at (pb + 5), 0.0f, 1.0f) * 0.5f;                           // swing
        }
        else if (ty == 8)
        {
            // reverb: engine and tuning per mode, pre-delay (samples), width, wet tone filters;  FX-REV
            int   md    = fxMode.at (s);
            int   ab    = fxAb (s);
            float dsc   = 0.85f;      // delay length scale of the FDN
            float rtLo  = 0.6f;       // RT60 range (s) over the Size knob
            float rtHi  = 8.0f;
            float lowM  = 1.3f;       // low-frequency RT60 multiplier
            float dampM = 1.0f;
            float algo  = 0.0f;

            if (md == 1) { dsc = 0.35f; rtLo = 0.15f; rtHi = 1.3f;  lowM = 1.0f; }                  // room
            if (md == 2) { algo = 1.0f; }                                                            // plate (Dattorro)
            if (md == 3) { dsc = 1.0f;  rtLo = 2.0f;  rtHi = 16.0f; lowM = 1.5f; }                  // cathedral
            if (md == 4) { dsc = 0.55f; rtLo = 0.3f;  rtHi = 2.5f;  lowM = 1.1f; }                  // chamber
            if (md == 5) { algo = 1.0f; }                                                            // ambience (small plate)
            if (md == 6) { dsc = 0.9f;  dampM = 0.3f; lowM = 1.5f; }                                // dark hall
            if (md == 7) { dsc = 0.9f;  dampM = 3.0f; lowM = 0.9f; }                                // bright hall
            if (md == 8) { dsc = 1.0f;  rtLo = 1000.0f; rtHi = 1000.0f; lowM = 1.0f; }              // infinite

            float dampHz = clamp ((1500.0f + 22500.0f * (1.0f - p2) * (1.0f - p2)) * dampM, 800.0f, 24000.0f);

            fxD.at (db)     = 0.0f;
            fxD.at (db + 2) = clamp (p3 * 0.1f * sr, 0.0f, 8000.0f);
            fxD.at (db + 3) = p4;
            fxD.at (db + 4) = algo;
            fxD.at (db + 6) = clamp (float (twoPi) * fxExpMap (p5, 20.0f, 800.0f) * dt, 0.0f, 1.0f);       // wet low cut
            fxD.at (db + 7) = clamp (float (twoPi) * fxExpMap (clamp (fxP.at (pb + 5), 0.0f, 1.0f), 1500.0f, 20000.0f) * dt, 0.0f, 1.0f);   // wet high cut

            if (algo < 0.5f)
            {
                float rtMid = rtLo * float (pow (rtHi / rtLo, p1));
                float rtLow = rtMid * lowM;
                float wlo   = 6.2832f * 200.0f / sr;
                float chi   = 2.0f;
                if (dampHz <= 0.49f * sr) chi = 1.0f - float (cos (6.2832f * dampHz / sr));

                for (int i = 0; i < 8; ++i)
                {
                    float del = zitaD2.at (i) * dsc;
                    float gmf = float (pow (0.001f, del / rtMid));
                    float glo = float (pow (0.001f, del / rtLow)) / gmf - 1.0f;
                    float g   = float (pow (0.001f, del / (0.5f * rtMid))) / gmf;
                    float t   = (1.0f - g * g) / (2.0f * g * g * chi);
                    float whi = (sqrt (1.0f + 4.0f * t) - 1.0f) / (2.0f * t);
                    int   k1  = clamp (int (floor (zitaD1.at (i) * sr * dsc + 0.5f)), 1, 4095);
                    int   k2  = clamp (int (floor (zitaD2.at (i) * sr * dsc + 0.5f)), k1 + 1, 16383 + k1);

                    fxArena.at (ab + 180224 + i * 4) = gmf;
                    fxArena.at (ab + 180225 + i * 4) = glo;
                    fxArena.at (ab + 180226 + i * 4) = wlo;
                    fxArena.at (ab + 180227 + i * 4) = whi;
                    fxArena.at (ab + 180256 + i)     = float (k1);
                    fxArena.at (ab + 180264 + i)     = float (k2 - k1);
                }

                fxArena.at (ab + 180272) = clamp (1.0f / sqrt (rtMid), 0.22f, 1.0f);
                fxD.at (db + 5) = 1.0f;
            }
            else
            {
                float rs2 = sr / 29761.0f;
                float lsc = 0.7f + 0.6f * p1;
                float dec = 0.5f + 0.45f * p1;

                if (md == 5) { lsc = 0.3f + 0.4f * p1; dec = 0.15f + 0.5f * p1; }

                fxD.at (db + 8) = dec;
                fxD.at (db + 9) = clamp (0.9f - 0.9f * clamp (dampHz / 24000.0f, 0.0f, 1.0f) + 0.04f, 0.02f, 0.95f);
                fxD.at (db + 5) = 0.6f;

                for (int k = 0; k < 26; ++k)
                {
                    float scl = rs2;
                    if (k >= 4) scl = rs2 * lsc;
                    fxArena.at (ab + 180288 + k) = float (clamp (int (float (datLen.at (k)) * scl + 0.5f), 1, 16380));
                }

                for (int k = 0; k < 4; ++k)
                    fxArena.at (ab + 180288 + k) = float (clamp (int (float (datLen.at (k)) * rs2 + 0.5f), 1, 2040));

                fxArena.at (ab + 180292) = clamp (fxArena.at (ab + 180292), 24.0f, 16000.0f);
                fxArena.at (ab + 180296) = clamp (fxArena.at (ab + 180296), 24.0f, 16000.0f);
                fxArena.at (ab + 180318) = clamp (8.0f * rs2 * lsc, 1.0f, 20.0f);
            }
        }
        else if (ty == 9)
        {
            // filter: coefficients shared by all 30 types, input drive
            float fc = clamp (fxExpMap (p1, 20.0f, 20000.0f), 20.0f, sr * 0.45f);
            fxD.at (db)     = float (tan (float64 (fc) * pi * processor.period));
            fxD.at (db + 1) = 2.0f - 1.96f * p2;
            fxD.at (db + 2) = p2;
            fxD.at (db + 3) = fc;
            fxD.at (db + 4) = 1.0f + 8.0f * p3;

            // FX-FENV2: envelope amount (+-1 = +-7 octaves), the modulation envelope that supplies the times (0..9), key tracking amount
            fxD.at (db + 5) = (p4 - 0.5f) * 2.0f;
            fxD.at (db + 6) = float (clamp (int (p5 * 9.0f + 0.5f), 0, 9));
            fxD.at (db + 7) = clamp (fxP.at (pb + 5), 0.0f, 1.0f);
        }
        else if (ty == 34)
        {
            // FX-SHTAB: drive gain, table position, table bank (shaper table of oscillator 1..6 = bank 6..11), bias, tone low-pass coefficient, level
            fxD.at (db)     = float (pow (10.0f, p1 * 36.0f / 20.0f));
            fxD.at (db + 1) = p2;
            fxD.at (db + 2) = float (6 + clamp (int (p3 * 5.0f + 0.5f), 0, 5));
            fxD.at (db + 3) = (p4 - 0.5f);
            fxD.at (db + 4) = clamp (float (twoPi) * fxExpMap (p5, 500.0f, 20000.0f) * dt, 0.0f, 1.0f);
            fxD.at (db + 5) = float (pow (10.0f, (clamp (fxP.at (pb + 5), 0.0f, 1.0f) * 36.0f - 24.0f) / 20.0f));
        }
        else if (ty == 10)
        {
            // EQ: low shelf 100 Hz, mid bell, high shelf 8 kHz; mode 1 tilt (Low = tilt amount, Mid Freq = pivot), 2 loudness contour (Low = amount), 3 presence (wider ranges)
            int em = fxMode.at (s);
            float hiF = fxExpMap (clamp (fxP.at (pb + 5), 0.0f, 1.0f), 4000.0f, 16000.0f);

            if (em == 1)
            {
                float tl = (p1 - 0.5f) * 24.0f;
                float pv = fxExpMap (p3, 200.0f, 5000.0f);
                fxBiquad (db,      0, -tl * 0.5f, pv * 0.6f, 0.6f);
                fxBiquad (db + 5,  1, (p2 - 0.5f) * 24.0f, pv, fxExpMap (p5, 0.3f, 4.0f));
                fxBiquad (db + 10, 2, tl * 0.5f, pv * 1.6f, 0.6f);
            }
            else if (em == 2)
            {
                float am = p1 * 14.0f;
                fxBiquad (db,      0, am, 90.0f, 0.7f);
                fxBiquad (db + 5,  1, (p2 - 0.5f) * 24.0f - am * 0.25f, fxExpMap (p3, 200.0f, 5000.0f), fxExpMap (p5, 0.3f, 4.0f));
                fxBiquad (db + 10, 2, am * 0.7f + (p4 - 0.5f) * 24.0f, hiF, 0.7f);
            }
            else if (em == 3)
            {
                fxBiquad (db,      0, (p1 - 0.5f) * 24.0f, 160.0f, 0.7f);
                fxBiquad (db + 5,  1, (p2 - 0.5f) * 24.0f, fxExpMap (p3, 900.0f, 7000.0f), fxExpMap (p5, 0.5f, 6.0f));
                fxBiquad (db + 10, 2, (p4 - 0.5f) * 24.0f, fxExpMap (clamp (fxP.at (pb + 5), 0.0f, 1.0f), 8000.0f, 18000.0f), 0.6f);
            }
            else
            {
                fxBiquad (db,      0, (p1 - 0.5f) * 24.0f, 100.0f, 0.7f);
                fxBiquad (db + 5,  1, (p2 - 0.5f) * 24.0f, fxExpMap (p3, 200.0f, 5000.0f), fxExpMap (p5, 0.3f, 4.0f));
                fxBiquad (db + 10, 2, (p4 - 0.5f) * 24.0f, hiF, 0.7f);
            }
        }
        else if (ty == 12)
        {
            // convolution reverb: size, decay, damp (rebuild the IR when they or the mode change), pre-delay, width, tone filters
            fxD.at (db)     = p1;
            fxD.at (db + 1) = p2;
            fxD.at (db + 2) = p3;
            fxD.at (db + 3) = float (int (p4 * 0.2f * sr));
            fxD.at (db + 4) = p5 * 2.0f;

            float p6  = clamp (fxP.at (pb + 5), 0.0f, 1.0f);
            float lpf = p6 < 0.5f ? fxExpMap (p6 * 2.0f, 800.0f, 20000.0f) : 20000.0f;
            float hpf = p6 > 0.5f ? fxExpMap ((p6 - 0.5f) * 2.0f, 20.0f, 2000.0f) : 20.0f;
            fxD.at (db + 5) = clamp (1.0f - float (exp (-float (twoPi) * lpf * dt)), 0.0f, 1.0f);
            fxD.at (db + 6) = clamp (1.0f - float (exp (-float (twoPi) * hpf * dt)), 0.0f, 1.0f);

            int rk = fxRk (s);

            if (cvOwner.at (rk) == s)
            {
                int ee = rk * 32;
                int md = clamp (fxMode.at (s), 0, 8);

                if (cvF.at (ee + 14) != p1 || cvF.at (ee + 15) != p2 || cvF.at (ee + 16) != p3 || cvI.at (ee + 13) != md || cvF.at (ee + 17) < 0.0f)
                {
                    cvF.at (ee + 14) = p1;
                    cvF.at (ee + 15) = p2;
                    cvF.at (ee + 16) = p3;
                    cvF.at (ee + 17) = 0.0f;
                    cvI.at (ee + 13) = md;
                    cvI.at (ee + 9)  = int (0.15f * sr);
                }
            }
        }
        else if (ty == 11)
        {
            // compressor: threshold (linear), gain-curve exponent, attack / release coefficients, make-up gain
            float ratio = 1.0f + 19.0f * p2 * p2;
            fxD.at (db)     = float (pow (10.0f, (-60.0f + 60.0f * p1) / 20.0f));
            fxD.at (db + 1) = 1.0f / ratio - 1.0f;
            fxD.at (db + 2) = float (exp (-1.0f / (sr * 0.001f * fxExpMap (p3, 0.1f, 100.0f))));
            fxD.at (db + 3) = float (exp (-1.0f / (sr * 0.001f * fxExpMap (p4, 10.0f, 1000.0f))));
            fxD.at (db + 4) = float (pow (10.0f, 24.0f * p5 / 20.0f));
            fxD.at (db + 5) = 12.0f * clamp (fxP.at (pb + 5), 0.0f, 1.0f);                       // knee width (dB)

            if (fxMode.at (s) == 2)
            {
                // limiter: ratio about 20:1, attack about 0.1 ms
                fxD.at (db + 1) = -0.95f;
                fxD.at (db + 2) = float (exp (-1.0f / (sr * 0.0001f)));
            }
        }

        if (ty == 13)
            fxPeqDerive (s);

        if (ty == 14)
            fxSatDerive (s);   // FX-SAT

        if (ty == 15)
            fxWsDerive (s);

        if (ty == 28)
            fxPlDerive (s);   // FX-PLASMA

        if (ty == 29)
            fxMgDerive (s);   // FX-MUTABLE

        if (ty == 31)
            fxCsDerive (s);   // FX-CLOUDSEED

        if (ty == 32)
            fxWgDerive (s);   // FX-WAVEGUIDE

        if (ty == 33 && s < 48)
            fxYbDerive (s);   // FX-YAYBAHAR

        if (ty >= 35 && ty <= 37 && s < 48)
            fxYbpDerive (s, ty);   // FX-YBPARTS

        if (ty == 30)
            fxWpDerive (s);

        if (ty == 18)
            fxFbDerive (s);   // FX-FBANK

        if (ty >= 19 && ty <= 27)
            awDerive (s);   // FX-AW

        if (ty == 17)
            fxConDerive (s);   // FX-CONSOLE

        if (ty == 16)
            fxUniDerive (s);   // FX-UNI

        // FX-SYNC: the delay time follows the tempo division of the slot
        if (ty == 3 && fxSync.at (s) > 0)
        {
            float bpmN = syncBpmOver > 1.0f ? syncBpmOver : hostBpm;
            fxD.at (db) = clamp (divBeats.at (clamp (fxSync.at (s) - 1, 0, 17)) * 60.0f / bpmN * sr, 2.0f, 98000.0f);
        }
    }

    // ---------------- convolution reverb engine (tools/fx/build_fx.py) ----------------
    // Uniform partitioned convolution (overlap-save): block 1024, FFT 2048, up to 72 partitions (1.5 s at 48 kHz). One engine per rack (the lowest
    // convolution slot of a rack owns it). The impulse response (built-in generator or a loaded file) is rendered in slices over many samples, turned
    // into partition spectra in the background (double buffered) and swapped in when ready. Partitions 1.. are accumulated one bin per sample during the
    // block, so only partition 0, one forward and one inverse FFT run in the burst at the block end. Output latency: one block (1024 samples).
    // Per engine e: cvI[e * 32 + ...] ints, cvF[e * 32 + ...] floats.
    //   cvI: 0 position in the block, 1 FDL head, 2 active H buffer, 3 active partitions, 4 job (0 idle, 1 generating, 2 transforming), 5 gen position, 6 IR length,
    //        7 partition being transformed, 8 FFT progress (-1 = fill next), 9 rebuild countdown, 10 partitions of the IR being built, 11 / 12 noise states,
    //        13 mode, 14 buffer being built, 15 IR available, 16 reverse flag, 17 user IR length, 18 ER taps added
    //   cvF: 0 scale, 1 T60, 2 damp, 3 / 4 low-pass states, 5 energy, 6 density build time, 7 initial density, 8 ER level, 9 length (s), 10 tilt state L, 11 R,
    //        12 hp state L, 13 R, 14 last size, 15 decay, 16 damp, 17 mode (change detection)
    const int cvP = 72;
    float[8192]    cvRe;           // FFT scratch: region 0 = audio path, 1..3 = IR preparation of engine 0..2
    float[8192]    cvIm;
    float[1024]    cvCos;
    float[1024]    cvSin;
    int[2048]      cvRev;
    float[2097152] cvH;            // spectra of the IR partitions: ((e * 2 + buf) * 72 + p) * 4100 + ch * 2050 + k * 2 (+ 1 imaginary)
    float[1048576] cvX;            // input spectra history (frequency delay line): (e * 72 + slot) * 4100 + ch * 2050 + k * 2
    float[16384]   cvS;            // accumulated spectrum of the partitions 1.. of the block being played: e * 4100 + ch * 2050 + k * 2
    float[8192]    cvInL;          // e * 2048: previous block, current block
    float[8192]    cvInR;
    float[4096]    cvOutL;         // e * 1024: result of the previous block
    float[4096]    cvOutR;
    float[262144]  cvIrL;          // e * 73728: the impulse response being transformed
    float[262144]  cvIrR;
    float[524288]  cvUser;         // e * 96000: loaded impulse response (mono)
    int[128]       cvI;
    float[128]     cvF;
    int[4]         cvOwner;        // slot (0..47) that owns the engine of rack e, or -1

    void cvInit()
    {
        for (int i = 0; i < 1024; ++i)
        {
            cvCos.at (i) = float (cos (twoPi * float64 (i) / 2048.0));
            cvSin.at (i) = float (sin (twoPi * float64 (i) / 2048.0));
        }

        for (int i = 0; i < 2048; ++i)
        {
            int r = 0;
            int v = i;

            for (int b = 0; b < 11; ++b)
            {
                r = (r << 1) | (v & 1);
                v = v >> 1;
            }

            cvRev.at (i) = r;
        }

        for (int e = 0; e < 3; ++e)
        {
            cvOwner.at (e) = -1;
            cvI.at (e * 32 + 11) = 12345 + e * 7919;
            cvI.at (e * 32 + 12) = 54321 + e * 104729;
            cvI.at (e * 32 + 3)  = 1;
        }

        cvOwner.at (3) = -1;
    }

    // butterflies from .. from + count - 1 of the 11264 of a 2048-point FFT in the scratch region at base (input already bit reversed); sgn -1 forward, +1 inverse
    void cvFft (int base, int from, int count, float sgn)
    {
        int end = from + count;

        for (int c = from; c < end; ++c)
        {
            int   s  = c >> 10;
            int   id = c & 1023;
            int   h  = 1 << s;
            int   j  = id & (h - 1);
            int   i0 = base + ((id >> s) << (s + 1)) + j;
            int   i1 = i0 + h;
            int   ti = j << (10 - s);
            float wr = cvCos.at (ti);
            float wi = sgn * cvSin.at (ti);
            float xr = cvRe.at (i1);
            float xi = cvIm.at (i1);
            float tr = xr * wr - xi * wi;
            float ti2 = xr * wi + xi * wr;
            float ar = cvRe.at (i0);
            float ai = cvIm.at (i0);
            cvRe.at (i1) = ar - tr;
            cvIm.at (i1) = ai - ti2;
            cvRe.at (i0) = ar + tr;
            cvIm.at (i0) = ai + ti2;
        }
    }

    // splits the FFT of z = left + j * right (region at base, natural order) into the two spectra (bins 0..1024) at dst (+ 0 left, + 2050 right)
    void cvUnpack (int base, bool toH, int dstIdx)
    {
        for (int k = 0; k <= 1024; ++k)
        {
            int   m   = (2048 - k) & 2047;
            float zr  = cvRe.at (base + k);
            float zi  = cvIm.at (base + k);
            float nr  = cvRe.at (base + m);
            float ni  = cvIm.at (base + m);
            int   o   = dstIdx + k * 2;

            if (toH)
            {
                cvH.at (o)            = (zr + nr) * 0.5f;
                cvH.at (o + 1)        = (zi - ni) * 0.5f;
                cvH.at (o + 2050)     = (zi + ni) * 0.5f;
                cvH.at (o + 2051)     = -(zr - nr) * 0.5f;
            }
            else
            {
                cvX.at (o)            = (zr + nr) * 0.5f;
                cvX.at (o + 1)        = (zi - ni) * 0.5f;
                cvX.at (o + 2050)     = (zi + ni) * 0.5f;
                cvX.at (o + 2051)     = -(zr - nr) * 0.5f;
            }
        }
    }

    float cvNoise (int e, int ch)
    {
        int k = e * 32 + 11 + ch;
        int s = (cvI.at (k) * 1103515245 + 12345) & 0x7fffffff;
        cvI.at (k) = s;
        return float (s) / 1073741824.0f - 1.0f;
    }

    // Starts a rebuild of the impulse response of engine e from the parameters of its owner slot
    void cvStartJob (int e)
    {
        int   ii   = e * 32;
        int   ff   = e * 32;
        float sr   = float (processor.frequency);
        int   mode = cvI.at (ii + 13);
        float size = cvF.at (ff + 14);
        float dec  = cvF.at (ff + 15);
        float t60  = 0.3f;
        float len  = 0.5f;
        float tb   = 0.03f;
        float d0   = 0.2f;
        float er   = 0.0f;
        float dmp  = cvF.at (ff + 16);

        if (mode == 0)      { t60 = 0.15f + 0.85f * size; tb = 0.02f; d0 = 0.15f; er = 0.5f;  dmp = dmp * 0.9f + 0.15f; }
        else if (mode == 1) { t60 = 0.5f + 1.3f * size;   tb = 0.08f; d0 = 0.05f; er = 0.25f; }
        else if (mode == 2) { t60 = 0.4f + 1.3f * size;   tb = 0.004f; d0 = 0.9f; er = 0.0f;  dmp = dmp * 0.5f; }
        else if (mode == 3) { t60 = 1.2f + 1.5f * size;   tb = 0.15f; d0 = 0.03f; er = 0.15f; dmp = dmp * 0.8f + 0.25f; }
        else if (mode == 4) { t60 = 0.3f + 0.9f * size;   tb = 0.03f; d0 = 0.12f; er = 0.4f; }
        else if (mode == 5) { t60 = 0.4f + 1.1f * size;   tb = 0.004f; d0 = 0.9f; er = 0.0f; }
        else if (mode == 6) { t60 = 0.2f + 0.5f * size;   tb = 0.004f; d0 = 0.9f; er = 0.0f; }
        else if (mode == 7) { t60 = 0.08f + 0.25f * size; tb = 0.006f; d0 = 0.3f; er = 0.7f; }
        else                { t60 = 0.2f + 1.5f * size;   tb = 0.001f; d0 = 1.0f; er = 0.0f; }

        // the decay control trades length against tail: low = shorter
        t60 = t60 * (0.35f + 1.3f * dec);

        len = clamp (t60 * 1.15f + 0.04f, 0.05f, 1.5f);

        if (mode == 6)
            len = clamp (t60 * 0.8f, 0.05f, 1.5f);

        int ls = clamp (int (len * sr), 512, cvP * 1024 - 1024);

        if (mode == 8)
        {
            int ul = cvI.at (ii + 17);
            ls = clamp (int (float (ul) * (0.1f + 0.9f * size)), 0, cvP * 1024 - 1024);
        }

        cvI.at (ii + 6)  = ls;
        cvI.at (ii + 5)  = 0;
        cvI.at (ii + 4)  = 1;
        cvI.at (ii + 16) = mode == 5 ? 1 : 0;
        cvI.at (ii + 18) = 0;
        cvF.at (ff + 1)  = t60;
        cvF.at (ff + 2)  = clamp (dmp, 0.0f, 1.0f);
        cvF.at (ff + 3)  = 0.0f;
        cvF.at (ff + 4)  = 0.0f;
        cvF.at (ff + 5)  = 0.0f;
        cvF.at (ff + 6)  = tb;
        cvF.at (ff + 7)  = d0;
        cvF.at (ff + 8)  = er;
        cvF.at (ff + 9)  = len;
        cvI.at (ii + 11) = 12345 + e * 7919;
        cvI.at (ii + 12) = 54321 + e * 104729;
    }

    // generates count samples of the impulse response; at the end the early reflections are added and the scale computed
    void cvGenSlice (int e, int count)
    {
        int   ii   = e * 32;
        int   ff   = e * 32;
        float sr   = float (processor.frequency);
        int   mode = cvI.at (ii + 13);
        int   i0   = cvI.at (ii + 5);
        int   len  = cvI.at (ii + 6);
        int   end  = min (i0 + count, len);
        float t60  = cvF.at (ff + 1);
        float dmp  = cvF.at (ff + 2);
        float tb   = cvF.at (ff + 6);
        float d0   = cvF.at (ff + 7);
        float lpL  = cvF.at (ff + 3);
        float lpR  = cvF.at (ff + 4);
        float en   = cvF.at (ff + 5);
        int   ob   = e * 73728;
        int   ub   = e * 96000;
        float fc0  = 16000.0f * (1.0f - 0.7f * dmp);
        float dec  = -6.9078f / (max (t60, 0.02f) * sr);

        for (int i = i0; i < end; ++i)
        {
            float t   = float (i) / sr;
            float env = float (exp (dec * float (i)));

            if (mode == 6)
                env = i < len - int (0.02f * sr) ? 1.0f : max (0.0f, float (len - i) / (0.02f * sr));
            else if (mode == 8)
                env = float (exp (dec * 0.5f * float (i)));

            float dn  = clamp (d0 + (1.0f - d0) * t / max (tb, 0.0005f), 0.02f, 1.0f);
            float nl  = 0.0f;
            float nr  = 0.0f;

            if (mode == 8)
            {
                int ui = ub + i;
                nl = cvUser.at (ui);
                nr = nl;
            }
            else
            {
                float ra = cvNoise (e, 0);
                float rb = cvNoise (e, 1);
                float pa = cvNoise (e, 0) * 0.5f + 0.5f;
                float pb = cvNoise (e, 1) * 0.5f + 0.5f;
                float is = 1.0f / float (sqrt (dn));
                nl = pa < dn ? ra * is : 0.0f;
                nr = pb < dn ? rb * is : 0.0f;
            }

            // darker as the tail goes on: the cut-off falls with t / T60
            float fc = max (300.0f, fc0 * float (exp (-dmp * 4.0f * t / max (t60, 0.05f))));
            float a  = 1.0f - float (exp (-twoPi * fc / sr));
            lpL += a * (nl * env - lpL);
            lpR += a * (nr * env - lpR);
            cvIrL.at (ob + i) = lpL;
            cvIrR.at (ob + i) = lpR;
            en += lpL * lpL + lpR * lpR;
        }

        cvF.at (ff + 3) = lpL;
        cvF.at (ff + 4) = lpR;
        cvF.at (ff + 5) = en;
        cvI.at (ii + 5) = end;

        if (end >= len)
        {
            // early reflections: a deterministic set of taps in the first 80 ms
            float er = cvF.at (ff + 8);

            if (er > 0.0f && mode != 8)
            {
                for (int r = 0; r < 14; ++r)
                {
                    float fr = float (r) * 0.618034f;
                    fr = fr - float (floor (fr));
                    int   p  = clamp (int ((0.004f + 0.075f * fr) * sr), 1, len - 1);
                    float g  = er * 0.35f / (1.0f + float (r) * 0.35f);
                    cvIrL.at (ob + p) = cvIrL.at (ob + p) + g * ((r & 1) == 1 ? -1.0f : 1.0f);
                    int   q  = clamp (p + 37 + r * 11, 1, len - 1);
                    cvIrR.at (ob + q) = cvIrR.at (ob + q) + g * ((r & 1) == 1 ? 1.0f : -1.0f);
                    en += 2.0f * g * g;
                }
            }

            float avg = max (en * 0.5f, 1.0e-9f);
            cvF.at (ff) = float (sqrt (0.35f / avg));
            cvI.at (ii + 10) = clamp ((len + 1023) / 1024, 1, cvP);
            cvI.at (ii + 14) = 1 - cvI.at (ii + 2);
            cvI.at (ii + 7)  = 0;
            cvI.at (ii + 8)  = -1;
            cvI.at (ii + 4)  = 2;
        }
    }

    // transforms partitions of the finished impulse response: budget butterflies of work
    void cvPrepSlice (int e, int budget)
    {
        int ii  = e * 32;
        int ff  = e * 32;
        int sb  = (1 + e) * 2048;
        int len = cvI.at (ii + 6);
        int ob  = e * 73728;
        int p   = cvI.at (ii + 7);
        int c   = cvI.at (ii + 8);

        while (budget > 0 && cvI.at (ii + 4) == 2)
        {
            if (c < 0)
            {
                float sc   = cvF.at (ff);
                bool  rev  = cvI.at (ii + 16) == 1;
                float fade = 0.03f * float (processor.frequency);

                for (int i = 0; i < 1024; ++i)
                {
                    int   j  = p * 1024 + i;
                    float l  = 0.0f;
                    float r  = 0.0f;

                    if (j < len)
                    {
                        int   jj = rev ? len - 1 - j : j;
                        float w  = min (1.0f, float (len - j) / fade) * sc;
                        l = cvIrL.at (ob + jj) * w;
                        r = cvIrR.at (ob + jj) * w;
                    }

                    int ri = sb + cvRev.at (i);
                    cvRe.at (ri) = l;
                    cvIm.at (ri) = r;
                }

                for (int i = 1024; i < 2048; ++i)
                {
                    int ri = sb + cvRev.at (i);
                    cvRe.at (ri) = 0.0f;
                    cvIm.at (ri) = 0.0f;
                }

                c = 0;
                budget -= 600;
            }
            else
            {
                int n = min (budget, 11264 - c);
                cvFft (sb, c, n, -1.0f);
                c += n;
                budget -= n;

                if (c >= 11264)
                {
                    int dst = ((e * 2 + cvI.at (ii + 14)) * cvP + p) * 4100;
                    cvUnpack (sb, true, dst);
                    p += 1;
                    c = -1;
                    budget -= 1000;

                    if (p >= cvI.at (ii + 10))
                    {
                        cvI.at (ii + 2)  = cvI.at (ii + 14);
                        cvI.at (ii + 3)  = cvI.at (ii + 10);
                        cvI.at (ii + 15) = 1;
                        cvI.at (ii + 4)  = 0;
                    }
                }
            }
        }

        cvI.at (ii + 7) = p;
        cvI.at (ii + 8) = c;
    }

    // One stereo sample through engine e (the wet convolution signal)
    float<2> cvProcess (int e, float<2> x)
    {
        int ii = e * 32;

        // rebuild countdown and background jobs
        int pend = cvI.at (ii + 9);

        if (pend > 0)
        {
            pend -= 1;
            cvI.at (ii + 9) = pend;

            if (pend == 0)
                cvStartJob (e);
        }

        int job = cvI.at (ii + 4);

        if (job == 1)
            cvGenSlice (e, 384);
        else if (job == 2)
            cvPrepSlice (e, 260);

        if (cvI.at (ii + 15) == 0)
            return float<2> (0.0f, 0.0f);

        int t    = cvI.at (ii);
        int hd   = cvI.at (ii + 1);
        int pact = cvI.at (ii + 3);
        int hb   = cvI.at (ii + 2);
        int ib   = e * 2048;

        cvInL.at (ib + 1024 + t) = x[0];
        cvInR.at (ib + 1024 + t) = x[1];
        float<2> y = float<2> (cvOutL.at (e * 1024 + t), cvOutR.at (e * 1024 + t));

        // bins t (and 1024 at the start of the block) of the partitions 1..: S += H_p * X_(n - p)
        int nb = t == 0 ? 2 : 1;

        for (int q = 0; q < nb; ++q)
        {
            int k  = q == 0 ? t : 1024;
            int ko = k * 2;
            float sLr = 0.0f;
            float sLi = 0.0f;
            float sRr = 0.0f;
            float sRi = 0.0f;

            for (int p = 1; p < pact; ++p)
            {
                int sl = hd - p;
                if (sl < 0) sl += cvP;
                int xo = (e * cvP + sl) * 4100 + ko;
                int ho = ((e * 2 + hb) * cvP + p) * 4100 + ko;
                float xr = cvX.at (xo);
                float xi = cvX.at (xo + 1);
                float hr = cvH.at (ho);
                float hi = cvH.at (ho + 1);
                sLr += xr * hr - xi * hi;
                sLi += xr * hi + xi * hr;
                xr = cvX.at (xo + 2050);
                xi = cvX.at (xo + 2051);
                hr = cvH.at (ho + 2050);
                hi = cvH.at (ho + 2051);
                sRr += xr * hr - xi * hi;
                sRi += xr * hi + xi * hr;
            }

            int so = e * 4100 + ko;
            cvS.at (so)        = sLr;
            cvS.at (so + 1)    = sLi;
            cvS.at (so + 2050) = sRr;
            cvS.at (so + 2051) = sRi;
        }

        t += 1;

        if (t >= 1024)
        {
            t = 0;

            // forward FFT of [previous block | current block] (left real, right imaginary)
            for (int i = 0; i < 2048; ++i)
            {
                int ri = cvRev.at (i);
                cvRe.at (ri) = cvInL.at (ib + i);
                cvIm.at (ri) = cvInR.at (ib + i);
            }

            cvFft (0, 0, 11264, -1.0f);
            int xdst = (e * cvP + hd) * 4100;
            cvUnpack (0, false, xdst);

            // Y = S + H_0 * X_n, packed for one inverse FFT
            int h0 = ((e * 2 + hb) * cvP) * 4100;

            for (int k = 0; k <= 1024; ++k)
            {
                int   ko = k * 2;
                float xLr = cvX.at (xdst + ko);
                float xLi = cvX.at (xdst + ko + 1);
                float xRr = cvX.at (xdst + ko + 2050);
                float xRi = cvX.at (xdst + ko + 2051);
                float hLr = cvH.at (h0 + ko);
                float hLi = cvH.at (h0 + ko + 1);
                float hRr = cvH.at (h0 + ko + 2050);
                float hRi = cvH.at (h0 + ko + 2051);
                int   so  = e * 4100 + ko;
                float yLr = cvS.at (so)        + xLr * hLr - xLi * hLi;
                float yLi = cvS.at (so + 1)    + xLr * hLi + xLi * hLr;
                float yRr = cvS.at (so + 2050) + xRr * hRr - xRi * hRi;
                float yRi = cvS.at (so + 2051) + xRr * hRi + xRi * hRr;

                int ia = cvRev.at (k);
                cvRe.at (ia) = yLr - yRi;
                cvIm.at (ia) = yLi + yRr;

                if (k > 0 && k < 1024)
                {
                    int ib2 = cvRev.at (2048 - k);
                    cvRe.at (ib2) = yLr + yRi;
                    cvIm.at (ib2) = -yLi + yRr;
                }
            }

            cvFft (0, 0, 11264, 1.0f);

            for (int i = 0; i < 1024; ++i)
            {
                cvOutL.at (e * 1024 + i) = cvRe.at (1024 + i) * (1.0f / 2048.0f);
                cvOutR.at (e * 1024 + i) = cvIm.at (1024 + i) * (1.0f / 2048.0f);
            }

            // the current block becomes the previous one
            for (int i = 0; i < 1024; ++i)
            {
                cvInL.at (ib + i) = cvInL.at (ib + 1024 + i);
                cvInR.at (ib + i) = cvInR.at (ib + 1024 + i);
            }

            hd += 1;
            if (hd >= cvP) hd = 0;
            cvI.at (ii + 1) = hd;
        }

        cvI.at (ii) = t;
        return y;
    }

    // owner of the engine of a rack: the lowest slot of the rack whose effect is a convolution reverb
    void cvUpdateOwner (int rk)
    {
        int ow = -1;

        for (int k = 15; k >= 0; --k)
            if (fxType.at (fxG (rk, k)) == 12)
                ow = fxG (rk, k);

        if (ow != cvOwner.at (rk))
        {
            cvOwner.at (rk) = ow;

            if (ow >= 0)
            {
                fxDirty.at (ow) = true;
                cvI.at (rk * 32 + 9) = 1;
            }
        }
    }

    // loaded impulse response (mono, up to 96000 samples) of rack e
    void cvUserChunk (int e, int offset, int count, int total, BankChunk c)
    {
        int ii = e * 32;

        if (total <= 0)
        {
            cvI.at (ii + 17) = 0;
        }
        else
        {
            int base = e * 96000;

            for (int i = 0; i < min (count, 256); ++i)
            {
                int pos = offset + i;
                if (pos >= 0 && pos < 96000)
                    cvUser.at (base + pos) = clamp (c.data.at (i), -1.0f, 1.0f);
            }

            if (offset + count >= total)
                cvI.at (ii + 17) = clamp (total, 0, 96000);
        }

        if (cvI.at (ii + 13) == 8)
            cvI.at (ii + 9) = 6000;
    }

    // the slot s (owner or not) of convolution type: dry when it does not own the engine
    float<2> fxConv (int s, float<2> x)
    {
        int   rk = fxRk (s);

        if (cvOwner.at (rk) != s)
            return x;

        int   db = s * 16;
        int   fb = s * 40;
        int   ib = s * 24;
        int   ab = fxAb (s);
        float dt = float (processor.period);

        // pre-delay
        int pd = int (fxD.at (db + 3));
        int wp = fxI.at (ib);
        fxArena.at (ab + wp)         = x[0];
        fxArena.at (ab + 16384 + wp) = x[1];
        int rp = (wp - pd) & 16383;
        float<2> inp = float<2> (fxArena.at (ab + rp), fxArena.at (ab + 16384 + rp));
        fxI.at (ib) = (wp + 1) & 16383;

        float<2> w = cvProcess (rk, inp);

        // tone: low-pass / high-pass tilt around the middle of the control
        float lpC = fxD.at (db + 5);
        float hpC = fxD.at (db + 6);
        float l = fxF.at (fb)     + lpC * (w[0] - fxF.at (fb));
        float r = fxF.at (fb + 1) + lpC * (w[1] - fxF.at (fb + 1));
        fxF.at (fb)     = l;
        fxF.at (fb + 1) = r;
        float hl = l - (fxF.at (fb + 2) + hpC * (l - fxF.at (fb + 2)));
        float hr = r - (fxF.at (fb + 3) + hpC * (r - fxF.at (fb + 3)));
        fxF.at (fb + 2) = fxF.at (fb + 2) + hpC * (l - fxF.at (fb + 2));
        fxF.at (fb + 3) = fxF.at (fb + 3) + hpC * (r - fxF.at (fb + 3));

        // width
        float md = (hl + hr) * 0.5f;
        float sd = (hl - hr) * 0.5f * fxD.at (db + 4);
        return float<2> (md + sd, md - sd);
    }

    // ---------------- one function per effect: returns the processed ("wet") signal ----------------

    float<2> fxDist (int s, float<2> x)
    {
        int   fb = s * 40;
        int   db = s * 16;
        int   al = fxMode.at (s);
        float d  = fxD.at (db);
        float a  = fxD.at (db + 1);
        float g  = fxD.at (db + 2);

        // low cut before the shaper, bias into it
        float lc  = fxD.at (db + 4);
        float lpl = fxF.at (fb + 30) + lc * (x[0] - fxF.at (fb + 30));
        float lpr = fxF.at (fb + 31) + lc * (x[1] - fxF.at (fb + 31));
        fxF.at (fb + 30) = lpl;
        fxF.at (fb + 31) = lpr;
        float bias = fxD.at (db + 3);

        float yl = shapeSigAlg ((x[0] - lpl) * 0.5f + bias * 0.5f, d, al) * 2.0f;
        float yr = shapeSigAlg ((x[1] - lpr) * 0.5f + bias * 0.5f, d, al) * 2.0f;

        float tl = fxF.at (fb)     + a * (yl - fxF.at (fb));
        float tr = fxF.at (fb + 1) + a * (yr - fxF.at (fb + 1));
        fxF.at (fb)     = tl;
        fxF.at (fb + 1) = tr;

        // presence: the part above about 2.3 kHz boosted
        float pl = fxF.at (fb + 32) + 0.3f * (tl - fxF.at (fb + 32));
        float pr = fxF.at (fb + 33) + 0.3f * (tr - fxF.at (fb + 33));
        fxF.at (fb + 32) = pl;
        fxF.at (fb + 33) = pr;
        float pres = fxD.at (db + 5);
        tl = tl + pres * (tl - pl);
        tr = tr + pres * (tr - pr);

        // DC blocker (bias and rectification add an offset)
        float dl = fxF.at (fb + 28) + 0.0015f * (tl - fxF.at (fb + 28));
        float dr = fxF.at (fb + 29) + 0.0015f * (tr - fxF.at (fb + 29));
        fxF.at (fb + 28) = dl;
        fxF.at (fb + 29) = dr;

        return float<2> ((tl - dl) * g, (tr - dr) * g);
    }


    // ================= FX-SAT: Saturator (FX type 14) and Waveshaper (FX type 15) =================
    // Saturator models (mode): 0 Tube (asymmetric tanh), 1 Tape (soft tanh, head bump, high-frequency loss), 2 Transformer (low frequencies driven harder),
    // 3 Diode (asinh), 4 Fuzz (asymmetric hard clip), 5 Soft Clip (cubic), 6 Hard Clip, 7 Rectifier (tanh + half-wave), 8 Sine Fold, 9 Rational (x / (1 + |x|)),
    // 10 Exciter (saturated high band added back), 11 Arctan.
    // Slot parameters: P1 Drive (0..36 dB), P2 Tone (tilt), P3 Bias, P4 Output (+-12 dB), P5 Low Cut (before the shaper), P6 Sag (level dependent drive loss).
    // Waveshaper: P1 Drive (0..30 dB), P2 Bias, P3 Output (+-12 dB), P4 Tone (post low-pass), P5 Low Cut; modes 0 Curve, 1 Mirror (odd symmetric), 2 Rectified.
    // fxD: Saturator db 0 drive gain, 1 bias, 2 output gain, 3 tone, 4 low-cut coefficient, 5 sag, 6 tone low-pass coefficient, 7 dc coefficient, 8 transformer low-pass,
    // 9 tape low-pass, 10 exciter low-pass, 11 envelope attack, 12 envelope release, 13 tape bump low-pass.  fxF per channel c: c low cut, 2 + c previous input,
    // 4 + c tone low-pass, 6 + c dc, 8 + c transformer, 10 + c post low-pass, 12 + c tape, 14 + c bump / exciter, 16 + c envelope.

    float satLogCosh (float x)
    {
        float a = abs (x);
        return a + float (log (1.0f + float (exp (-2.0f * a)))) - 0.6931472f;
    }

    float satf (int m, float u)
    {
        float a = abs (u);

        if (m == 0)  return u >= 0.0f ? float (tanh (u)) : 0.75f * float (tanh (u / 0.75f));
        if (m == 1)  return 1.05f * float (tanh (0.9f * u));
        if (m == 3)  return float (log (a + sqrt (a * a + 1.0f))) * (u < 0.0f ? -1.0f : 1.0f);
        if (m == 4)  return clamp (4.0f * u, -0.6f, 1.0f);
        if (m == 5)  return a <= 1.0f ? 1.5f * (u - u * u * u * 0.333333f) : (u < 0.0f ? -1.0f : 1.0f);
        if (m == 6)  return clamp (u, -1.0f, 1.0f);
        if (m == 7)  return 0.6f * (float (tanh (u)) + 0.7f * abs (float (tanh (u))));
        if (m == 8)  return float (sin (2.0f * u));
        if (m == 9)  return u / (1.0f + a);
        if (m == 11) return 0.63662f * float (atan (1.6f * u));

        return float (tanh (u));
    }

    // antiderivative of satf (F(0) = 0)
    float satF (int m, float u)
    {
        float a = abs (u);

        if (m == 0)  return u >= 0.0f ? satLogCosh (u) : 0.5625f * satLogCosh (u / 0.75f);
        if (m == 1)  return 1.1666667f * satLogCosh (0.9f * u);
        if (m == 3)  return a * (float (log (a + sqrt (a * a + 1.0f)))) - sqrt (u * u + 1.0f) + 1.0f;

        if (m == 4)
        {
            if (u < -0.15f) return 0.045f - 0.6f * (u + 0.15f);
            if (u > 0.25f)  return 0.125f + (u - 0.25f);
            return 2.0f * u * u;
        }

        if (m == 5)  return a <= 1.0f ? 1.5f * (u * u * 0.5f - u * u * u * u * 0.083333f) : 0.625f + (a - 1.0f);
        if (m == 6)  return a <= 1.0f ? u * u * 0.5f : a - 0.5f;
        if (m == 7)  return 0.6f * satLogCosh (u) * (u < 0.0f ? 0.3f : 1.7f);
        if (m == 8)  return 0.5f * (1.0f - float (cos (2.0f * u)));
        if (m == 9)  return a - float (log (1.0f + a));
        if (m == 11) return 0.63662f * (u * float (atan (1.6f * u)) - float (log (1.0f + 2.56f * u * u)) * 0.3125f);

        return satLogCosh (u);
    }

    float satAdaa (int m, float u, float up)
    {
        float du = u - up;

        if (abs (du) < 0.0001f)
            return satf (m, 0.5f * (u + up));

        return (satF (m, u) - satF (m, up)) / du;
    }

    void fxSatDerive (int s)
    {
        float sr = float (processor.frequency);
        float dt = float (processor.period);
        int   db = s * 16;
        int   pb = s * 6;
        int   m  = fxMode.at (s);
        float p1 = clamp (fxP.at (pb),     0.0f, 1.0f);
        float g  = float (pow (10.0f, p1 * 36.0f / 20.0f));
        float cp = 1.0f;

        if (m != 10)
            cp = 0.5f / max (abs (satf (m, 0.5f * g)), 0.05f);

        fxD.at (db)      = g;
        fxD.at (db + 1)  = (clamp (fxP.at (pb + 2), 0.0f, 1.0f) - 0.5f) * 1.0f;
        fxD.at (db + 2)  = float (pow (10.0f, (clamp (fxP.at (pb + 3), 0.0f, 1.0f) - 0.5f) * 24.0f / 20.0f)) * cp;
        fxD.at (db + 3)  = (clamp (fxP.at (pb + 1), 0.0f, 1.0f) - 0.5f) * 2.0f;
        fxD.at (db + 4)  = clamp (float (twoPi) * fxExpMap (clamp (fxP.at (pb + 4), 0.0f, 1.0f), 10.0f, 800.0f) * dt, 0.0f, 1.0f);
        fxD.at (db + 5)  = clamp (fxP.at (pb + 5), 0.0f, 1.0f);
        fxD.at (db + 6)  = clamp (float (twoPi) * 2500.0f * dt, 0.0f, 1.0f);
        fxD.at (db + 7)  = clamp (float (twoPi) * 18.0f * dt, 0.0f, 1.0f);
        fxD.at (db + 8)  = clamp (float (twoPi) * 130.0f * dt, 0.0f, 1.0f);
        fxD.at (db + 9)  = clamp (float (twoPi) * 11000.0f * dt, 0.0f, 1.0f);
        fxD.at (db + 10) = clamp (float (twoPi) * 3000.0f * dt, 0.0f, 1.0f);
        fxD.at (db + 11) = clamp (1.0f - float (exp (-1.0f / (sr * 0.001f))), 0.0f, 1.0f);
        fxD.at (db + 12) = clamp (1.0f - float (exp (-1.0f / (sr * 0.12f))), 0.0f, 1.0f);
        fxD.at (db + 13) = clamp (float (twoPi) * 90.0f * dt, 0.0f, 1.0f);
    }

    // one channel of the Saturator
    float satCh (int s, int c, float x)
    {
        int   fb  = s * 40;
        int   db  = s * 16;
        int   m   = fxMode.at (s);
        float g   = fxD.at (db);
        float bi  = fxD.at (db + 1);

        // low cut before the shaper
        float lcs = fxF.at (fb + c);
        lcs += fxD.at (db + 4) * (x - lcs);
        fxF.at (fb + c) = lcs;
        float xi = x - lcs;

        // sag: the louder the input, the less drive
        float env = fxF.at (fb + 16 + c);
        float ae  = abs (xi);
        env += (ae > env ? fxD.at (db + 11) : fxD.at (db + 12)) * (ae - env);
        fxF.at (fb + 16 + c) = env;
        float ge = g / (1.0f + fxD.at (db + 5) * 8.0f * env);

        float y = 0.0f;

        if (m == 10)
        {
            // exciter: the high band saturated and added back
            float lp = fxF.at (fb + 14 + c);
            lp += fxD.at (db + 10) * (xi - lp);
            fxF.at (fb + 14 + c) = lp;
            float hp = xi - lp;
            y = xi + 0.7f * float (tanh (min (ge, 30.0f) * hp * 4.0f)) * 0.5f;
        }
        else
        {
            float u = xi * ge + bi;

            if (m == 2)
            {
                float l = fxF.at (fb + 8 + c);
                l += fxD.at (db + 8) * (u - l);
                fxF.at (fb + 8 + c) = l;
                u += 1.2f * l;
            }

            float up = fxF.at (fb + 2 + c);
            fxF.at (fb + 2 + c) = u;
            y = satAdaa (m, u, up);

            if (m == 2)
            {
                float l2 = fxF.at (fb + 10 + c);
                l2 += fxD.at (db + 8) * (y - l2);
                fxF.at (fb + 10 + c) = l2;
                y -= 0.4f * l2;
            }
            else if (m == 1)
            {
                float t = fxF.at (fb + 12 + c);
                t += fxD.at (db + 9) * (y - t);
                fxF.at (fb + 12 + c) = t;
                float bp = fxF.at (fb + 14 + c);
                bp += fxD.at (db + 13) * (t - bp);
                fxF.at (fb + 14 + c) = bp;
                y = t + 0.35f * bp;
            }
        }

        // DC blocker (bias and asymmetric models add an offset)
        float dc = fxF.at (fb + 6 + c);
        dc += fxD.at (db + 7) * (y - dc);
        fxF.at (fb + 6 + c) = dc;
        y -= dc;

        // tone: below the middle a low-pass blend, above it the highs boosted
        float tn = fxD.at (db + 3);
        float tl = fxF.at (fb + 4 + c);
        tl += fxD.at (db + 6) * (y - tl);
        fxF.at (fb + 4 + c) = tl;

        if (tn >= 0.0f)  y += tn * 1.5f * (y - tl);
        else             y = y * (1.0f + tn) + tl * (-tn);

        return y * fxD.at (db + 2);
    }

    float<2> fxSat (int s, float<2> x)
    {
        return float<2> (satCh (s, 0, x[0]), satCh (s, 1, x[1]));
    }

    // ---- Waveshaper: the transfer curve table of a slot lives in the arena: f at ab + 0 .. 1024, antiderivative F (F(0) = 0) at ab + 1100 .. 2124, input -1 .. 1 ----
    float wsNodeCurve (int s, float x)
    {
        int   nb = s * 240;
        int   n  = clamp (int (peqB.at (nb) * 16.0f + 0.5f), 0, 16);

        if (n < 2)
            return x;

        float[16] nx;
        float[16] ny;
        float[16] nc;

        for (int i = 0; i < n; ++i)
        {
            nx.at (i) = peqB.at (nb + 1 + 3 * i);
            ny.at (i) = peqB.at (nb + 2 + 3 * i);
            nc.at (i) = peqB.at (nb + 3 + 3 * i);
        }

        // insertion sort by x
        for (int i = 1; i < n; ++i)
        {
            float kx = nx.at (i);
            float ky = ny.at (i);
            float kc = nc.at (i);
            int   j  = i - 1;

            while (j >= 0 && nx.at (j) > kx)
            {
                nx.at (j + 1) = nx.at (j);
                ny.at (j + 1) = ny.at (j);
                nc.at (j + 1) = nc.at (j);
                j -= 1;
            }

            nx.at (j + 1) = kx;
            ny.at (j + 1) = ky;
            nc.at (j + 1) = kc;
        }

        if (x <= nx.at (0))
            return ny.at (0);

        for (int i = 0; i < n - 1; ++i)
        {
            if (x <= nx.at (i + 1))
            {
                float w = nx.at (i + 1) - nx.at (i);
                float t = w > 0.00001f ? (x - nx.at (i)) / w : 1.0f;
                float p = float (pow (2.0f, nc.at (i) * 3.0f));
                return ny.at (i) + (ny.at (i + 1) - ny.at (i)) * float (pow (clamp (t, 0.0f, 1.0f), p));
            }
        }

        return ny.at (n - 1);
    }

    void fxWsDerive (int s)
    {
        float dt = float (processor.period);
        int   db = s * 16;
        int   pb = s * 6;
        int   ab = fxAb (s);

        fxD.at (db)     = float (pow (10.0f, clamp (fxP.at (pb), 0.0f, 1.0f) * 30.0f / 20.0f));
        fxD.at (db + 1) = (clamp (fxP.at (pb + 1), 0.0f, 1.0f) - 0.5f) * 1.0f;
        fxD.at (db + 2) = float (pow (10.0f, (clamp (fxP.at (pb + 2), 0.0f, 1.0f) - 0.5f) * 24.0f / 20.0f));
        fxD.at (db + 3) = clamp (float (twoPi) * fxExpMap (clamp (fxP.at (pb + 3), 0.0f, 1.0f), 500.0f, 20000.0f) * dt, 0.0f, 1.0f);
        fxD.at (db + 4) = clamp (float (twoPi) * fxExpMap (clamp (fxP.at (pb + 4), 0.0f, 1.0f), 10.0f, 800.0f) * dt, 0.0f, 1.0f);
        fxD.at (db + 7) = clamp (float (twoPi) * 18.0f * dt, 0.0f, 1.0f);

        float acc = 0.0f;
        float prev = 0.0f;

        for (int i = 0; i <= 1024; ++i)
        {
            float x  = float (i - 512) / 512.0f;
            float fy = clamp (wsNodeCurve (s, x), -1.0f, 1.0f);
            fxArena.at (ab + i) = fy;

            if (i > 0)
                acc += 0.5f * (prev + fy) / 512.0f;

            prev = fy;
            fxArena.at (ab + 1100 + i) = acc;
        }

        // F(0) = 0
        float f0 = fxArena.at (ab + 1100 + 512);

        for (int i = 0; i <= 1024; ++i)
            fxArena.at (ab + 1100 + i) -= f0;
    }

    float wsTabF (int ab, float u)
    {
        float a = clamp (u, -1.0f, 1.0f);
        float p = (a + 1.0f) * 512.0f;
        int   i = clamp (int (p), 0, 1023);
        float fr = p - float (i);
        float v = fxArena.at (ab + 1100 + i) * (1.0f - fr) + fxArena.at (ab + 1101 + i) * fr;

        if (u > 1.0f)       v += fxArena.at (ab + 1024) * (u - 1.0f);
        else if (u < -1.0f) v += fxArena.at (ab) * (u + 1.0f);

        return v;
    }

    float wsTabf (int ab, float u)
    {
        float a = clamp (u, -1.0f, 1.0f);
        float p = (a + 1.0f) * 512.0f;
        int   i = clamp (int (p), 0, 1023);
        float fr = p - float (i);
        return fxArena.at (ab + i) * (1.0f - fr) + fxArena.at (ab + 1 + i) * fr;
    }

    // value and antiderivative of the shaped function for mode md (0 curve, 1 odd mirror, 2 rectified)
    float wsFn (int ab, int md, float u)
    {
        if (md == 1) return u < 0.0f ? -wsTabf (ab, -u) : wsTabf (ab, u);
        if (md == 2) return wsTabf (ab, abs (u));
        return wsTabf (ab, u);
    }

    float wsAnti (int ab, int md, float u)
    {
        if (md == 1) return wsTabF (ab, abs (u));
        if (md == 2) return u < 0.0f ? -wsTabF (ab, -u) : wsTabF (ab, u);
        return wsTabF (ab, u);
    }

    float wsCh (int s, int c, float x)
    {
        int   fb = s * 40;
        int   db = s * 16;
        int   ab = fxAb (s);
        int   md = fxMode.at (s);

        float lcs = fxF.at (fb + c);
        lcs += fxD.at (db + 4) * (x - lcs);
        fxF.at (fb + c) = lcs;

        float u  = (x - lcs) * fxD.at (db) + fxD.at (db + 1);
        float up = fxF.at (fb + 2 + c);
        fxF.at (fb + 2 + c) = u;
        float du = u - up;
        float y  = abs (du) < 0.0001f ? wsFn (ab, md, 0.5f * (u + up)) : (wsAnti (ab, md, u) - wsAnti (ab, md, up)) / du;

        float dc = fxF.at (fb + 6 + c);
        dc += fxD.at (db + 7) * (y - dc);
        fxF.at (fb + 6 + c) = dc;
        y -= dc;

        float tl = fxF.at (fb + 4 + c);
        tl += fxD.at (db + 3) * (y - tl);
        fxF.at (fb + 4 + c) = tl;

        return tl * fxD.at (db + 2);
    }

    float<2> fxWs (int s, float<2> x)
    {
        return float<2> (wsCh (s, 0, x[0]), wsCh (s, 1, x[1]));
    }

    float<2> fxCrush (int s, float<2> x)
    {
        int fb  = s * 40;
        int ib  = s * 24;
        int db  = s * 16;
        int cnt = fxI.at (ib) + 1;
        int cm  = fxMode.at (s);

        // small LCG for dither / jitter
        int rs = (fxI.at (ib + 1) * 1103515245 + 12345) & 0x7fffffff;
        int rt = (rs * 1103515245 + 12345) & 0x7fffffff;
        fxI.at (ib + 1) = rt;
        float r1 = float (rs) / 2147483648.0f;
        float r2 = float (rt) / 2147483648.0f;

        if (fxI.at (ib + 2) < 1)
            fxI.at (ib + 2) = 1;

        if (cnt >= fxI.at (ib + 2))
        {
            cnt = 0;
            fxF.at (fb)     = x[0];
            fxF.at (fb + 1) = x[1];
            fxI.at (ib + 2) = cm == 3 ? 1 : max (1, int (fxD.at (db + 1) * (1.0f + fxD.at (db + 4) * (r1 * 2.0f - 1.0f))));
        }

        fxI.at (ib) = cnt;

        float yl = fxF.at (fb);
        float yr = fxF.at (fb + 1);

        if (fxD.at (db) < 15.5f && cm != 4)
        {
            float lv = fxD.at (db + 2);
            float dz = fxD.at (db + 3) * (r1 - r2) / lv;

            if (cm == 1)
            {
                // mu-law: companded quantiser (finer steps for quiet signals)
                float mu = 60.0f;
                float cl = (yl < 0.0f ? -1.0f : 1.0f) * float (log (1.0f + mu * min (1.0f, abs (yl)))) / float (log (1.0f + mu));
                float cr = (yr < 0.0f ? -1.0f : 1.0f) * float (log (1.0f + mu * min (1.0f, abs (yr)))) / float (log (1.0f + mu));
                cl = rint ((cl + dz) * lv) / lv;
                cr = rint ((cr + dz) * lv) / lv;
                yl = (cl < 0.0f ? -1.0f : 1.0f) * (float (exp (abs (cl) * float (log (1.0f + mu)))) - 1.0f) / mu;
                yr = (cr < 0.0f ? -1.0f : 1.0f) * (float (exp (abs (cr) * float (log (1.0f + mu)))) - 1.0f) / mu;
            }
            else if (cm == 2)
            {
                // floor: truncating quantiser (asymmetric, gritty)
                yl = floor ((yl + dz) * lv) / lv;
                yr = floor ((yr + dz) * lv) / lv;
            }
            else if (cm == 5)
            {
                // noise shaped: the quantisation error of the previous sample is fed back
                float ul = yl - fxF.at (fb + 2) * 0.9f + dz;
                float ur = yr - fxF.at (fb + 3) * 0.9f + dz;
                float ql = rint (ul * lv) / lv;
                float qr = rint (ur * lv) / lv;
                fxF.at (fb + 2) = ql - ul;
                fxF.at (fb + 3) = qr - ur;
                yl = ql;
                yr = qr;
            }
            else
            {
                yl = rint ((yl + dz) * lv) / lv;
                yr = rint ((yr + dz) * lv) / lv;
            }
        }

        return float<2> (yl, yr);
    }

    float<2> fxDelay (int s, float<2> x)
    {
        int   fb  = s * 40;
        int   ib  = s * 24;
        int   pb  = s * 4;
        int   db  = s * 16;
        int   ab  = fxAb (s);
        float sr  = float (processor.frequency);
        int   dty = fxMode.at (s);

        float target = fxD.at (db);
        float cur    = fxF.at (fb + 2);

        if (fxI.at (ib + 1) == 0)
        {
            cur = target;
            fxI.at (ib + 1) = 1;
        }

        cur += (target - cur) * 0.0005f;
        fxF.at (fb + 2) = cur;

        float tapeMod = 0.0f;
        if (dty == 1)
        {
            float64 t1 = fxPh.at (pb)     + 0.55 * processor.period;
            float64 t2 = fxPh.at (pb + 1) + 6.3  * processor.period;
            if (t1 >= 1.0) t1 -= 1.0;
            if (t2 >= 1.0) t2 -= 1.0;
            fxPh.at (pb)     = t1;
            fxPh.at (pb + 1) = t2;
            tapeMod = (0.0004f * float (sin (float (twoPi) * float (t1))) + 0.00008f * float (sin (float (twoPi) * float (t2)))) * sr;
        }

        float dmod = 0.0f;

        if (fxD.at (db + 4) > 0.5f)
        {
            float64 t3 = fxPh.at (pb + 2) + 0.7 * processor.period;
            if (t3 >= 1.0) t3 -= 1.0;
            fxPh.at (pb + 2) = t3;
            dmod = fxD.at (db + 4) * float (sin (float (twoPi) * float (t3)));
        }

        int   wp   = fxI.at (ib);
        float rpos = float (wp) - cur - tapeMod - dmod;
        if (rpos < 0.0f) rpos += 98304.0f;

        int i0 = clamp (int (rpos), 0, 98303);
        int i1 = i0 + 1;
        if (i1 >= 98304) i1 = 0;
        float fr = rpos - float (i0);

        float dl = fxArena.at (ab + i0)         * (1.0f - fr) + fxArena.at (ab + i1)         * fr;
        float dr = fxArena.at (ab + 98304 + i0) * (1.0f - fr) + fxArena.at (ab + 98304 + i1) * fr;

        if (dty == 4)
        {
            // reverse: two read heads run backwards through the last two delay times, crossfaded with sin^2 windows
            float rt  = clamp (cur, 64.0f, 49000.0f);
            float tt  = float (fxPh.at (pb + 3)) + 1.0f;
            if (tt >= rt) tt -= rt;
            fxPh.at (pb + 3) = float64 (tt);
            float tb  = tt + rt * 0.5f;
            if (tb >= rt) tb -= rt;
            float sa  = float (sin (float (pi) * tt / rt));
            float sb  = float (sin (float (pi) * tb / rt));
            dl = fxTapN (ab, 98304, float (wp) - 2.0f * tt) * sa * sa + fxTapN (ab, 98304, float (wp) - 2.0f * tb) * sb * sb;
            dr = fxTapN (ab + 98304, 98304, float (wp) - 2.0f * tt) * sa * sa + fxTapN (ab + 98304, 98304, float (wp) - 2.0f * tb) * sb * sb;
        }

        float dampA = fxD.at (db + 2);
        float sL = fxF.at (fb)     + dampA * (dl - fxF.at (fb));
        float sR = fxF.at (fb + 1) + dampA * (dr - fxF.at (fb + 1));
        fxF.at (fb)     = sL;
        fxF.at (fb + 1) = sR;

        float ping    = fxD.at (db + 3);
        float fbSameL = sL * (1.0f - ping) + sR * ping;
        float fbSameR = sR * (1.0f - ping) + sL * ping;
        float hpc     = fxD.at (db + 5);
        float hpl     = fxF.at (fb + 34) + hpc * (fbSameL - fxF.at (fb + 34));
        float hpr     = fxF.at (fb + 35) + hpc * (fbSameR - fxF.at (fb + 35));
        fxF.at (fb + 34) = hpl;
        fxF.at (fb + 35) = hpr;
        float fbSendL = fbSameL - hpl;
        float fbSendR = fbSameR - hpr;

        if (dty == 1)
        {
            // tape: saturating feedback path
            fbSendL = softClip (fbSameL * 1.6f) * 0.625f;
            fbSendR = softClip (fbSameR * 1.6f) * 0.625f;
        }

        float fbk = fxD.at (db + 1);
        fxArena.at (ab + wp)         = x[0] + fbSendL * fbk;
        fxArena.at (ab + 98304 + wp) = x[1] + fbSendR * fbk;

        float dl2 = 0.0f;
        float dr2 = 0.0f;
        if (dty == 2)
        {
            // dual: extra tap at half the delay time
            float rpos2 = float (wp) - cur * 0.5f;
            if (rpos2 < 0.0f) rpos2 += 98304.0f;
            int j0 = clamp (int (rpos2), 0, 98303);
            int j1 = j0 + 1;
            if (j1 >= 98304) j1 = 0;
            float jf = rpos2 - float (j0);
            dl2 = (fxArena.at (ab + j0)         * (1.0f - jf) + fxArena.at (ab + j1)         * jf) * 0.6f;
            dr2 = (fxArena.at (ab + 98304 + j0) * (1.0f - jf) + fxArena.at (ab + 98304 + j1) * jf) * 0.6f;
        }

        if (dty == 5)
        {
            // multi-tap: extra taps at 2/3 and 1/3 of the delay time, the right channel swapped
            dl2 = fxTapN (ab, 98304, float (wp) - cur * 0.6667f) * 0.6f + fxTapN (ab + 98304, 98304, float (wp) - cur * 0.3333f) * 0.4f;
            dr2 = fxTapN (ab + 98304, 98304, float (wp) - cur * 0.6667f) * 0.6f + fxTapN (ab, 98304, float (wp) - cur * 0.3333f) * 0.4f;
        }

        wp += 1;
        if (wp >= 98304) wp = 0;
        fxI.at (ib) = wp;

        return float<2> (x[0] + dl + dl2, x[1] + dr + dr2);
    }

    float<2> fxChorus (int s, float<2> x)
    {
        int   fb   = s * 40;
        int   ib   = s * 24;
        int   pb   = s * 4;
        int   db   = s * 16;
        int   ab   = fxAb (s);
        float sr   = float (processor.frequency);
        int   mode = fxMode.at (s);

        float64 ph = fxPhase (s, pb, db);

        float chPhL = float (ph);
        float chPhR = chPhL + (mode == 4 ? 0.5f : 0.25f);
        if (chPhR >= 1.0f) chPhR -= 1.0f;

        float chModL = float (sin (float (twoPi) * chPhL));
        float chModR = float (sin (float (twoPi) * chPhR));
        float chBase = 0.011f;
        float chDep  = 0.006f;
        if (mode == 1) { chBase = 0.0065f; chDep = 0.0016f; }
        if (mode == 2) { chBase = 0.007f;  chDep = 0.0045f; }
        if (mode == 3) { chBase = 0.012f;  chDep = 0.0035f; }
        if (mode == 4) { chBase = 0.0095f; chDep = 0.005f; }

        float depth = fxD.at (db + 1);
        float chDlyL = (chBase + chDep * depth * chModL) * sr;
        float chDlyR = (chBase + chDep * depth * chModR) * sr;

        int pos = fxI.at (ib);
        fxArena.at (ab + pos)        = x[0] + fxF.at (fb)     * fxD.at (db + 2);
        fxArena.at (ab + 8192 + pos) = x[1] + fxF.at (fb + 1) * fxD.at (db + 2);

        float rdL = float (pos) - chDlyL;
        if (rdL < 0.0f) rdL += 8192.0f;
        float rdR = float (pos) - chDlyR;
        if (rdR < 0.0f) rdR += 8192.0f;

        int l0 = clamp (int (rdL), 0, 8191);
        int l1 = l0 + 1;
        if (l1 >= 8192) l1 = 0;
        int r0 = clamp (int (rdR), 0, 8191);
        int r1 = r0 + 1;
        if (r1 >= 8192) r1 = 0;
        float frL = rdL - float (l0);
        float frR = rdR - float (r0);

        float wetL = fxArena.at (ab + l0)        * (1.0f - frL) + fxArena.at (ab + l1)        * frL;
        float wetR = fxArena.at (ab + 8192 + r0) * (1.0f - frR) + fxArena.at (ab + 8192 + r1) * frR;

        if (mode == 3)
        {
            // ensemble: three voices 120 degrees apart
            float wl = wetL;
            float wr = wetR;

            for (int ev = 1; ev < 3; ++ev)
            {
                float po = float (ev) * 0.3333f;
                float pl = chPhL + po;  if (pl >= 1.0f) pl -= 1.0f;
                float pr = chPhR + po;  if (pr >= 1.0f) pr -= 1.0f;
                wl += fxTapN (ab, 8192, float (pos) - (chBase + chDep * depth * float (sin (float (twoPi) * pl))) * sr);
                wr += fxTapN (ab + 8192, 8192, float (pos) - (chBase + chDep * depth * float (sin (float (twoPi) * pr))) * sr);
            }

            wetL = wl * 0.5f;
            wetR = wr * 0.5f;
        }

        fxF.at (fb)     = wetL;
        fxF.at (fb + 1) = wetR;

        pos += 1;
        if (pos >= 8192) pos = 0;
        fxI.at (ib) = pos;

        // vibrato: pitch modulation only, the wet signal replaces the dry one
        if (mode == 2)
            return float<2> (wetL, wetR);

        return float<2> (x[0] * 0.6f + wetL * 0.7f, x[1] * 0.6f + wetR * 0.7f);
    }

    float<2> fxFlanger (int s, float<2> x)
    {
        int   fb = s * 40;
        int   ib = s * 24;
        int   pb = s * 4;
        int   db = s * 16;
        int   ab = fxAb (s);
        float sr = float (processor.frequency);
        int   fm = fxMode.at (s);

        float64 ph = fxPhase (s, pb, db);

        float flMod  = 0.5f + 0.5f * float (sin (float (twoPi) * float (ph)));
        float flModR = flMod;

        if (fm == 3)
        {
            float pr = float (ph) + 0.25f;
            if (pr >= 1.0f) pr -= 1.0f;
            flModR = 0.5f + 0.5f * float (sin (float (twoPi) * pr));
        }

        float flDly  = clamp ((0.0008f + 0.0042f * fxD.at (db + 1) * flMod)  * sr, 2.0f, 4000.0f);
        float flDlyR = clamp ((0.0008f + 0.0042f * fxD.at (db + 1) * flModR) * sr, 2.0f, 4000.0f);

        if (fm == 2)
        {
            // through-zero: the wet delay sweeps around the fixed delay of the dry signal
            float tz = float (sin (float (twoPi) * float (ph)));
            flDly  = clamp ((0.003f + 0.0027f * fxD.at (db + 1) * tz) * sr, 2.0f, 4000.0f);
            flDlyR = flDly;
        }

        int pos = fxI.at (ib);
        fxArena.at (ab + pos)        = x[0] + fxF.at (fb)     * fxD.at (db + 2);
        fxArena.at (ab + 4096 + pos) = x[1] + fxF.at (fb + 1) * fxD.at (db + 2);

        float wetL = fxTapN (ab, 4096, float (pos) - flDly);
        float wetR = fxTapN (ab + 4096, 4096, float (pos) - flDlyR);

        fxF.at (fb)     = wetL;
        fxF.at (fb + 1) = wetR;

        float dryL = x[0] * 0.5f;
        float dryR = x[1] * 0.5f;

        if (fm == 2)
        {
            dryL = fxTapN (ab, 4096, float (pos) - 0.003f * sr) * 0.5f;
            dryR = fxTapN (ab + 4096, 4096, float (pos) - 0.003f * sr) * 0.5f;
        }

        pos += 1;
        if (pos >= 4096) pos = 0;
        fxI.at (ib) = pos;

        return float<2> (dryL + wetL * 0.6f, dryR + wetR * 0.6f);
    }

    float<2> fxPhaser (int s, float<2> x)
    {
        int   fb = s * 40;
        int   pb = s * 4;
        int   db = s * 16;
        float sr = float (processor.frequency);

        float64 ph = fxPhase (s, pb, db);

        float phMod  = 0.5f + 0.5f * float (sin (float (twoPi) * float (ph)));
        float phFreq = clamp (200.0f * float (pow (2.0f, phMod * 4.0f * (0.3f + 0.7f * fxD.at (db + 1)))), 20.0f, sr * 0.45f);
        float phTan  = float (tan (float64 (phFreq) * pi * processor.period));
        float phCoef = (1.0f - phTan) / (1.0f + phTan);

        float xL = x[0] + fxF.at (fb)     * fxD.at (db + 2);
        float xR = x[1] + fxF.at (fb + 1) * fxD.at (db + 2);

        int pm = fxMode.at (s);
        int stages = pm <= 5 ? 2 * (pm + 1) : (pm == 6 ? 4 : 8);
        for (int ps = 0; ps < stages; ++ps)
        {
            float yL = phCoef * xL + fxF.at (fb + 2 + ps);
            fxF.at (fb + 2 + ps) = xL - phCoef * yL;
            xL = yL;

            float yR = phCoef * xR + fxF.at (fb + 14 + ps);
            fxF.at (fb + 14 + ps) = xR - phCoef * yR;
            xR = yR;
        }

        fxF.at (fb)     = clamp (xL, -4.0f, 4.0f);
        fxF.at (fb + 1) = clamp (xR, -4.0f, 4.0f);

        if (pm >= 6)
            return float<2> (x[0] * 0.5f - xL * 0.5f, x[1] * 0.5f - xR * 0.5f);

        return float<2> (x[0] * 0.5f + xL * 0.5f, x[1] * 0.5f + xR * 0.5f);
    }

    float<2> fxTrem (int s, float<2> x)
    {
        int pb = s * 4;
        int db = s * 16;
        int fb = s * 40;
        int ib = s * 24;

        float64 ph = fxPhase (s, pb, db);

        float pL = float (ph);
        float pR = pL + 0.5f * fxD.at (db + 2);
        if (pR >= 1.0f) pR -= 1.0f;

        int   wv    = fxMode.at (s);
        float depth = fxD.at (db + 1);
        float lL    = 0.0f;
        float lR    = 0.0f;

        if (wv == 5)
        {
            // trance gate: 16 step pattern per cycle, the right channel shifted by up to half a pattern, smoothed edges
            int   pat = clamp (int (fxD.at (db + 3)), 0, 23);
            float sw  = fxD.at (db + 5);
            float gL  = 1.0f - fxGateAt (pat, pL, sw);
            float gR  = 1.0f - fxGateAt (pat, pR, sw);
            float cf  = fxD.at (db + 4);
            lL = fxF.at (fb)     + cf * (gL - fxF.at (fb));
            lR = fxF.at (fb + 1) + cf * (gR - fxF.at (fb + 1));
            fxF.at (fb)     = lL;
            fxF.at (fb + 1) = lR;
        }
        else if (wv == 6)
        {
            // auto-pan: equal power pan sweep, depth = width of the sweep
            float pp = 0.5f + 0.5f * depth * float (sin (float (twoPi) * pL));
            return float<2> (x[0] * float (cos (pp * 1.5708f)) * 1.4142f, x[1] * float (sin (pp * 1.5708f)) * 1.4142f);
        }
        else if (wv == 7 || wv == 8)
        {
            // random: a new value every cycle (7 sample & hold with slew, 8 interpolated)
            float prev = float (fxPh.at (pb + 1));

            if (pL < prev)
            {
                int rs = fxI.at (ib);
                if (rs == 0) rs = 12345;
                rs = (rs * 1103515245 + 12345) & 0x7fffffff;
                float r1 = float (rs) / 2147483648.0f;
                rs = (rs * 1103515245 + 12345) & 0x7fffffff;
                float r2 = float (rs) / 2147483648.0f;
                fxI.at (ib) = rs;
                fxF.at (fb + 4) = fxF.at (fb + 2);
                fxF.at (fb + 5) = fxF.at (fb + 3);
                fxF.at (fb + 2) = r1;
                fxF.at (fb + 3) = r1 + (r2 - r1) * fxD.at (db + 2);
            }

            fxPh.at (pb + 1) = float64 (pL);

            if (wv == 7)
            {
                float cf = fxD.at (db + 4);
                lL = fxF.at (fb)     + cf * (fxF.at (fb + 2) - fxF.at (fb));
                lR = fxF.at (fb + 1) + cf * (fxF.at (fb + 3) - fxF.at (fb + 1));
                fxF.at (fb)     = lL;
                fxF.at (fb + 1) = lR;
            }
            else
            {
                float sm = pL * pL * (3.0f - 2.0f * pL);
                lL = fxF.at (fb + 4) + (fxF.at (fb + 2) - fxF.at (fb + 4)) * sm;
                lR = fxF.at (fb + 5) + (fxF.at (fb + 3) - fxF.at (fb + 5)) * sm;
            }
        }
        else if (wv == 0)
        {
            lL = 0.5f - 0.5f * float (sin (float (twoPi) * pL));
            lR = 0.5f - 0.5f * float (sin (float (twoPi) * pR));
        }
        else if (wv == 1)
        {
            lL = abs (2.0f * pL - 1.0f);
            lR = abs (2.0f * pR - 1.0f);
        }
        else if (wv == 2)
        {
            if (pL < 0.5f) lL = 0.0f; else lL = 1.0f;
            if (pR < 0.5f) lR = 0.0f; else lR = 1.0f;
        }
        else if (wv == 3)
        {
            lL = 1.0f - pL;
            lR = 1.0f - pR;
        }
        else
        {
            lL = pL;
            lR = pR;
        }

        return float<2> (x[0] * (1.0f - depth * lL), x[1] * (1.0f - depth * lR));
    }

    // FX-REV: Zita-rev1 FDN (modes 0 1 3 4 6 7 8) and Dattorro plate (modes 2 5).  One sample counter (fxI[ib]) indexes every ring buffer of a slot.
    // Arena layout: Zita delay-with-feedback lines at i*4096, delay lines at 32768 + i*16384; Dattorro input allpasses at i*2048, tank lines at 8192 + k*16384;
    // pre-delay lines at 172032 / 180480; coefficient / length tables at 180224 (Zita) and 180288 (Dattorro).
    const float[8] zitaD1 = ( 20346e-6f, 24421e-6f, 31604e-6f, 27333e-6f, 22904e-6f, 29291e-6f, 13458e-6f, 19123e-6f );
    const float[8] zitaD2 = ( 153129e-6f, 210389e-6f, 127837e-6f, 256891e-6f, 174713e-6f, 192303e-6f, 125000e-6f, 219991e-6f );
    const int[26]  datLen = ( 142, 107, 379, 277, 672, 4453, 1800, 3720, 908, 4217, 2656, 3163, 266, 2974, 1913, 1996, 1990, 187, 1066, 353, 3627, 1228, 2111, 335, 121, 1990 );

    float rvRd (int base, int mask, int wp, int d)
    {
        return fxArena.at (base + ((wp - d) & mask));
    }

    void rvWr (int base, int mask, int wp, float v)
    {
        fxArena.at (base + (wp & mask)) = v;
    }

    float rvRdF (int base, int mask, int wp, float d)
    {
        int   di = int (d);
        float fr = d - float (di);
        return rvRd (base, mask, wp, di) * (1.0f - fr) + rvRd (base, mask, wp, di + 1) * fr;
    }

    // Schroeder allpass on its own line (reads the tail, writes the head)
    float rvAp (int base, int mask, int wp, int d, float g, float x)
    {
        float z = rvRd (base, mask, wp, d);
        float v = x - g * z;
        rvWr (base, mask, wp, v);
        return z + g * v;
    }

    float rvApMod (int base, int mask, int wp, float d, float g, float x)
    {
        float z = rvRdF (base, mask, wp, d);
        float v = x - g * z;
        rvWr (base, mask, wp, v);
        return z + g * v;
    }

    float<2> fxReverb (int s, float<2> x)
    {
        int   fb = s * 40;
        int   ib = s * 24;
        int   db = s * 16;
        int   ab = fxAb (s);
        float dt = float (processor.period);

        float preS = fxD.at (db + 2);
        float rvW  = fxD.at (db + 3);
        int   algo = int (fxD.at (db + 4));
        float wetG = fxD.at (db + 5);
        int   wp   = fxI.at (ib);

        // DC blockers on the inputs: a DC offset would be amplified by the feedback
        float hpA   = 1.0f - clamp (float (twoPi) * 60.0f * dt, 0.0001f, 0.5f);
        float rvL   = x[0] - fxF.at (fb)      + hpA * fxF.at (fb + 1);
        float rvR   = x[1] - fxF.at (fb + 24) + hpA * fxF.at (fb + 25);
        fxF.at (fb)      = x[0];
        fxF.at (fb + 1)  = rvL;
        fxF.at (fb + 24) = x[1];
        fxF.at (fb + 25) = rvR;

        // pre-delay
        rvWr (ab + 172032, 8191, wp, rvL);
        rvWr (ab + 180480, 8191, wp, rvR);
        int   pdI = clamp (int (preS), 0, 8000);
        float pL  = rvRd (ab + 172032, 8191, wp, pdI);
        float pR  = rvRd (ab + 180480, 8191, wp, pdI);

        float tL = 0.0f;
        float tR = 0.0f;

        if (algo == 0)
        {
            // ---- Zita-rev1: 8 delay lines with allpass feedback, Hadamard mixing, per-line RT60 filters ----
            float t0 = 0.3f * pL;
            float t1 = 0.3f * pR;
            float[8] z;

            for (int i = 0; i < 8; ++i)
            {
                float tin = t0;
                if (i >= 2) tin = -t0;
                if (i >= 4) tin = t1;
                if (i >= 6) tin = -t1;

                int   k1 = int (fxArena.at (ab + 180256 + i));
                int   dl = int (fxArena.at (ab + 180264 + i));
                float c  = 0.6f;
                if ((i & 1) != 0) c = -0.6f;

                float xin = rvRd (ab + 32768 + i * 16384, 16383, wp, dl) + tin;
                float zc  = rvRd (ab + i * 4096, 4095, wp, k1);
                xin -= c * zc;
                rvWr (ab + i * 4096, 4095, wp, xin);
                z.at (i) = zc + c * xin;
            }

            for (int st = 1; st < 8; st *= 2)
            {
                for (int i = 0; i < 8; ++i)
                {
                    if ((i & st) == 0)
                    {
                        float va = z.at (i);
                        float vb = z.at (i + st);
                        z.at (i)      = va + vb;
                        z.at (i + st) = va - vb;
                    }
                }
            }

            float wl = fxArena.at (ab + 180272);
            tL = wl * (z.at (1) + z.at (2));
            tR = wl * (z.at (1) - z.at (2));

            for (int i = 0; i < 8; ++i)
            {
                float gmf = fxArena.at (ab + 180224 + i * 4);
                float glo = fxArena.at (ab + 180225 + i * 4);
                float wlo = fxArena.at (ab + 180226 + i * 4);
                float whi = fxArena.at (ab + 180227 + i * 4);
                float v   = 0.35355339f * z.at (i);
                float slo = fxF.at (fb + 6 + i * 2);
                float shi = fxF.at (fb + 7 + i * 2);
                slo += wlo * (v - slo) + 1.0e-10f;
                v   += glo * slo;
                shi += whi * (v - shi);
                fxF.at (fb + 6 + i * 2) = slo;
                fxF.at (fb + 7 + i * 2) = shi;
                rvWr (ab + 32768 + i * 16384, 16383, wp, gmf * shi);
            }
        }
        else
        {
            // ---- Dattorro plate: bandwidth, 4 input allpasses, two cross-coupled tank halves with modulated allpasses ----
            float decay = fxD.at (db + 8);
            float dmp   = fxD.at (db + 9);
            float g2    = clamp (decay + 0.15f, 0.25f, 0.5f);
            float inp   = 0.5f * (pL + pR) * 0.5f;

            float bwS = fxF.at (fb + 28);
            bwS += 0.9995f * (inp - bwS);
            fxF.at (fb + 28) = bwS;

            float d1 = rvAp (ab,        2047, wp, int (fxArena.at (ab + 180288)), 0.75f,  bwS);
            float d2 = rvAp (ab + 2048, 2047, wp, int (fxArena.at (ab + 180289)), 0.75f,  d1);
            float d3 = rvAp (ab + 4096, 2047, wp, int (fxArena.at (ab + 180290)), 0.625f, d2);
            float d4 = rvAp (ab + 6144, 2047, wp, int (fxArena.at (ab + 180291)), 0.625f, d3);

            // slow modulation of the first tank allpasses
            float64 ph0 = fxPh.at (s * 4)     + 0.9 * processor.period;
            float64 ph1 = fxPh.at (s * 4 + 1) + 1.15 * processor.period;
            if (ph0 >= 1.0) ph0 -= 1.0;
            if (ph1 >= 1.0) ph1 -= 1.0;
            fxPh.at (s * 4)     = ph0;
            fxPh.at (s * 4 + 1) = ph1;
            float exc = fxArena.at (ab + 180318);
            float mL  = exc * float (sin (float64 (twoPi) * ph0));
            float mR  = exc * float (sin (float64 (twoPi) * ph1));

            float fbL = fxF.at (fb + 22);
            float fbR = fxF.at (fb + 23);

            // left half: modulated allpass, delay, damping, allpass, delay
            float a1 = rvApMod (ab + 8192, 16383, wp, fxArena.at (ab + 180292) + mL, 0.7f, d4 + fbR);
            rvWr (ab + 24576, 16383, wp, a1);
            float e1 = rvRd (ab + 24576, 16383, wp, int (fxArena.at (ab + 180293)));
            float lpl = (1.0f - dmp) * e1 + dmp * fxF.at (fb + 26) + 1.0e-10f;
            fxF.at (fb + 26) = lpl;
            float a2 = rvAp (ab + 40960, 16383, wp, int (fxArena.at (ab + 180294)), g2, lpl * decay);
            rvWr (ab + 57344, 16383, wp, a2);
            float e2 = rvRd (ab + 57344, 16383, wp, int (fxArena.at (ab + 180295)));

            // right half
            float b1 = rvApMod (ab + 73728, 16383, wp, fxArena.at (ab + 180296) + mR, 0.7f, d4 + fbL);
            rvWr (ab + 90112, 16383, wp, b1);
            float f1 = rvRd (ab + 90112, 16383, wp, int (fxArena.at (ab + 180297)));
            float lpr = (1.0f - dmp) * f1 + dmp * fxF.at (fb + 27) + 1.0e-10f;
            fxF.at (fb + 27) = lpr;
            float b2 = rvAp (ab + 106496, 16383, wp, int (fxArena.at (ab + 180298)), g2, lpr * decay);
            rvWr (ab + 122880, 16383, wp, b2);
            float f2 = rvRd (ab + 122880, 16383, wp, int (fxArena.at (ab + 180299)));

            fxF.at (fb + 22) = e2 * decay;
            fxF.at (fb + 23) = f2 * decay;

            // output taps (Dattorro's table)
            tL = rvRd (ab + 90112, 16383, wp, int (fxArena.at (ab + 180300)))
               + rvRd (ab + 90112, 16383, wp, int (fxArena.at (ab + 180301)))
               - rvRd (ab + 106496, 16383, wp, int (fxArena.at (ab + 180302)))
               + rvRd (ab + 122880, 16383, wp, int (fxArena.at (ab + 180303)))
               - rvRd (ab + 24576, 16383, wp, int (fxArena.at (ab + 180304)))
               - rvRd (ab + 40960, 16383, wp, int (fxArena.at (ab + 180305)))
               - rvRd (ab + 57344, 16383, wp, int (fxArena.at (ab + 180306)));
            tR = rvRd (ab + 24576, 16383, wp, int (fxArena.at (ab + 180307)))
               + rvRd (ab + 24576, 16383, wp, int (fxArena.at (ab + 180308)))
               - rvRd (ab + 40960, 16383, wp, int (fxArena.at (ab + 180309)))
               + rvRd (ab + 57344, 16383, wp, int (fxArena.at (ab + 180310)))
               - rvRd (ab + 90112, 16383, wp, int (fxArena.at (ab + 180311)))
               - rvRd (ab + 106496, 16383, wp, int (fxArena.at (ab + 180312)))
               - rvRd (ab + 122880, 16383, wp, int (fxArena.at (ab + 180313)));
        }

        fxI.at (ib) = (wp + 1) & 16777215;

        float rvMid  = (tL + tR) * 0.5f;
        float rvSide = (tL - tR) * 0.5f * rvW;
        float rawL   = (rvMid + rvSide) * wetG;
        float rawR   = (rvMid - rvSide) * wetG;

        // DC blocker on the output (removes any offset left in the tail)
        float outA = 1.0f - clamp (float (twoPi) * 8.0f * dt, 0.0001f, 0.5f);
        float oL   = rawL - fxF.at (fb + 2) + outA * fxF.at (fb + 3);
        float oR   = rawR - fxF.at (fb + 4) + outA * fxF.at (fb + 5);
        fxF.at (fb + 2) = rawL;
        fxF.at (fb + 3) = oL;
        fxF.at (fb + 4) = rawR;
        fxF.at (fb + 5) = oR;

        return float<2> (x[0] + oL, x[1] + oR);
    }

    // one channel of a state-variable filter (Cytomic TPT form); fb is the slot's float state base
    // one-pole TPT low-pass stage (state at fxF[idx])
    float fxOnePole (int idx, float x, float g)
    {
        float gg = g / (1.0f + g);
        float st = fxF.at (idx);
        float v  = (x - st) * gg;
        float lp = v + st;
        fxF.at (idx) = lp + v;
        return lp;
    }

    // one TPT state-variable stage (states at fxF[idx], fxF[idx+1]); mode 0 LP, 1 BP, 2 HP, 3 notch, 4 allpass
    float fxSvfStage (int idx, float x, float g, float k, int mode)
    {
        float a1 = 1.0f / (1.0f + g * (g + k));
        float a2 = g * a1;
        float a3 = g * a2;
        float s1 = fxF.at (idx);
        float s2 = fxF.at (idx + 1);
        float v3 = x - s2;
        float v1 = a1 * s1 + a2 * v3;
        float v2 = s2 + a2 * s1 + a3 * v3;

        fxF.at (idx)     = 2.0f * v1 - s1;
        fxF.at (idx + 1) = 2.0f * v2 - s2;

        if (mode == 1) return v1 * k;
        if (mode == 2) return x - k * v1 - v2;
        if (mode == 3) return x - k * v1;
        if (mode == 4) return x - 2.0f * k * v1;
        return v2;
    }

    // the 30 filter types of the Filter page (same maths as the voice filter), on one channel of rack slot s
    // FX-KORG: state variable filter whose damping grows with the band level (saturating positive feedback); mode 0 low-pass, 1 high-pass, 2 band-pass
    float fxSatSvf (int idx, float x, float g, float kr, float sat, int mode)
    {
        float s1 = fxF.at (idx);
        float s2 = fxF.at (idx + 1);
        float a  = abs (s1) * sat;
        float k  = 2.0f - kr + kr * (1.0f - 1.0f / float (sqrt (1.0f + a * a)));
        float a1 = 1.0f / (1.0f + g * (g + k));
        float a2 = g * a1;
        float a3 = g * a2;
        float v3 = x - s2;
        float v1 = a1 * s1 + a2 * v3;
        float v2 = s2 + a2 * s1 + a3 * v3;

        fxF.at (idx)     = 2.0f * v1 - s1;
        fxF.at (idx + 1) = 2.0f * v2 - s2;

        if (mode == 1) return x - k * v1 - v2;
        if (mode == 2) return v1;
        return v2;
    }

    // FX-FILTERS: OTA style saturation (slope 1 at 0, limit +-2) and an OTA one-pole stage (state at fxF[idx])
    float fxOta (float d)
    {
        return softClip (d * 0.5f) * 2.0f;
    }

    float fxOtaPole (int idx, float x, float g)
    {
        float gg = g / (1.0f + g);
        float st = fxF.at (idx);
        float v  = fxOta (x - st) * gg;
        float lp = v + st;
        fxF.at (idx) = lp + v;
        return lp;
    }

    // Polivoks / Steiner-Parker style state variable stage: the integrator states are limited (asym > 0 makes the limit asymmetric); modes 0 LP, 1 BP, 2 HP, 3 notch
    float fxLimSvf (int idx, float x, float g, float k, float lim, float asym, int mode)
    {
        float a1 = 1.0f / (1.0f + g * (g + k));
        float a2 = g * a1;
        float a3 = g * a2;
        float s1 = fxF.at (idx);
        float s2 = fxF.at (idx + 1);
        float v3 = x - s2;
        float v1 = a1 * s1 + a2 * v3;
        float v2 = s2 + a2 * s1 + a3 * v3;
        float n1 = 2.0f * v1 - s1;
        float n2 = 2.0f * v2 - s2;

        n1 = softClip (n1 / lim + asym * n1 * n1 / (lim * lim)) * lim;
        n2 = softClip (n2 / (lim * 1.6f)) * lim * 1.6f;

        fxF.at (idx)     = n1;
        fxF.at (idx + 1) = n2;

        if (mode == 1) return v1 * k;
        if (mode == 2) return x - k * v1 - v2;
        if (mode == 3) return x - k * v1;
        return v2;
    }

    float fxFilterX (int s, int ch, float x, float g, float k, float res, float fc, int ft)
    {
        int   b  = s * 40 + ch * 16;
        int   pb = s * 4;
        int   ib = s * 24;
        float sr = float (processor.frequency);

        if (ft == 0)  return fxSvfStage (b + 2, fxSvfStage (b, x, g, k, 0), g, 1.2f, 0);
        if (ft == 1)  return fxSvfStage (b, x, g, k, 0);
        if (ft == 2)  return fxSvfStage (b, x, g, k, 2);
        if (ft == 3)  return fxSvfStage (b, x, g, k, 1);
        if (ft == 4)  return fxOnePole (b, x, g);
        if (ft == 5)  return fxSvfStage (b + 2, fxOnePole (b, x, g), g, k, 0);
        if (ft == 6)  return x - fxOnePole (b, x, g);
        if (ft == 7)  return fxSvfStage (b + 2, x - fxOnePole (b, x, g), g, k, 2);
        if (ft == 8)  return fxSvfStage (b + 2, fxSvfStage (b, x, g, k, 2), g, 1.2f, 2);
        if (ft == 9)  return fxSvfStage (b + 2, fxSvfStage (b, x, g, k, 1), g, k, 1);
        if (ft == 10) return fxSvfStage (b, x, g, k, 3);
        if (ft == 11) return fxSvfStage (b + 2, fxSvfStage (b, x, g, k, 3), g, k, 3);
        if (ft == 12) return x + res * 4.0f * fxSvfStage (b, x, g, 0.6f, 1);
        if (ft == 13) return x + res * 3.0f * fxSvfStage (b, x, g, 1.4f, 0);
        if (ft == 14) return x + res * 3.0f * fxSvfStage (b, x, g, 1.4f, 2);
        if (ft == 15) return fxSvfStage (b, x, g, k, 4);

        if (ft >= 16 && ft <= 18)
        {
            // ladder family: four (three for Acid) one-pole stages with resonance feedback
            float kr = res * 3.9f;
            if (ft == 17) kr = res * 3.2f;
            if (ft == 18) kr = res * 3.6f;

            float y4p = fxF.at (b + 4);
            float u   = softClip (x - kr * y4p);
            float y1  = fxOnePole (b, u, g);
            float y2  = fxOnePole (b + 1, y1, g);
            float y3  = fxOnePole (b + 2, y2, g);

            if (ft == 18)
            {
                fxF.at (b + 4) = y3;
                return y3 * (1.0f + res);
            }

            float y4 = fxOnePole (b + 3, y3, g);
            fxF.at (b + 4) = y4;

            if (ft == 17) return (y3 + y4) * 0.5f;
            return y4 * (1.0f + 0.4f * kr);   // bass makeup for the resonance feedback
        }

        if (ft == 19)
        {
            // dirty low-pass: two saturated 12 dB stages
            float t = fxSvfStage (b, softClip (x * 2.0f), g, k, 0);
            return fxSvfStage (b + 2, softClip (t * 1.5f), g, 1.2f, 0) * 1.3f;
        }

        if (ft == 20 || ft == 21)
        {
            // comb filter (positive / negative feedback), delay = one cycle of the cutoff
            float dly = clamp (sr / max (fc, 20.0f), 2.0f, 2040.0f);
            int   di  = int (dly);
            float fr  = dly - float (di);
            int   w   = fxI.at (ib);
            int   cb  = fxAb (s) + ch * 2048;
            int   r0  = (w - di) & 2047;
            int   r1  = (w - di - 1) & 2047;
            float d   = fxArena.at (cb + r0) * (1.0f - fr) + fxArena.at (cb + r1) * fr;
            float fb  = res * 0.97f;
            if (ft == 21) fb = -fb;

            float yc = x + fb * d;
            fxArena.at (cb + w) = yc;
            return yc * 0.7f;
        }

        if (ft >= 24 && ft <= 27)
        {
            // MG Low 6/12/18/24: Moog-style ladder with the output tapped after stage 1/2/3/4
            float kr  = res * 3.9f;
            float y4p = fxF.at (b + 4);
            float u   = softClip (x * 1.2f - kr * y4p);
            float y1  = fxOnePole (b, u, g);
            float y2  = fxOnePole (b + 1, y1, g);
            float y3  = fxOnePole (b + 2, y2, g);
            float y4  = fxOnePole (b + 3, y3, g);
            fxF.at (b + 4) = y4;

            float mk = 1.1f * (1.0f + 0.4f * kr);
            if (ft == 24) return y1 * mk;
            if (ft == 25) return y2 * mk;
            if (ft == 26) return y3 * mk;
            return y4 * mk;
        }

        if (ft == 28 || ft == 29)
        {
            // Flange+ / Flange-: comb filter whose delay is swept by a slow internal LFO
            float sweep = 1.0f + 0.5f * float (sin (fxPh.at (pb) * 2.0 * pi));
            float dly   = clamp (sr / max (fc, 20.0f) * sweep, 2.0f, 2040.0f);
            int   di    = int (dly);
            float fr    = dly - float (di);
            int   w     = fxI.at (ib);
            int   cb    = fxAb (s) + ch * 2048;
            int   r0    = (w - di) & 2047;
            int   r1    = (w - di - 1) & 2047;
            float d     = fxArena.at (cb + r0) * (1.0f - fr) + fxArena.at (cb + r1) * fr;
            float fb    = res * 0.95f;
            if (ft == 29) fb = -fb;

            float yc = x + fb * d;
            fxArena.at (cb + w) = yc;
            return yc * 0.7f;
        }

        if (ft == 22)
        {
            // phaser: four all-pass stages with feedback
            float fbk = res * 0.85f;
            float a   = x + fbk * fxF.at (b + 8);

            a = 2.0f * fxOnePole (b,     a, g) - a;
            a = 2.0f * fxOnePole (b + 1, a, g) - a;
            a = 2.0f * fxOnePole (b + 2, a, g) - a;
            a = 2.0f * fxOnePole (b + 3, a, g) - a;

            fxF.at (b + 8) = a;
            return 0.5f * (x + a);
        }

        if (ft == 30 || ft == 31)
        {
            // Korg35 low-pass / high-pass (12 dB Sallen-Key, saturating resonance)
            return fxSatSvf (b, x, g, res * 1.96f, 1.4f, ft == 31 ? 1 : 0);
        }

        if (ft == 32)
        {
            // Scream (after Massive): 24 dB low-pass (saturating-resonance stage + plain 12 dB stage) with extra internal feedback of the saturated output
            // back to the input; the Drive knob is the Scream amount (fxD db + 4 = 1 + 8 * knob), Reso is the normal resonance
            float sc = clamp ((fxD.at (s * 16 + 4) - 1.0f) * 0.125f, 0.0f, 1.0f);
            float yp = fxF.at (b + 4);
            float fb = softClip (yp * 2.0f + 0.25f * yp * yp);   // FX-SCREAM: asymmetric saturation of the fed-back output
            float u  = softClip (x * (1.0f + 0.6f * sc) - sc * 3.0f * fb);
            float y1 = fxSatSvf (b, u, g, res * 1.5f, 1.4f, 0);
            float y2 = fxSvfStage (b + 2, y1, g, 1.2f, 0);
            fxF.at (b + 4) = y2;
            return y2 * (1.0f + 0.3f * sc);
        }

        if (ft >= 33)
        {
            // FX-FILTERS: more filter models
            if (ft <= 35)
            {
                // Polivoks: 12 dB OTA state variable filter, hard asymmetric limiting, grainy resonance; 33 LP, 34 BP, 35 HP
                float xi = x * 1.3f + 0.04f * x * x;
                float kp = max (0.03f, 2.0f - 1.97f * res);
                return fxLimSvf (b, xi, g, kp, 0.9f, 0.18f, ft == 33 ? 0 : (ft == 34 ? 1 : 2)) * 1.25f;
            }

            if (ft >= 36 && ft <= 38)
            {
                // four OTA poles with feedback: 36 OTA (Jupiter / IR3109), 37 CEM (Prophet, resonance compensation), 38 SSM (bass thinning resonance)
                float y4p = fxF.at (b + 4);
                float y3p = fxF.at (b + 5);
                float kr  = res * (ft == 37 ? 4.2f : 4.0f);
                float fbv = y4p;

                if (ft == 37) fbv = y4p + 0.15f * (y3p - y4p);
                if (ft == 38) fbv = y4p - fxOnePole (b + 8, y4p, g * 0.15f);   // feedback without lows

                float u  = fxOta (x * (ft == 37 ? 1.1f : 1.0f) - kr * fbv);
                float y1 = fxOtaPole (b, u, g);
                float y2 = fxOtaPole (b + 1, y1, g);
                float y3 = fxOtaPole (b + 2, y2, g);
                float y4 = fxOtaPole (b + 3, y3, g);
                fxF.at (b + 4) = y4;
                fxF.at (b + 5) = y3;

                if (ft == 37) return y4 * (1.0f + 0.5f * kr);
                if (ft == 38) return y4 * (1.0f + 0.15f * kr);
                return y4 * (1.0f + 0.3f * kr);
            }

            if (ft >= 39 && ft <= 42)
            {
                // Oberheim SEM: clean 12 dB multimode, resonance limited below self oscillation, a little saturation; 39 LP, 40 BP, 41 notch, 42 HP
                float ks = 2.0f - 1.8f * res;
                float y  = fxLimSvf (b, x, g, ks, 3.0f, 0.0f, ft == 39 ? 0 : (ft == 40 ? 1 : (ft == 41 ? 3 : 2)));
                return y;
            }

            if (ft == 43)
            {
                // Diode ladder (TB-303 like): four coupled poles, asymmetric input, weak resonance with strong bass loss
                float kr = res * 3.4f;
                float y1p = fxF.at (b + 4);
                float y2p = fxF.at (b + 5);
                float y3p = fxF.at (b + 6);
                float y4p = fxF.at (b + 7);
                float xi  = x * 1.3f - kr * y4p;
                float u   = softClip (xi + 0.12f * xi * xi);
                float y1  = fxOnePole (b,     u  + 0.3f * (y2p - y1p), g);
                float y2  = fxOnePole (b + 1, y1 + 0.3f * (y3p - y2p), g * 0.9f);
                float y3  = fxOnePole (b + 2, y2 + 0.3f * (y4p - y3p), g * 0.8f);
                float y4  = fxOnePole (b + 3, y3, g * 0.7f);
                fxF.at (b + 4) = y1;
                fxF.at (b + 5) = y2;
                fxF.at (b + 6) = y3;
                fxF.at (b + 7) = y4;
                return y4 * (1.0f + 0.35f * kr);
            }

            // 44 / 45 Steiner-Parker: 12 dB with strong, bright resonance; the resonance is fed back before the input stage so that even the high-pass resonates
            float kq = max (0.04f, 2.0f - 1.96f * res);
            return fxLimSvf (b, x * 1.1f, g, kq, 1.4f, 0.0f, ft == 44 ? 0 : 2) * 1.1f;
        }

        // 23: vowel / formant filter, cutoff sweeps A-E-I-O-U
        float p  = clamp (float (log (max (fc, 100.0f) / 100.0f)) / float (log (30.0f)), 0.0f, 1.0f) * 4.0f;
        int   v0 = clamp (int (p), 0, 3);
        float vf = p - float (v0);
        float kq = 2.0f - 1.96f * clamp (0.5f + res * 0.45f, 0.0f, 0.98f);
        float acc = 0.0f;

        float f0 = vowelFreq (v0, 0) * (1.0f - vf) + vowelFreq (v0 + 1, 0) * vf;
        float f1 = vowelFreq (v0, 1) * (1.0f - vf) + vowelFreq (v0 + 1, 1) * vf;
        float f2 = vowelFreq (v0, 2) * (1.0f - vf) + vowelFreq (v0 + 1, 2) * vf;

        acc += fxSvfStage (b,     x, float (tan (float64 (f0) * pi / float64 (sr))), kq, 1);
        acc += fxSvfStage (b + 2, x, float (tan (float64 (f1) * pi / float64 (sr))), kq, 1) * 0.7f;
        acc += fxSvfStage (b + 4, x, float (tan (float64 (f2) * pi / float64 (sr))), kq, 1) * 0.5f;

        return acc * 1.4f;
    }

    // FX-KEYTRACK: a note was played: the key tracking modes of Waveguide (modes 5..9) and Yaybahar (modes 3..5) retune
    void fxKeyDirty()
    {
        for (int ks = 0; ks < 48; ++ks)
        {
            int kt = fxType.at (ks);

            if ((kt == 33 && fxMode.at (ks) >= 3) || (kt == 32 && fxMode.at (ks) >= 5) || (kt >= 36 && kt <= 37 && fxMode.at (ks) >= 3))
                fxDirty.at (ks) = true;
        }
    }

    float fxKeyHz()
    {
        return 440.0f * float (pow (2.0f, float (fxLastNote - 69) / 12.0f));
    }

    // ---- FX-FENV: ADSR of the filter effect ----
    void fxGateUpdate()
    {
        bool h = false;

        for (int fv = 0; fv < 8; ++fv)
            if (voices.at (fv).active && voices.at (fv).stage != 3)
                h = true;

        fxHeld = h;
    }

    // FX-FENV2: the envelope of the filter effect runs like the modulation envelope e (same times, sustain and curves)
    float fxEnvStep (int s, int db)
    {
        int   st = fxEnvSt.at (s);
        float lv = fxEnvLv.at (s);
        int   e  = clamp (int (fxD.at (db + 6) + 0.5f), 0, 9);
        float dt = float (processor.period);

        if (fxEnvSeen.at (s) != fxNoteSeq)
        {
            fxEnvSeen.at (s) = fxNoteSeq;

            if (fxHeld)
                st = 1;
        }

        if (fxHeld)
        {
            if (st == 0 || st == 4)
                st = 1;
        }
        else if (st >= 1 && st <= 3)
            st = 4;

        if (st == 1)
        {
            lv += dt / max (mEnvA.at (e) * 0.001f, 0.0005f);

            if (lv >= 1.0f)
            {
                lv = 1.0f;
                st = 2;
            }
        }
        else if (st == 2 || st == 3)
        {
            float sus = mEnvS.at (e);
            lv += (sus - lv) * clamp (dt * 5.0f / (max (mEnvD.at (e), 1.0f) * 0.001f), 0.0f, 0.99f);
            st = abs (lv - sus) < 0.0005f ? 3 : 2;
        }
        else if (st == 4)
        {
            lv -= lv * clamp (dt * 5.0f / (max (mEnvR.at (e), 1.0f) * 0.001f), 0.0f, 0.99f);

            if (lv < 0.0001f)
            {
                lv = 0.0f;
                st = 0;
            }
        }

        fxEnvSt.at (s) = st;
        fxEnvLv.at (s) = lv;
        return lv;
    }

    float<2> fxFilter (int s, float<2> x)
    {
        int   db  = s * 16;
        int   pb  = s * 4;
        int   ib  = s * 24;
        int   ft  = fxMode.at (s);
        float gd  = fxD.at (db + 4);
        float inL = x[0];
        float inR = x[1];

        if (gd > 1.01f && ft != 32)   // FX-SCREAM: in Scream mode Drive is the Scream (feedback) amount
        {
            inL = softClip (inL * gd);
            inR = softClip (inR * gd);
        }

        float g   = fxD.at (db);
        float k   = fxD.at (db + 1);
        float res = fxD.at (db + 2);
        float fc  = fxD.at (db + 3);
        float eAmt = fxD.at (db + 5);
        float kt   = fxD.at (db + 7);

        // FX-FENV2: key tracking and cutoff smoothing, then the envelope
        float sr   = float (processor.frequency);
        float fcT  = kt > 0.001f ? clamp (fc * float (pow (2.0f, lastKeyV * 4.0f * kt)), 20.0f, sr * 0.45f) : fc;
        float fcS  = fxFcS.at (s);
        bool  mv   = false;

        if (fcS < 1.0f)
            fcS = fcT;

        if (abs (fcT - fcS) > fcT * 0.0003f)
        {
            fcS += (fcT - fcS) * 0.004f;
            mv = true;
        }
        else
            fcS = fcT;

        fxFcS.at (s) = fcS;

        if (abs (eAmt) > 0.001f || mv || kt > 0.001f || abs (fcS - fc) > fc * 0.0003f)
        {
            float lv = abs (eAmt) > 0.001f ? fxEnvStep (s, db) : 0.0f;
            fc = clamp (fcS * float (exp (float64 (eAmt * lv * 7.0f) * 0.6931471805599453)), 20.0f, sr * 0.45f);
            int ec = fxEnvCt.at (s);

            if (ec <= 0)
            {
                fxEnvGc.at (s) = float (tan (float64 (fc) * pi * processor.period));
                ec = 4;
            }

            fxEnvCt.at (s) = ec - 1;
            g = fxEnvGc.at (s);
        }

        float yl = fxFilterX (s, 0, inL, g, k, res, fc, ft);
        float yr = fxFilterX (s, 1, inR, g, k, res, fc, ft);

        // comb / flange write position and the flange sweep advance once per sample
        fxI.at (ib) = (fxI.at (ib) + 1) & 2047;
        float64 ph = fxPh.at (pb) + 0.3 * processor.period;
        if (ph >= 1.0) ph -= 1.0;
        fxPh.at (pb) = ph;

        return float<2> (yl, yr);
    }

    float<2> fxEq (int s, float<2> x)
    {
        int   fb = s * 40;
        int   db = s * 16;
        float yl = x[0];
        float yr = x[1];

        for (int b = 0; b < 3; ++b)
        {
            int   ci = db + b * 5;
            int   zi = fb + b * 4;
            float c0 = fxD.at (ci);
            float c1 = fxD.at (ci + 1);
            float c2 = fxD.at (ci + 2);
            float c3 = fxD.at (ci + 3);
            float c4 = fxD.at (ci + 4);

            float xin = yl;
            float yo  = c0 * xin + fxF.at (zi);
            fxF.at (zi)     = c1 * xin - c3 * yo + fxF.at (zi + 1);
            fxF.at (zi + 1) = c2 * xin - c4 * yo;
            yl = yo;

            xin = yr;
            yo  = c0 * xin + fxF.at (zi + 2);
            fxF.at (zi + 2) = c1 * xin - c3 * yo + fxF.at (zi + 3);
            fxF.at (zi + 3) = c2 * xin - c4 * yo;
            yr = yo;
        }

        return float<2> (yl, yr);
    }

    float<2> fxComp (int s, float<2> x)
    {
        int   fb    = s * 40;
        int   db    = s * 16;
        bool  rms   = fxMode.at (s) == 1;
        float th    = max (fxD.at (db), 0.00001f);
        float det   = max (abs (x[0]), abs (x[1]));
        if (rms) det = det * det;

        float env = fxF.at (fb);
        if (det > env) env = fxD.at (db + 2) * env + (1.0f - fxD.at (db + 2)) * det;
        else           env = fxD.at (db + 3) * env + (1.0f - fxD.at (db + 3)) * det;
        fxF.at (fb) = env;

        float lvl = env;
        if (rms) lvl = float (sqrt (env));

        float gain = 1.0f;
        float kw   = fxD.at (db + 5);

        if (kw < 0.1f)
        {
            if (lvl > th)
                gain = float (pow (lvl / th, fxD.at (db + 1)));
        }
        else if (lvl > 0.00001f)
        {
            // quadratic soft knee in the dB domain
            float lv  = 8.6859f * float (log (lvl / th));
            float ex  = fxD.at (db + 1);
            float red = 0.0f;

            if (lv * 2.0f > kw)
                red = ex * lv;
            else if (lv * 2.0f > -kw)
                red = ex * (lv + kw * 0.5f) * (lv + kw * 0.5f) / (2.0f * kw);

            gain = float (exp (red / 8.6859f));
        }

        int cmd = fxMode.at (s);

        if (cmd >= 3)
        {
            // downward expander / gate: below the threshold the level is pushed further down (ratio = strength)
            float st = (1.0f / (1.0f + fxD.at (db + 1)) - 1.0f) * (cmd == 3 ? 0.5f : 2.0f);
            gain = 1.0f;

            if (lvl < th)
                gain = max (float (pow (max (lvl, 0.000001f) / th, st)), 0.0001f);
        }

        return x * (gain * fxD.at (db + 4));
    }

    // ================= FX-UNI: Unison (FX type 16) =================
    void fxUniDerive (int s)
    {
        int   db = s * 16;
        int   pb = s * 6;
        int   fb = s * 40;
        float sr = float (processor.frequency);
        float dt = float (processor.period);
        float p1 = clamp (fxP.at (pb),     0.0f, 1.0f);
        float p2 = clamp (fxP.at (pb + 1), 0.0f, 1.0f);
        float p3 = clamp (fxP.at (pb + 2), 0.0f, 1.0f);
        float p4 = clamp (fxP.at (pb + 3), 0.0f, 1.0f);
        float p5 = clamp (fxP.at (pb + 4), 0.0f, 1.0f);
        float p6 = clamp (fxP.at (pb + 5), 0.0f, 1.0f);
        int   n    = 2 + int (rint (p1 * 6.0f));
        int   mode = fxMode.at (s);
        float det  = p2 * 100.0f;

        for (int v = 0; v < 8; ++v)
        {
            float lin = n > 1 ? 2.0f * float (v) / float (n - 1) - 1.0f : 0.0f;
            float sg  = lin < 0.0f ? -1.0f : 1.0f;
            float x   = lin;
            float oct = 0.0f;

            if (mode == 1) x = sg * float (pow (abs (lin), 1.5f));
            if (mode == 2) x = sg * float (pow (abs (lin), 0.7f));

            if (mode == 3)
            {
                x = lin * 0.3f;
                if (v % 3 == 1) oct = 1200.0f;
                if (v % 3 == 2) oct = -1200.0f;
            }

            float pan = p3 * lin;
            fxF.at (fb + 8 + v)  = x * det + oct;
            fxF.at (fb + 16 + v) = min (1.0f, 1.4142f * float (cos ((pan + 1.0f) * 0.785398f)));
            fxF.at (fb + 24 + v) = min (1.0f, 1.4142f * float (sin ((pan + 1.0f) * 0.785398f)));
        }

        float w = clamp ((10.0f + 50.0f * p5) * 0.001f * sr, 64.0f, 15000.0f);
        float fc = fxExpMap (p6, 800.0f, 20000.0f);
        fxD.at (db)     = float (n);
        fxD.at (db + 1) = p4 * 12.0f;
        fxD.at (db + 2) = w;
        fxD.at (db + 3) = p6 > 0.995f ? 1.0f : clamp (1.0f - float (exp (-float (twoPi) * fc * dt)), 0.0f, 1.0f);
        fxD.at (db + 4) = 1.0f / float (sqrt (float (n)));
        fxD.at (db + 5) = 1.0f / w;
    }

    float<2> fxUni (int s, float<2> x)
    {
        int   fb    = s * 40;
        int   ib    = s * 24;
        int   db    = s * 16;
        int   ab    = fxAb (s);
        int   n     = int (fxD.at (db) + 0.5f);
        float drift = fxD.at (db + 1);
        float wnd   = fxD.at (db + 2);
        float invW  = fxD.at (db + 5);
        int   pos   = fxI.at (ib);

        if (fxI.at (ib + 1) == 0)
        {
            fxI.at (ib + 1) = 1;

            for (int v = 0; v < 8; ++v)
                fxF.at (fb + v) = float (v) / float (n);
        }

        fxArena.at (ab + pos)         = x[0];
        fxArena.at (ab + 16384 + pos) = x[1];

        float64 dph = fxPh.at (s * 4 + 1) + processor.period * 0.2;
        if (dph >= 1.0) dph -= 1.0;
        fxPh.at (s * 4 + 1) = dph;

        float wl = 0.0f;
        float wr = 0.0f;

        for (int v = 0; v < n; ++v)
        {
            float c  = fxF.at (fb + 8 + v);
            float ga = fxF.at (fb + 16 + v);
            float gb = fxF.at (fb + 24 + v);
            float vl = x[0];
            float vr = x[1];

            if (abs (c) > 0.001f || drift > 0.001f)
            {
                if (drift > 0.001f)
                    c += drift * float (sin (float (twoPi) * (float (v + 1) * float (dph) + float (v) * 0.137f)));

                float ratio = float (exp (c * 0.00057762265f));
                float phi   = fxF.at (fb + v) + (1.0f - ratio) * invW;
                phi -= float (floor (phi));
                fxF.at (fb + v) = phi;

                float sn = float (sin (3.14159265f * phi));
                float w1 = sn * sn;
                float w2 = 1.0f - w1;
                float p2 = phi + 0.5f;
                if (p2 >= 1.0f) p2 -= 1.0f;
                float d1 = phi * wnd + 2.0f;
                float d2 = p2 * wnd + 2.0f;

                vl = fxTapN (ab, 16384, float (pos) - d1) * w1 + fxTapN (ab, 16384, float (pos) - d2) * w2;
                vr = fxTapN (ab + 16384, 16384, float (pos) - d1) * w1 + fxTapN (ab + 16384, 16384, float (pos) - d2) * w2;
            }

            wl += vl * ga;
            wr += vr * gb;
        }

        float g  = fxD.at (db + 4);
        float tc = fxD.at (db + 3);
        float l1 = fxF.at (fb + 32) + tc * (wl * g - fxF.at (fb + 32));
        float r1 = fxF.at (fb + 33) + tc * (wr * g - fxF.at (fb + 33));
        fxF.at (fb + 32) = l1;
        fxF.at (fb + 33) = r1;

        pos += 1;
        if (pos >= 16384) pos = 0;
        fxI.at (ib) = pos;

        return float<2> (l1, r1);
    }

    // ================= FX-CONSOLE: Console channel strip (FX type 17) =================
    void fxConDerive (int s)
    {
        int   db = s * 16;
        int   pb = s * 6;
        float sr = float (processor.frequency);
        float dt = float (processor.period);
        float p1 = clamp (fxP.at (pb),     0.0f, 1.0f);
        float p2 = clamp (fxP.at (pb + 1), 0.0f, 1.0f);
        float p3 = clamp (fxP.at (pb + 2), 0.0f, 1.0f);
        float p4 = clamp (fxP.at (pb + 3), 0.0f, 1.0f);
        float p5 = clamp (fxP.at (pb + 4), 0.0f, 1.0f);
        float p6 = clamp (fxP.at (pb + 5), 0.0f, 1.0f);
        int   bw = clamp (fxMode.at (s), 0, 7) & 3;
        float q  = 0.45f;
        if (bw == 1) q = 1.0f;
        if (bw == 2) q = 2.5f;
        if (bw == 3) q = 6.0f;

        fxBiquad (db,     1, (p2 - 0.5f) * 30.0f, fxExpMap (p1, 45.0f, 3000.0f),   q);
        fxBiquad (db + 5, 1, (p4 - 0.5f) * 30.0f, fxExpMap (p3, 500.0f, 18000.0f), q);

        float d = 1.0f + 5.0f * p5;
        fxD.at (db + 10) = d;
        fxD.at (db + 11) = p6;
        fxD.at (db + 12) = 1.0f / (1.0f + 0.6f * (d - 1.0f));
        float fc = fxExpMap (1.0f - p6, 7000.0f, 22000.0f);
        fxD.at (db + 13) = fc > 20000.0f ? 1.0f : clamp (1.0f - float (exp (-float (twoPi) * fc * dt)), 0.0f, 1.0f);
    }

    // transformer / op-amp stage: tanh saturation, the age adds an asymmetric bias and rounds the highs
    float fxConSat (int s, int ch, float x)
    {
        int   fb  = s * 40;
        int   db  = s * 16;
        float d   = fxD.at (db + 10);
        float age = fxD.at (db + 11);
        float lc  = fxD.at (db + 13);
        float bias = 0.22f * age;
        float y   = (float (tanh (x * d + bias)) - float (tanh (bias))) * fxD.at (db + 12);
        float st  = fxF.at (fb + 8 + ch);
        st += lc * (y - st);
        fxF.at (fb + 8 + ch) = st;
        return st;
    }

    float fxConEq (int s, int ch, float x)
    {
        int   fb = s * 40;
        int   db = s * 16;
        float y  = x;

        for (int b = 0; b < 2; ++b)
        {
            int   ci = db + b * 5;
            int   zi = fb + b * 4 + ch * 2;
            float yo = fxD.at (ci) * y + fxF.at (zi);
            fxF.at (zi)     = fxD.at (ci + 1) * y - fxD.at (ci + 3) * yo + fxF.at (zi + 1);
            fxF.at (zi + 1) = fxD.at (ci + 2) * y - fxD.at (ci + 4) * yo;
            y = yo;
        }

        return y;
    }

    float<2> fxCon (int s, float<2> x)
    {
        bool flip = fxMode.at (s) >= 4;
        float l = x[0];
        float r = x[1];

        if (flip)
            return float<2> (fxConSat (s, 0, fxConEq (s, 0, l)), fxConSat (s, 1, fxConEq (s, 1, r)));

        return float<2> (fxConEq (s, 0, fxConSat (s, 0, l)), fxConEq (s, 1, fxConSat (s, 1, r)));
    }

    // ================= FX-FBANK: Filterbank (FX type 18) =================
    void fxFbDerive (int s)
    {
        int   db = s * 16;
        int   pb = s * 6;
        float sr = float (processor.frequency);
        float p1 = clamp (fxP.at (pb),     0.0f, 1.0f);
        float p2 = clamp (fxP.at (pb + 1), 0.0f, 1.0f);
        float p3 = clamp (fxP.at (pb + 2), 0.0f, 1.0f);
        float p4 = clamp (fxP.at (pb + 3), 0.0f, 1.0f);
        float p5 = clamp (fxP.at (pb + 4), 0.0f, 1.0f);
        float p6 = clamp (fxP.at (pb + 5), 0.0f, 1.0f);
        int   md = clamp (fxMode.at (s), 0, 5);
        int   rt = md % 3;
        bool  mirror = md >= 3;

        float f1 = fxExpMap (p1, 20.0f, 20000.0f);
        float st = float (rint ((p6 - 0.5f) * 48.0f));
        float f2 = f1 * float (pow (2.0f, st / 12.0f));
        float lim = sr * 0.45f;
        f1 = clamp (f1, 20.0f, lim);
        f2 = clamp (f2, 20.0f, lim);

        fxD.at (db)     = float (tan (3.14159265f * f1 / sr));
        fxD.at (db + 1) = float (tan (3.14159265f * f2 / sr));
        fxD.at (db + 2) = 2.0f - 1.84f * p2;
        fxD.at (db + 3) = 2.0f - 1.84f * min (1.0f, p2 * 1.15f);

        float q3 = mirror ? 1.0f - p3 : p3;
        fxD.at (db + 4)  = clamp (1.0f - 2.0f * p3, 0.0f, 1.0f);
        fxD.at (db + 5)  = 1.0f - abs (2.0f * p3 - 1.0f);
        fxD.at (db + 6)  = clamp (2.0f * p3 - 1.0f, 0.0f, 1.0f);
        fxD.at (db + 7)  = p4;
        float d = 1.0f + 7.0f * p5;
        fxD.at (db + 8)  = d;
        fxD.at (db + 9)  = 1.0f / (1.0f + 0.5f * (d - 1.0f));
        fxD.at (db + 10) = clamp (1.0f - 2.0f * q3, 0.0f, 1.0f);
        fxD.at (db + 11) = 1.0f - abs (2.0f * q3 - 1.0f);
        fxD.at (db + 12) = clamp (2.0f * q3 - 1.0f, 0.0f, 1.0f);
        fxD.at (db + 13) = rt == 0 ? 0.0f : (rt == 1 ? 1.0f : 0.5f);
    }

    // one multimode filter (TPT state variable): response mix of low / band / high pass with the anti-mix crossfade to the notch
    float fxFbStage (int zi, float x, float g, float k, float wl, float wb, float wh, float c)
    {
        float s1  = fxF.at (zi);
        float s2  = fxF.at (zi + 1);
        float hp  = (x - (k + g) * s1 - s2) / (1.0f + k * g + g * g);
        float bp  = g * hp + s1;
        float lp  = g * bp + s2;
        fxF.at (zi)     = g * hp + bp;
        fxF.at (zi + 1) = g * bp + lp;
        float bn  = bp * k;
        float y   = wl * lp + wb * bn + wh * hp;
        y += c * (lp + hp - bn - y);
        return float (tanh (y * 0.8f)) * 1.25f;
    }

    float fxFbCh (int s, int ch, float x)
    {
        int   fb = s * 40 + ch * 8;
        int   db = s * 16;
        float d  = fxD.at (db + 8);
        float u  = d > 1.001f ? float (tanh (x * d)) * fxD.at (db + 9) : x;
        float c  = fxD.at (db + 7);
        float a  = fxFbStage (fb,     u, fxD.at (db),     fxD.at (db + 2), fxD.at (db + 4),  fxD.at (db + 5),  fxD.at (db + 6),  c);
        float b2 = fxFbStage (fb + 2, u, fxD.at (db + 1), fxD.at (db + 3), fxD.at (db + 10), fxD.at (db + 11), fxD.at (db + 12), c);
        float sr = fxFbStage (fb + 4, a, fxD.at (db + 1), fxD.at (db + 3), fxD.at (db + 10), fxD.at (db + 11), fxD.at (db + 12), c);
        float ser = fxD.at (db + 13);
        return (1.0f - ser) * 0.5f * (a + b2) + ser * sr;
    }

    float<2> fxFb (int s, float<2> x)
    {
        return float<2> (fxFbCh (s, 0, x[0]), fxFbCh (s, 1, x[1]));
    }

    // ================= FX-AW: Airwindows effects (FX types 19..26) =================
    // Ports of Airwindows plugins by Chris Johnson (MIT licence, https://github.com/airwindows/airwindows). Computed in float64; state awS[s * 40 + ...], derived awD[s * 24 + ...].
    // 19 PurestDrive, 20 Spiral2, 21 Drive, 22 Tube2, 23 Density2, 24 Console7Channel, 25 Channel9 (mode = console type), 26 ToTape6.

    float64 awExp (float64 n, float64 lo, float64 hi)
    {
        return lo * pow (hi / lo, n);
    }

    void awDerive (int s)
    {
        int     ty = fxType.at (s);
        int     db = s * 24;
        int     pb = s * 6;
        float64 sr = float64 (processor.frequency);
        float64 os = sr / 44100.0;
        float64 a  = clamp (float64 (fxP.at (pb)),     0.0, 1.0);
        float64 b  = clamp (float64 (fxP.at (pb + 1)), 0.0, 1.0);
        float64 c  = clamp (float64 (fxP.at (pb + 2)), 0.0, 1.0);
        float64 d  = clamp (float64 (fxP.at (pb + 3)), 0.0, 1.0);
        float64 e  = clamp (float64 (fxP.at (pb + 4)), 0.0, 1.0);

        if (ty == 19)
            awD.at (db) = a;

        if (ty == 20)
        {
            awD.at (db)     = pow (a * 2.0, 2.0);
            awD.at (db + 1) = pow (b, 3.0) / os;
            awD.at (db + 2) = c;
            awD.at (db + 3) = d;
        }

        if (ty == 21)
        {
            awD.at (db)     = pow (a * 2.0, 2.0);
            awD.at (db + 1) = pow (b, 3.0) / os;
            awD.at (db + 2) = c;
        }

        if (ty == 22)
        {
            int pf = int (9.0 * (1.0 - b)) + 1;
            awD.at (db)     = a;
            awD.at (db + 1) = float64 (pf);
            awD.at (db + 2) = 1.0 / float64 (pf + 1);
            awD.at (db + 3) = 1.0 + 1.0 / float64 (pf);
            awD.at (db + 4) = os > 1.9 ? 1.0 : 0.0;
        }

        if (ty == 23)
        {
            float64 density = a * 5.0 - 1.0;
            float64 o       = abs (density);

            while (o > 1.0)
                o -= 1.0;

            awD.at (db)     = density * abs (density);
            awD.at (db + 1) = o;
            awD.at (db + 2) = pow (b, 3.0) / os;
            awD.at (db + 3) = c;
        }

        if (ty == 24)
        {
            float64 fc   = min (20000.0 / sr, 0.49);
            float64 q    = 1.618033988749894848;
            float64 k    = tan (3.14159265358979 * fc);
            float64 norm = 1.0 / (1.0 + k / q + k * k);
            awD.at (db)     = a * 1.272019649514069;
            awD.at (db + 1) = k * k * norm;
            awD.at (db + 2) = 2.0 * k * k * norm;
            awD.at (db + 3) = k * k * norm;
            awD.at (db + 4) = 2.0 * (k * k - 1.0) * norm;
            awD.at (db + 5) = (1.0 - k / q + k * k) * norm;
        }

        if (ty == 25)
        {
            int     m   = clamp (fxMode.at (s), 0, 4);
            float64 iir = 0.005832;  float64 thr = 0.33362176;  float64 cut = 28811.0;

            if (m == 1) { iir = 0.004096; thr = 0.59969536; cut = 27216.0; }
            if (m == 2) { iir = 0.004913; thr = 0.84934656; cut = 23011.0; }
            if (m == 3) { iir = 0.009216; thr = 0.149;      cut = 18544.0; }
            if (m == 4) { iir = 0.011449; thr = 0.092;      cut = 19748.0; }

            float64 density  = a * 2.0;
            float64 phattity = max (density - 1.0, 0.0);
            density = min (density, 1.0);

            float64 fc = cut / sr;
            float64 k  = tan (3.14159265358979 * min (fc, 0.49));
            float64 qa = 1.618033988749894848;
            float64 qb = 0.618033988749894848;
            float64 na = 1.0 / (1.0 + k / qa + k * k);
            float64 nb = 1.0 / (1.0 + k / qb + k * k);
            awD.at (db)      = iir / os;
            awD.at (db + 1)  = thr;
            awD.at (db + 2)  = density;
            awD.at (db + 3)  = phattity;
            awD.at (db + 4)  = 5.0 - density;
            awD.at (db + 5)  = b;
            awD.at (db + 6)  = fc < 0.49999 ? 1.0 : 0.0;
            awD.at (db + 7)  = k * k * na;
            awD.at (db + 8)  = 2.0 * (k * k - 1.0) * na;
            awD.at (db + 9)  = (1.0 - k / qa + k * k) * na;
            awD.at (db + 10) = k * k * nb;
            awD.at (db + 11) = 2.0 * (k * k - 1.0) * nb;
            awD.at (db + 12) = (1.0 - k / qb + k * k) * nb;
        }

        if (ty == 26)
        {
            float64 inputgain = pow (10.0, ((a - 0.5) * 24.0) / 20.0);
            float64 soften    = b * b;
            float64 k1        = tan (3.14159265358979 * (0.007 / os));
            float64 q1        = 0.0009;
            float64 n1        = 1.0 / (1.0 + k1 / q1 + k1 * k1);
            float64 k2        = tan (3.14159265358979 * (0.032 / os));
            float64 q2        = 0.0007;
            float64 n2        = 1.0 / (1.0 + k2 / q2 + k2 * k2);
            awD.at (db)      = inputgain;
            awD.at (db + 1)  = (1.0 - soften * 0.45) / os;
            awD.at (db + 2)  = c * 0.25 * inputgain;
            awD.at (db + 3)  = 0.12 / os;
            awD.at (db + 4)  = k1 / q1 * n1;
            awD.at (db + 5)  = 2.0 * (k1 * k1 - 1.0) * n1;
            awD.at (db + 6)  = (1.0 - k1 / q1 + k1 * k1) * n1;
            awD.at (db + 7)  = k2 / q2 * n2;
            awD.at (db + 8)  = 2.0 * (k2 * k2 - 1.0) * n2;
            awD.at (db + 9)  = (1.0 - k2 / q2 + k2 * k2) * n2;
            awD.at (db + 10) = pow (10.0, ((e - 0.5) * 24.0) / 20.0);
            awD.at (db + 11) = d * d * os * 70.0;
            awD.at (db + 12) = (0.0024 * d * d) / os;
        }

        if (ty == 27)   // FX-AW-MACK
        {
            float64 fc = min (19160.0 / sr, 0.49);
            float64 k  = tan (3.14159265358979 * fc);
            float64 q0 = 0.431684981684982;
            float64 q1 = 1.1582298;
            float64 q2 = 0.657027382751269;
            float64 q3 = 1.076210852946577;
            float64 n0 = 1.0 / (1.0 + k / q0 + k * k);
            float64 n1 = 1.0 / (1.0 + k / q1 + k * k);
            float64 n2 = 1.0 / (1.0 + k / q2 + k * k);
            float64 n3 = 1.0 / (1.0 + k / q3 + k * k);
            float64 tr = a * 10.0;
            awD.at (db)      = tr * tr;
            awD.at (db + 1)  = pow (b, 2.0) * 4.0;
            awD.at (db + 2)  = sqrt (b);
            awD.at (db + 3)  = pow (c, 2.0) * 4.0;
            awD.at (db + 4)  = sqrt (c);
            awD.at (db + 5)  = d;
            awD.at (db + 6)  = 0.001860867 / os;
            awD.at (db + 7)  = 0.000287496 / os;
            awD.at (db + 8)  = 0.159 / os;
            awD.at (db + 9)  = 0.236 / os;
            awD.at (db + 10) = k * k * n0;  awD.at (db + 11) = 2.0 * (k * k - 1.0) * n0;  awD.at (db + 12) = (1.0 - k / q0 + k * k) * n0;
            awD.at (db + 13) = k * k * n1;  awD.at (db + 14) = 2.0 * (k * k - 1.0) * n1;  awD.at (db + 15) = (1.0 - k / q1 + k * k) * n1;
            awD.at (db + 16) = k * k * n2;  awD.at (db + 17) = 2.0 * (k * k - 1.0) * n2;  awD.at (db + 18) = (1.0 - k / q2 + k * k) * n2;
            awD.at (db + 19) = k * k * n3;  awD.at (db + 20) = 2.0 * (k * k - 1.0) * n3;  awD.at (db + 21) = (1.0 - k / q3 + k * k) * n3;
        }
    }

    // alternating tiny offset (keeps the filter memories out of the denormal range)
    float64 awNoise (int s)
    {
        return awS.at (s * 40 + 39) > 0.5 ? 1.0e-20 : -1.0e-20;
    }

    void awFlip (int s)
    {
        awS.at (s * 40 + 39) = awS.at (s * 40 + 39) > 0.5 ? 0.0 : 1.0;
    }

    // ---- PurestDrive ----
    float64 awPurestCh (int s, int c, float64 x)
    {
        int     sb = s * 40;
        float64 i  = awD.at (s * 24);
        float64 sn = sin (x);
        float64 ap = (abs (awS.at (sb + c) + sn) * 0.5) * i;
        awS.at (sb + c) = sin (x);
        return x * (1.0 - ap) + sn * ap;
    }

    float<2> fxAwPurest (int s, float<2> x)
    {
        float64 n = awNoise (s);
        float64 l = awPurestCh (s, 0, float64 (x[0]) + n);
        float64 r = awPurestCh (s, 1, float64 (x[1]) + n);
        awFlip (s);
        return float<2> (float (l), float (r));
    }

    // ---- Spiral2 ----
    float64 awSpiralCh (int s, int c, float64 x, bool flip)
    {
        int     sb   = s * 40;
        int     db   = s * 24;
        float64 gain = awD.at (db);
        float64 iir  = awD.at (db + 1);
        float64 pres = awD.at (db + 2);
        float64 outp = awD.at (db + 3);
        float64 dry  = x;
        float64 prev = awS.at (sb + 4 + c);

        if (gain != 1.0)
        {
            x    *= gain;
            prev *= gain;
        }

        if (flip)
        {
            float64 v = awS.at (sb + c) * (1.0 - iir) + x * iir;
            awS.at (sb + c) = v;
            x -= v;
        }
        else
        {
            float64 v = awS.at (sb + 2 + c) * (1.0 - iir) + x * iir;
            awS.at (sb + 2 + c) = v;
            x -= v;
        }

        float64 ps = sin (x * abs (prev)) / (prev == 0.0 ? 1.0 : abs (prev));
        x = sin (x * abs (x)) / (abs (x) == 0.0 ? 1.0 : abs (x));

        if (outp < 1.0)
        {
            x  *= outp;
            ps *= outp;
        }

        if (pres > 0.0)
            x = x * (1.0 - pres) + ps * pres;

        awS.at (sb + 4 + c) = dry;
        return x;
    }

    float<2> fxAwSpiral (int s, float<2> x)
    {
        float64 n = awNoise (s);
        bool    f = awS.at (s * 40 + 39) > 0.5;
        float64 l = awSpiralCh (s, 0, float64 (x[0]) + n, f);
        float64 r = awSpiralCh (s, 1, float64 (x[1]) + n, f);
        awFlip (s);
        return float<2> (float (l), float (r));
    }

    // ---- Drive ----
    float64 awDriveCh (int s, int c, float64 x, bool flip)
    {
        int     sb    = s * 40;
        int     db    = s * 24;
        float64 drive = awD.at (db);
        float64 iir   = awD.at (db + 1);
        float64 outp  = awD.at (db + 2);

        if (flip)
        {
            float64 v = awS.at (sb + c) * (1.0 - iir) + x * iir;
            awS.at (sb + c) = v;
            x -= v;
        }
        else
        {
            float64 v = awS.at (sb + 2 + c) * (1.0 - iir) + x * iir;
            awS.at (sb + 2 + c) = v;
            x -= v;
        }

        x = clamp (x, -1.0, 1.0);

        float64 glitch = 0.60;
        float64 o      = drive;

        while (o > glitch)
        {
            o -= glitch;
            x -= x * (abs (x) * glitch) * (abs (x) * glitch);
            x *= 1.0 + glitch;
        }

        x -= x * (abs (x) * o) * (abs (x) * o);
        x *= 1.0 + o;

        if (outp < 1.0)
            x *= outp;

        return x;
    }

    float<2> fxAwDrive (int s, float<2> x)
    {
        float64 n = awNoise (s);
        bool    f = awS.at (s * 40 + 39) > 0.5;
        float64 l = awDriveCh (s, 0, float64 (x[0]) + n, f);
        float64 r = awDriveCh (s, 1, float64 (x[1]) + n, f);
        awFlip (s);
        return float<2> (float (l), float (r));
    }

    // ---- Tube2 ----
    float64 awTubeCh (int s, int c, float64 x)
    {
        int     sb    = s * 40;
        int     db    = s * 24;
        float64 pad   = awD.at (db);
        int     pf    = int (awD.at (db + 1) + 0.5);
        float64 gs    = awD.at (db + 2);
        float64 os2   = awD.at (db + 3);
        bool    hiSr  = awD.at (db + 4) > 0.5;

        if (pad < 1.0)
            x *= pad;

        if (hiSr)
        {
            float64 st = x;
            x = (x + awS.at (sb + c)) * 0.5;
            awS.at (sb + c) = st;
        }

        x = clamp (x, -1.0, 1.0);

        float64 asym = float64 (pf);
        x /= asym;
        float64 sharpen = -x;
        sharpen = sharpen > 0.0 ? 1.0 + sqrt (sharpen) : 1.0 - sqrt (-sharpen);
        x -= x * abs (x) * sharpen * 0.25;
        x *= asym;

        float64 factor = x;

        for (int k = 0; k < pf; ++k)
            factor *= x;

        if ((pf % 2 == 1) && x != 0.0)
            factor = (factor / x) * abs (x);

        factor *= gs;
        x -= factor;
        x *= os2;

        if (hiSr)
        {
            float64 st = x;
            x = (x + awS.at (sb + 2 + c)) * 0.5;
            awS.at (sb + 2 + c) = st;
        }

        float64 slew = awS.at (sb + 4 + c) - x;

        if (hiSr)
        {
            float64 st = x;
            x = (x + awS.at (sb + 4 + c)) * 0.5;
            awS.at (sb + 4 + c) = st;
        }
        else
            awS.at (sb + 4 + c) = x;

        slew = slew > 0.0 ? 1.0 + sqrt (slew) * 0.5 : 1.0 - sqrt (-slew) * 0.5;
        x -= x * abs (x) * slew * gs;
        x = clamp (x, -0.52, 0.52);
        return x * 1.923076923076923;
    }

    float<2> fxAwTube (int s, float<2> x)
    {
        float64 n = awNoise (s);
        float64 l = awTubeCh (s, 0, float64 (x[0]) + n);
        float64 r = awTubeCh (s, 1, float64 (x[1]) + n);
        awFlip (s);
        return float<2> (float (l), float (r));
    }

    // ---- Density2 ----
    float64 awDensShape (float64 v, float64 density, float64 o)
    {
        float64 count = density;
        float64 br;

        while (count > 1.0)
        {
            br = min (abs (v) * 1.57079633, 1.57079633);
            br = sin (br);
            v  = v > 0.0 ? br : -br;
            count -= 1.0;
        }

        br = min (abs (v) * 1.57079633, 1.57079633);
        br = density > 0.0 ? sin (br) : 1.0 - cos (br);
        return v > 0.0 ? v * (1.0 - o) + br * o : v * (1.0 - o) - br * o;
    }

    float64 awDensityCh (int s, int c, float64 x)
    {
        int     sb      = s * 40 + c * 8;
        int     db      = s * 24;
        float64 density = awD.at (db);
        float64 o       = awD.at (db + 1);
        float64 iir     = awD.at (db + 2);
        float64 outp    = awD.at (db + 3);
        float64 k       = 0.915965594177219015;
        float64 dry     = x;

        float64 half    = (x + awS.at (sb) + ((-awS.at (sb + 1) + awS.at (sb + 2)) * 0.0414213562373095048801688)) * 0.5;
        float64 halfDry = half;
        awS.at (sb + 2) = awS.at (sb + 1);
        awS.at (sb + 1) = awS.at (sb);
        awS.at (sb)     = x;

        awS.at (sb + 4) = awS.at (sb + 4) * (1.0 - iir) + half * iir;
        half -= awS.at (sb + 4);
        half = awDensShape (half, density, o);

        float64 ataC = half - halfDry;
        float64 ataA = awS.at (sb + 5) * k;
        float64 ataB = awS.at (sb + 6) * k;
        ataB += ataC;  ataA -= ataC;  ataC = ataB;
        float64 halfDiff = ataC * k;

        awS.at (sb + 3) = awS.at (sb + 3) * (1.0 - iir) + x * iir;
        x -= awS.at (sb + 3);
        x = awDensShape (x, density, o);

        ataC = x - dry;
        ataA *= k;  ataB *= k;
        ataA += ataC;  ataB -= ataC;  ataC = ataA;
        awS.at (sb + 5) = ataA;
        awS.at (sb + 6) = ataB;
        float64 diff = ataC * k;

        x = dry + ((diff + halfDiff + awS.at (sb + 7)) / 1.187);
        awS.at (sb + 7) = diff * 0.5;
        return x * outp;
    }

    float<2> fxAwDensity (int s, float<2> x)
    {
        float64 n = awNoise (s);
        float64 l = awDensityCh (s, 0, float64 (x[0]) + n);
        float64 r = awDensityCh (s, 1, float64 (x[1]) + n);
        awFlip (s);
        return float<2> (float (l), float (r));
    }

    // ---- Console7Channel ----
    float64 awConsoleCh (int s, int c, float64 x, float64 gc)
    {
        int     sb = s * 40 + c * 4;
        int     db = s * 24;
        float64 o  = awD.at (db + 1) * x + awD.at (db + 2) * awS.at (sb) + awD.at (db + 3) * awS.at (sb + 1)
                     - awD.at (db + 4) * awS.at (sb + 2) - awD.at (db + 5) * awS.at (sb + 3);
        awS.at (sb + 1) = awS.at (sb);
        awS.at (sb)     = x;
        awS.at (sb + 3) = awS.at (sb + 2);
        awS.at (sb + 2) = o;
        x = o;

        if (gc != 1.0)
            x *= gc * gc * gc;

        x = clamp (x, -1.097, 1.097);
        x = ((sin (x * abs (x)) / (abs (x) == 0.0 ? 1.0 : abs (x))) * 0.8) + (sin (x) * 0.2);

        if (gc != 1.0 && gc != 0.0)
            x /= gc;

        return x;
    }

    float<2> fxAwConsole (int s, float<2> x)
    {
        int     sb = s * 40;
        float64 ig = awD.at (s * 24);
        float64 gc = awS.at (sb + 8);

        if (gc < 0.0)
            gc = ig;

        gc = (gc * 64.0 + ig) / 65.0;
        awS.at (sb + 8) = gc;

        float64 n = awNoise (s);
        float64 l = awConsoleCh (s, 0, float64 (x[0]) + n, gc);
        float64 r = awConsoleCh (s, 1, float64 (x[1]) + n, gc);
        awFlip (s);
        return float<2> (float (l), float (r));
    }

    // ---- Channel9 ----
    float64 awChannelCh (int s, int c, float64 x, bool flip)
    {
        int     sb  = s * 40;
        int     db  = s * 24;
        float64 liir = awD.at (db);
        float64 thr  = awD.at (db + 1);
        float64 dens = awD.at (db + 2);
        float64 phat = awD.at (db + 3);
        float64 nl   = awD.at (db + 4);
        float64 outp = awD.at (db + 5);
        bool    bq   = awD.at (db + 6) > 0.5;
        int     ba   = sb + c * 4;
        int     bb   = sb + 8 + c * 4;

        if (bq)
        {
            float64 t = awD.at (db + 7) * x + 2.0 * awD.at (db + 7) * awS.at (ba) + awD.at (db + 7) * awS.at (ba + 1)
                        - awD.at (db + 8) * awS.at (ba + 2) - awD.at (db + 9) * awS.at (ba + 3);
            awS.at (ba + 1) = awS.at (ba);
            awS.at (ba)     = x;
            x = abs (t) < 1.18e-37 ? 0.0 : t;
            awS.at (ba + 3) = awS.at (ba + 2);
            awS.at (ba + 2) = x;
        }

        float64 ds  = abs (2.0 - ((x + nl) / nl));
        int     ii  = flip ? sb + 16 + c * 2 : sb + 17 + c * 2;
        float64 v   = abs (awS.at (ii)) < 1.18e-37 ? 0.0 : awS.at (ii);
        v = v * (1.0 - (liir * ds)) + (x * liir * ds);
        awS.at (ii) = v;
        x -= v;

        float64 dry = x;
        x = clamp (x, -1.0, 1.0);
        float64 phatS = sin (x * 1.57079633);
        x *= 1.2533141373155;
        float64 dist = sin (x * abs (x)) / (abs (x) == 0.0 ? 1.0 : abs (x));
        x = dist;

        if (dens < 1.0)
            x = dry * (1.0 - dens) + dist * dens;

        if (phat > 0.0)
            x = x * (1.0 - phat) + phatS * phat;

        int     la = sb + 20 + c * 3;
        float64 cl = (awS.at (la + 1) - awS.at (la + 2)) * 0.381966011250105;
        cl -= (awS.at (la) - awS.at (la + 1)) * 0.6180339887498948482045;
        cl += x - awS.at (la);
        awS.at (la + 2) = awS.at (la + 1);
        awS.at (la + 1) = awS.at (la);
        awS.at (la)     = x;

        if (cl > thr)  x = awS.at (la + 1) + thr;
        if (-cl > thr) x = awS.at (la + 1) - thr;

        awS.at (la) = awS.at (la) * 0.381966011250105 + x * 0.6180339887498948482045;

        if (outp < 1.0)
            x *= outp;

        if (awD.at (db + 6) > 0.5)
        {
            float64 t = awD.at (db + 10) * x + 2.0 * awD.at (db + 10) * awS.at (bb) + awD.at (db + 10) * awS.at (bb + 1)
                        - awD.at (db + 11) * awS.at (bb + 2) - awD.at (db + 12) * awS.at (bb + 3);
            awS.at (bb + 1) = awS.at (bb);
            awS.at (bb)     = x;
            x = abs (t) < 1.18e-37 ? 0.0 : t;
            awS.at (bb + 3) = awS.at (bb + 2);
            awS.at (bb + 2) = x;
        }

        return x;
    }

    float<2> fxAwChannel (int s, float<2> x)
    {
        float64 n = awNoise (s);
        bool    f = awS.at (s * 40 + 39) > 0.5;
        float64 l = awChannelCh (s, 0, float64 (x[0]) + n, f);
        float64 r = awChannelCh (s, 1, float64 (x[1]) + n, f);
        awFlip (s);
        return float<2> (float (l), float (r));
    }

    // ---- ToTape6 ----
    float64 awTapeBq (int ix, float64 x, float64 b0, float64 a1, float64 a2)
    {
        float64 t = x * b0 + awS.at (ix);
        awS.at (ix)     = -t * a1 + awS.at (ix + 1);
        awS.at (ix + 1) = -x * b0 - t * a2;
        return t;
    }

    float64 awTapeCh (int s, int c, float64 x, bool flip)
    {
        int     sb    = s * 40 + c * 12;
        int     db    = s * 24;
        float64 ig    = awD.at (db);
        float64 roll  = awD.at (db + 1);
        float64 hbc   = awD.at (db + 2);
        float64 hbf   = awD.at (db + 3);
        float64 outg  = awD.at (db + 10);
        float64 vib   = x;
        float64 highs;

        // the mid roller, head bump (two interleaved biquads) and the main biquad (see ToTape6)
        int     im = sb + (flip ? 8 : 9);
        int     ih = sb + (flip ? 10 : 11);
        int     bh = sb + (flip ? 0 : 2);
        int     bm = sb + (flip ? 4 : 6);

        awS.at (im) = awS.at (im) * (1.0 - roll) + x * roll;
        highs = x - awS.at (im);

        float64 hb = awS.at (ih) + x * 0.05;
        hb -= hb * hb * hb * hbf;
        hb = sin (hb);
        hb = awTapeBq (bh, hb, awD.at (db + 4), awD.at (db + 5), awD.at (db + 6));
        hb = asin (clamp (hb, -1.0, 1.0));
        awS.at (ih) = hb;

        x = sin (x);
        x = awTapeBq (bm, x, awD.at (db + 7), awD.at (db + 8), awD.at (db + 9));
        x = asin (clamp (x, -1.0, 1.0));

        float64 ground = vib - x;

        if (ig > 1.0)
            x *= ig;

        float64 soft = 1.0 - cos (min (abs (highs) * 1.57079633, 1.57079633));

        if (highs > 0.0) x -= soft;
        if (highs < 0.0) x += soft;

        float64 suppress = (1.0 - abs (x)) * 0.00013;
        int     ia = sb + 10;
        int     ib = sb + 11;

        if (awS.at (ia) >  suppress) awS.at (ia) -= suppress;
        if (awS.at (ia) < -suppress) awS.at (ia) += suppress;
        if (awS.at (ib) >  suppress) awS.at (ib) -= suppress;
        if (awS.at (ib) < -suppress) awS.at (ib) += suppress;

        x += (awS.at (ia) + awS.at (ib)) * hbc;
        x = clamp (x, -1.0, 1.0);

        float64 mojo = pow (abs (x), 0.25);

        if (mojo > 0.0)
            x = sin (x * mojo * 3.14159265358979 * 0.5) / mojo;

        x += ground;

        if (outg != 1.0)
            x *= outg;

        // ADClip
        float64 refclip = 0.99;
        float64 softn   = 0.618033988749894848204586;
        int     li      = s * 40 + 24 + c;
        float64 last    = awS.at (li);

        if (last >= refclip)  last = x < refclip ? refclip * softn + x * (1.0 - softn) : refclip;
        if (last <= -refclip) last = x > -refclip ? -refclip * softn + x * (1.0 - softn) : -refclip;

        if (x > refclip)  x = last < refclip ? refclip * softn + last * (1.0 - softn) : refclip;
        if (x < -refclip) x = last > -refclip ? -refclip * softn + last * (1.0 - softn) : -refclip;

        awS.at (li) = x;
        return clamp (x, -refclip, refclip);
    }

    float<2> fxAwTape (int s, float<2> x)
    {
        int     sb    = s * 40;
        int     db    = s * 24;
        int     ab    = fxAb (s);
        float64 ig    = awD.at (db);
        float64 depth = awD.at (db + 11);
        float64 ft    = awD.at (db + 12);
        float64 n     = awNoise (s);
        float64 l     = float64 (x[0]) + n;
        float64 r     = float64 (x[1]) + n;
        bool    flip  = awS.at (sb + 39) > 0.5;

        if (ig < 1.0)
        {
            l *= ig;
            r *= ig;
        }

        int gc = int (awS.at (sb + 29));

        if (gc < 0 || gc > 499)
            gc = 499;

        fxArena.at (ab + gc)       = float (l);
        fxArena.at (ab + 500 + gc) = float (r);

        if (depth != 0.0)
        {
            float64 rate  = awS.at (sb + 27);
            float64 sweep = awS.at (sb + 26);
            float64 off   = depth + (depth * rate * rate * sin (sweep));
            float64 fl    = floor (off);
            float64 fr    = off - fl;
            int     i0    = (gc + int (fl)) % 500;
            int     i1    = (gc + int (fl) + 1) % 500;
            l = float64 (fxArena.at (ab + i0))       * (1.0 - fr) + float64 (fxArena.at (ab + i1))       * fr;
            r = float64 (fxArena.at (ab + 500 + i0)) * (1.0 - fr) + float64 (fxArena.at (ab + 500 + i1)) * fr;

            rate = rate * (1.0 - ft) + awS.at (sb + 28) * ft;
            sweep += rate * ft;

            if (sweep >= 6.28318530717959)
            {
                sweep -= 3.14159265358979;
                int rs = fxI.at (s * 24 + 21);
                rs = rs * 1664525 + 1013904223;
                fxI.at (s * 24 + 21) = rs;
                awS.at (sb + 28) = 0.24 + float64 ((rs >> 8) & 16777215) / 16777216.0 * 0.74;
            }

            awS.at (sb + 27) = rate;
            awS.at (sb + 26) = sweep;
        }

        awS.at (sb + 29) = float64 (gc - 1);

        float64 yl = awTapeCh (s, 0, l, flip);
        float64 yr = awTapeCh (s, 1, r, flip);
        awFlip (s);
        return float<2> (float (yl), float (yr));
    }

    // ---- MackEQ (FX type 27): state per channel c at awT[s * 48 + c * 24]: 0..5 one-pole filters A-F, 6 + 4 * f .. biquads A-D (x1, x2, y1, y2) ----
    float64 awMackBq (int ix, float64 x, int cf)
    {
        float64 b0 = awD.at (cf);
        float64 o  = b0 * x + 2.0 * b0 * awT.at (ix) + b0 * awT.at (ix + 1) - awD.at (cf + 1) * awT.at (ix + 2) - awD.at (cf + 2) * awT.at (ix + 3);
        awT.at (ix + 1) = awT.at (ix);
        awT.at (ix)     = x;
        awT.at (ix + 3) = awT.at (ix + 2);
        awT.at (ix + 2) = o;
        return o;
    }

    float64 awMackSat (float64 x)
    {
        x = clamp (x, -1.0, 1.0);
        return x - pow (x, 5.0) * 0.1768;
    }

    float64 awMackIir (int ix, float64 x, float64 amt)
    {
        float64 v = abs (awT.at (ix)) < 1.18e-37 ? 0.0 : awT.at (ix);
        v = v * (1.0 - amt) + x * amt;
        awT.at (ix) = v;
        return v;
    }

    float64 awMackCh (int s, int c, float64 x)
    {
        int     sb = s * 48 + c * 24;
        int     db = s * 24;
        float64 inTrim = awD.at (db),     gainHigh = awD.at (db + 1), outHigh = awD.at (db + 2);
        float64 gainBass = awD.at (db + 3), outBass = awD.at (db + 4), outPad = awD.at (db + 5);
        float64 iirA = awD.at (db + 6), iirB = awD.at (db + 7), iirBM = awD.at (db + 8), iirMH = awD.at (db + 9);

        x -= awMackIir (sb, x, iirA);

        if (inTrim != 1.0)
            x *= inTrim;

        x = awMackBq (sb + 6, x, db + 10);
        x = awMackSat (x);
        x = awMackBq (sb + 10, x, db + 13);
        x -= awMackIir (sb + 1, x, iirB);

        float64 bass = awMackIir (sb + 2, x, iirBM);
        float64 mid  = x - bass;

        if (gainBass != 1.0)
            bass *= gainBass;

        bass = awMackSat (bass);
        bass = awMackIir (sb + 3, bass, iirBM);

        float64 e    = awMackIir (sb + 4, mid, iirMH);
        float64 high = mid - e;
        mid = e;
        high -= awMackIir (sb + 5, high, iirMH);

        if (gainHigh != 1.0)
            high *= gainHigh;

        high = awMackSat (high);
        x = ((bass * outBass) + mid + (high * outHigh)) * 4.0;

        x = awMackBq (sb + 14, x, db + 16);
        x = awMackSat (x);
        x = awMackBq (sb + 18, x, db + 19);

        if (outPad != 1.0)
            x *= outPad;

        return x;
    }

    float<2> fxAwMack (int s, float<2> x)
    {
        float64 n = awNoise (s);
        float64 l = awMackCh (s, 0, float64 (x[0]) + n);
        float64 r = awMackCh (s, 1, float64 (x[1]) + n);
        awFlip (s);
        return float<2> (float (l), float (r));
    }

    // ================= FX-PLASMA: asymmetric distortion with girth noise and a resonant filter (FX type 28) =================
    // style m: 0 Soft, 1 Hard, 2 Fold, 3 Half, 4 Fuzz, 5 Diode, 6 Arctan, 7 Rational, 8 Soft Exp, 9 Ripple, 10 Tri Fold, 11 Cubic
    float plLogCosh (float u)
    {
        float a = abs (u);
        return a + float (log (1.0f + exp (-2.0f * a))) - 0.6931472f;
    }

    float plFn (int m, float u)
    {
        float a = abs (u);

        if (m == 0)  return float (tanh (u));
        if (m == 1)  return clamp (u, -1.0f, 1.0f);
        if (m == 2)  return float (sin (u * 1.5707963f));
        if (m == 3)  return u > 0.0f ? float (tanh (u)) : 0.15f * float (tanh (u));
        if (m == 4)  return u < 0.0f ? -(1.0f - float (exp (-2.0f * a))) : (1.0f - float (exp (-2.0f * a)));
        if (m == 5)  return u >= 0.0f ? 1.0f - float (exp (-u)) : 0.3f * (float (exp (u)) - 1.0f);
        if (m == 6)  return float (atan (u)) * 0.63661977f;
        if (m == 7)  return u / float (sqrt (1.0f + u * u));
        if (m == 8)  return u / (1.0f + a);
        if (m == 9)  return 0.9f * float (tanh (u)) + 0.1f * float (sin (8.0f * u));
        if (m == 10) return 0.63661977f * float (asin (clamp (float (sin (u * 1.5707963f)), -1.0f, 1.0f)));

        if (a <= 1.0f)
            return 1.5f * u - 0.5f * u * u * u;

        return u < 0.0f ? -1.0f : 1.0f;
    }

    // antiderivative of plFn with F (0) = 0
    float plAnti (int m, float u)
    {
        float a = abs (u);

        if (m == 0)  return plLogCosh (u);
        if (m == 1)  return a <= 1.0f ? 0.5f * u * u : a - 0.5f;
        if (m == 2)  return 0.63661977f * (1.0f - float (cos (u * 1.5707963f)));
        if (m == 3)  return u > 0.0f ? plLogCosh (u) : 0.15f * plLogCosh (u);
        if (m == 4)  return a + 0.5f * (float (exp (-2.0f * a)) - 1.0f);
        if (m == 5)  return u >= 0.0f ? u + float (exp (-u)) - 1.0f : 0.3f * (float (exp (u)) - 1.0f - u);
        if (m == 6)  return (u * float (atan (u)) - 0.5f * float (log (1.0f + u * u))) * 0.63661977f;
        if (m == 7)  return float (sqrt (1.0f + u * u)) - 1.0f;
        if (m == 8)  return a - float (log (1.0f + a));
        if (m == 9)  return 0.9f * plLogCosh (u) + 0.0125f * (1.0f - float (cos (8.0f * u)));

        if (a <= 1.0f)
            return 0.75f * u * u - 0.125f * u * u * u * u;

        return a - 0.375f;
    }

    void fxPlDerive (int s)
    {
        float sr = float (processor.frequency);
        int   db = s * 16;
        int   pb = s * 6;
        int   m  = clamp (fxMode.at (s), 0, 11);
        float p1 = clamp (fxP.at (pb),     0.0f, 1.0f);
        float g  = float (pow (10.0f, p1 * 40.0f / 20.0f));
        float bi = (clamp (fxP.at (pb + 1), 0.0f, 1.0f) - 0.5f) * 1.6f;
        float f  = fxExpMap (clamp (fxP.at (pb + 4), 0.0f, 1.0f), 20.0f, 20000.0f);
        float rs = clamp (fxP.at (pb + 5), 0.0f, 1.0f);
        int   ft = clamp (int (clamp (fxP.at (pb + 3), 0.0f, 1.0f) * 4.0f), 0, 3);
        float fm = 0.45f * sr;

        fxD.at (db)      = g;
        fxD.at (db + 1)  = bi;
        fxD.at (db + 2)  = 0.5f / max (abs (plFn (m, 0.5f * g)), 0.25f);           // level compensation
        fxD.at (db + 3)  = clamp (fxP.at (pb + 2), 0.0f, 1.0f);                    // girth
        fxD.at (db + 4)  = float (ft);
        fxD.at (db + 5)  = float (tan (3.14159265f * min (f, fm) / sr));           // filter A
        fxD.at (db + 6)  = 1.414f - 1.364f * rs;                                   // damping (Q 0.7 .. 20)
        fxD.at (db + 7)  = float (tan (3.14159265f * min (f * 0.4f, fm) / sr));    // Dual: high-pass below
        fxD.at (db + 8)  = float (tan (3.14159265f * min (f * 2.0f, fm) / sr));    // Dual: low-pass above
        fxD.at (db + 9)  = clamp (float (twoPi) * 15.0f / sr, 0.0f, 1.0f);         // DC blocker
        fxD.at (db + 10) = rs * 10.0f;                                             // Peak boost
        fxD.at (db + 11) = plFn (m, bi);                                           // static offset of the bias
    }

    float plNoise (int idx)
    {
        plN.at (idx) = (plN.at (idx) * 1103515245L + 12345L) & 2147483647L;
        return float ((plN.at (idx) >> 8) & 65535L) * 0.0000305176f - 1.0f;
    }

    float plCh (int s, int c, float x)
    {
        int   fb = s * 40;
        int   db = s * 16;
        int   m  = clamp (fxMode.at (s), 0, 11);
        float g  = fxD.at (db);
        float u  = x * g + fxD.at (db + 1);
        float gr = fxD.at (db + 3);

        if (gr > 0.0f)   // girth: high-passed noise that follows the signal level erodes the sound
        {
            float nz = plNoise (s * 2 + c);
            float hp = nz - fxF.at (fb + 4 + c);
            fxF.at (fb + 4 + c) = nz;
            u += gr * 0.6f * hp * min (abs (x) * g, 1.0f);
        }

        float up = fxF.at (fb + c);
        fxF.at (fb + c) = u;
        float du = u - up;
        float y;

        if (m == 10 || abs (du) < 0.0001f)
            y = plFn (m, 0.5f * (u + up));
        else
            y = (plAnti (m, u) - plAnti (m, up)) / du;

        y = (y - fxD.at (db + 11)) * fxD.at (db + 2);

        float dc = fxF.at (fb + 2 + c);
        dc += fxD.at (db + 9) * (y - dc);
        fxF.at (fb + 2 + c) = dc;
        y -= dc;

        int   ft = int (fxD.at (db + 4));
        float k  = fxD.at (db + 6);
        int   ia = fb + 6 + c * 2;
        int   ib = fb + 10 + c * 2;

        if (ft == 0)
            y = fxSvfStage (ia, y, fxD.at (db + 5), k, 2);
        else if (ft == 1)
            y = fxSvfStage (ia, y, fxD.at (db + 5), k, 0);
        else if (ft == 2)
        {
            y = fxSvfStage (ia, y, fxD.at (db + 7), k, 2);
            y = fxSvfStage (ib, y, fxD.at (db + 8), k, 0);
        }
        else
            y += fxSvfStage (ia, y, fxD.at (db + 5), 0.5f, 1) * fxD.at (db + 10);

        return y;
    }

    float<2> fxPlasma (int s, float<2> x)
    {
        return float<2> (plCh (s, 0, x[0]), plCh (s, 1, x[1]));
    }

    // ================= FX-MUTABLE: Granular (FX type 29) and Warp (FX type 30) =================
    // ---- Granular: a stereo recording buffer (2 x 98304 samples of the slot arena) read by up to 32 overlapping grains
    float mgWindow (float p, float sh)
    {
        float hann = 0.5f - 0.5f * float (cos (6.2831853f * p));
        float rect = clamp (min (p, 1.0f - p) * 20.0f, 0.0f, 1.0f);
        float q    = (p - 0.5f) / 0.16f;
        float gau  = float (exp (-0.5f * q * q));

        if (sh < 0.5f)
            return rect + (hann - rect) * (sh * 2.0f);

        return hann + (gau - hann) * ((sh - 0.5f) * 2.0f);
    }

    void fxMgDerive (int s)
    {
        float sr = float (processor.frequency);
        int   db = s * 16;
        int   pb = s * 6;
        int   md = clamp (fxMode.at (s), 0, 3);
        float p1 = clamp (fxP.at (pb),     0.0f, 1.0f);
        float p2 = clamp (fxP.at (pb + 1), 0.0f, 1.0f);
        float p3 = clamp (fxP.at (pb + 2), 0.0f, 1.0f);
        float p4 = clamp (fxP.at (pb + 3), 0.0f, 1.0f);
        float p5 = clamp (fxP.at (pb + 4), 0.0f, 1.0f);
        float p6 = clamp (fxP.at (pb + 5), 0.0f, 1.0f);

        fxD.at (db)      = p1 * 90000.0f;                                                       // position: how far behind the write head the grains start
        fxD.at (db + 1)  = clamp (fxExpMap (p2, 0.02f, 0.6f) * sr, 64.0f, 40000.0f);              // grain length
        fxD.at (db + 2)  = float (pow (2.0f, (p3 - 0.5f) * 4.0f));                              // pitch ratio, +-24 semitones
        fxD.at (db + 3)  = 0.3f * float (pow (26.0f, p4));                                      // overlap (grains sounding at once)
        fxD.at (db + 4)  = p5;                                                                  // texture: window shape
        fxD.at (db + 5)  = p6 * (md == 3 ? 0.98f : 0.9f);                                       // feedback
        fxD.at (db + 6)  = p5 * 0.25f * 90000.0f;                                               // texture: scatter of the start position
        fxD.at (db + 7)  = clamp (fxExpMap (p2, 0.05f, 2.0f) * sr, 256.0f, 98300.0f);             // loop length of the looping delay
    }

    float<2> fxGranular (int s, float<2> x)
    {
        int   ib  = s * 24;
        int   fb  = s * 40;
        int   ab  = fxAb (s);
        int   gb  = s * 256;
        int   db  = s * 16;
        int   md  = clamp (fxMode.at (s), 0, 3);
        int   N   = 98304;
        int   wp  = fxI.at (ib + 4);
        float fbk = fxD.at (db + 5);

        if (md == 3)   // looping delay: the input is written into a loop that runs round with feedback
        {
            int L = int (fxD.at (db + 7));

            if (wp >= L)
                wp = 0;

            float oL = fxArena.at (ab + wp);
            float oR = fxArena.at (ab + N + wp);
            fxArena.at (ab + wp)     = clamp (x[0] + fbk * oL, -2.0f, 2.0f);
            fxArena.at (ab + N + wp) = clamp (x[1] + fbk * oR, -2.0f, 2.0f);
            wp++;

            if (wp >= L)
                wp = 0;

            fxI.at (ib + 4) = wp;
            return float<2> (oL, oR);
        }

        float ratio   = fxD.at (db + 2);
        float len     = min (fxD.at (db + 1), 0.45f * float (N) / max (ratio, 1.0f));
        float ovl     = fxD.at (db + 3);
        float tex     = fxD.at (db + 4);
        bool  shifter = md == 2;

        if (shifter)
        {
            ovl = 2.0f;
            tex = 0.5f;
        }

        float tim = fxF.at (fb) - 1.0f;

        if (tim <= 0.0f)
        {
            int gi = -1;

            for (int g = 0; g < 32; ++g)
                if (gi < 0 && mgG.at (gb + g * 8) < 0.5f)
                    gi = g;

            if (gi >= 0)
            {
                float minOff = md == 1 ? 4.0f : max (len * (ratio - 1.0f), 0.0f) + 4.0f;
                float off    = fxD.at (db) * (shifter ? 0.3f : 1.0f);

                if (! shifter)
                    off += fxD.at (db + 6) * (nextNoise() * 0.5f + 0.5f);

                off = clamp (max (off, minOff), 4.0f, float (N) - len * max (ratio, 1.0f) - 8.0f);

                float pan = shifter ? 0.5f : 0.5f + 0.35f * nextNoise();
                float gn  = 1.4142136f / float (sqrt (max (ovl, 1.0f)));
                float st  = float (wp) - off;

                if (st < 0.0f)
                    st += float (N);

                int g8 = gb + gi * 8;
                mgG.at (g8)     = 1.0f;
                mgG.at (g8 + 1) = st;
                mgG.at (g8 + 2) = ratio;
                mgG.at (g8 + 3) = 0.0f;
                mgG.at (g8 + 4) = len;
                mgG.at (g8 + 5) = float (cos (pan * 1.5707963f)) * gn;
                mgG.at (g8 + 6) = float (sin (pan * 1.5707963f)) * gn;
            }

            tim += max (len / ovl * (1.0f + (shifter ? 0.0f : 0.4f) * nextNoise()), 8.0f);
        }

        fxF.at (fb) = tim;

        float aL = 0.0f;
        float aR = 0.0f;

        for (int g = 0; g < 32; ++g)
        {
            int g8 = gb + g * 8;

            if (mgG.at (g8) > 0.5f)
            {
                float pos = mgG.at (g8 + 1);
                float age = mgG.at (g8 + 3);
                float gl  = mgG.at (g8 + 4);
                float w   = mgWindow (age / gl, tex);
                int   i0  = clamp (int (pos), 0, N - 1);
                int   i1  = i0 + 1 >= N ? 0 : i0 + 1;
                float fr  = pos - float (i0);
                aL += (fxArena.at (ab + i0)     * (1.0f - fr) + fxArena.at (ab + i1)     * fr) * w * mgG.at (g8 + 5);
                aR += (fxArena.at (ab + N + i0) * (1.0f - fr) + fxArena.at (ab + N + i1) * fr) * w * mgG.at (g8 + 6);
                pos += mgG.at (g8 + 2);

                if (pos >= float (N))
                    pos -= float (N);

                age += 1.0f;
                mgG.at (g8 + 1) = pos;
                mgG.at (g8 + 3) = age;

                if (age >= gl)
                    mgG.at (g8) = 0.0f;
            }
        }

        if (md != 1)   // Freeze stops the recording
        {
            fxArena.at (ab + wp)     = clamp (x[0] + fbk * aL, -2.0f, 2.0f);
            fxArena.at (ab + N + wp) = clamp (x[1] + fbk * aR, -2.0f, 2.0f);
            wp++;

            if (wp >= N)
                wp = 0;

            fxI.at (ib + 4) = wp;
        }

        return float<2> (aL, aR);
    }

    // ---- Warp: the input is the modulator, an internal oscillator the carrier
    float wpShape (float ph, float sh)
    {
        float sn = float (sin (6.2831853f * ph));
        float tr = 4.0f * abs (ph - 0.5f) - 1.0f;
        float sw = 2.0f * ph - 1.0f;
        float sq = ph < 0.5f ? 1.0f : -1.0f;
        float k  = clamp (sh, 0.0f, 1.0f) * 3.0f;

        if (k < 1.0f) return sn + (tr - sn) * k;
        if (k < 2.0f) return tr + (sw - tr) * (k - 1.0f);
        return sw + (sq - sw) * (k - 2.0f);
    }

    void fxWpDerive (int s)
    {
        int   db = s * 16;
        int   pb = s * 6;
        float p1 = clamp (fxP.at (pb),     0.0f, 1.0f);
        float p2 = clamp (fxP.at (pb + 1), 0.0f, 1.0f);
        float p3 = clamp (fxP.at (pb + 2), 0.0f, 1.0f);
        float p4 = clamp (fxP.at (pb + 3), 0.0f, 1.0f);
        float p5 = clamp (fxP.at (pb + 4), 0.0f, 1.0f);
        float p6 = clamp (fxP.at (pb + 5), 0.0f, 1.0f);

        fxD.at (db)      = fxExpMap (p3, 20.0f, 4000.0f);                                  // carrier frequency / shift in Hz
        fxD.at (db + 1)  = p1;                                                              // amount
        fxD.at (db + 2)  = p2 * 2.0f;                                                       // level
        fxD.at (db + 3)  = p4;                                                              // carrier shape
        fxD.at (db + 4)  = float (pow (10.0f, (p5 - 0.5f) * 24.0f / 20.0f));                // modulator gain
        fxD.at (db + 5)  = p6;
    }

    float wpAp (int idx, float x, float a2)   // one all-pass section of the Hilbert pair: y = a2 x - x[n-2] + a2 y[n-2]
    {
        float y = a2 * x - wpV.at (idx + 1) + a2 * wpV.at (idx + 3);
        wpV.at (idx + 1) = wpV.at (idx);
        wpV.at (idx)     = x;
        wpV.at (idx + 3) = wpV.at (idx + 2);
        wpV.at (idx + 2) = y;
        return y;
    }

    float wpBp (int idx, float x, float g, float k)   // band-pass of a TPT state variable filter, unity gain at the centre
    {
        float a1 = 1.0f / (1.0f + g * (g + k));
        float a2 = g * a1;
        float a3 = g * a2;
        float s1 = wpV.at (idx);
        float s2 = wpV.at (idx + 1);
        float v3 = x - s2;
        float v1 = a1 * s1 + a2 * v3;
        float v2 = s2 + a2 * s1 + a3 * v3;
        wpV.at (idx)     = 2.0f * v1 - s1;
        wpV.at (idx + 1) = 2.0f * v2 - s2;
        return v1 * k;
    }

    // algorithms 0..1 (carrier c, modulator m, amount a); the crossfade / fold / xor / comparator modes live in the oscillator matrices now
    float wpAlg (int md, float a, float c, float m)
    {
        if (md == 0)   // analog ring modulator: the difference of two diode-like curves, the amount makes them harder (more saturation, harsher products)
        {
            float k = 1.0f + 5.0f * a;
            float u = c + m;
            float v = c - m;
            return 0.5f * (u * float (tanh (k * u)) - v * float (tanh (k * v))) / k;
        }

        // digital ring modulator: the product, folded with the amount
        return float (sin (c * m * (1.0f + a * 3.0f) * 1.5707963f * 2.0f));
    }

    float<2> fxWarp (int s, float<2> x)
    {
        int   pb = s * 4;
        int   db = s * 16;
        int   wb = s * 128;
        int   md = clamp (fxMode.at (s), 0, 3);
        float sr = float (processor.frequency);
        float f  = fxD.at (db);
        float a  = fxD.at (db + 1);
        float lv = fxD.at (db + 2);
        float gm = fxD.at (db + 4);
        float p6 = fxD.at (db + 5);
        float64 ph = fxPh.at (pb) + float64 (f / sr);

        if (ph >= 1.0)
            ph -= 1.0;

        fxPh.at (pb) = ph;
        float c  = wpShape (float (ph), fxD.at (db + 3));
        float m0 = x[0] * gm;
        float m1 = x[1] * gm;

        if (md == 3)   // frequency shifter: Hilbert pair and a quadrature oscillator at the shift frequency
        {
            float64 sp = fxPh.at (pb + 1) + float64 ((p6 < 0.5f ? f : -f) / sr);

            if (sp >= 1.0) sp -= 1.0;
            if (sp < 0.0)  sp += 1.0;

            fxPh.at (pb + 1) = sp;
            float cs = float (cos (6.2831853f * float (sp)));
            float sn = float (sin (6.2831853f * float (sp)));
            float yo0 = 0.0f;
            float yo1 = 0.0f;

            for (int ch = 0; ch < 2; ++ch)
            {
                int   hb = wb + ch * 40;
                float v  = ch == 0 ? m0 : m1;
                float ia = wpAp (hb,      v,  0.47942553f);
                ia       = wpAp (hb + 4,  ia, 0.87625358f);
                ia       = wpAp (hb + 8,  ia, 0.97660297f);
                ia       = wpAp (hb + 12, ia, 0.99749985f);
                float qb = wpAp (hb + 16, v,  0.16176015f);
                qb       = wpAp (hb + 20, qb, 0.73297800f);
                qb       = wpAp (hb + 24, qb, 0.94539700f);
                qb       = wpAp (hb + 28, qb, 0.99059050f);
                float id = wpV.at (hb + 32);   // the in-phase path is delayed by one sample
                wpV.at (hb + 32) = ia;
                float o  = id * cs - qb * sn;

                if (ch == 0) yo0 = o; else yo1 = o;
            }

            return float<2> (yo0 * lv, yo1 * lv);
        }

        if (md == 2)   // vocoder: ten bands, the envelopes of the input shape the same bands of the carrier
        {
            float mm  = 0.5f * (m0 + m1);
            float rel = 1.0f - float (exp (-1.0f / (sr * (0.005f + p6 * p6 * 0.4f))));
            float att = 1.0f - float (exp (-1.0f / (sr * 0.002f)));
            float acc = 0.0f;

            for (int b = 0; b < 10; ++b)
            {
                float fc = 150.0f * float (pow (1.5025f, float (b)));
                float g  = float (tan (3.14159265f * min (fc, 0.45f * sr) / sr));
                int   bi = wb + b * 5;
                float mb = wpBp (bi,     mm, g, 0.3f);
                float cb = wpBp (bi + 2, c,  g, 0.3f);
                float en = wpV.at (bi + 4);
                float ab = abs (mb);
                en += (ab > en ? att : rel) * (ab - en);
                wpV.at (bi + 4) = en;
                acc += cb * en;
            }

            float o = acc * 6.0f * lv;
            return float<2> (o, o);
        }

        return float<2> (wpAlg (md, a, c, m0) * lv, wpAlg (md, a, c, m1) * lv);
    }

    // ================= FX-CLOUDSEED: CloudSeed reverb (FX type 31) =================
    // Arena (per channel, 98304 floats at ab + c * 98304): pre-delay 0 (4096), multitap 4096 (8192), early diffuser 12288 (6 x 1024), lines 18432 (8 x 4096),
    // late diffusers 51200 (8 x 4 x 1024).  One sample counter (fxI[s * 24 + 8]) indexes every ring.
    // csV per slot: derived 0..511 (per channel c: tap offsets 0-31, tap gains 32-63, modulation base 64-109, amount 110-155, rate 156-201 for the units
    // 0-5 early stages, 6-13 lines, 14-45 late stages; line feedback 202-209), global 440..); states 512..1023 (per channel 256: input filters 0-1, phases 2-47,
    // current delays 48-93, line feedback 94-101, low shelf 102-133, high shelf 134-165, low-pass 166-173).
    const float[296] csModes = ( 0.0f, 1.0f, 1.0f, 50.0f, 0.0f, 1.0f, 10.0f, 0.77f, 0.36f, 0.6f, 8.0f, 1.0f, 4.0f, 20.0f, 0.85f, 0.37f, 0.06f, 40.0f, 0.68f, 0.095f, 1.0f, 0.0f, 200.0f, -3.0f, 1.0f, 4500.0f, -4.6f, 0.0f, 334.0f, 185.0f, 218.0f, 365.0f, 1.0f, 340.0f, 0.0f, 20000.0f, 0.9f, 0.0f, 1.0f, 1.0f, 50.0f, 1.0f, 4.0f, 10.0f, 0.75f, 0.3f, 0.3f, 8.0f, 1.0f, 3.0f, 15.0f, 0.7f, 0.5f, 0.3f, 45.0f, 1.0f, 0.4f, 1.0f, 0.0f, 200.0f, -3.0f, 1.0f, 6000.0f, -3.0f, 0.5f, 123.0f, 456.0f, 789.0f, 321.0f, 1.0f, 100.0f, 0.0f, 20000.0f, 0.9f, 1.0f, 12.0f, 0.8f, 40.0f, 1.0f, 3.0f, 10.0f, 0.7f, 0.2f, 0.3f, 6.0f, 1.0f, 2.0f, 10.0f, 0.65f, 0.3f, 0.3f, 18.0f, 0.4f, 0.3f, 1.0f, 0.0f, 200.0f, -2.0f, 1.0f, 8000.0f, -2.5f, 0.4f, 555.0f, 111.0f, 222.0f, 333.0f, 1.0f, 80.0f, 0.0f, 20000.0f, 0.9f, 1.0f, 8.0f, 0.6f, 60.0f, 1.0f, 4.0f, 10.0f, 0.8f, 0.3f, 0.3f, 8.0f, 1.0f, 3.0f, 12.0f, 0.7f, 0.4f, 0.3f, 30.0f, 0.7f, 0.3f, 1.0f, 0.0f, 200.0f, -2.0f, 1.0f, 7000.0f, -5.0f, 0.5f, 246.0f, 135.0f, 579.0f, 864.0f, 1.0f, 120.0f, 0.0f, 20000.0f, 0.9f, 0.0f, 1.0f, 1.0f, 50.0f, 1.0f, 5.0f, 15.0f, 0.8f, 0.5f, 0.25f, 8.0f, 1.0f, 4.0f, 20.0f, 0.8f, 0.8f, 0.2f, 70.0f, 1.2f, 0.25f, 1.0f, 1.0f, 200.0f, -3.0f, 1.0f, 5000.0f, -5.0f, 0.7f, 654.0f, 321.0f, 987.0f, 159.0f, 1.0f, 60.0f, 0.0f, 20000.0f, 0.9f, 0.0f, 1.0f, 1.0f, 50.0f, 1.0f, 4.0f, 12.0f, 0.75f, 2.0f, 0.8f, 8.0f, 1.0f, 4.0f, 20.0f, 0.8f, 2.0f, 1.0f, 50.0f, 2.4f, 0.9f, 0.0f, 0.0f, 200.0f, -3.0f, 1.0f, 9000.0f, -3.0f, 0.8f, 777.0f, 888.0f, 999.0f, 666.0f, 1.0f, 120.0f, 0.0f, 20000.0f, 0.9f, 1.0f, 24.0f, 0.5f, 80.0f, 1.0f, 2.0f, 8.0f, 0.7f, 0.2f, 0.3f, 4.0f, 1.0f, 2.0f, 8.0f, 0.6f, 0.3f, 0.3f, 20.0f, 0.5f, 0.3f, 1.0f, 0.0f, 200.0f, -2.0f, 1.0f, 9000.0f, -2.0f, 0.3f, 101.0f, 202.0f, 303.0f, 404.0f, 1.0f, 150.0f, 0.0f, 20000.0f, 0.9f, 1.0f, 6.0f, 0.2f, 170.0f, 1.0f, 1.0f, 8.0f, 0.7f, 0.2f, 0.3f, 8.0f, 1.0f, 2.0f, 10.0f, 0.7f, 0.4f, 0.3f, 50.0f, 0.8f, 0.3f, 1.0f, 0.0f, 200.0f, -3.0f, 1.0f, 7000.0f, -4.0f, 0.6f, 13.0f, 57.0f, 91.0f, 135.0f, 1.0f, 100.0f, 0.0f, 20000.0f, 0.9f );

    float csRnd()
    {
        csLcg = (csLcg * 22695477 + 1) & 4294967295L;
        return float (csLcg) / 4294967295.0f;
    }

    // RandomBuffer.Generate (seed, count, crossSeed): two LCG series (seed and ~seed) blended by the cross seed
    void csFill (int seed, int count, float cross)
    {
        csLcg = int64 (seed);

        for (int i = 0; i < count; ++i)
            csTmp.at (i) = csRnd() * (1.0f - cross);

        csLcg = 4294967295L - int64 (seed);

        for (int i = 0; i < count; ++i)
            csTmp.at (i) = csTmp.at (i) + csRnd() * cross;
    }

    float csDb (float d)
    {
        return float (pow (10.0f, d * 0.05f));
    }

    // low / high shelf coefficients (CloudSeed Biquad): b0 b1 b2 a1 a2 into csV at o
    void csShelf (int o, bool high, float fc, float gdb, float sr)
    {
        float V = float (pow (10.0f, abs (gdb) / 20.0f));
        float K = float (tan (3.14159265f * min (fc, sr * 0.45f) / sr));
        float s2 = 1.41421356f, sv = sqrt (2.0f * V);
        float b0, b1, b2, a1, a2, nm;

        if (! high)
        {
            if (gdb >= 0.0f)
            {
                nm = 1.0f / (1.0f + s2 * K + K * K);
                b0 = (1.0f + sv * K + V * K * K) * nm;  b1 = 2.0f * (V * K * K - 1.0f) * nm;  b2 = (1.0f - sv * K + V * K * K) * nm;
                a1 = 2.0f * (K * K - 1.0f) * nm;        a2 = (1.0f - s2 * K + K * K) * nm;
            }
            else
            {
                nm = 1.0f / (1.0f + sv * K + V * K * K);
                b0 = (1.0f + s2 * K + K * K) * nm;      b1 = 2.0f * (K * K - 1.0f) * nm;      b2 = (1.0f - s2 * K + K * K) * nm;
                a1 = 2.0f * (V * K * K - 1.0f) * nm;    a2 = (1.0f - sv * K + V * K * K) * nm;
            }
        }
        else
        {
            if (gdb >= 0.0f)
            {
                nm = 1.0f / (1.0f + s2 * K + K * K);
                b0 = (V + sv * K + K * K) * nm;         b1 = 2.0f * (K * K - V) * nm;         b2 = (V - sv * K + K * K) * nm;
                a1 = 2.0f * (K * K - 1.0f) * nm;        a2 = (1.0f - s2 * K + K * K) * nm;
            }
            else
            {
                nm = 1.0f / (V + sv * K + K * K);
                b0 = (1.0f + s2 * K + K * K) * nm;      b1 = 2.0f * (K * K - 1.0f) * nm;      b2 = (1.0f - s2 * K + K * K) * nm;
                a1 = 2.0f * (K * K - V) * nm;           a2 = (V - sv * K + K * K) * nm;
            }
        }

        csV.at (o) = b0;  csV.at (o + 1) = b1;  csV.at (o + 2) = b2;  csV.at (o + 3) = a1;  csV.at (o + 4) = a2;
    }

    // one-pole coefficient of CloudSeed's Lp1 / Hp1: a1 and b0 = 1 - a1
    float csPoleA (float hz, float sr)
    {
        float x  = 6.2831853f * min (hz, sr * 0.499f) / sr;
        float nn = 2.0f - cos (x);
        return nn - sqrt (nn * nn - 1.0f);
    }

    void fxCsDerive (int s)
    {
        float sr  = float (processor.frequency);
        int   D   = s * 1024;
        int   pb  = s * 6;
        int   md  = clamp (fxMode.at (s), 0, 8 - 1);
        int   mo  = md * 37;
        float p1  = clamp (fxP.at (pb),     0.0f, 1.0f);
        float p2  = clamp (fxP.at (pb + 1), 0.0f, 1.0f);
        float p3  = clamp (fxP.at (pb + 2), 0.0f, 1.0f);
        float p4  = clamp (fxP.at (pb + 3), 0.0f, 1.0f);
        float p5  = clamp (fxP.at (pb + 4), 0.0f, 1.0f);
        float p6  = clamp (fxP.at (pb + 5), 0.0f, 1.0f);
        float ms  = sr * 0.001f;
        float sz  = 0.4f + 1.6f * p2;
        float modS = p5 * 2.0f;
        float decay = fxExpMap (p1, 0.2f, 30.0f);
        int   lines = clamp (int (csModes.at (mo + 10)), 1, 8);
        int   edSt  = clamp (int (csModes.at (mo + 5)), 1, 6);
        int   ldSt  = clamp (int (csModes.at (mo + 12)), 1, 4);
        int   nTaps = clamp (int (csModes.at (mo + 1)), 1, 32);
        int   fl    = 0;

        if (csModes.at (mo + 0) > 0.5f)   fl += 1;
        if (csModes.at (mo + 4) > 0.5f)    fl += 2;
        if (csModes.at (mo + 11) > 0.5f)    fl += 4;
        if (csModes.at (mo + 20) > 0.5f)    fl += 8;
        if (csModes.at (mo + 21) > 0.5f)    fl += 16;
        if (csModes.at (mo + 24) > 0.5f)    fl += 32;
        fl += 64;                                                                                  // loop low-pass (Damp)
        if (csModes.at (mo + 32) > 0.5f)    fl += 128;
        if (csModes.at (mo + 34) > 0.5f)    fl += 256;

        int G = D + 440;
        csV.at (G)      = min (p4 * 80.0f * ms, 4000.0f);                                       // pre-delay samples
        csV.at (G + 1)  = csPoleA (csModes.at (mo + 33), sr);
        csV.at (G + 3)  = csPoleA (csModes.at (mo + 35), sr);
        csV.at (G + 5)  = csPoleA (fxExpMap (1.0f - p3, 1500.0f, 20000.0f), sr);                 // loop low-pass
        csShelf (G + 7,  false, csModes.at (mo + 22), csModes.at (mo + 23), sr);
        csShelf (G + 12, true,  csModes.at (mo + 25), csModes.at (mo + 26), sr);
        csV.at (G + 17) = p6 * 1.5f;                                                             // early level
        csV.at (G + 18) = csModes.at (mo + 36);                                        // late level
        csV.at (G + 19) = 1.0f / sqrt (float (lines));                                           // per-line gain
        csV.at (G + 20) = float (fl);
        csV.at (G + 21) = float (edSt);
        csV.at (G + 22) = float (lines);
        csV.at (G + 23) = float (ldSt);
        csV.at (G + 24) = float (nTaps);
        csV.at (G + 25) = csModes.at (mo + 7);
        csV.at (G + 26) = csModes.at (mo + 14);

        float cross = csModes.at (mo + 27);
        float tapLen = clamp (csModes.at (mo + 3) * ms, 10.0f, 8190.0f);
        float tapDec = csModes.at (mo + 2);
        float edDel  = csModes.at (mo + 6) * sz * ms;
        float edAmt  = csModes.at (mo + 8) * modS * ms;
        float edRate = csModes.at (mo + 9);
        float ldDel  = csModes.at (mo + 13) * sz * ms;
        float ldAmt  = csModes.at (mo + 15) * modS * ms;
        float ldRate = csModes.at (mo + 16);
        float lnSize = csModes.at (mo + 17) * sz * ms;
        float lnAmt  = csModes.at (mo + 18) * modS * ms;
        float lnRate = csModes.at (mo + 19);
        float decSamp = decay * sr;

        for (int c = 0; c < 2; ++c)
        {
            int   Dc = D + c * 220;
            float cs = c == 1 ? 0.5f * cross : 1.0f - 0.5f * cross;

            // multitap
            csFill (int (csModes.at (mo + 28)), 96, cs);
            float lenSc = tapLen / float (nTaps);
            float totG  = 3.0f / sqrt (1.0f + float (nTaps)) * (1.0f + tapDec * 2.0f);

            for (int j = 0; j < 32; ++j)
            {
                float ph  = csTmp.at (j * 3) < 0.5f ? 1.0f : -1.0f;
                float g   = csDb (-20.0f + csTmp.at (j * 3 + 1) * 20.0f) * ph;
                float off = (float (j) + csTmp.at (j * 3 + 2)) * lenSc;
                float de  = float (exp (-off / tapLen * 3.3f)) * tapDec + (1.0f - tapDec);
                csV.at (Dc + j)      = float (clamp (int (off), 0, 8190));
                csV.at (Dc + 32 + j) = j < nTaps ? g * de * totG : 0.0f;
            }

            // early diffuser
            csFill (int (csModes.at (mo + 29)), 36, cs);

            for (int k = 0; k < 6; ++k)
            {
                float d = float (clamp (int (edDel * float (pow (10.0f, csTmp.at (k)) * 0.1f)), 2, 1000));
                float a = min (min (edAmt * (0.85f + 0.3f * csTmp.at (12 + k)), d - 1.0f), 1015.0f - d);
                csV.at (Dc + 64 + k)  = d;
                csV.at (Dc + 110 + k) = csModes.at (mo + 8) * modS > 0.5f ? max (a, 0.0f) : 0.0f;
                csV.at (Dc + 156 + k) = edRate * (0.85f + 0.3f * csTmp.at (24 + k)) / sr;
            }

            // late lines
            csFill (int (csModes.at (mo + 30)), 36, cs);

            for (int i = 0; i < 8; ++i)
            {
                float a  = lnAmt * (0.7f + 0.3f * csTmp.at (i));
                float r  = lnRate * (0.7f + 0.3f * csTmp.at (12 + i)) / sr;
                float d  = (0.5f + csTmp.at (24 + i)) * lnSize;
                d = max (d, a + 2.0f);
                d = min (d, 4090.0f - a);
                a = min (a, max (d - 2.0f, 0.0f));
                float fb = csDb (d / decSamp * -60.0f);
                csV.at (Dc + 64 + 6 + i)  = float (int (d));
                csV.at (Dc + 110 + 6 + i) = a;
                csV.at (Dc + 156 + 6 + i) = r;
                csV.at (Dc + 202 + i)     = fb;
            }

            // late diffusers (one seed series per line)
            for (int i = 0; i < 8; ++i)
            {
                csFill (int (csModes.at (mo + 31)) * (i + 1), 36, cs);

                for (int k = 0; k < 4; ++k)
                {
                    int   u = 14 + i * 4 + k;
                    float d = float (clamp (int (ldDel * float (pow (10.0f, csTmp.at (k)) * 0.1f)), 2, 1000));
                    float a = min (min (ldAmt * (0.85f + 0.3f * csTmp.at (12 + k)), d - 1.0f), 1015.0f - d);
                    csV.at (Dc + 64 + u)  = d;
                    csV.at (Dc + 110 + u) = max (a, 0.0f);
                    csV.at (Dc + 156 + u) = ldRate * (0.85f + 0.3f * csTmp.at (24 + k)) / sr;
                }
            }
        }

        // phases and current delays start at once (first derive of the slot)
        for (int c = 0; c < 2; ++c)
        {
            int Sc = s * 1024 + 512 + c * 256;
            int Dc = D + c * 220;

            for (int u = 0; u < 46; ++u)
            {
                if (csV.at (Sc + 2 + u) == 0.0f)
                    csV.at (Sc + 2 + u) = 0.6180339f * float (u + 1 + c * 7) - floor (0.6180339f * float (u + 1 + c * 7));

                csV.at (Sc + 48 + u) = max (csV.at (Dc + 64 + u), 1.0f);
            }
        }
    }

    // modulated allpass (CloudSeed ModulatedAllpass): unit u, ring at base with mask, feedback gain fbk
    float csAp (int base, int mask, int wp, int Sc, int u, float v, float fbk)
    {
        float tot = min (csV.at (Sc + 48 + u), float (mask - 3));
        int   dA  = int (tot);
        float fr  = tot - float (dA);
        float bo  = rvRd (base, mask, wp, dA) * (1.0f - fr) + rvRd (base, mask, wp, dA + 1) * fr;
        float iv  = v + bo * fbk;
        rvWr (base, mask, wp, iv);
        return bo - iv * fbk;
    }

    // one channel of the reverb; returns (early, late)
    float<2> csChan (int s, int c, float x, int wp)
    {
        int D  = s * 1024;
        int Dc = D + c * 220;
        int G  = D + 440;
        int Sc = D + 512 + c * 256;
        int cb = fxAb (s) + c * 98304;
        int fl = int (csV.at (G + 20));
        float v = x;

        // modulation update every 8 samples
        if ((wp & 7) == 0)
        {
            for (int u = 0; u < 46; ++u)
            {
                float a = csV.at (Dc + 110 + u);

                if (a > 0.0f)
                {
                    float ph = csV.at (Sc + 2 + u) + csV.at (Dc + 156 + u) * 8.0f;
                    ph = ph - floor (ph);
                    csV.at (Sc + 2 + u)  = ph;
                    csV.at (Sc + 48 + u) = max (csV.at (Dc + 64 + u) + a * sin (6.2831853f * ph), 1.0f);
                }
            }
        }

        if ((fl & 128) != 0)
        {
            float lo = csV.at (Sc) * csV.at (G + 1) + v * (1.0f - csV.at (G + 1));
            csV.at (Sc) = lo;
            v = v - lo;
        }

        if ((fl & 256) != 0)
        {
            float lo = csV.at (Sc + 1) * csV.at (G + 3) + v * (1.0f - csV.at (G + 3));
            csV.at (Sc + 1) = lo;
            v = lo;
        }

        if (v * v < 0.000000001f)
            v = 0.0f;

        // pre-delay
        rvWr (cb, 4095, wp, v);
        v = rvRd (cb, 4095, wp, int (csV.at (G)));

        // multitap
        if ((fl & 1) != 0)
        {
            rvWr (cb + 4096, 8191, wp, v);
            float acc = 0.0f;
            int   nt  = int (csV.at (G + 24));

            for (int j = 0; j < nt; ++j)
                acc += rvRd (cb + 4096, 8191, wp, int (csV.at (Dc + j))) * csV.at (Dc + 32 + j);

            v = acc;
        }

        // early diffuser
        if ((fl & 2) != 0)
        {
            int ns = int (csV.at (G + 21));

            for (int k = 0; k < ns; ++k)
                v = csAp (cb + 12288 + k * 1024, 1023, wp, Sc, k, v, csV.at (G + 25));
        }

        float eo = v;
        float sum = 0.0f;
        int   nl = int (csV.at (G + 22));
        int   ld = int (csV.at (G + 23));
        bool  post = (fl & 8) != 0;

        for (int i = 0; i < nl; ++i)
        {
            int   lb  = cb + 18432 + i * 4096;
            float tmp = eo + csV.at (Sc + 94 + i) * csV.at (Dc + 202 + i);
            rvWr (lb, 4095, wp, tmp);
            float tot = csV.at (Sc + 48 + 6 + i);
            int   dA  = int (tot);
            float fr  = tot - float (dA);
            float y   = rvRd (lb, 4095, wp, dA) * (1.0f - fr) + rvRd (lb, 4095, wp, dA + 1) * fr;
            float tapped = y;

            if ((fl & 4) != 0)
                for (int k = 0; k < ld; ++k)
                    y = csAp (cb + 51200 + (i * 4 + k) * 1024, 1023, wp, Sc, 14 + i * 4 + k, y, csV.at (G + 26));

            if ((fl & 16) != 0)
            {
                int   o  = Sc + 102 + i * 4;
                int   cf = G + 7;
                float yy = csV.at (cf) * y + csV.at (cf + 1) * csV.at (o) + csV.at (cf + 2) * csV.at (o + 1) - csV.at (cf + 3) * csV.at (o + 2) - csV.at (cf + 4) * csV.at (o + 3);
                csV.at (o + 1) = csV.at (o);  csV.at (o) = y;  csV.at (o + 3) = csV.at (o + 2);  csV.at (o + 2) = yy;
                y = yy;
            }

            if ((fl & 32) != 0)
            {
                int   o  = Sc + 134 + i * 4;
                int   cf = G + 12;
                float yy = csV.at (cf) * y + csV.at (cf + 1) * csV.at (o) + csV.at (cf + 2) * csV.at (o + 1) - csV.at (cf + 3) * csV.at (o + 2) - csV.at (cf + 4) * csV.at (o + 3);
                csV.at (o + 1) = csV.at (o);  csV.at (o) = y;  csV.at (o + 3) = csV.at (o + 2);  csV.at (o + 2) = yy;
                y = yy;
            }

            float lp = csV.at (Sc + 166 + i) * csV.at (G + 5) + y * (1.0f - csV.at (G + 5));
            csV.at (Sc + 166 + i) = lp;
            y = lp;
            csV.at (Sc + 94 + i) = clamp (y, -8.0f, 8.0f);
            sum += post ? y : tapped;
        }

        return float<2> (eo, sum * csV.at (G + 19));
    }

    float<2> fxCloudSeed (int s, float<2> x)
    {
        int   ib = s * 24 + 8;
        int   G  = s * 1024 + 440;
        int   wp = fxI.at (ib);
        float<2> l = csChan (s, 0, x[0], wp);
        float<2> r = csChan (s, 1, x[1], wp);
        fxI.at (ib) = (wp + 1) & 1073741823;
        float eg = csV.at (G + 17), lg = csV.at (G + 18);
        return float<2> (clamp (l[0] * eg + l[1] * lg, -4.0f, 4.0f), clamp (r[0] * eg + r[1] * lg, -4.0f, 4.0f));
    }

    // ================= FX-WAVEGUIDE: resonating string / tube (FX type 32) =================
    // The input excites one or two delay loops (low-pass in the loop, optional soft saturation).  Modes: 0 String, 1 Tube (inverting, half period),
    // 2 Dual Strings (second loop detuned), 3 Fifth Drone (x 1.5), 4 Octave Drone (x 0.5).  P1 Pitch, P2 Decay, P3 Damp, P4 Detune, P5 Excite, P6 Drive.
    // fxD per slot: 0..3 delay (samples) of loop 0 left / right, loop 1 left / right; 4 / 5 loop gain; 6 damping coefficient; 7 input gain; 8 drive; 9 loops; 10 sign; 11 output gain.
    // Arena: channel c at fxAb + c * 8192, loop j at + j * 4096 (ring of 4096); position fxI[s * 24]; low-pass states fxF[s * 40 + c * 2 + j].
    void fxWgDerive (int s)
    {
        float sr   = float (processor.frequency);
        int   db   = s * 16;
        int   pb   = s * 6;
        bool  key  = s < 48 && fxMode.at (s) >= 5;   // FX-KEYTRACK
        int   md   = clamp (fxMode.at (s) >= 5 ? fxMode.at (s) - 5 : fxMode.at (s), 0, 4);
        float f    = 30.0f * float (pow (2000.0f / 30.0f, clamp (fxP.at (pb), 0.0f, 1.0f)));

        if (key)
            f = fxKeyHz() * f / 261.63f;

        float t60  = 0.05f * float (pow (160.0f, clamp (fxP.at (pb + 1), 0.0f, 1.0f)));
        float fc   = 500.0f * float (pow (32.0f, clamp (fxP.at (pb + 2), 0.0f, 1.0f)));
        float cent = 50.0f * clamp (fxP.at (pb + 3), 0.0f, 1.0f);
        float exc  = 0.2f + 1.8f * clamp (fxP.at (pb + 4), 0.0f, 1.0f);
        float drv  = clamp (fxP.at (pb + 5), 0.0f, 1.0f);
        float a    = float (exp (-6.2831853f * min (fc, sr * 0.45f) / sr));
        int   nl   = md >= 2 ? 2 : 1;
        float sgn  = md == 1 ? -1.0f : 1.0f;
        float tubeK = md == 1 ? 0.5f : 1.0f;

        for (int j = 0; j < 2; ++j)
        {
            float ratio = 1.0f;

            if (j == 1)
                ratio = md == 2 ? float (pow (2.0f, (3.0f + cent) / 1200.0f)) : (md == 3 ? 1.5f : 0.5f);

            float gj = 0.0f;

            for (int c = 0; c < 2; ++c)
            {
                float sp = md == 2 ? 0.0f : (c == 0 ? -0.5f : 0.5f) * cent;
                float fj = clamp (f * ratio * float (pow (2.0f, sp / 1200.0f)), 12.0f, sr * 0.2f);
                float T  = sr / fj * tubeK;
                float w0 = 6.2831853f * fj / sr;
                float d  = clamp (T - wgLpDelay (a, w0), 4.0f, 4000.0f);
                fxD.at (db + j * 2 + c) = d;
                gj = float (exp (-6.9078f * T / (sr * t60))) / wgLpGain (a, w0);
            }

            fxD.at (db + 4 + j) = min (gj, 0.9998f);
        }

        fxD.at (db + 6)  = a;
        fxD.at (db + 7)  = exc * sqrt (1.0f - fxD.at (db + 4));
        fxD.at (db + 8)  = drv;
        fxD.at (db + 9)  = float (nl);
        fxD.at (db + 10) = sgn;
        fxD.at (db + 11) = nl == 2 ? 0.7f : 1.0f;
    }

    float<2> fxWaveguide (int s, float<2> x)
    {
        int   ab  = fxAb (s);
        int   ib  = s * 24;
        int   db  = s * 16;
        int   fb  = s * 40;
        int   pos = fxI.at (ib);
        int   nl  = int (fxD.at (db + 9) + 0.5f);
        float a   = fxD.at (db + 6);
        float ing = fxD.at (db + 7);
        float drv = fxD.at (db + 8);
        float sgn = fxD.at (db + 10);
        float og  = fxD.at (db + 11);
        float sat = 1.0f + 4.0f * drv;
        float<2> o = float<2> (0.0f, 0.0f);

        for (int c = 0; c < 2; ++c)
        {
            float acc = 0.0f;

            for (int j = 0; j < nl; ++j)
            {
                int   lb = ab + c * 8192 + j * 4096;
                float rp = float (pos) - fxD.at (db + j * 2 + c);
                int   i0 = int (floor (rp));
                float fr = rp - float (i0);
                float y  = fxArena.at (lb + (i0 & 4095)) * (1.0f - fr) + fxArena.at (lb + ((i0 + 1) & 4095)) * fr;
                float lp = fxF.at (fb + c * 2 + j);
                lp = (1.0f - a) * y + a * lp;
                fxF.at (fb + c * 2 + j) = lp;
                float fk = lp * fxD.at (db + 4 + j) * sgn;

                if (drv > 0.001f)
                    fk = float (tanh (fk * sat)) / sat;

                fxArena.at (lb + (pos & 4095)) = clamp (x[c] * ing + fk, -8.0f, 8.0f);
                acc += y;
            }

            o[c] = float (tanh (acc * og));
        }

        fxI.at (ib) = (pos + 1) & 4095;
        return o;
    }

    // ================= FX-YAYBAHAR: string -> two springs -> two drum membranes (FX type 33) =================
    // Own implementation after the architecture of the instrument (a string drives two springs, every spring drives a drum membrane; the springs and drums act back on the string):
    //   string loop (bowed by the input)  ->  spring (delay line with dispersion all-passes, damping, feedback)  ->  rectangular membrane (8 modal resonators)
    // Modes: 0 Classic (mono string, spring 2 is 1.37 x as long, drum 2 one octave lower, outputs panned 80 / 20), 1 Stereo (a string, spring and drum per channel), 2 Deep (Classic, drums tuned lower).
    // Arena of the slot (196608 floats): string rings (string u at u * 8192, 8192 long), spring rings at 16384 + v * 32768 (32768 long).
    // fxI: s * 24 string position, + 1 spring position.   fxF (s * 40): 0..1 string low-pass, 2..3 spring low-pass, 6..13 dispersion all-pass states (v * 4 + stage).
    // fxD (s * 16): 0..1 string delay, 2 string loop gain, 3 string low-pass, 4 input gain, 5..6 spring delay, 7 spring -> string coupling, 8 drum -> spring coupling, 9 spring gain,
    //               10 spring low-pass, 11 all-pass coefficient, 12 mode, 13 output gain, 14 pan.
    // csV (s * 1024): membrane v mode k at (v * 8 + k) * 4: c1, c2, input gain, output weight; states from 512 + (v * 8 + k) * 2; 600 + v last membrane output.
    void fxYbDerive (int s)
    {
        float sr   = float (processor.frequency);
        int   db   = s * 16;
        int   pb   = s * 6;
        int   cb   = s * 1024;
        bool  key  = fxMode.at (s) >= 3;   // FX-KEYTRACK
        int   md   = clamp (key ? fxMode.at (s) - 3 : fxMode.at (s), 0, 2);
        float f    = 40.0f * float (pow (20.0f, clamp (fxP.at (pb), 0.0f, 1.0f)));

        if (key)
            f = fxKeyHz() * f / 261.63f;

        float sprT = 0.02f * float (pow (12.5f, clamp (fxP.at (pb + 1), 0.0f, 1.0f)));
        float dec  = clamp (fxP.at (pb + 2), 0.0f, 1.0f);
        float disp = 0.75f * clamp (fxP.at (pb + 3), 0.0f, 1.0f);
        float fm   = 40.0f * float (pow (6.25f, clamp (fxP.at (pb + 4), 0.0f, 1.0f)));
        float fc   = 500.0f * float (pow (16.0f, clamp (fxP.at (pb + 5), 0.0f, 1.0f)));
        float aSp  = float (exp (-6.2831853f * min (fc, sr * 0.45f) / sr));
        float aSt  = float (exp (-6.2831853f * min (fc * 2.0f, sr * 0.45f) / sr));
        float t60  = 0.2f * float (pow (30.0f, dec));
        float fS   = clamp (f, 20.0f, sr * 0.2f);
        float T    = sr / fS;
        float w0   = 6.2831853f * fS / sr;
        float d    = clamp (T - wgLpDelay (aSt, w0), 4.0f, 8000.0f);
        float gSp  = 0.55f + 0.42f * dec;

        fxD.at (db)      = d;
        fxD.at (db + 1)  = clamp (d * 1.004f, 4.0f, 8000.0f);
        float gS = min (float (exp (-6.9078f * T / (sr * t60))) / wgLpGain (aSt, w0), 0.9998f);
        fxD.at (db + 2)  = gS;
        fxD.at (db + 3)  = aSt;
        fxD.at (db + 4)  = 0.5f;
        fxD.at (db + 5)  = clamp (sprT * sr, 16.0f, 30000.0f);
        fxD.at (db + 6)  = clamp (sprT * (md == 1 ? 1.07f : 1.37f) * sr, 16.0f, 30000.0f);
        fxD.at (db + 7)  = 0.3f * (1.0f - gS) * (1.0f - gSp);   // the return must stay below the loss of the string loop, or the string runs away
        fxD.at (db + 8)  = 0.01f * (1.0f - gSp);   // drum resonance gain (up to 5) x spring resonance (1 / (1 - gSp)) x output gain stays below unity
        fxD.at (db + 9)  = gSp;
        fxD.at (db + 10) = aSp;
        fxD.at (db + 11) = disp;
        fxD.at (db + 12) = float (md);
        fxD.at (db + 13) = 1.4f;
        fxD.at (db + 14) = 0.8f;
        float t60m = 0.4f + 2.5f * dec;
        float[8] ratio = (1.0f, 1.634f, 1.527f, 2.0f, 2.335f, 2.133f, 2.604f, 2.494f);   // rectangular membrane (1,1) (1,2) (2,1) (2,2) (1,3) (3,1) (2,3) (3,2), aspect 1.12
        float[8] win   = (0.968f, 0.243f, 0.422f, 0.106f, -0.908f, -0.784f, -0.395f, -0.197f);   // drive at (0.43, 0.46)
        float[8] wout  = (0.880f, 0.275f, 0.799f, 0.250f, -0.794f, -0.155f, -0.721f, -0.048f);   // pick-up at (0.35, 0.45)

        for (int v = 0; v < 2; ++v)
        {
            float tune = v == 0 ? (md == 2 ? 0.6f : 1.0f) : (md == 0 ? 0.5f : (md == 1 ? 0.94f : 0.3f));

            for (int k = 0; k < 8; ++k)
            {
                float fk = fm * tune * ratio.at (k);
                float tk = t60m / (1.0f + 0.5f * (ratio.at (k) - 1.0f));
                float r  = float (exp (-6.9078f / (tk * sr)));
                float w  = 6.2831853f * fk / sr;
                bool  ok = fk < sr * 0.45f;
                int   ci = cb + (v * 8 + k) * 4;
                csV.at (ci)     = ok ? 2.0f * r * float (cos (w)) : 0.0f;
                csV.at (ci + 1) = ok ? r * r : 0.0f;
                csV.at (ci + 2) = ok ? (1.0f - r) * float (sin (w)) * 10.0f * win.at (k) : 0.0f;
                csV.at (ci + 3) = wout.at (k);
            }
        }
    }

    float<2> fxYaybahar (int s, float<2> x)
    {
        int   ab   = fxAb (s);
        int   ib   = s * 24;
        int   db   = s * 16;
        int   fb   = s * 40;
        int   cb   = s * 1024;
        int   sp   = fxI.at (ib);
        int   pp   = fxI.at (ib + 1);
        bool  st   = int (fxD.at (db + 12) + 0.5f) == 1;
        float aSt  = fxD.at (db + 3);
        float gSt  = fxD.at (db + 2);
        float ing  = fxD.at (db + 4);
        float kc   = fxD.at (db + 7);
        float kb   = fxD.at (db + 8);
        float gSp  = fxD.at (db + 9);
        float aSp  = fxD.at (db + 10);
        float aAp  = fxD.at (db + 11);
        float og   = fxD.at (db + 13);
        float pan  = fxD.at (db + 14);
        float xm   = 0.5f * (x[0] + x[1]);
        float[2] ys;
        float[2] fk;
        float[2] ls;
        float[2] ret;
        float[2] A;

        // read the strings
        for (int u = 0; u < (st ? 2 : 1); ++u)
        {
            int   sb = ab + u * 8192;
            float rp = float (sp) - fxD.at (db + u);
            int   i0 = int (floor (rp));
            float fr = rp - float (i0);
            float y  = fxArena.at (sb + (i0 & 8191)) * (1.0f - fr) + fxArena.at (sb + ((i0 + 1) & 8191)) * fr;
            float lp = (1.0f - aSt) * y + aSt * fxF.at (fb + u);
            fxF.at (fb + u) = lp;
            ys.at (u) = y;
            fk.at (u) = lp * gSt;
            ret.at (u) = 0.0f;
        }

        // springs: read, dispersion, damping; write with the string signal and the drum motion
        for (int v = 0; v < 2; ++v)
        {
            int   u   = st ? v : 0;
            int   pb  = ab + 16384 + v * 32768;
            float rq  = float (pp) - fxD.at (db + 5 + v);
            int   q0  = int (floor (rq));
            float qf  = rq - float (q0);
            float y   = fxArena.at (pb + (q0 & 32767)) * (1.0f - qf) + fxArena.at (pb + ((q0 + 1) & 32767)) * qf;

            for (int a = 0; a < 4; ++a)   // dispersion: the low frequencies arrive later
            {
                int   ai = fb + 6 + v * 4 + a;
                float yo = -aAp * y + fxF.at (ai);
                fxF.at (ai) = clamp (y + aAp * yo, -16.0f, 16.0f);
                y = yo;
            }

            float l = (1.0f - aSp) * y + aSp * fxF.at (fb + 2 + v);
            fxF.at (fb + 2 + v) = l;
            ls.at (v) = l;
            ret.at (u) += l * kc;
            fxArena.at (pb + (pp & 32767)) = clamp (ys.at (u) * 0.7f + csV.at (cb + 600 + v) * kb + l * gSp, -8.0f, 8.0f);
        }

        // write the strings (input, loop and the return of the springs)
        for (int u = 0; u < (st ? 2 : 1); ++u)
            fxArena.at (ab + u * 8192 + (sp & 8191)) = clamp ((st ? x[u] : xm) * ing + fk.at (u) + ret.at (u), -8.0f, 8.0f);

        // drum membranes, driven by the end of the springs
        for (int v = 0; v < 2; ++v)
        {
            float drive = ls.at (v) * og;
            float mem   = 0.0f;

            for (int k = 0; k < 8; ++k)
            {
                int   ci = cb + (v * 8 + k) * 4;
                int   mi = cb + 512 + (v * 8 + k) * 2;
                float yv = clamp (csV.at (ci) * csV.at (mi) - csV.at (ci + 1) * csV.at (mi + 1) + csV.at (ci + 2) * drive, -16.0f, 16.0f);
                csV.at (mi + 1) = csV.at (mi);
                csV.at (mi)     = yv;
                mem += yv * csV.at (ci + 3);
            }

            csV.at (cb + 600 + v) = mem;
            A.at (v) = drive * 0.7f + mem * 0.8f;
        }

        fxI.at (ib)     = (sp + 1) & 8191;
        fxI.at (ib + 1) = (pp + 1) & 32767;

        if (st)
            return float<2> (float (tanh (A.at (0))), float (tanh (A.at (1))));

        return float<2> (float (tanh (pan * A.at (0) + (1.0f - pan) * A.at (1))), float (tanh ((1.0f - pan) * A.at (0) + pan * A.at (1))));
    }

    // ================= FX-VIZ: live data of the monitored effect slot =================
    void vzInit()
    {
        float sr = float (processor.frequency);

        for (int b = 0; b < 24; ++b)
        {
            float fc = 40.0f * float (pow (400.0f, float (b) / 23.0f));
            float w  = 6.2831853f * min (fc, sr * 0.45f) / sr;
            float al = float (sin (w)) / (2.0f * 4.3f);
            float a0 = 1.0f + al;
            vzB0.at (b) = al / a0;
            vzA1.at (b) = -2.0f * float (cos (w)) / a0;
            vzA2.at (b) = (1.0f - al) / a0;
        }

        for (int i = 0; i < 128; ++i)
            vzZ.at (i) = 0.0f;

        for (int i = 0; i < 48; ++i)
            vzEnv.at (i) = 0.0f;

        for (int i = 0; i < 4; ++i)
            vzP.at (i) = 0.0f;

        vzK     = 1.0f - float (exp (-1.0f / (sr * 0.03f)));
        vzIdx   = 99;
        vzCount = 0;
    }

    float vzNorm (float e)
    {
        return clamp ((20.0f * float (log10 (max (e * 1.57f, 0.00001f))) + 72.0f) / 72.0f, 0.0f, 1.0f);
    }

    void vzTap (float<2> xin, float<2> yout)
    {
        vzP.at (0) = max (vzP.at (0), abs (xin[0]));
        vzP.at (1) = max (vzP.at (1), abs (xin[1]));
        vzP.at (2) = max (vzP.at (2), abs (yout[0]));
        vzP.at (3) = max (vzP.at (3), abs (yout[1]));
        float mi = (xin[0] + xin[1]) * 0.5f;
        float mo = (yout[0] + yout[1]) * 0.5f;

        for (int b = 0; b < 24; ++b)
        {
            float b0 = vzB0.at (b);
            float a1 = vzA1.at (b);
            float a2 = vzA2.at (b);
            int   zi = b * 4;
            float yi = b0 * mi + vzZ.at (zi);
            vzZ.at (zi)     = clamp (-a1 * yi + vzZ.at (zi + 1), -64.0f, 64.0f);
            vzZ.at (zi + 1) = clamp (-b0 * mi - a2 * yi, -64.0f, 64.0f);
            float yo = b0 * mo + vzZ.at (zi + 2);
            vzZ.at (zi + 2) = clamp (-a1 * yo + vzZ.at (zi + 3), -64.0f, 64.0f);
            vzZ.at (zi + 3) = clamp (-b0 * mo - a2 * yo, -64.0f, 64.0f);
            vzEnv.at (b)      += vzK * (abs (yi) - vzEnv.at (b));
            vzEnv.at (24 + b) += vzK * (abs (yo) - vzEnv.at (24 + b));
        }

        vzCount++;
        vzGap++;

        if (vzIdx < 54 && vzGap >= 48)   // one event per 48 samples: the host keeps only 32 output events per block
        {
            vzGap = 0;
            fxViz <- vzPkt.at (vzIdx);
            vzIdx++;
        }

        if (vzCount >= int (float (processor.frequency) * 0.05f) && vzIdx >= 54)
        {
            vzCount = 0;
            vzPkt.at (0) = -1.0f;
            vzPkt.at (1) = float (fxMon);

            for (int i = 0; i < 4; ++i)
            {
                vzPkt.at (2 + i) = min (vzP.at (i), 8.0f);
                vzP.at (i) = 0.0f;
            }

            for (int b = 0; b < 48; ++b)
                vzPkt.at (6 + b) = vzNorm (vzEnv.at (b));

            vzIdx = 0;
        }
    }

    // ================= FX-SHTAB: Shaper Table distortion (FX type 34) =================
    // one read of the transfer curve (shaper table of an oscillator): v = input after drive and bias, m = mode
    float fxShRead (int bank, float pos, float v, int m)
    {
        float w = v;

        if (m == 0)
            w = clamp (v, -1.0f, 1.0f);
        else if (m == 1)
        {
            float t = v * 0.25f + 0.25f;
            t -= float (floor (t));
            w = 1.0f - 4.0f * abs (t - 0.5f);
        }
        else if (m == 2)
        {
            float t = (v + 1.0f) * 0.5f;
            t -= float (floor (t));
            w = t * 2.0f - 1.0f;
        }
        else
        {
            float h = tblRead (bank, pos, 0.5f + 0.5f * min (abs (v), 1.0f));
            return h;   // Rect: the upper half of the curve for |v|, even symmetric (octave up)
        }

        return tblRead (bank, pos, w * 0.5f + 0.5f);
    }

    float<2> fxShTab (int s, float<2> x)
    {
        int   db   = s * 16;
        int   fb   = s * 40;
        int   md   = fxMode.at (s);
        float drv  = fxD.at (db);
        float pos  = fxD.at (db + 1);
        int   bank = int (fxD.at (db + 2) + 0.5f);
        float bias = fxD.at (db + 3);
        float lpc  = fxD.at (db + 4);
        float lvl  = fxD.at (db + 5);
        float<2> o;

        for (int c = 0; c < 2; ++c)
        {
            int   cb  = fb + c * 8;
            float xin = x[c];
            float xp  = fxF.at (cb);
            fxF.at (cb) = xin;

            float y  = 0.5f * (fxShRead (bank, pos, (xp + xin) * 0.5f * drv + bias, md) + fxShRead (bank, pos, xin * drv + bias, md));
            float dc = fxF.at (cb + 1);
            dc += 0.0013f * (y - dc);
            fxF.at (cb + 1) = dc;
            y -= dc;
            float ls = fxF.at (cb + 2);
            ls += lpc * (y - ls);
            fxF.at (cb + 2) = ls;
            o[c] = ls * lvl;
        }

        return o;
    }

    // ================= FX-EX: effect specific extra parameters =================
    void fxExSet (int s, int k, float v)
    {
        int q = s * 8;
        fxE.at (q + k) = v;
        fxE.at (q + 5) = 1.0f;
        bool act = false;

        for (int i = 0; i < 4; ++i)
            if (fxE.at (q + i) > 0.002f)
                act = true;

        fxE.at (q + 4) = act ? 1.0f : 0.0f;
    }

    void fxExSetO (int g, int k, float v)
    {
        for (int vi = 0; vi < 8; ++vi)
            fxExSet (48 + vi * 96 + (g - 48), k, v);
    }

    float fxExVal (int s, int ty, int tool)
    {
        for (int k = 0; k < 4; ++k)
            if (fxExTab.at (ty * 4 + k) == tool)
                return fxE.at (s * 8 + k);

        return 0.0f;
    }

    float fxExA (float hz)
    {
        return 1.0f - float (exp (-6.283185307f * hz / float (processor.frequency)));
    }

    void fxExRecalc (int s, int ty)
    {
        int   q  = s * 8;
        int   cq = s * 8;
        float sr = float (processor.frequency);

        for (int k = 0; k < 4; ++k)
        {
            int   tool = fxExTab.at (ty * 4 + k);
            float v    = fxE.at (q + k);
            float c    = 0.0f;

            if (tool == 1)      c = fxExA (20.0f * float (pow (50.0f, v)));
            else if (tool == 2) c = fxExA (20000.0f * float (pow (0.075f, v)));
            else if (tool == 3) c = float (pow (10.0f, (-70.0f + 50.0f * v) / 20.0f));
            else if (tool == 4) c = clamp (v * 0.25f * sr, 0.0f, 16000.0f);
            else if (tool == 7 || tool == 8) c = float (pow (10.0f, 9.0f * v / 20.0f)) - 1.0f;
            else if (tool == 11) c = float (pow (10.0f, -24.0f * v / 20.0f));

            fxEc.at (cq + k) = c;
        }

        float rv  = fxExVal (s, ty, 6);
        float ms  = fxExTab.at (ty * 4) == 6 || fxExTab.at (ty * 4 + 1) == 6 || fxExTab.at (ty * 4 + 2) == 6 || fxExTab.at (ty * 4 + 3) == 6 ? 40.0f * float (pow (37.5f, rv)) : 250.0f;
        fxEc.at (cq + 4) = 1.0f - float (exp (-1.0f / (ms * 0.001f * sr)));
        fxEc.at (cq + 5) = 0.1f * float (pow (80.0f, fxExVal (s, ty, 9))) / sr;
        fxEc.at (cq + 6) = fxExA (200.0f);
        fxEc.at (cq + 7) = fxExA (6000.0f);
        fxE.at (q + 5) = 0.0f;
        fxE.at (q + 6) = float (ty);
    }

    // input side: Pre HP, Pre LP, Gate, Pre Delay
    float<2> fxExPre (int s, float<2> x)
    {
        int ty = fxType.at (s);
        int q  = s * 8;
        int wb = s * 16;

        if (fxE.at (q + 5) > 0.5f || fxE.at (q + 6) != float (ty))
            fxExRecalc (s, ty);

        float l = x[0];
        float r = x[1];

        for (int k = 0; k < 4; ++k)
        {
            int tool = fxExTab.at (ty * 4 + k);

            if (tool < 1 || tool > 4 || fxE.at (q + k) <= 0.002f)
                continue;

            float c = fxEc.at (q + k);

            if (tool == 1)
            {
                fxW.at (wb)     += c * (l - fxW.at (wb));
                fxW.at (wb + 1) += c * (r - fxW.at (wb + 1));
                l -= fxW.at (wb);
                r -= fxW.at (wb + 1);
            }
            else if (tool == 2)
            {
                fxW.at (wb + 2) += c * (l - fxW.at (wb + 2));
                fxW.at (wb + 3) += c * (r - fxW.at (wb + 3));
                fxW.at (wb + 4) += c * (fxW.at (wb + 2) - fxW.at (wb + 4));
                fxW.at (wb + 5) += c * (fxW.at (wb + 3) - fxW.at (wb + 5));
                l = fxW.at (wb + 4);
                r = fxW.at (wb + 5);
            }
            else if (tool == 3)
            {
                float det = max (abs (l), abs (r));
                float en  = fxW.at (wb + 6);
                en += (det > en ? 0.05f : 0.0005f) * (det - en);
                fxW.at (wb + 6) = en;
                float gt = fxW.at (wb + 7);
                gt += ((en > c ? 1.0f : 0.0f) - gt) * (en > c ? 0.01f : 0.001f);
                fxW.at (wb + 7) = gt;
                l *= gt;
                r *= gt;
            }
            else if (s < 48)
            {
                int base = s * 32768;
                int pos  = int (fxW.at (wb + 8));
                fxPd.at (base + pos)         = l;
                fxPd.at (base + 16384 + pos) = r;
                int rp = (pos - int (c)) & 16383;
                l = fxPd.at (base + rp);
                r = fxPd.at (base + 16384 + rp);
                fxW.at (wb + 8) = float ((pos + 1) & 16383);
            }
        }

        return float<2> (l, r);
    }

    // output side: Duck, Warmth, Air, Pan, Trim (x0 = the input of the slot)
    float<2> fxExPost (int s, float<2> y, float<2> x0)
    {
        int ty = fxType.at (s);
        int q  = s * 8;
        int wb = s * 16;
        float l = y[0];
        float r = y[1];

        for (int k = 0; k < 4; ++k)
        {
            int tool = fxExTab.at (ty * 4 + k);

            if (tool < 5 || fxE.at (q + k) <= 0.002f)
                continue;

            float v = fxE.at (q + k);
            float c = fxEc.at (q + k);

            if (tool == 5)
            {
                float det = max (abs (x0[0]), abs (x0[1]));
                float en  = fxW.at (wb + 9);
                en += (det > en ? 0.01f : fxEc.at (q + 4)) * (det - en);
                fxW.at (wb + 9) = en;
                float dg = 1.0f - v * clamp (en * 6.0f, 0.0f, 1.0f);
                l *= dg;
                r *= dg;
            }
            else if (tool == 7)
            {
                fxW.at (wb + 10) += fxEc.at (q + 6) * (l - fxW.at (wb + 10));
                fxW.at (wb + 11) += fxEc.at (q + 6) * (r - fxW.at (wb + 11));
                l += fxW.at (wb + 10) * c;
                r += fxW.at (wb + 11) * c;
            }
            else if (tool == 8)
            {
                fxW.at (wb + 12) += fxEc.at (q + 7) * (l - fxW.at (wb + 12));
                fxW.at (wb + 13) += fxEc.at (q + 7) * (r - fxW.at (wb + 13));
                l += (l - fxW.at (wb + 12)) * c;
                r += (r - fxW.at (wb + 13)) * c;
            }
            else if (tool == 10)
            {
                float ph = fxW.at (wb + 14) + fxEc.at (q + 5);
                ph -= float (floor (ph));
                fxW.at (wb + 14) = ph;
                float pn = v * float (sin (6.283185307f * ph));
                l *= pn > 0.0f ? 1.0f - pn : 1.0f;
                r *= pn < 0.0f ? 1.0f + pn : 1.0f;
            }
            else if (tool == 11)
            {
                l *= c;
                r *= c;
            }
        }

        return float<2> (l, r);
    }

    // ================= FX-YBPARTS: the elements of the Yaybahar as effects of their own (types 35 spring, 36 drum, 37 string) =================
    // fxD (s * 16): spring: 0..1 delay (samples), 2 loop gain, 3 damping, 4 all-pass coefficient, 5 modulation depth (samples), 6 modulation rate (cycles / sample), 7 level, 8 mode
    //               drum:   8 mode, 9 level, 10 input gain
    //               string: 0..1 delay, 2..3 loop gain, 4 damping, 5 input gain, 6 nonlinearity, 7 level, 8 mode (loop gain of string 1 at 3)
    // spring arena: ring v at v * 32768; string arena: ring u at u * 8192; drum: csV like the Yaybahar (c1, c2, input gain, output weight per mode; states from 512)
    void fxYbpDerive (int s, int ty)
    {
        float sr  = float (processor.frequency);
        int   db  = s * 16;
        int   pb  = s * 6;
        int   cb  = s * 1024;
        float p0  = clamp (fxP.at (pb),     0.0f, 1.0f);
        float p1  = clamp (fxP.at (pb + 1), 0.0f, 1.0f);
        float p2  = clamp (fxP.at (pb + 2), 0.0f, 1.0f);
        float p3  = clamp (fxP.at (pb + 3), 0.0f, 1.0f);
        float p4  = clamp (fxP.at (pb + 4), 0.0f, 1.0f);
        float p5  = clamp (fxP.at (pb + 5), 0.0f, 1.0f);
        int   mo  = fxMode.at (s);
        bool  key = ty != 35 && mo >= 3;
        int   md  = clamp (mo >= 3 ? mo - 3 : mo, 0, 2);
        float lvl = float (pow (10.0f, (p5 - 0.5f) * 24.0f / 20.0f));

        if (ty == 35)
        {
            float sprT = 0.02f * float (pow (12.5f, p0));
            fxD.at (db)     = clamp (sprT * sr, 16.0f, 28000.0f);
            fxD.at (db + 1) = clamp (sprT * (md == 2 ? 1.07f : 1.37f) * sr, 16.0f, 28000.0f);
            fxD.at (db + 2) = 0.5f + 0.47f * p1;
            fxD.at (db + 3) = float (exp (-6.2831853f * min (500.0f * float (pow (16.0f, p3)), sr * 0.45f) / sr));
            fxD.at (db + 4) = 0.75f * p2;
            fxD.at (db + 5) = p4 * 0.0015f * sr;
            fxD.at (db + 6) = 0.7f / sr;
            fxD.at (db + 7) = lvl;
            fxD.at (db + 8) = float (md);
        }
        else if (ty == 36)
        {
            float fm = 40.0f * float (pow (6.25f, p0));

            if (key)
                fm = clamp (fxKeyHz() * fm / 261.63f, 20.0f, sr * 0.2f);

            float t60m = 0.4f + 2.5f * p1;
            float asp  = 0.6f + p2;
            float xs   = 0.1f + 0.4f * p3;
            float xp   = 0.1f + 0.4f * p4;
            float dk   = 0.2f + 1.8f * p5;
            float[8] mm = (1.0f, 1.0f, 2.0f, 2.0f, 1.0f, 3.0f, 2.0f, 3.0f);
            float[8] nn = (1.0f, 2.0f, 1.0f, 2.0f, 3.0f, 1.0f, 3.0f, 2.0f);
            float nrm = float (sqrt (1.0f + 1.0f / (asp * asp)));

            fxD.at (db + 8)  = float (md);

            for (int v = 0; v < 2; ++v)
            {
                float tune = v == 0 ? 1.0f : (md == 1 ? 0.5f : 0.94f);

                for (int k = 0; k < 8; ++k)
                {
                    float ratio = float (sqrt (mm.at (k) * mm.at (k) + nn.at (k) * nn.at (k) / (asp * asp))) / nrm;
                    float fk = fm * tune * ratio;
                    float tk = t60m / (1.0f + dk * (ratio - 1.0f));
                    float r  = float (exp (-6.9078f / (tk * sr)));
                    float w  = 6.2831853f * fk / sr;
                    bool  ok = fk < sr * 0.45f;
                    float wi = float (sin (3.14159265f * mm.at (k) * xs) * sin (3.14159265f * nn.at (k) * 0.46f));
                    float wo = float (sin (3.14159265f * mm.at (k) * xp) * sin (3.14159265f * nn.at (k) * 0.45f));
                    int   ci = cb + (v * 8 + k) * 4;
                    csV.at (ci)     = ok ? 2.0f * r * float (cos (w)) : 0.0f;
                    csV.at (ci + 1) = ok ? r * r : 0.0f;
                    csV.at (ci + 2) = ok ? (1.0f - r) * float (sin (w)) * 40.0f * wi : 0.0f;
                    csV.at (ci + 3) = wo;
                }
            }

            fxD.at (db + 9) = lvl;
        }
        else
        {
            float f   = 40.0f * float (pow (20.0f, p0));

            if (key)
                f = fxKeyHz() * f / 261.63f;

            float fc  = 500.0f * float (pow (16.0f, p2));
            float aSt = float (exp (-6.2831853f * min (fc * 2.0f, sr * 0.45f) / sr));
            float t60 = 0.2f * float (pow (30.0f, p1));
            float ct  = float (pow (2.0f, (p4 - 0.5f) * 50.0f / 1200.0f));
            float f1  = md == 2 ? 0.5f * ct : ct;

            for (int u = 0; u < 2; ++u)
            {
                float fS = clamp (u == 0 ? f : f * f1, 20.0f, sr * 0.2f);
                float T  = sr / fS;
                float w0 = 6.2831853f * fS / sr;
                fxD.at (db + u) = clamp (T - wgLpDelay (aSt, w0), 4.0f, 8000.0f);
                fxD.at (db + 2 + u) = min (float (exp (-6.9078f * T / (sr * t60))) / wgLpGain (aSt, w0), 0.9998f);
            }

            fxD.at (db + 4) = aSt;
            fxD.at (db + 5) = 0.25f;
            fxD.at (db + 6) = 1.0f + 4.0f * p3;
            fxD.at (db + 7) = lvl;
            fxD.at (db + 8) = float (md);
        }
    }

    float<2> fxYbSpring (int s, float<2> x)
    {
        int   ab  = fxAb (s);
        int   ib  = s * 24;
        int   db  = s * 16;
        int   fb  = s * 40;
        int   pp  = fxI.at (ib);
        int   md  = int (fxD.at (db + 8) + 0.5f);
        float g   = fxD.at (db + 2);
        float aSp = fxD.at (db + 3);
        float aAp = fxD.at (db + 4);
        float dep = fxD.at (db + 5);
        float inc = fxD.at (db + 6);
        float lvl = fxD.at (db + 7);
        float xm  = 0.5f * (x[0] + x[1]);
        float[2] ys;

        for (int v = 0; v < 2; ++v)
        {
            int   pb = ab + v * 32768;
            float ph = fxF.at (fb + 4 + v) + inc * (1.0f + 0.43f * float (v));
            ph -= float (floor (ph));
            fxF.at (fb + 4 + v) = ph;
            float rq = float (pp) - (fxD.at (db + v) + dep * float (sin (6.2831853f * ph)));
            int   q0 = int (floor (rq));
            float qf = rq - float (q0);
            float y  = fxArena.at (pb + (q0 & 32767)) * (1.0f - qf) + fxArena.at (pb + ((q0 + 1) & 32767)) * qf;

            for (int a = 0; a < 4; ++a)   // dispersion: the low frequencies arrive later
            {
                int   ai = fb + 6 + v * 4 + a;
                float yo = -aAp * y + fxF.at (ai);
                fxF.at (ai) = clamp (y + aAp * yo, -16.0f, 16.0f);
                y = yo;
            }

            float l = (1.0f - aSp) * y + aSp * fxF.at (fb + 2 + v);
            fxF.at (fb + 2 + v) = l;
            ys.at (v) = l;
            fxArena.at (pb + (pp & 32767)) = clamp ((md == 2 ? x[v] : xm) * 0.7f + l * g, -8.0f, 8.0f);
        }

        fxI.at (ib) = (pp + 1) & 32767;

        if (md == 0)
        {
            float o = float (tanh (ys.at (0) * lvl));
            return float<2> (o, o);
        }

        if (md == 1)
            return float<2> (float (tanh ((0.8f * ys.at (0) + 0.2f * ys.at (1)) * lvl)), float (tanh ((0.2f * ys.at (0) + 0.8f * ys.at (1)) * lvl)));

        return float<2> (float (tanh (ys.at (0) * lvl)), float (tanh (ys.at (1) * lvl)));
    }

    float<2> fxYbDrum (int s, float<2> x)
    {
        int   db  = s * 16;
        int   cb  = s * 1024;
        int   md  = int (fxD.at (db + 8) + 0.5f);
        float lvl = fxD.at (db + 9);
        float xm  = 0.5f * (x[0] + x[1]);
        float[2] A;

        for (int v = 0; v < (md == 0 ? 1 : 2); ++v)
        {
            float drive = md == 2 ? x[v] : xm;
            float mem   = 0.0f;

            for (int k = 0; k < 8; ++k)
            {
                int   ci = cb + (v * 8 + k) * 4;
                int   mi = cb + 512 + (v * 8 + k) * 2;
                float yv = clamp (csV.at (ci) * csV.at (mi) - csV.at (ci + 1) * csV.at (mi + 1) + csV.at (ci + 2) * drive, -16.0f, 16.0f);
                csV.at (mi + 1) = csV.at (mi);
                csV.at (mi)     = yv;
                mem += yv * csV.at (ci + 3);
            }

            A.at (v) = mem;
        }

        if (md == 0)
        {
            float o = float (tanh (A.at (0) * lvl));
            return float<2> (o, o);
        }

        if (md == 1)
            return float<2> (float (tanh ((0.8f * A.at (0) + 0.2f * A.at (1)) * lvl)), float (tanh ((0.2f * A.at (0) + 0.8f * A.at (1)) * lvl)));

        return float<2> (float (tanh (A.at (0) * lvl)), float (tanh (A.at (1) * lvl)));
    }

    float<2> fxYbString (int s, float<2> x)
    {
        int   ab  = fxAb (s);
        int   ib  = s * 24;
        int   db  = s * 16;
        int   fb  = s * 40;
        int   sp  = fxI.at (ib);
        float aSt = fxD.at (db + 4);
        float ing = fxD.at (db + 5);
        float nl  = fxD.at (db + 6);
        float lvl = fxD.at (db + 7);
        int   md  = int (fxD.at (db + 8) + 0.5f);
        float xm  = 0.5f * (x[0] + x[1]);
        float[2] ys;

        for (int u = 0; u < (md == 0 ? 1 : 2); ++u)
        {
            int   sb = ab + u * 8192;
            float rp = float (sp) - fxD.at (db + u);
            int   i0 = int (floor (rp));
            float fr = rp - float (i0);
            float y  = fxArena.at (sb + (i0 & 8191)) * (1.0f - fr) + fxArena.at (sb + ((i0 + 1) & 8191)) * fr;
            float lp = (1.0f - aSt) * y + aSt * fxF.at (fb + u);
            fxF.at (fb + u) = lp;
            float w = ((md == 1 ? x[u] : xm) * ing + lp * fxD.at (db + 2 + u)) * nl;
            fxArena.at (sb + (sp & 8191)) = float (tanh (w)) / nl;   // the bow: the friction limits the loop
            ys.at (u) = y;
        }

        fxI.at (ib) = (sp + 1) & 8191;

        if (md == 0)
        {
            float o = float (tanh (ys.at (0) * lvl));
            return float<2> (o, o);
        }

        if (md == 1)
            return float<2> (float (tanh (ys.at (0) * lvl)), float (tanh (ys.at (1) * lvl)));

        return float<2> (float (tanh ((0.8f * ys.at (0) + 0.2f * ys.at (1)) * lvl)), float (tanh ((0.2f * ys.at (0) + 0.8f * ys.at (1)) * lvl)));
    }

    // One slot: dry/wet mix of the selected effect; empty and bypassed slots pass the signal through untouched
    // FX-WET: wet signal post processing of every slot (P7..P10: Low Cut, High Cut, Width, Sat)
    void fxWetSet (int s, int k, float v)
    {
        int q = s * 8;
        fxQ.at (q + k) = v;
        float sr = float (processor.frequency);
        fxQ.at (q + 4) = 1.0f - float (exp (-6.283185307f * 20.0f * float (pow (50.0f, fxQ.at (q))) / sr));
        fxQ.at (q + 5) = 1.0f - float (exp (-6.283185307f * 1500.0f * float (pow (13.3333f, fxQ.at (q + 1))) / sr));
        bool act = fxQ.at (q) > 0.002f || fxQ.at (q + 1) < 0.998f || abs (fxQ.at (q + 2) - 0.5f) > 0.002f || fxQ.at (q + 3) > 0.002f;
        fxQ.at (q + 6) = act ? 1.0f : 0.0f;
    }

    // the same for an oscillator rack slot g (48 + 16 * osc + slot): written to the copies of all 8 voices
    void fxWetSetO (int g, int k, float v)
    {
        for (int vi = 0; vi < 8; ++vi)
            fxWetSet (48 + vi * 96 + (g - 48), k, v);
    }

    float<2> fxWet (int s, float<2> y)
    {
        int q = s * 8;

        if (fxQ.at (q + 6) < 0.5f)
            return y;

        float l = y[0];
        float r = y[1];

        if (fxQ.at (q) > 0.002f)
        {
            float c = fxQ.at (q + 4);
            fxX.at (q)     += c * (l - fxX.at (q));
            fxX.at (q + 1) += c * (r - fxX.at (q + 1));
            l -= fxX.at (q);
            r -= fxX.at (q + 1);
        }

        if (fxQ.at (q + 1) < 0.998f)
        {
            float c = fxQ.at (q + 5);
            fxX.at (q + 2) += c * (l - fxX.at (q + 2));
            fxX.at (q + 3) += c * (r - fxX.at (q + 3));
            fxX.at (q + 4) += c * (fxX.at (q + 2) - fxX.at (q + 4));
            fxX.at (q + 5) += c * (fxX.at (q + 3) - fxX.at (q + 5));
            l = fxX.at (q + 4);
            r = fxX.at (q + 5);
        }

        float sa = fxQ.at (q + 3);

        if (sa > 0.002f)
        {
            float gs = 1.0f + 6.0f * sa;
            float nr = 1.0f / sqrt (gs);
            l = float (tanh (l * gs)) * nr;
            r = float (tanh (r * gs)) * nr;
        }

        float wd = fxQ.at (q + 2);

        if (abs (wd - 0.5f) > 0.002f)
        {
            float md = (l + r) * 0.5f;
            float sd = (l - r) * 0.5f * (wd * 2.0f);
            l = md + sd;
            r = md - sd;
        }

        return float<2> (l, r);
    }

    float<2> fxRunSlot (int s, float<2> x)
    {
        int ty = fxType.at (s);

        if (ty == 0 || fxOn.at (s) < 0.5f)
            return x;

        if (fxDirty.at (s))
        {
            fxDerive (s);
            fxDirty.at (s) = false;
        }

        float<2> x0 = x;   // FX-EX
        bool     exOn = fxE.at (s * 8 + 4) > 0.5f;

        if (exOn)
            x = fxExPre (s, x);

        float<2> y = x;

        if (ty == 1)       y = fxDist   (s, x);
        else if (ty == 2)  y = fxCrush  (s, x);
        else if (ty == 3)  y = fxDelay  (s, x);
        else if (ty == 4)  y = fxChorus (s, x);
        else if (ty == 5)  y = fxFlanger (s, x);
        else if (ty == 6)  y = fxPhaser (s, x);
        else if (ty == 7)  y = fxTrem   (s, x);
        else if (ty == 8)  y = fxReverb (s, x);
        else if (ty == 9)  y = fxFilter (s, x);
        else if (ty == 10) y = fxEq     (s, x);
        else if (ty == 11) y = fxComp   (s, x);
        else if (ty == 12) y = fxConv   (s, x);
        else if (ty == 13) y = fxPeq    (s, x);
        else if (ty == 14) y = fxSat    (s, x);
        else if (ty == 15) y = fxWs     (s, x);
        else if (ty == 16) y = fxUni    (s, x);
        else if (ty == 17) y = fxCon    (s, x);
        else if (ty == 18) y = fxFb     (s, x);
        else if (ty == 19) y = fxAwPurest  (s, x);
        else if (ty == 20) y = fxAwSpiral  (s, x);
        else if (ty == 21) y = fxAwDrive   (s, x);
        else if (ty == 22) y = fxAwTube    (s, x);
        else if (ty == 23) y = fxAwDensity (s, x);
        else if (ty == 24) y = fxAwConsole (s, x);
        else if (ty == 25) y = fxAwChannel (s, x);
        else if (ty == 26) y = fxAwTape    (s, x);
        else if (ty == 27) y = fxAwMack    (s, x);
        else if (ty == 28) y = fxPlasma    (s, x);
        else if (ty == 29) y = fxGranular  (s, x);
        else if (ty == 30) y = fxWarp      (s, x);
        else if (ty == 31) y = fxCloudSeed (s, x);
        else if (ty == 32) y = fxWaveguide (s, x);
        else if (ty == 34) y = s < 48 ? fxShTab (s, x) : x;   // FX-SHTAB
        else if (ty == 35) y = s < 48 ? fxYbSpring (s, x) : x;   // FX-YBPARTS
        else if (ty == 36) y = s < 48 ? fxYbDrum (s, x) : x;
        else if (ty == 37) y = s < 48 ? fxYbString (s, x) : x;
        else if (ty == 33) y = s < 48 ? fxYaybahar (s, x) : x;   // FX-YAYBAHAR: needs the big arena of the rack slots

        // FX-EXT: wet-signal post processing   // FX-SYNC
        if (ty >= 4 && ty <= 6)
        {
            float md = (y[0] + y[1]) * 0.5f;
            float sd = (y[0] - y[1]) * 0.5f * fxD.at (s * 16 + 6);
            y = float<2> (md + sd, md - sd);
        }
        else if (ty == 8)
        {
            int   fb = s * 40;
            int   db = s * 16;
            float l1 = fxF.at (fb + 36) + fxD.at (db + 7) * (y[0] - fxF.at (fb + 36));
            float r1 = fxF.at (fb + 37) + fxD.at (db + 7) * (y[1] - fxF.at (fb + 37));
            fxF.at (fb + 36) = l1;
            fxF.at (fb + 37) = r1;
            float l2 = fxF.at (fb + 38) + fxD.at (db + 6) * (l1 - fxF.at (fb + 38));
            float r2 = fxF.at (fb + 39) + fxD.at (db + 6) * (r1 - fxF.at (fb + 39));
            fxF.at (fb + 38) = l2;
            fxF.at (fb + 39) = r2;
            y = float<2> (l1 - l2, r1 - r2);
        }
        else if (ty == 3 && fxMode.at (s) == 3)
        {
            // ducking delay: the echoes drop while the input plays and swell back when it stops
            int   fb  = s * 40;
            float det = max (abs (x[0]), abs (x[1]));
            float en  = fxF.at (fb + 36);
            en += (det > en ? 0.01f : 0.0002f) * (det - en);
            fxF.at (fb + 36) = en;
            y = y * (1.0f / (1.0f + en * 12.0f));
        }

        if (exOn)
            y = fxExPost (s, y, x0);   // FX-EX

        y = fxWet (s, y);   // FX-WET

        float mix = clamp (fxMix.at (s), 0.0f, 1.0f);
        float<2> res = x0 + (y - x0) * mix;

        if (s == fxMon)
            vzTap (x0, res);   // FX-VIZ

        return res;
    }

    // The whole rack, in the user's order
    float<2> fxRunRack (int rk, float<2> x)
    {
        float<2> v = x;

        for (int k = 0; k < 16; ++k)
            v = fxRunSlot (fxG (rk, fxSeq.at (rk * 16 + k)), v);

        return v;
    }

    // Start-up values of the rack (every slot empty, on, 100 % mix, identity order)
    void fxInit()
    {
        for (int s = 0; s < 48; ++s)
        {
            fxType.at (s)  = 0;
            fxOn.at (s)    = 1.0f;
            fxMix.at (s)   = 1.0f;
            fxMode.at (s)  = 0;
            fxDirty.at (s) = true;
            fxQ.at (s * 8 + 1) = 1.0f;   // FX-WET: defaults High Cut open, Width 0.5 (unchanged)
            fxQ.at (s * 8 + 2) = 0.5f;

            for (int k = 0; k < 6; ++k)
                fxP.at (s * 6 + k) = 0.5f;
        }

        for (int s = 48; s < 816; ++s)   // OSCFX3-DSP: per voice slots of the oscillator racks
        {
            fxType.at (s)  = 0;
            fxOn.at (s)    = 1.0f;
            fxMix.at (s)   = 1.0f;
            fxMode.at (s)  = 0;
            fxDirty.at (s) = true;
            fxSync.at (s)  = 0;
            fxEnvSus.at (s) = 1.0f;
            fxEnvRel.at (s) = 0.3f;
            fxQ.at (s * 8 + 1) = 1.0f;   // FX-WET: defaults High Cut open, Width 0.5 (unchanged)
            fxQ.at (s * 8 + 2) = 0.5f;

            for (int k = 0; k < 6; ++k)
                fxP.at (s * 6 + k) = 0.5f;
        }

        for (int o = 0; o < 96; ++o)   // OSCFX4-DSP
        {
            oscOrd.at (o) = o - (o / 16) * 16;
            oscSeq.at (o) = o - (o / 16) * 16;
        }

        for (int o = 0; o < 48; ++o)
        {
            fxOrder.at (o) = o - (o / 16) * 16;
            fxSeq.at (o)   = o - (o / 16) * 16;
        }
    }

    // ---------------- MIXER EQ HELPERS (processor scope) ----------------

    // ---------------- SAMPLE MEMORY HELPERS (processor scope) ----------------

    // ---------------- SAMPLER 2 MEMORY HELPERS (processor scope) ----------------

    // ---------------- WAVETABLE MEMORY HELPERS (processor scope) ----------------

    // ---------------- WAVETABLE 2 MEMORY HELPERS (processor scope) ----------------

    // ---------------- WAVETABLE 3 MEMORY HELPERS (processor scope) ----------------

    // ---------------- WAVETABLE UNISON HELPERS (processor scope) ----------------

    // Fixed pseudo-random position (-1..1) of a unison voice, used by the Random unison style
    float uniRandPos (int e, int j)
    {
        float s = float (sin (float (j * 7 + e * 13 + 1) * 12.9898f)) * 43758.5453f;
        return 2.0f * (s - float (floor (s))) - 1.0f;
    }

    // Phase warp (modes 1-6) of one warp slot: maps the 0..1 oscillator phase to the table read phase
    float wtWarpPhase (int mode, float amt, float ph)   // WT2-WARP
    {
        if (mode == 1)
            return float (pow (ph, 1.0f + 3.0f * amt));                    // bend +

        if (mode == 2)
            return 1.0f - float (pow (1.0f - ph, 1.0f + 3.0f * amt));      // bend -

        if (mode == 3)
        {
            float x = ph * (1.0f + 7.0f * amt);                           // sync
            return x - float (floor (x));
        }

        if (mode == 4)
        {
            float w = 0.5f - 0.45f * amt;                                 // pulse width
            if (ph < w) return ph * 0.5f / w;
            return 0.5f + (ph - w) * 0.5f / (1.0f - w);
        }

        if (mode == 5)
        {
            float x = ph * (1.0f + amt);                                  // mirror
            if (x > 1.0f) x = 2.0f - x;
            return clamp (x, 0.0f, 1.0f);
        }

        if (mode == 6)
            return ph * (1.0f - amt) + (1.0f - ph) * amt;                 // flip

        if (mode == 9)
            return ph + amt * 0.159155f * float (sin (6.2831853f * ph));  // smear: a smooth bulge of the phase

        if (mode == 10)
            return ph + amt * 0.05f * float (sin (31.415927f * ph));      // ripple: fast phase wobble (adds harmonics)

        if (mode == 11)
        {
            float x = ph * 4.0f;                                          // stairs: four smoothed steps per cycle
            float i = float (floor (x));
            float f = x - i;
            float s = f * f * (3.0f - 2.0f * f);
            return (i + f + (s - f) * amt) * 0.25f;
        }

        if (mode == 12)
        {
            float x = ph * (1.0f + 3.0f * amt) * 0.5f;                    // fold phase: the phase runs forth and back
            float t = (x - float (floor (x))) * 2.0f;
            return t < 1.0f ? t : 2.0f - t;
        }

        if (mode == 18)
        {
            float x = ph * 2.0f - 1.0f;                                   // pinch: the phase is pulled toward the middle of the cycle
            float a = float (pow (abs (x), 1.0f + 3.0f * amt));
            return 0.5f + 0.5f * (x < 0.0f ? -a : a);
        }

        if (mode == 19)
        {
            float x = ph * 2.0f - 1.0f;                                   // spread: the phase is pushed away from the middle
            float a = float (pow (abs (x), 1.0f / (1.0f + 3.0f * amt)));
            return 0.5f + 0.5f * (x < 0.0f ? -a : a);
        }

        if (mode == 20)
            return clamp (ph / (1.0f - 0.9f * amt), 0.0f, 1.0f);           // slice: the cycle is squeezed to its start, then held

        if (mode == 21)
        {
            float x = ph * 2.0f;                                          // twin: two cycles blended in
            return ph + (x - float (floor (x)) - ph) * amt;
        }

        return ph;
    }

    // Amplitude warp (modes 7, 8, 13 .. 17, 22 .. 26) of one warp slot
    float wtWarpAmp (int mode, float amt, float y)
    {
        if (mode == 7)
        {
            float s = 2.0f + (1.0f - amt) * 254.0f;                       // quantize
            return float (floor (y * s + 0.5f)) / s;
        }

        if (mode == 8)
            return y * (1.0f - amt) + amt * float (sin (y * (1.0f + 4.0f * amt) * 1.5708f));   // fold

        if (mode == 13)
            return clamp (y * (1.0f + 6.0f * amt), -1.0f, 1.0f);           // clip

        if (mode == 14)
            return y + (float (abs (y)) - y) * amt;                        // rectify (the DC is removed afterwards)

        if (mode == 15)
        {
            float z = y * (1.0f + 3.0f * amt);                            // wrap around
            return z - 2.0f * float (floor ((z + 1.0f) * 0.5f));
        }

        if (mode == 16)
            return y > 0.0f ? y : y * (1.0f - 0.9f * amt);                 // asymmetric

        if (mode == 17)
        {
            float d = 1.0f + 6.0f * amt;                                  // soft drive
            return float (tanh (y * d)) / float (tanh (d));
        }

        if (mode == 22)
            return y + (4.0f * y * y * y - 3.0f * y - y) * amt;            // Chebyshev T3 (adds the 3rd harmonic)

        if (mode == 23)
        {
            float y2 = y * y;
            return y + (y * (16.0f * y2 * y2 - 20.0f * y2 + 5.0f) - y) * amt;   // Chebyshev T5
        }

        if (mode == 24)
        {
            float d = amt * 0.5f;                                         // deadzone: small values fall to zero
            float a = max (float (abs (y)) - d, 0.0f) / (1.0f - d);
            return y < 0.0f ? -a : a;
        }

        if (mode == 25)
        {
            float a = float (pow (abs (y), 1.0f + 2.0f * amt));           // expand: quiet parts get quieter
            return y < 0.0f ? -a : a;
        }

        if (mode == 26)
        {
            float a = float (pow (abs (y), 1.0f / (1.0f + 2.0f * amt)));  // compress: quiet parts get louder
            return y < 0.0f ? -a : a;
        }

        return y;
    }

    bool wtIsAmp (int m)
    {
        return m == 7 || m == 8 || m >= 13;
    }

    bool wtIsPhase (int m)
    {
        return (m >= 1 && m <= 6) || (m >= 9 && m <= 12) || (m >= 18 && m <= 21);
    }

    float nextNoise()
    {
        noiseState = (noiseState * 1103515245 + 12345) & 0x7fffffff;
        return (float (noiseState) / 2147483647.0f) * 2.0f - 1.0f;
    }

    // ---------------- MOD PAGE HELPERS (processor scope) ----------------

    // Advances all 10 mod LFOs by one sample; outputs are bipolar -1..1 in mLfoV
    // LFO frequency of a sync division at the current tempo
    float syncHz (float divIdx)
    {
        float bpm = hostBpm;
        if (syncBpmOver > 1.0f) bpm = syncBpmOver;
        return (bpm / 60.0f) / divBeats.at (clamp (int (divIdx + 0.5f), 0, 17));
    }

    // LFO2-BEGIN
    // Reads the drawn shape of LFO m at phase p (0..1); looping shapes interpolate from the last point back to the first (linear or cubic)
    float lfoTabRead (int m, float p, bool wrapEnd)
    {
        float pos = clamp (p, 0.0f, 1.0f) * 256.0f;
        int   i0  = int (pos);
        float fr  = pos - float (i0);

        if (i0 > 255)
        {
            i0 = 255;
            fr = 0.0f;
        }

        int i1 = i0 + 1;
        int im = i0 - 1;
        int i2 = i0 + 2;

        if (wrapEnd)
        {
            i1 = i1 & 255;
            im = im & 255;
            i2 = i2 & 255;
        }
        else
        {
            i1 = min (i1, 255);
            im = max (im, 0);
            i2 = min (i2, 255);
        }

        float y0 = lfoTab.at (m * 256 + i0);
        float y1 = lfoTab.at (m * 256 + i1);

        if (mLfoCubic.at (m) < 0.5f)
            return y0 + (y1 - y0) * fr;

        float ym = lfoTab.at (m * 256 + im);
        float y2 = lfoTab.at (m * 256 + i2);
        return clamp (y0 + 0.5f * fr * (y1 - ym + fr * (2.0f * ym - 5.0f * y0 + 4.0f * y1 - y2 + fr * (3.0f * (y0 - y1) + y2 - ym))), -1.0f, 1.0f);
    }

    float lfoFrac (float x)
    {
        return x - float (floor (x));
    }

    // polyBLEP residual for a discontinuity at phase 0 (p = phase, dp = phase increment per sample)
    float lfoBlep (float p, float dp)
    {
        if (dp <= 0.0f || dp >= 0.5f)
            return 0.0f;

        if (p < dp)
        {
            float t = p / dp;
            return t + t - t * t - 1.0f;
        }

        if (p > 1.0f - dp)
        {
            float t = (p - 1.0f) / dp;
            return t * t + t + t + 1.0f;
        }

        return 0.0f;
    }

    // the basic shapes: 0 sine, 1 triangle, 2 square, 3 S&H, 4 saw up, 5 saw down, 6 drawn
    float lfoBasic (int w, int m, float p, float sh, bool wrapEnd, float dp)
    {
        if (w == 0)
            return float (sin (float (twoPi) * p));
        if (w == 1)
            return 4.0f * abs (p - 0.5f) - 1.0f;
        if (w == 2)
        {
            float q = p + 0.5f;
            if (q >= 1.0f) q -= 1.0f;
            float y = 1.0f;
            if (p >= 0.5f) y = -1.0f;
            return y + lfoBlep (p, dp) - lfoBlep (q, dp);
        }
        if (w == 3)
            return sh;
        if (w == 4)
            return 2.0f * p - 1.0f - lfoBlep (p, dp);
        if (w == 5)
            return 1.0f - 2.0f * p + lfoBlep (p, dp);

        return lfoTabRead (m, p, wrapEnd);
    }

    // frame fr of the wavetable of LFO m at phase p (always looping; linear or cubic)
    float lfoWtRead (int m, int fr, float p)
    {
        float pos = clamp (p, 0.0f, 1.0f) * 256.0f;
        int   i0  = int (pos) & 255;
        float f   = pos - float (int (pos));
        int   b   = ((m * 16 + fr) * 256);
        float y0  = lfoWt.at (b + i0);
        float y1  = lfoWt.at (b + ((i0 + 1) & 255));

        if (mLfoCubic.at (m) < 0.5f)
            return y0 + (y1 - y0) * f;

        float ym = lfoWt.at (b + ((i0 + 255) & 255));
        float y2 = lfoWt.at (b + ((i0 + 2) & 255));
        return clamp (y0 + 0.5f * f * (y1 - ym + f * (2.0f * ym - 5.0f * y0 + 4.0f * y1 - y2 + f * (3.0f * (y0 - y1) + y2 - ym))), -1.0f, 1.0f);
    }

    // Output of LFO m at phase p; wave 7 = the editable wavetable (up to 16 frames of 256 points, Position scans the frames)
    float lfoWaveVal (int m, float p, float sh, bool wrapEnd, float dp)
    {
        int w = int (mLfoWave.at (m) + 0.5f);

        if (w == 7)
        {
            int   n  = clamp (lfoWtN.at (m), 1, 16);
            float fp = clamp (mLfoTpos.at (m), 0.0f, 1.0f) * float (n - 1);
            int   fa = min (int (fp), n - 1);
            int   fb = min (fa + 1, n - 1);
            float ff = fp - float (fa);
            float a  = lfoWtRead (m, fa, p);

            if (fb == fa || ff <= 0.0f)
                return a;

            return a + (lfoWtRead (m, fb, p) - a) * ff;
        }

        return lfoBasic (w, m, p, sh, wrapEnd, dp);
    }

    // phase bend (Skew), quantizer (Steps) and Depth of LFO m applied to the raw value
    float lfoSkewPhase (int m, float p)
    {
        float s = mLfoSkew.at (m);

        if (s > -0.001f && s < 0.001f)
            return p;

        return float (pow (clamp (p, 0.0f, 1.0f), lfoSkewExp (m, s)));
    }

    float lfoShape (int m, float v)
    {
        float n = mLfoSteps.at (m);

        if (n >= 1.5f)
        {
            float q = float (floor ((v * 0.5f + 0.5f) * n - 0.0001f));
            v = clamp (q, 0.0f, n - 1.0f) / (n - 1.0f) * 2.0f - 1.0f;
        }

        return v * mLfoDepth.at (m);
    }

    // one-pole lag of the Smooth control (0 = off, 1 = about 250 ms)
    // LFOFAST-BEGIN: parameter dependent values are computed when the parameters change, not for every voice and sample
    float[16] lfoKmArg;
    float[16] lfoKmVal;
    int[16]   lfoKmOk;
    float[16] lfoSkArg;
    float[16] lfoSkVal;
    int[16]   lfoSkOk;
    float[16] lfoLgS;
    float[16] lfoLgD;
    float[16] lfoLgK;
    int[16]   lfoLgOk;

    float lfoKeyMul (int m)
    {
        float a = mLfoOct.at (m) - 4.0f + (mLfoSemi.at (m) - 12.0f) / 12.0f + mLfoFine.at (m) / 1200.0f;

        if (lfoKmOk.at (m) == 0 || a != lfoKmArg.at (m))
        {
            lfoKmArg.at (m) = a;
            lfoKmVal.at (m) = float (pow (2.0f, a));
            lfoKmOk.at (m)  = 1;
        }

        return lfoKmVal.at (m);
    }

    float lfoSkewExp (int m, float s)
    {
        if (lfoSkOk.at (m) == 0 || s != lfoSkArg.at (m))
        {
            lfoSkArg.at (m) = s;
            lfoSkVal.at (m) = float (pow (2.0f, s * 2.0f));
            lfoSkOk.at (m)  = 1;
        }

        return lfoSkVal.at (m);
    }

    float lfoLagM (int m, float state, float x, float smooth, float dtv)
    {
        if (smooth <= 0.001f)
            return x;

        if (lfoLgOk.at (m) == 0 || smooth != lfoLgS.at (m) || dtv != lfoLgD.at (m))
        {
            lfoLgS.at (m)  = smooth;
            lfoLgD.at (m)  = dtv;
            lfoLgK.at (m)  = 1.0f - float (exp (-dtv / (0.0002f + smooth * 0.25f)));
            lfoLgOk.at (m) = 1;
        }

        return state + (x - state) * lfoLgK.at (m);
    }
    // LFOFAST-END

    float lfoLag (float state, float x, float smooth, float dtv)
    {
        if (smooth <= 0.001f)
            return x;

        return state + (x - state) * (1.0f - float (exp (-dtv / (0.0002f + smooth * 0.25f))));
    }

    float lfoRateHz (int m)
    {
        if (mLfoSync.at (m) > 0.5f)
            return syncHz (mLfoDiv.at (m));

        return mLfoRate.at (m);
    }

    // true when LFO m runs per voice (Trig / Env or Key follow)
    bool lfoPerVoice (int m)
    {
        return mLfoMode.at (m) > 0.5f || mLfoKey.at (m) > 0.5f;
    }

    // Free-running (global) LFOs: advances all 10 by one sample
    void updateModLfos (float dtv)
    {
        for (int m = 0; m < 10; ++m)
        {
            if (mLfoKey.at (m) > 0.5f)
                continue;

            float rate = lfoRateHz (m) * (1.0f + mLfoJit.at (m) * 0.5f * mLfoJ.at (m));
            float64 np = mLfoPhase.at (m) + float64 (rate) * processor.period;
            if (np >= 1.0)
            {
                np -= 1.0;
                mLfoSh.at (m) = nextNoise();
                mLfoJ.at (m)  = nextNoise();
            }
            mLfoPhase.at (m) = np;

            if ((lfoMask & (1 << m)) == 0)   // no matrix slot uses this LFO: only the phase runs on
                continue;

            float p = float (np) + mLfoStart.at (m);
            if (p >= 1.0f) p -= 1.0f;

            float val = lfoShape (m, lfoWaveVal (m, lfoSkewPhase (m, p), mLfoSh.at (m), true, rate * float (processor.period)));
            mLfoSm.at (m) = lfoLagM (m, mLfoSm.at (m), val, mLfoSmooth.at (m), dtv);
            mLfoV.at (m)  = mLfoSm.at (m);
        }
    }

    // Per-voice LFOs (Trig, Env, Key follow): phase restarts on note-on, Delay / Rise fade the output in, Env stops at the end of the shape
    void updateVoiceLfos (int vi, float dtv)
    {
        if (lfoMask == 0)
            return;

        for (int m = 0; m < 10; ++m)
        {
            if ((lfoMask & (1 << m)) == 0 || ! lfoPerVoice (m))
                continue;

            bool    oneShot = mLfoMode.at (m) > 1.5f;
            bool    keyed   = mLfoKey.at (m) > 0.5f;
            float   age     = voices.at (vi).lfoAge.at (m);
            bool    first   = age < 0.0f;
            float64 np      = voices.at (vi).lfoPh.at (m);
            float   rate    = lfoRateHz (m);

            if (keyed)
                rate = clamp (voices.at (vi).curFreq * lfoKeyMul (m), 0.001f, float (processor.frequency) * 0.45f);

            rate *= 1.0f + mLfoJit.at (m) * 0.5f * voices.at (vi).lfoJ.at (m);

            if (first)
            {
                age = 0.0f;
                np  = float64 (mLfoSpread.at (m) * lfoFrac (float (vi) * 0.618034f + 0.137f));
            }
            else
            {
                age += dtv;
                np  += float64 (rate) * processor.period;

                if (np >= 1.0)
                {
                    if (oneShot)
                        np = 1.0;
                    else
                    {
                        np -= 1.0;
                        voices.at (vi).lfoSh.at (m) = nextNoise();
                        voices.at (vi).lfoJ.at (m)  = nextNoise();
                    }
                }
            }

            voices.at (vi).lfoPh.at (m)  = np;
            voices.at (vi).lfoAge.at (m) = age;

            float p = float (np);
            if (! oneShot)
            {
                p += mLfoStart.at (m);
                if (p >= 1.0f) p -= 1.0f;
            }

            float val  = lfoShape (m, lfoWaveVal (m, lfoSkewPhase (m, p), voices.at (vi).lfoSh.at (m), ! oneShot, rate * float (processor.period)));
            float fade = 1.0f;
            float dl   = mLfoDelay.at (m) * 0.001f;
            float rs   = mLfoRise.at (m) * 0.001f;

            if (age < dl)
                fade = 0.0f;
            else if (rs > 0.0001f)
                fade = clamp ((age - dl) / rs, 0.0f, 1.0f);

            val *= fade;

            float st = voices.at (vi).lfoSm.at (m);
            if (first)
                st = val;

            st = lfoLagM (m, st, val, mLfoSmooth.at (m), dtv);
            voices.at (vi).lfoSm.at (m) = st;
            voices.at (vi).lfoV.at (m)  = st;
        }
    }
    // LFO2-END

    // Moves the per-sample maxima of each mod envelope (across voices) into the global slot
    void rollEnvMax()
    {
        for (int m = 0; m < 10; ++m)
        {
            envMax.at (m)     = envMaxNext.at (m);
            envMaxNext.at (m) = 0.0f;
        }
    }

    // RND-DSP: one uniform random number -1..1 from the state of RND r of voice vi
    float rndUni (int vi, int r)
    {
        int s = (voices.at (vi).rS.at (r) * 1103515245 + 12345) & 0x7fffffff;
        voices.at (vi).rS.at (r) = s;
        return (float (s) / 2147483647.0f) * 2.0f - 1.0f;
    }

    // RND-DSP: a random value with the distribution of RND r
    float rndDraw (int vi, int r)
    {
        float a = rndUni (vi, r);
        int   d = rDist.at (r);

        if (d == 1)
            a = clamp ((a + rndUni (vi, r) + rndUni (vi, r)) * 0.6667f, -1.0f, 1.0f);   // bell shaped
        else if (d == 2)
            a = a >= 0.0f ? 1.0f : -1.0f;
        else if (d == 3)
            a = floor (a * 2.0f + 0.5f) * 0.5f;   // 5 levels: -1 -0.5 0 0.5 1

        return a;
    }

    // RND-DSP: note on, every RND draws its first value
    void rndNoteOn (int vi)
    {
        for (int r = 0; r < 10; ++r)
        {
            int sd = rSeed.at (r);
            voices.at (vi).rS.at (r) = sd > 0 ? ((sd * 7919 + r * 104729 + 12345) & 0x7fffffff) : ((noiseState * 69069 + r * 7919 + 1) & 0x7fffffff);
            float v = rndDraw (vi, r);
            voices.at (vi).rV.at (r)    = v;
            voices.at (vi).rPrev.at (r) = v;
            voices.at (vi).rTgt.at (r)  = v;
            voices.at (vi).rPh.at (r)   = 0.0f;
        }
    }

    // RND-DSP: advances the 10 random modulators of one voice by one sample (Note mode keeps its value)
    void updateVoiceRnd (int vi, float dtv)
    {
        for (int r = 0; r < 10; ++r)
        {
            int mode = rMode.at (r);

            if (mode == 0)
                continue;

            float hz = rSync.at (r) > 0 ? syncHz (rDiv.at (r)) : rRate.at (r);
            float ph = voices.at (vi).rPh.at (r) + dtv * hz;

            if (ph >= 1.0f)
            {
                ph = ph - floor (ph);
                voices.at (vi).rPrev.at (r) = voices.at (vi).rTgt.at (r);
                voices.at (vi).rTgt.at (r)  = mode == 3 ? clamp (voices.at (vi).rTgt.at (r) + rndDraw (vi, r) * 0.35f, -1.0f, 1.0f) : rndDraw (vi, r);
            }

            voices.at (vi).rPh.at (r) = ph;

            float target = voices.at (vi).rTgt.at (r);

            if (mode == 2)
                target = voices.at (vi).rPrev.at (r) + (target - voices.at (vi).rPrev.at (r)) * (ph * ph * (3.0f - 2.0f * ph));

            float sm = rSmooth.at (r);
            float cur = voices.at (vi).rV.at (r);
            voices.at (vi).rV.at (r) = sm <= 0.001f ? target : cur + (target - cur) * clamp (dtv / (sm * sm * 0.5f + 0.0001f), 0.0f, 1.0f);
        }
    }

    float rndOut (int vi, int r)
    {
        float v = voices.at (vi).rV.at (r);
        return rUni.at (r) > 0 ? v * 0.5f + 0.5f : v;
    }

    // MSEG-DSP: advances MSEG m of one voice by one sample
    void msStep (int vi, int m, float dtv)
    {
        int   ms  = voices.at (vi).mstage.at (m);
        float me  = voices.at (vi).menv.at (m);
        int   n   = msN.at (m);
        int   sus = msSus.at (m) - 1;
        int   fl  = voices.at (vi).vmFlag.at (m);
        int   k   = voices.at (vi).vmNode.at (m);

        if (ms == 3 && fl == 0)
        {
            fl = 1;
            voices.at (vi).vmFrom.at (m) = me;
            voices.at (vi).vmT.at (m)    = 0.0f;

            if (sus < 0)
                fl = 2;
            else
            {
                if (k <= sus)
                    k = sus + 1;

                if (k >= n)
                    fl = 2;
            }
        }

        if ((ms == 1 || (ms == 3 && fl == 1)) && k < n)
        {
            float tt = max (msT.at (m * 8 + k), 0.0f) * 0.001f;
            float t  = voices.at (vi).vmT.at (m) + dtv;
            float x  = tt <= 0.00002f ? 1.0f : t / tt;
            float lv = msL.at (m * 8 + k);

            if (x >= 1.0f)
            {
                me = lv;
                voices.at (vi).vmFrom.at (m) = me;
                voices.at (vi).vmT.at (m)    = 0.0f;

                if (ms == 1)
                {
                    int le = max (msLoopS.at (m), msLoopE.at (m)) - 1;
                    int ls = min (msLoopS.at (m), msLoopE.at (m)) - 1;

                    if (msLoopOn.at (m) > 0 && k == le && le < n)
                        k = ls;
                    else if (k == sus)
                        ms = 2;
                    else if (k + 1 >= n)
                        ms = 2;
                    else
                        k = k + 1;
                }
                else
                    k = k + 1;
            }
            else
            {
                float sh = float (pow (x, float (exp (msC.at (m * 8 + k) * 2.5f))));
                me = voices.at (vi).vmFrom.at (m) + (lv - voices.at (vi).vmFrom.at (m)) * sh;
                voices.at (vi).vmT.at (m) = t;
            }
        }
        else if (fl == 2)
            me -= me * clamp (dtv * 5.0f / (max (mEnvR.at (m), 1.0f) * 0.001f), 0.0f, 0.99f);

        voices.at (vi).mstage.at (m) = ms;
        voices.at (vi).vmFlag.at (m) = fl;
        voices.at (vi).vmNode.at (m) = k;
        voices.at (vi).menv.at (m)   = me;

        if (me > envMaxNext.at (m))
            envMaxNext.at (m) = me;
    }

    // ENV2-BEGIN
    struct EnvR
    {
        int   st;
        float lv;
    }

    // remaining fraction (1 -> 0) of a shaped fall at progress q (0..1); c = 0 is about the old exponential (99 % at the end), -1 nearly linear, +1 very snappy
    float envFall (float q, float c)
    {
        float k = 5.0f + 6.0f * c;

        if (q >= 1.0f)
            return 0.0f;

        if (abs (k) < 0.01f)
            return 1.0f - q;

        return (float (exp (-k * q)) - float (exp (-k))) / (1.0f - float (exp (-k)));
    }

    // true while every extra of envelope k is at its default
    void xeRefresh (int k)
    {
        xeSimple.at (k) = xeDelay.at (k) == 0.0f && xeHold.at (k) == 0.0f && xeAC.at (k) == 0.0f && xeDC.at (k) == 0.0f && xeRC.at (k) == 0.0f
                          && xeVel.at (k) == 0.0f && xeKey.at (k) == 0.0f && xeLvl.at (k) == 1.0f && xeLoop.at (k) < 0.5f;
    }

    // One sample of envelope k of voice vi. st: 0 idle, 1 attack (delay, rise, hold), 2 decay / sustain, 3 release
    EnvR envX (int vi, int k, int st, float lv, float dt, float a, float d, float sus, float r)
    {
        EnvR o;
        o.st = st;
        o.lv = lv;

        if (st == 0)
            return o;

        // all extras at their defaults: exactly the old envelope (cheap path)
        if (xeSimple.at (k))
        {
            voices.at (vi).exPrev.at (k) = 0;

            if (st == 1)
            {
                o.lv = lv + dt / max (a * 0.001f, 0.0005f);
                if (o.lv >= 1.0f) { o.lv = 1.0f; o.st = 2; }
            }
            else if (st == 2)
                o.lv = lv + (sus - lv) * clamp (dt * 5.0f / (max (d, 1.0f) * 0.001f), 0.0f, 0.99f);
            else
                o.lv = lv - lv * clamp (dt * 5.0f / (max (r, 1.0f) * 0.001f), 0.0f, 0.99f);

            return o;
        }

        float kt   = xeKey.at (k);
        float ts   = 1.0f;
        if (kt != 0.0f)
            ts = float (pow (2.0f, -kt * (float (voices.at (vi).noteNumber) - 60.0f) / 12.0f));

        float va   = 0.0f;
        if (k != 10)
            va = xeVel.at (k);
        float peak = xeLvl.at (k) * (1.0f - va + va * voices.at (vi).velRaw);
        float susE = sus * peak;
        float ac   = xeAC.at (k);
        float dc   = xeDC.at (k);
        float rc   = xeRC.at (k);
        bool  isLoop = k != 10 && xeLoop.at (k) > 0.5f;

        // entering a stage: timers reset, progress of the attack continues from the current level
        if (st != voices.at (vi).exPrev.at (k))
        {
            voices.at (vi).exPrev.at (k) = st;
            voices.at (vi).exT.at (k)    = 0.0f;
            voices.at (vi).exSub.at (k)  = 0;
            voices.at (vi).exL.at (k)    = lv;
            voices.at (vi).exQ.at (k)    = 0.0f;

            if (st == 1)
            {
                float x = 1.0f;
                if (peak > 0.0001f)
                    x = clamp (lv / peak, 0.0f, 1.0f);
                if (ac != 0.0f)
                    x = float (pow (x, float (pow (4.0f, ac))));
                voices.at (vi).exQ.at (k) = x;
            }
        }

        if (st == 1)
        {
            if (voices.at (vi).exSub.at (k) == 0)
            {
                float t = voices.at (vi).exT.at (k);

                if (t < xeDelay.at (k) * 0.001f)
                    voices.at (vi).exT.at (k) = t + dt;
                else
                {
                    float q = voices.at (vi).exQ.at (k) + dt / max (a * ts * 0.001f, 0.0005f);

                    if (q >= 1.0f)
                    {
                        q    = 1.0f;
                        o.lv = peak;

                        if (xeHold.at (k) > 0.0f)
                        {
                            voices.at (vi).exSub.at (k) = 1;
                            voices.at (vi).exT.at (k)   = 0.0f;
                        }
                        else
                        {
                            o.st = 2;
                            voices.at (vi).exPrev.at (k) = 2;
                            voices.at (vi).exL.at (k)    = peak;
                            voices.at (vi).exQ.at (k)    = 0.0f;
                            voices.at (vi).exT.at (k)    = 0.0f;
                            voices.at (vi).exSub.at (k)  = 0;
                            return o;
                        }
                    }
                    else if (ac != 0.0f)
                        o.lv = peak * float (pow (q, float (pow (4.0f, -ac))));
                    else
                        o.lv = peak * q;

                    voices.at (vi).exQ.at (k) = q;
                }
            }
            else
            {
                float t = voices.at (vi).exT.at (k) + dt;
                o.lv = peak;
                voices.at (vi).exT.at (k) = t;

                if (t >= xeHold.at (k) * 0.001f)
                {
                    o.st = 2;
                    voices.at (vi).exPrev.at (k) = 2;
                    voices.at (vi).exL.at (k)    = peak;
                    voices.at (vi).exQ.at (k)    = 0.0f;
                    voices.at (vi).exT.at (k)    = 0.0f;
                    voices.at (vi).exSub.at (k)  = 0;
                }
            }
        }
        else if (st == 2)
        {
            if (dc == 0.0f && ! isLoop)
                o.lv = lv + (susE - lv) * clamp (dt * 5.0f / (max (d * ts, 1.0f) * 0.001f), 0.0f, 0.99f);
            else
            {
                float q = voices.at (vi).exQ.at (k) + dt / max (d * ts * 0.001f, 0.0005f);
                voices.at (vi).exQ.at (k) = min (q, 1.0f);
                o.lv = susE + (voices.at (vi).exL.at (k) - susE) * envFall (q, dc);

                if (q >= 1.0f && isLoop)
                {
                    o.st = 1;
                    voices.at (vi).exPrev.at (k) = 1;
                    voices.at (vi).exSub.at (k)  = 0;
                    voices.at (vi).exT.at (k)    = xeDelay.at (k) * 0.001f;
                    voices.at (vi).exL.at (k)    = o.lv;
                    float x = 1.0f;
                    if (peak > 0.0001f)
                        x = clamp (o.lv / peak, 0.0f, 1.0f);
                    if (ac != 0.0f)
                        x = float (pow (x, float (pow (4.0f, ac))));
                    voices.at (vi).exQ.at (k) = x;
                }
            }
        }
        else
        {
            if (rc == 0.0f)
                o.lv = lv - lv * clamp (dt * 5.0f / (max (r * ts, 1.0f) * 0.001f), 0.0f, 0.99f);
            else
            {
                float q = voices.at (vi).exQ.at (k) + dt / max (r * ts * 0.001f, 0.0005f);
                voices.at (vi).exQ.at (k) = min (q, 1.0f);
                o.lv = voices.at (vi).exL.at (k) * envFall (q, rc);
            }
        }

        return o;
    }
    // ENV2-END

    // Advances the 10 mod envelopes of one voice by one sample
    void updateModEnvs (int vi, float dtv)
    {
        for (int m = 0; m < 10; ++m)
        {
            if (msMode.at (m) == 1)
            {
                msStep (vi, m, dtv);
                continue;
            }

            if ((envMask & (1 << m)) == 0)
                continue;

            int   ms = voices.at (vi).mstage.at (m);
            float me = voices.at (vi).menv.at (m);

            EnvR me2 = envX (vi, m, ms, me, dtv, mEnvA.at (m), mEnvD.at (m), mEnvS.at (m), mEnvR.at (m));   // ENV2
            ms = me2.st;
            me = me2.lv;

            voices.at (vi).menv.at (m)   = me;
            voices.at (vi).mstage.at (m) = ms;

            if (me > envMaxNext.at (m))
                envMaxNext.at (m) = me;
        }
    }

    // value of Freq modulator m at time t (seconds): the curve in units of 4 octaves (octaves / 4), transpose included
    float frqEval (int m, float t)
    {
        float len = max (frqRate.at (m), 1.0f) * 0.001f;
        float x   = t / len;

        if (frqLoop.at (m) > 0.5f)
            x = x - floor (x);
        else
            x = min (x, 1.0f);

        float fp = clamp (x, 0.0f, 1.0f) * 255.0f;
        int   i0 = int (fp);
        int   i1 = min (i0 + 1, 255);
        float ff = fp - float (i0);
        float y  = frqTab.at (m * 256 + i0) + (frqTab.at (m * 256 + i1) - frqTab.at (m * 256 + i0)) * ff;

        return (y * 9.9658f + frqTrans.at (m) / 12.0f) * 0.25f;
    }

    void updateFrqGlobal (float dt)
    {
        for (int m = 0; m < 10; ++m)
        {
            if ((frqMask & (1 << m)) == 0)
                continue;

            frqGT.at (m) += dt;
            frqGV.at (m)  = frqEval (m, frqGT.at (m));
        }
    }

    void updateVoiceFrq (int vi, float dt)
    {
        for (int m = 0; m < 10; ++m)
        {
            if ((frqMask & (1 << m)) == 0 || frqRetrig.at (m) < 0.5f)
                continue;

            voices.at (vi).frqT.at (m) += dt;
            voices.at (vi).frqV.at (m)  = frqEval (m, voices.at (vi).frqT.at (m));
        }
    }

    // ---------------- MOD-SEQ: step sequencers (sources 34..43) ----------------
    float seqDefault (int k)
    {
        float[16] d = (0.5f, 1.0f, 0.25f, 0.75f, 0.0f, 0.6f, 0.3f, 0.9f, 0.5f, 1.0f, 0.25f, 0.75f, 0.0f, 0.6f, 0.3f, 0.9f);
        return d.at (k);
    }

    float seqMult (int m)   // MOD-SEQ2: Time x1..x4
    {
        return float (clamp (int (seqTime.at (m) + 0.5f), 0, 3) + 1);
    }

    float seqStepHz (int m)
    {
        return (seqSync.at (m) > 0.5f ? syncHz (seqDiv.at (m)) : seqRate.at (m)) * seqMult (m);
    }

    // shape of one step over its length (ph 0..1): 0 flat, 1 ramp down, 2 ramp up, 3 triangle, 4 half sine, 5 gate 50 %, 6 gate 25 %, 7 decay
    float seqShapeVal (int sh, float ph)
    {
        if (sh == 1) return 1.0f - ph;
        if (sh == 2) return ph;
        if (sh == 3) return 1.0f - abs (2.0f * ph - 1.0f);
        if (sh == 4) return float (sin (3.14159265f * ph));
        if (sh == 5) return ph < 0.5f ? 1.0f : 0.0f;
        if (sh == 6) return ph < 0.25f ? 1.0f : 0.0f;
        if (sh == 7) return float (exp (-4.0f * ph));
        return 1.0f;
    }

    // advances sequencer m by dt seconds
    SeqS seqRun (int m, float dt, SeqS s)
    {
        int   len = clamp (int (seqLen.at (m) + 0.5f), 1, 16);
        int   lp  = clamp (int (seqLoop.at (m) + 0.5f) - 1, 0, len - 1);   // MOD-SEQ2: first step of the loop
        int   idx = clamp (int (s.idx + 0.5f), 0, len - 1);
        float hz  = max (seqStepHz (m), 0.01f);
        float ph  = s.ph + hz * dt;
        float dir = s.dir;
        int   md  = int (seqDir.at (m) + 0.5f);

        if (seqSync.at (m) > 1.5f)   // MOD-SEQ2: Spos, the position follows the host (loop region only)
        {
            float64 sb  = float64 (divBeats.at (clamp (int (seqDiv.at (m) + 0.5f), 0, 17))) / float64 (seqMult (m));
            float64 pos = fxBeat / sb;
            int     n   = int (floor (pos));
            int     reg = len - lp;
            int     per = max (2 * reg - 2, 1);
            int     k   = ((n % reg) + reg) % reg;

            ph = float (pos - float64 (n));

            if (md == 1)
                idx = len - 1 - k;
            else if (md == 2)
            {
                int p = ((n % per) + per) % per;
                idx = lp + (p < reg ? p : per - p);
            }
            else
                idx = lp + k;
        }
        else
        {
            for (int k = 0; k < 4 && ph >= 1.0f; ++k)
            {
                ph -= 1.0f;

                if (md == 0)
                    idx = idx + 1 >= len ? lp : idx + 1;
                else if (md == 1)
                    idx = idx - 1 < lp ? len - 1 : idx - 1;
                else if (md == 2)
                {
                    int nx = idx + int (dir);

                    if (nx >= len || nx < lp)
                        dir = -dir;

                    idx = clamp (idx + int (dir), lp, len - 1);
                }
                else
                    idx = lp + clamp (int (abs (nextNoise()) * float (len - lp)), 0, len - lp - 1);
            }

            if (ph >= 1.0f)
                ph = 0.0f;
        }

        float lvl = seqStep.at (m * 16 + idx);
        int   sh  = seqHold.at (m) > 0.5f ? 0 : int (seqShape.at (m * 16 + idx) + 0.5f);
        float shp = seqShapeVal (sh, ph);
        float tv  = seqPol.at (m) > 0.5f ? 0.5f + (lvl - 0.5f) * shp : lvl * shp;
        float g   = seqGlide.at (m);
        float v   = s.v;

        if (g < 0.002f)
            v = tv;
        else
            v += (tv - v) * (1.0f - float (exp (-dt / max (g * 0.6f / hz, 0.00005f))));

        return SeqS (ph, float (idx), dir, v);
    }

    void updateSeqGlobal (float dt)
    {
        bool gate = seqKeyStart < 0.5f;   // MOD-SEQ4: without Key Start they run all the time

        for (int dv = 0; dv < 8; ++dv)
            if (voices.at (dv).active)
                gate = true;

        if (gate && ! seqGate)            // the first note: every sequencer starts at step 1
            for (int m = 0; m < 10; ++m)
                seqG.at (m) = SeqS (0.0f, 0.0f, 1.0f, seqStep.at (m * 16));

        seqGate = gate;

        if (! gate)
            return;

        for (int m = 0; m < 10; ++m)   // the ones used by the matrix and the one the editor shows (its playhead moves before it is routed)
            if ((seqMask & (1 << m)) != 0 || m == seqMon - 1)
                seqG.at (m) = seqRun (m, dt, seqG.at (m));
    }

    void updateVoiceSeq (int vi, float dt)
    {
        for (int m = 0; m < 10; ++m)
            if (((seqMask & (1 << m)) != 0 || m == seqMon - 1) && seqRetrig.at (m) > 0.5f)
                voices.at (vi).seqS.at (m) = seqRun (m, dt, voices.at (vi).seqS.at (m));
    }

    float seqPolar (int m, float v)
    {
        return seqPol.at (m) > 0.5f ? v * 2.0f - 1.0f : v;
    }

    // Mod source value for a voice (1-10 LFO, 11-20 envelope, 21 velocity, 22 key, 23 random)
    // MOD-BIP: unipolar 0..1 -> bipolar -1..1 when the modulator's Bipolar switch is on
    float bipMap (float v, int i)
    {
        return modBip.at (i) > 0.5f ? v * 2.0f - 1.0f : v;
    }

    // MOD-LFOBIP: -1..1 -> 0..1 when the LFO is unipolar
    float lfoPol (float v, int i)
    {
        return lfoUni.at (i) > 0.5f ? v * 0.5f + 0.5f : v;
    }

    float srcValueVoice (int src, int vi)
    {
        if (src >= 1 && src <= 10)
        {
            if (lfoPerVoice (src - 1))
                return lfoPol (voices.at (vi).lfoV.at (src - 1), src - 1);   // MOD-LFOBIP
            return lfoPol (mLfoV.at (src - 1), src - 1);
        }
        if (src >= 11 && src <= 20)
            return bipMap (voices.at (vi).menv.at (src - 11), src - 11);   // MOD-BIP
        if (src == 21)
            return bipMap (voices.at (vi).velRaw, 10);   // MOD-BIP
        if (src == 22)
            return clamp ((float (voices.at (vi).noteNumber) - 60.0f) / 48.0f, -1.0f, 1.0f);
        if (src == 23)
            return rndOut (vi, 0);
        if (src >= 44 && src <= 52)
            return rndOut (vi, src - 43);
        if (src >= 24 && src <= 33)
            return frqRetrig.at (src - 24) > 0.5f ? voices.at (vi).frqV.at (src - 24) : frqGV.at (src - 24);
        if (src >= 34 && src <= 43)   // MOD-SEQ
            return seqPolar (src - 34, seqRetrig.at (src - 34) > 0.5f ? voices.at (vi).seqS.at (src - 34).v : seqG.at (src - 34).v);
        return 0.0f;
    }

    // Mod source value for global destinations (envelopes use the loudest voice)
    float srcValueGlobal (int src)
    {
        if (src >= 1 && src <= 10)
        {
            if (lfoPerVoice (src - 1))
                return lfoPol (voices.at (lastVoice).lfoV.at (src - 1), src - 1);   // MOD-LFOBIP
            return lfoPol (mLfoV.at (src - 1), src - 1);
        }
        if (src >= 11 && src <= 20)
            return bipMap (envMax.at (src - 11), src - 11);   // MOD-BIP
        if (src == 21)
            return bipMap (lastVelV, 10);   // MOD-BIP
        if (src == 22)
            return lastKeyV;
        if (src == 23)
            return rndOut (lastVoice, 0);
        if (src >= 44 && src <= 52)
            return rndOut (lastVoice, src - 43);
        if (src >= 24 && src <= 33)
            return frqGV.at (src - 24);
        if (src >= 34 && src <= 43)   // MOD-SEQ
            return seqPolar (src - 34, seqG.at (src - 34).v);
        return 0.0f;
    }

    // MODALL-BEGIN
    float[4078] genBase;      // value set by the host / UI
    int[4078]   genSet;       // 1 = genBase is valid
    float[4078] genNorm;      // applied modulation (amount * source summed, 1 = half the range)
    float[4078] genAcc;
    int[4078]   genMark;
    int[4078]   genIn;
    int[512]     genList;
    int          genN;
    int          genStamp;
    int          genTick;

