        a3Gate.at (12) = 1.0f;
        a3Gate.at (13) = 1.0f;
        a3Gate.at (14) = 1.0f;

        // MOD-ARP64: steps 17-64 repeat the default pattern
        a3Note.at (18) = 12.0f;
