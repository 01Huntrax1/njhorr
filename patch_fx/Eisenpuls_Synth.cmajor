        // INSPIRATOR6-DSP: styles 14-19 (Disco, Bossa Nova, Synthwave, Dubstep, Trance, Drill)
        ins_set4 (2, 14, 9, 0, 5, 8);  ins_set4 (3, 14, 9, 8, 0, 2);
