    // Sample-rate reducer

    // ---------------- INIT ----------------
    void init()
    {
        // LFO sync divisions in beats (quarter notes) per cycle
        divBeats.at (0)  = 32.0f;    divBeats.at (1)  = 16.0f;    divBeats.at (2)  = 8.0f;
        divBeats.at (3)  = 4.0f;     divBeats.at (4)  = 3.0f;     divBeats.at (5)  = 2.0f;
        divBeats.at (6)  = 1.3333f;  divBeats.at (7)  = 1.5f;     divBeats.at (8)  = 1.0f;
        divBeats.at (9)  = 0.6667f;  divBeats.at (10) = 0.75f;    divBeats.at (11) = 0.5f;
        divBeats.at (12) = 0.3333f;  divBeats.at (13) = 0.375f;   divBeats.at (14) = 0.25f;
        divBeats.at (15) = 0.1667f;  divBeats.at (16) = 0.125f;   divBeats.at (17) = 0.0833f;
        for (int ld = 0; ld < 10; ++ld)
            mLfoDiv.at (ld) = 8.0f;

        fxGateInit();
        ins_setupTables();   // INSPIRATOR-DSP

        for (int rq = 0; rq < 24; ++rq)   // OSCFX-DSP defaults: Filter > Dist > Reso > Off, mix 100 %, parameters 50 %
        {
            rkP.at (rq * 8)     = (rq & 3) < 3 ? float ((rq & 3) + 1) : 0.0f;
            rkP.at (rq * 8 + 1) = 1.0f;
            rkP.at (rq * 8 + 2) = 0.5f;
            rkP.at (rq * 8 + 3) = 0.5f;
            rkP.at (rq * 8 + 4) = 0.5f;
        }

        for (int ei = 0; ei < 32; ++ei)   // FX-FENV defaults
        {
            fxEnvSus.at (ei) = 1.0f;
            fxEnvRel.at (ei) = 0.3f;
        }

        // MOD-ARP303 defaults (same as the parameter defaults)
        a3Note.at (2) = 12.0f;
        a3Note.at (5) = 10.0f;
        a3Note.at (7) = 7.0f;
