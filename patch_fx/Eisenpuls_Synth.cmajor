    // ---- INSPIRATOR-DSP: glue to the synth ----
    void ins_position (float64 ppq, float64 barStart)
    {
        ins_hostPpq = ppq;
        if (barStart <= ppq + 0.001 && ppq - barStart < 40.0 && ins_barTicks > 0)
        {
            int bst = ins_floorTick (barStart + 0.0026);
            int bi = ins_floorDiv (bst + ins_barTicks / 2, ins_barTicks);
            ins_originOff = bst - bi * ins_barTicks;
        }
    }

    // returns true when the message is consumed (the keyboard transposes the pattern)
    bool ins_midi (std::midi::Message msg)
    {
        if (ins_pInMode == 2)
            return false;

        bool noteOn = msg.isNoteOn() && msg.getVelocity() > 0;
        bool noteOff = msg.isNoteOff() || (msg.isNoteOn() && msg.getVelocity() == 0);

        if (noteOn)
        {
            ins_heldCount += 1;
            if (ins_pMode != 4)
            {
                int tr = ins_posMod (msg.getNoteNumber() - ins_pKey, 12);
                if (tr > 6) tr -= 12;
                ins_transpose = tr;
            }
            return true;
        }

        if (noteOff)
        {
            ins_heldCount = ins_maxi (0, ins_heldCount - 1);
            if (ins_heldCount == 0 && ins_pInMode == 1) ins_allOff();
            return true;
        }

        return false;
    }

    void ins_flush()
    {
        if (ins_qCount > 0)
        {
            int st = ins_qS.at (ins_qHead);
            int nn = ins_qA.at (ins_qHead);
            int vv = ins_qB.at (ins_qHead);
            ins_qHead = (ins_qHead + 1) % 256;
            ins_qCount -= 1;

            if (st == 0x90) voiceNoteOn (nn, float (vv) / 127.0f);
            else            voiceNoteOff (nn);
        }
    }

    // called once per sample from main(): the original loop body without the UI dump
    void ins_frame()
    {
        if (ins_cooldown > 0) ins_cooldown -= 1;
        if (ins_dirty && ins_cooldown == 0)
        {
            ins_regenerate();
            ins_cooldown = 256;
        }

        ins_dumpTimer += 1;
        if (ins_dumpIdx >= 0 && ins_dumpTimer >= 16)
        {
            ins_dumpTimer = 0;
            ins_emitDump();
        }

        ins_redump += 1;
        if (ins_redump > int (processor.frequency * 1.5))
        {
            ins_redump = 0;
            if (ins_dumpIdx < 0) ins_dumpIdx = 0;
        }

        if (insOn < 0.5f)
        {
            if (ins_runState != 0)
            {
                ins_allOff();
                ins_runState = 0;
                ins_lastTick = -1000000;
                ins_lastStep = -1;
                insPos <- -1;
            }
            ins_flush();
            return;
        }

        int want = 0;
        if (ins_transportSeen && ins_transportPlaying) want = 1;
        else if (ins_heldCount > 0 && ins_pInMode != 2) want = 2;

        if (want != ins_runState)
        {
            ins_allOff();
            ins_lastTick = -1000000;
            ins_lastStep = -1;
            if (want == 2)
            {
                ins_freePpq = 0.0;
                ins_originOff = 0;
            }
            if (want == 0) insPos <- -1;
            ins_runState = want;
        }

        if (ins_runState != 0)
        {
            ins_bpm = syncBpmOver > 1.0f ? syncBpmOver : hostBpm;
            float64 ppq = ins_freePpq;
            if (ins_runState == 1) ppq = ins_hostPpq - float64 (ins_pOffsetMs) * float64 (ins_bpm) / 60000.0;
            int t = ins_floorTick (ppq);
            bool emit = (ins_pInMode != 1) || (ins_heldCount > 0);

            if (t != ins_lastTick)
            {
                int d = t - ins_lastTick;
                if (d > 0 && d <= 8)
                {
                    for (int k = ins_lastTick + 1; k <= t; ++k)
                        ins_processTick (k, emit);
                    ins_lastTick = t;
                }
                else if (d > 0 || d < -3)
                {
                    ins_allOff();
                    ins_processTick (t, emit);
                    ins_lastTick = t;
                }
            }

            float64 inc = float64 (ins_bpm) / 60.0 * processor.period;
            if (ins_runState == 1) ins_hostPpq += inc;
            else                   ins_freePpq += inc;
        }

        ins_flush();
    }

    event param7000 (float v) { insOn = v; }

    event timeSigIn (std::timeline::TimeSignature ts)
    {
        int den = ts.denominator;
        if (ts.numerator >= 1 && ts.numerator <= 32 && (den == 2 || den == 4 || den == 8 || den == 16))
        {
            if (ts.numerator != ins_tsNum || den != ins_tsDen)
            {
                ins_tsNum = ts.numerator;
                ins_tsDen = den;
                ins_dirty = true;
            }
        }
    }

    event transportStateIn (std::timeline::TransportState ts)
    {
        ins_transportSeen = true;
        ins_transportPlaying = ts.isPlaying();
    }

    // ---------------- AUDIO ----------------
    void main()
    {
        loop
        {
            float dt = float (processor.period);
            float sr = float (processor.frequency);

            flfPhase += 0.3 * processor.period;
            if (flfPhase >= 1.0) flfPhase -= 1.0;

            // ----- mod page: 10 LFOs + global matrix sums -----
            wtBuildTick();
            arpTick (dt);   // MOD-ARP
            ins_frame();    // INSPIRATOR-DSP
            updateModLfos (dt);
            frqMask = 0;
            for (int fs = 0; fs < mmTop; ++fs)
                if (mmSrcI.at (fs) >= 24 && mmSrcI.at (fs) <= 33 && mmDstI.at (fs) > 0)
                    frqMask |= 1 << (mmSrcI.at (fs) - 24);
            seqMask = 0;   // MOD-SEQ
            for (int fs = 0; fs < mmTop; ++fs)
                if (mmSrcI.at (fs) >= 34 && mmDstI.at (fs) > 0)
                    seqMask |= 1 << (mmSrcI.at (fs) - 34);
            updateSeqGlobal (dt);
            seqRefresh += dt;
            bool seqForce = seqRefresh > 0.3f;   // every 0.3 s all positions are sent again (an editor opened later, or a slow sequencer, shows its playhead at once)

            if (seqForce)
                seqRefresh = 0.0f;

            for (int m = 0; m < 10; ++m)   // MOD-SEQPOS: only the sequencer the editor shows reports
                if (m == seqMon - 1)
            {
                bool useVoice = seqRetrig.at (m) > 0.5f && voices.at (seqRepVoice).active;
                int  sp = int ((useVoice ? voices.at (seqRepVoice).seqS.at (m).idx : seqG.at (m).idx) + 0.5f);

                if (sp != seqLastPos.at (m) || seqForce)
                {
                    seqLastPos.at (m) = sp;
                    seqPos <- m * 16 + sp;
                }
            }
            updateFrqGlobal (dt);
            rollEnvMax();
            computeGlobalMod();

            float[3] mixSynthL;
            float[3] mixSynthR;

            for (int i = 0; i < 8; ++i)
            {
                if (! voices.at (i).active) continue;

                voices.at (i).age += 1;

                // glide
                float gc = 1.0f;
                float gms = glideMs;

                if (arpOn > 0.5f && int (arpMode + 0.5f) == 5)   // MOD-ARP303: a slide is at least 60 ms
                    gms = max (gms, 60.0f);

                if (gms > 0.5f)
                    gc = clamp (dt * 5.0f / (gms * 0.001f), 0.0f, 1.0f);
                voices.at (i).curFreq += (voices.at (i).targetFreq - voices.at (i).curFreq) * gc;

                // amp envelope
                int   st = voices.at (i).stage;
                float e  = voices.at (i).env;

                if (st == 1)
                {
                    e += dt / max (ampAttack * 0.001f, 0.0005f);
                    if (e >= 1.0f) { e = 1.0f; st = 2; }
                }
                else if (st == 2)
                {
                    e += (ampSustain - e) * clamp (dt * 5.0f / (max (ampDecay, 1.0f) * 0.001f), 0.0f, 0.99f);
                }
                else
                {
                    e -= e * clamp (dt * 5.0f / (max (ampRelease, 1.0f) * 0.001f), 0.0f, 0.99f);
                    if (e < 0.0003f)
                    {
                        e = 0.0f;
                        voices.at (i).active = false;
                    }
                }
                voices.at (i).env   = e;
                voices.at (i).stage = st;

                // mod envelopes, per-voice LFOs and the matrix sums
                updateModEnvs (i, dt);
                updateVoiceLfos (i, dt);
                updateVoiceFrq (i, dt);
                updateVoiceSeq (i, dt);   // MOD-SEQ
                computeVoiceMod (i);

                // pitch envelope (+ matrix pitch, +/-12 semitones at full amount)
                voices.at (i).penv -= voices.at (i).penv * clamp (dt * 5.0f / (max (pitchEgDec, 1.0f) * 0.001f), 0.0f, 0.99f);
                float pe     = voices.at (i).penv * pitchEgInt + vmod.at (1) * 12.0f;
                float tuneSt = masterTune * 0.01f;
                float cf     = voices.at (i).curFreq;
                int   nnote  = voices.at (i).noteNumber;

                // FM (frequency) and PM (phase): every slot is modulated by the previous sample of the slots that feed it
                float[6] fmIn;
                float[6] pmIn;
                float[6] pdIn;
                float[6] tzIn;
                for (int fd = 0; fd < (fmAny || vmodMat ? 6 : 0); ++fd)
                {
                    float acc = 0.0f;
                    float acp = 0.0f;
                    float acd = 0.0f;
                    float acz = 0.0f;
                    for (int fs = 0; fs < 6; ++fs)
                    {
                        int   mi = fs * 6 + fd;
                        float am = fmAmt.at (mi);
                        float ap = pmAmt.at (mi);
                        float ad = pdAmt.at (mi);
                        if (vmodMat)   // mod matrix destinations 60.. : FM 60 + n, PM 96 + n, PD 132 + n (+-50% of the range at full amount)
                        {
                            am = clamp (am + vmod.at (60 + mi) * 0.5f, 0.0f, 4.0f);   // MXRANGE-DSP: FM / PM / TZFM go to 400 %
                            ap = clamp (ap + vmod.at (96 + mi) * 0.5f, 0.0f, 4.0f);
                            ad = clamp (ad + vmod.at (132 + mi) * 0.5f, 0.0f, 1.0f);
                        }
                        if (am != 0.0f)
                            acc += am * voices.at (i).fmPrev.at (fs);
                        if (ap != 0.0f)
                            acp += ap * voices.at (i).fmPrev.at (fs);
                        if (ad != 0.0f)
                            acd += ad * voices.at (i).fmPrev.at (fs);
                        float az = tzAmt.at (mi);
                        if (vmodMat)   // MXDST-DSP: TZFM 1308 + n
                            az = clamp (az + vmod.at (1308 + mi) * 0.5f, 0.0f, 4.0f);
                        if (az != 0.0f)
                            acz += az * voices.at (i).fmPrev.at (fs);
                    }
                    fmIn.at (fd) = acc;
                    pmIn.at (fd) = acp;
                    pdIn.at (fd) = acd;
                    tzIn.at (fd) = acz;
                }

                // outputs of the previous sample: the modulators of the ring / amplitude modulation matrices
                float[6] rmPrev;
                for (int rq = 0; rq < 6; ++rq)
                    rmPrev.at (rq) = voices.at (i).fmPrev.at (rq);

                float[3] bInL;
                float[3] bInR;

                for (int o = 0; o < 6; ++o)
                {
                    int   ob  = o * 64;
                    int   ty  = int (op.at (ob) + 0.5f);
                    int   dB  = 6 + 9 * o;
                    float lvl = clamp (op.at (ob + 1) + vmod.at (dB + 1), 0.0f, 1.0f);

                    if (lvl <= 0.0005f && ! fmUsed.at (o) && ! vmodMat)
                    {
                        voices.at (i).fmPrev.at (o) = 0.0f;
                        continue;
                    }

                    // ----- source -----
                    float sSemi = op.at (ob + 4) * 12.0f + op.at (ob + 5) + op.at (ob + 6) * 0.01f;
                    float sExp  = (sSemi + pe + tuneSt) / 12.0f + vmod.at (dB);
                    float base  = cf;
                    if (op.at (ob + 7) <= 0.5f)
                        base = float (std::notes::noteToFrequency (int (op.at (ob + 12) + 0.5f)));
                    if (op.at (ob + 48) > 0.001f)   // Frequency knob: fixed oscillator frequency 20 Hz .. 20 kHz
                        base = 20.0f * float (pow (1000.0f, op.at (ob + 48)));
                    sExp += vmod.at (180 + o) * 4.0f;
                    float fmx   = fmIn.at (o);
                    if (fmx != 0.0f)
                        sExp += clamp (fmx, -8.0f, 8.0f) * 4.0f;   // exponential FM: +-4 octaves at full amount and full scale modulator
                    float freq  = clamp (base * float (pow (2.0f, sExp)), 1.0f, sr * 0.45f);
                    float pm    = pmIn.at (o);

                    // TZFM-DSP: the modulator is integrated into a phase offset: frequency f * (1 + 4 * amount * modulator), negative values run backwards
                    if (fmAny || vmodMat)
                    {
                        float tzv = tzIn.at (o);
                        float tzp = voices.at (i).tzPh.at (o);

                        if (tzv != 0.0f || tzp != 0.0f)
                        {
                            tzp += clamp (tzv, -8.0f, 8.0f) * 4.0f * freq / sr;
                            tzp -= float (floor (tzp));
                            voices.at (i).tzPh.at (o) = tzp;
                            pm += tzp;
                        }
                    }

                    // phase distortion: the modulator moves the break point of a two-segment phase warp (identity at 0.5), like the Casio CZ
                    float pdv = pdIn.at (o);
                    float pdPm = 0.0f;
                    {
                        float ph0 = voices.at (i).pdPh.at (o);
                        float ph1 = ph0 + freq / sr;
                        ph1 = ph1 - float (floor (ph1));
                        voices.at (i).pdPh.at (o) = ph1;

                        if (pdv != 0.0f)
                        {
                            float brk = clamp (0.5f - 0.49f * clamp (pdv, -1.0f, 1.0f), 0.01f, 0.99f);
                            float wph = ph0 < brk ? ph0 * 0.5f / brk : 0.5f + (ph0 - brk) * 0.5f / (1.0f - brk);
                            pdPm = wph - ph0;
                        }
                    }

                    float sL = 0.0f;
                    float sR = 0.0f;
                    bool  stereo = false;

                    if (ty == 0)
                    {
                        if (wtHas.at (o) && wtLen.at (o) > 1)
                        {
                            float pos = clamp (op.at (ob + 10) + vmod.at (dB + 3) * 0.5f, 0.0f, 1.0f);
                            float<2> w = wtStep (o, i, freq, pos, wtFrameLen (op.at (ob + 11)), pm + pdPm, vmod.at (dB + 4), vmod.at (dB + 5));
                            sL = w[0];
                            sR = w[1];
                            stereo = true;
                        }
                    }
                    else if (ty == 1)
                    {
                        if (smpHas.at (o) && smpLen.at (o) > 1)
                        {
                            sL = smpStep (o, i, freq, cf, pm + pdPm, sExp);
                            sR = sL;
                        }
                    }
                    else if (ty == 5)
                    {
                        sL = kickStep (i, o, freq, pm);
                        sR = sL;
                    }
                    else if (ty == 4)
                    {
                        float<2> jw = junoStep (i, o, freq, pm);
                        sL = jw[0];
                        sR = jw[1];
                        stereo = true;
                    }
                    else if (ty == 3)
                    {
                        sL = phyStep (i, o, freq);
                        sR = sL;
                    }
                    else if (ty == 2)
                    {
                        sL = terStep (i, o, freq / sr, pm + pdPm, clamp (int (op.at (ob + 24) + 0.5f), 0, 11),
                                      clamp (op.at (ob + 25) + vmod.at (dB + 3) * 0.5f, 0.0f, 1.0f),
                                      clamp (op.at (ob + 26) + vmod.at (dB + 4) * 0.5f, 0.0f, 1.0f),
                                      clamp (op.at (ob + 27) + vmod.at (dB + 5) * 0.5f, 0.0f, 1.0f));
                        sR = sL;
                    }
                    else if (ty == 6)
                    {
                        sL = wgStep (i, o, freq);
                        sR = sL;
                    }
                    else if (ty == 7)
                    {
                        float<2> jw = jpStep (i, o, freq, pm);
                        sL = jw[0];
                        sR = jw[1];
                        stereo = true;
                    }

                    else if (ty == 8)
                    {
                        float<2> gw = grStep (i, o, cf, sExp);
                        sL = gw[0];
                        sR = gw[1];
                        stereo = true;
                    }

                    else if (ty == 9)
                    {
                        float<2> aw = adStep (i, o, freq);
                        sL = aw[0];
                        sR = aw[1];
                        stereo = true;
                    }
                    else if (ty == 6)
                    {
                        sL = wgStep (i, o, freq);
                        sR = sL;
                    }
                    else if (ty == 7)
                    {
                        float<2> jw = jpStep (i, o, freq, pm);
                        sL = jw[0];
                        sR = jw[1];
                        stereo = true;
                    }

                    else if (ty == 10)
                    {
                        sL = dkStep (i, o, freq);
                        sR = sL;
                    }

                    else if (ty == 11)
                    {
                        float<2> sw = spStep (i, o, freq);
                        sL = sw[0];
                        sR = sw[1];
                        stereo = true;
                    }

                    else if (ty == 12)
                    {
                        float<2> fw = sfStep (i, o, cf, sExp);
                        sL = fw[0];
                        sR = fw[1];
                        stereo = true;
                    }

                    if (ty != 0 && ty != 4 && uniCnt.at (o) > 1)   // UNI-ALL: the sources without their own unison
                    {
                        float<2> uw = uniGeneric (i, o, sL, sR, stereo);
                        sL = uw[0];
                        sR = uw[1];
                        stereo = true;
                    }

                    // ----- filter envelope of the slot -----
                    int   fst = voices.at (i).fstage.at (o);
                    float fe  = voices.at (i).fenv.at (o);
                    if (fst == 1)
                    {
                        fe += dt / max (op.at (ob + 38) * 0.001f, 0.0005f);
                        if (fe >= 1.0f) { fe = 1.0f; fst = 2; }
                    }
                    else if (fst == 2)
                    {
                        fe += (op.at (ob + 40) - fe) * clamp (dt * 5.0f / (max (op.at (ob + 39), 1.0f) * 0.001f), 0.0f, 0.99f);
                    }
                    else
                    {
                        fe -= fe * clamp (dt * 5.0f / (max (op.at (ob + 41), 1.0f) * 0.001f), 0.0f, 0.99f);
                    }
                    voices.at (i).fenv.at (o)   = fe;
                    voices.at (i).fstage.at (o) = fst;

                    // signal flow per slot: source -> filter / distortion / resonator in the chosen order -> FM / PM matrix and output
                    // (the Order parameter puts filter, distortion and resonator in any order)
                    int   dty  = int (op.at (ob + 42) + 0.5f);
                    float dd   = clamp (op.at (ob + 43) + vmod.at (dB + 8) * 0.5f, 0.0f, 1.0f);
                    float dx   = op.at (ob + 44);
                    int   chOrd = clamp (int (op.at (ob + 45) + 0.5f), 0, 5);   // RESO-CHAIN
                    float dwp  = clamp (op.at (ob + 47) + vmod.at (169 + 2 * o) * 0.5f, 0.0f, 1.0f);

                    for (int chSt = 0; chSt < 4; ++chSt)
                    {
                        int   rkIx  = (o * 4 + chSt) * 8;
                        int   rkTy  = clamp (int (rkP.at (rkIx) + 0.5f), 0, 7);
                        float rkMx  = rkP.at (rkIx + 1);
                        float rk1   = rkP.at (rkIx + 2);
                        float rk2   = rkP.at (rkIx + 3);
                        float rk3   = rkP.at (rkIx + 4);
                        float rk4   = rkP.at (rkIx + 5);
                        float rk5   = rkP.at (rkIx + 6);
                        float rk6   = rkP.at (rkIx + 7);
                        int   chStage = rkTy >= 1 && rkTy <= 3 ? rkTy - 1 : -1;
                        float rkDL  = sL;
                        float rkDR  = sR;

                        if (rkTy == 0 || rkMx <= 0.0f)
                            continue;

                        // ----- filter -----
                        if (chStage == 0 && op.at (ob + 30) > 0.5f)
                        {
                            float fdrv = clamp (op.at (ob + 34), 0.0f, 1.0f);
                            if (fdrv > 0.001f)
                            {
                                float dg = 1.0f + fdrv * 6.0f;
                                float dm = 1.0f + fdrv * 0.8f;
                                float sdL = sL * dg;
                                float sdR = sR * dg;
                                sL = (sdL / (1.0f + abs (sdL))) * dm;
                                sR = (sdR / (1.0f + abs (sdR))) * dm;
                            }

                            float modExp = op.at (ob + 36) * fe * 4.0f
                                         + op.at (ob + 35) * float (nnote - 60) / 12.0f
                                         + op.at (ob + 37) * (voices.at (i).velRaw - 0.5f) * 4.0f
                                         + vmod.at (dB + 6) * 4.0f;
                            float fc    = clamp (op.at (ob + 32) * float (pow (2.0f, modExp)), 20.0f, sr * 0.45f);
                            float g     = float (tan (float64 (fc) * pi * processor.period));
                            float resE  = clamp (op.at (ob + 33) + vmod.at (dB + 7) * 0.5f, 0.0f, 1.0f);
                            float k     = 2.0f - 1.96f * resE;
                            int   ft    = clamp (int (op.at (ob + 31) + 0.5f), 0, 30);

                            float yL = 0.0f;
                            float yR = 0.0f;

                            if (ft >= 30)
                            {
                                float wfp = clamp (op.at (ob + 46) + vmod.at (168 + 2 * o) * 0.5f, 0.0f, 1.0f);
                                yL = wfStep (i, 0, o, sL, fc, resE, wfp, stereo);
                                yR = yL;
                                if (stereo)
                                    yR = wfStep (i, 1, o, sR, fc, resE, wfp, stereo);
                            }
                            else
                            {
                                yL = filterStepX (i, 0, o, sL, g, k, resE, fc, ft);
                                yR = yL;
                                if (stereo)
                                    yR = filterStepX (i, 1, o, sR, g, k, resE, fc, ft);
                            }
                            sL = yL;
                            sR = yR;
                        }

                        if (chStage == 1 && dty > 0)
                        {
                            sL = oscDist (sL, dty, dd, dx, o, dwp);
                            sR = stereo ? oscDist (sR, dty, dd, dx, o, dwp) : sL;
                        }

                        if (chStage == 2 && op.at (ob + 56) > 0.5f)
                        {
                            float<2> rz = resStep (i, o, sL, sR, stereo, freq);
                            sL = rz.at (0);
                            sR = stereo ? rz.at (1) : sL;
                        }

                        if (rkTy >= 4)
                        {
                            for (int ch = 0; ch < (stereo ? 2 : 1); ++ch)
                            {
                                int   si = ((o * 4 + chSt) * 2 + ch) * 8;   // inside rkS of this voice: 6 x 4 x 2 x 8 = 384
                                float c  = ch == 0 ? sL : sR;

                                if (rkTy == 4)   // bitcrush: bits and sample rate reduction
                                {
                                    float lv  = float (pow (2.0f, 1.0f + (1.0f - rk1) * 15.0f));
                                    float hold = 1.0f + rk2 * rk2 * 63.0f;
                                    float cnt = voices.at (i).rkS.at (si + 1) + 1.0f;
                                    if (cnt >= hold)
                                    {
                                        cnt -= hold;
                                        voices.at (i).rkS.at (si) = floor (clamp (c, -1.0f, 1.0f) * lv + 0.5f) / lv;
                                    }
                                    voices.at (i).rkS.at (si + 1) = cnt;
                                    c = voices.at (i).rkS.at (si);
                                }
                                else if (rkTy == 5)   // wavefolder: two cascaded folds, sine <> triangle shape, asymmetry, output level
                                {
                                    float g1 = 1.0f + rk1 * 9.0f;
                                    float as = (rk5 - 0.0f) * 0.9f;
                                    float y  = c * g1 * (c >= 0.0f ? 1.0f + as : 1.0f - as) + (rk2 - 0.5f);
                                    float f1 = float (sin (y * 1.5707963f)) * (1.0f - rk4) + rk4 * (2.0f / 3.1415927f) * float (asin (clamp (float (sin (y * 1.5707963f)), -1.0f, 1.0f)));
                                    float y2 = f1 * (1.0f + rk3 * 3.0f) * 1.0f;
                                    float f2 = float (sin (y2 * 1.5707963f)) * (1.0f - rk4) + rk4 * (2.0f / 3.1415927f) * float (asin (clamp (float (sin (y2 * 1.5707963f)), -1.0f, 1.0f)));
                                    c = (f1 + (f2 - f1) * rk3) * (1.0f - rk6 * 0.8f);
                                }
                                else if (rkTy == 6)   // comb: delay (optionally tuned to the key), feedback, damping, polarity, delay modulation
                                {
                                    int   cb = ((o * 4 + chSt) * 2 + ch) * 1024;
                                    int   wp = int (voices.at (i).rkS.at (si + 2));
                                    float dk = 2.0f + rk1 * rk1 * 1018.0f;
                                    float kt = clamp ((rk5 - 0.0f), 0.0f, 1.0f);
                                    float dkey = clamp (sr / max (freq, 20.0f), 2.0f, 1018.0f);
                                    float dly = dk + (dkey - dk) * kt;
                                    float mp = voices.at (i).rkS.at (si + 4) + 0.7f * float (processor.period);
                                    if (mp >= 1.0f) mp -= 1.0f;
                                    voices.at (i).rkS.at (si + 4) = mp;
                                    dly = clamp (dly * (1.0f + rk6 * 0.15f * float (sin (mp * 6.2831853f))), 2.0f, 1019.0f);
                                    float rp  = float (wp) - dly;
                                    int   i0  = int (floor (rp));
                                    float fr  = rp - float (i0);
                                    float dv  = voices.at (i).rkB.at (cb + (i0 & 1023)) * (1.0f - fr) + voices.at (i).rkB.at (cb + ((i0 + 1) & 1023)) * fr;
                                    float sg  = 1.0f - 2.0f * rk4;
                                    float lp  = voices.at (i).rkS.at (si + 3);
                                    lp += (dv - lp) * (1.0f - rk3 * 0.9f);
                                    voices.at (i).rkS.at (si + 3) = lp;
                                    voices.at (i).rkB.at (cb + (wp & 1023)) = clamp (c + lp * sg * rk2 * 0.95f, -4.0f, 4.0f);
                                    voices.at (i).rkS.at (si + 2) = float ((wp + 1) & 1023);
                                    c = c + dv * 0.5f * (sg >= 0.0f ? 1.0f : -1.0f) * max (abs (sg), 0.2f);
                                }
                                else   // tilt: one pole split, high or low shelf boost
                                {
                                    float fcT = 100.0f * float (pow (100.0f, rk1));
                                    float aT  = 1.0f - float (exp (-6.2831853f * fcT * float (processor.period)));
                                    float lpT = voices.at (i).rkS.at (si + 3);
                                    lpT += (c - lpT) * aT;
                                    voices.at (i).rkS.at (si + 3) = lpT;
                                    c = c + (rk2 - 0.5f) * 4.0f * (c - lpT);
                                }

                                if (ch == 0) sL = c; else sR = c;
                            }
                            if (! stereo)
                                sR = sL;
                        }

                        if (rkMx < 1.0f)
                        {
                            sL = rkDL + (sL - rkDL) * rkMx;
                            sR = rkDR + (sR - rkDR) * rkMx;
                        }
                    }

                    // ----- ring modulation (carrier x modulator) and amplitude modulation (carrier x unipolar modulator) -----
                    for (int rs = 0; rs < (fmAny || vmodMat ? 6 : 0); ++rs)
                    {
                        int   ri = rs * 6 + o;
                        float ar = rmAmt.at (ri);
                        float aa = amAmt.at (ri);
                        if (vmodMat)   // mod matrix destinations 186.. : RM 186 + n, AM 222 + n (+-50% of the range at full amount)
                        {
                            ar = clamp (ar + vmod.at (186 + ri) * 0.5f, 0.0f, 1.0f);
                            aa = clamp (aa + vmod.at (222 + ri) * 0.5f, 0.0f, 1.0f);
                        }
                        if (ar != 0.0f || aa != 0.0f)
                        {
                            float rmod = clamp (rmPrev.at (rs), -1.0f, 1.0f);
                            float rg   = (1.0f - ar) + ar * rmod;
                            float ag   = (1.0f - aa) + aa * (0.5f + 0.5f * rmod);
                            float tg   = rg * ag;
                            sL *= tg;
                            sR *= tg;
                        }
                    }

                    // ----- MXMAT-DSP: crossfade / fold / xor / comparator matrices (modulator = previous output of the source slot) -----
                    if (fmAny || vmodMat)
                    {
                        for (int xs = 0; xs < 6; ++xs)
                        {
                            int   xi = xs * 6 + o;
                            float axf = mxAmt.at (xi);
                            float afd = mxAmt.at (64 + xi);
                            float axr = mxAmt.at (128 + xi);
                            float acp = mxAmt.at (192 + xi);

                            if (vmodMat)   // MXDST-DSP: XF 1344 + n, FD 1380 + n, XR 1416 + n, CP 1452 + n
                            {
                                axf = clamp (axf + vmod.at (1344 + xi) * 0.5f, 0.0f, 1.0f);
                                afd = clamp (afd + vmod.at (1380 + xi) * 0.5f, 0.0f, 1.0f);
                                axr = clamp (axr + vmod.at (1416 + xi) * 0.5f, 0.0f, 1.0f);
                                acp = clamp (acp + vmod.at (1452 + xi) * 0.5f, 0.0f, 1.0f);
                            }

                            if (axf == 0.0f && afd == 0.0f && axr == 0.0f && acp == 0.0f)
                                continue;

                            float xm = clamp (rmPrev.at (xs), -1.0f, 1.0f);

                            for (int ch = 0; ch < 2; ++ch)
                            {
                                float c = ch == 0 ? sL : sR;

                                if (axf != 0.0f)   // crossfade, equal power: 100 % = only the modulator
                                    c = c * float (cos (axf * 1.5707963f)) + xm * float (sin (axf * 1.5707963f));

                                if (afd != 0.0f)   // fold: the sum of both is folded harder with the amount
                                    c += afd * (float (sin ((c + xm) * (0.4f + afd * 3.5f) * 1.5707963f)) - c);

                                if (axr != 0.0f)   // xor of the 16 bit values, faded in with the amount
                                {
                                    int ci = int (clamp (c, -1.0f, 0.9999f) * 32768.0f);
                                    int mi = int (clamp (xm, -1.0f, 0.9999f) * 32768.0f);
                                    c += axr * (float (ci ^ mi) / 32768.0f - c);
                                }

                                if (acp != 0.0f)   // comparator: dry > maximum (first half) > gate (modulator above / below the carrier)
                                {
                                    float mx = xm > c ? xm : c;
                                    float gt = xm > c ? 0.7f : -0.7f;
                                    float t  = acp * 2.0f;
                                    c = t < 1.0f ? c + (mx - c) * t : mx + (gt - mx) * (t - 1.0f);
                                }

                                if (ch == 0)
                                    sL = c;
                                else
                                    sR = c;
                            }
                        }
                    }

                    // the matrix modulators are the processed slot outputs (after filter and distortion)
                    voices.at (i).fmPrev.at (o) = stereo ? (sL + sR) * 0.5f : sL;

                    if (lvl <= 0.0005f)
                        continue;

                    // ----- level, pan, output route -----
                    float pn  = clamp (op.at (ob + 2) + vmod.at (dB + 2), -1.0f, 1.0f);
                    float pa  = (pn + 1.0f) * 0.25f * float (pi);
                    float gL  = float (cos (pa)) * 1.4142f * lvl;
                    float gR  = float (sin (pa)) * 1.4142f * lvl;
                    int   rt  = clamp (int (op.at (ob + 3) + 0.5f), 0, 2);
                    bInL.at (rt) += sL * gL;
                    bInR.at (rt) += sR * gR;
                }

                float a = e * voices.at (i).velGain * clamp (1.0f + vmod.at (2), 0.0f, 2.0f);

                voices.at (i).fdlW = (voices.at (i).fdlW + 1) & 2047;

                for (int mg = 0; mg < 3; ++mg)
                {
                    mixSynthL.at (mg) += bInL.at (mg) * a;
                    mixSynthR.at (mg) += bInR.at (mg) * a;
                }
            }

            for (int dq = 0; dq < 6; ++dq)   // Modal Drum sympathetic bus: this sample's outputs are heard by the next sample
            {
                dkBus.at (dq) = dkAcc.at (dq);
                dkAcc.at (dq) = 0.0f;
            }

            // ----- global mod destinations: drive, pan, output gain -----
            float driveEff = clamp (driveAmt + gmod.at (4) * 0.5f, 0.0f, 1.0f);

            float gPanL = panL;
            float gPanR = panR;
            if (abs (gmod.at (3)) > 0.0001f)
            {
                float gp   = clamp (panParam + gmod.at (3), -1.0f, 1.0f);
                float gAng = (gp + 1.0f) * 0.25f * float (pi);
                gPanL = float (cos (gAng)) * 1.4142f;
                gPanR = float (sin (gAng)) * 1.4142f;
            }

            float outGainMod = clamp (1.0f + gmod.at (5), 0.0f, 2.0f);

            // ----- synth drive / soft clip, pan and DC blocker, once per bus -----
            float synDcA = 1.0f - clamp (float (twoPi) * 5.0f * dt, 0.0001f, 0.5f);
            float[3] busInL;
            float[3] busInR;

            for (int bg = 0; bg < 3; ++bg)
            {
                float xinL = audioIn[0];
                float xinR = audioIn[1];
                float rawL = (xinL + driveEff * (shapeSig (xinL, driveEff) - xinL)) * gPanL;   // FX-PLUGIN: Drive blends the shaped input in
                float rawR = (xinR + driveEff * (shapeSig (xinR, driveEff) - xinR)) * gPanR;

                // always-on DC blocker (about 5 Hz): asymmetric shapers, ring mod and loaded samples can carry DC
                // that the delay / chorus / flanger / reverb feedback loops would amplify
                float dcL = rawL - busDcX.at (bg * 2)     + synDcA * busDcY.at (bg * 2);
                float dcR = rawR - busDcX.at (bg * 2 + 1) + synDcA * busDcY.at (bg * 2 + 1);
                busDcX.at (bg * 2)     = rawL;
                busDcY.at (bg * 2)     = dcL;
                busDcX.at (bg * 2 + 1) = rawR;
                busDcY.at (bg * 2 + 1) = dcR;
                busInL.at (bg) = dcL;
                busInR.at (bg) = dcR;
            }

            fxBeat += float64 (syncBpmOver > 1.0f ? syncBpmOver : hostBpm) * processor.period / 60.0;

            fxGateUpdate();   // FX-FENV

            // ----- FX-NOBUS: one FX rack (Main); what an oscillator routes to Bus 1 / Bus 2 plays through it as well -----
            float<2> rack = fxRunRack (0, float<2> (busInL.at (0), busInR.at (0)));
            float outL = rack[0];
            float outR = rack[1];

            // ----- stereo width (mid/side) -----
            float wdMid  = (outL + outR) * 0.5f;
            float wdSide = (outL - outR) * 0.5f * stereoWidth;
            outL = wdMid + wdSide;
            outR = wdMid - wdSide;

            // ----- output tone (tilt: dark <-> bright) and output gain -----
            float toneA = clamp (float (twoPi) * 1200.0f * dt, 0.0f, 1.0f);
            toneStL += toneA * (outL - toneStL);
            toneStR += toneA * (outR - toneStR);
            float toneHiL = outL - toneStL;
            float toneHiR = outR - toneStR;
            outL = toneStL * (1.0f - 0.6f * toneAmt) + toneHiL * (1.0f + 0.6f * toneAmt);
            outR = toneStR * (1.0f - 0.6f * toneAmt) + toneHiR * (1.0f + 0.6f * toneAmt);
            outL = outL * outGain * outGainMod;
            outR = outR * outGain * outGainMod;

            // ----- DC blocker (one-pole high-pass): always on, corner set by DC Freq when DC Block is on, otherwise 3 Hz -----
            float dcCorner = 3.0f;
            if (dcOn > 0.5f) dcCorner = dcFreq;
            float dcR = 1.0f - clamp (float (twoPi) * dcCorner * dt, 0.0001f, 0.5f);
            float dcInL = outL;
            float dcInR = outR;
            dcYL = dcInL - dcXL + dcR * dcYL;
            dcYR = dcInR - dcXR + dcR * dcYR;
            dcXL = dcInL;
            dcXR = dcInR;
            outL = dcYL;
            outR = dcYR;

            outL = clamp (outL, -8.0f, 8.0f);
            outR = clamp (outR, -8.0f, 8.0f);

            out <- float<2> (outL, outR);
            advance();
        }
    }
}
