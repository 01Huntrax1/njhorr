    // ---- Harmony ---------------------------------------------------------------
    // A chord is stored as a root (semitones above the key) plus intervals in semitones,
    // so chords from outside the scale can be played too.
    void ins_setTones (int c, int root, int i1, int i2, int i3, int i4, int cn)
    {
        ins_cRoot.at (c) = ins_posMod (root, 12);
        ins_cInt.at (c * 5) = 0;
        ins_cInt.at (c * 5 + 1) = i1;
        ins_cInt.at (c * 5 + 2) = i2;
        ins_cInt.at (c * 5 + 3) = i3;
        ins_cInt.at (c * 5 + 4) = i4;
        ins_cCnt.at (c) = cn;
    }

    // Borrowed chords. Major keys: bVII, bVI, iv, bIII, V/vi, V/ii, V/V.
    // Minor keys: V7, IV, bII, I (Picardy), V/V, V/iv, vii dim7.
    void ins_setBorrowed (int c, int idx)
    {
        if (ins_isMinorish())
        {
            if (idx == 0)      ins_setTones (c, 7, 4, 7, 10, 14, 4);
            else if (idx == 1) ins_setTones (c, 5, 4, 7, 11, 14, 3);
            else if (idx == 2) ins_setTones (c, 1, 4, 7, 11, 14, 3);
            else if (idx == 3) ins_setTones (c, 0, 4, 7, 11, 14, 3);
            else if (idx == 4) ins_setTones (c, 2, 4, 7, 10, 14, 4);
            else if (idx == 5) ins_setTones (c, 0, 4, 7, 10, 14, 4);
            else               ins_setTones (c, 11, 3, 6, 9, 14, 4);
        }
        else
        {
            if (idx == 0)      ins_setTones (c, 10, 4, 7, 10, 14, 3);
            else if (idx == 1) ins_setTones (c, 8, 4, 7, 11, 14, 3);
            else if (idx == 2) ins_setTones (c, 5, 3, 7, 10, 14, 3);
            else if (idx == 3) ins_setTones (c, 3, 4, 7, 11, 14, 3);
            else if (idx == 4) ins_setTones (c, 4, 4, 7, 10, 14, 4);
            else if (idx == 5) ins_setTones (c, 9, 4, 7, 10, 14, 4);
            else               ins_setTones (c, 2, 4, 7, 10, 14, 4);
        }
    }

    void ins_computeChords()
    {
        int nbars = ins_numBars;
        bool minorish = ins_isMinorish();
        // With Chords locked the progression keeps its own style, whatever this part plays
        int hs = ins_pStyle;
        if (ins_pLock != 0) hs = ins_pChordStyle;
        int sel = ins_rs (11, hs) % 4;
        int row = 0;
        if (minorish) row = ins_selMin.at (hs * 4 + sel);
        else          row = ins_selMaj.at (hs * 4 + sel);

        int lvl = 0;
        if (hs == 4 || hs == 7 || hs == 8) lvl = 1;
        if (hs == 5 && ins_pComplex > 35) lvl = 1;
        if (ins_pComplex > 55) lvl += 1;
        if (ins_pComplex > 85) lvl += 1;
        int cap = 2;
        if (hs == 1 || hs == 3 || hs == 6) cap = 1;
        ins_chordLevel = ins_clampi (lvl, 0, cap);

        for (int b = 0; b < 8; ++b)
        {
            int j = b % 4;
            if (nbars == 1)       j = 0;
            else if (nbars == 2)  j = (b % 2) * 2;
            else if (hs == 6)     j = ((b / 2) % 2) * 2;

            int deg = 0;
            if (minorish) deg = ins_progMin.at (row * 4 + j);
            else          deg = ins_progMaj.at (row * 4 + j);

            if (nbars >= 4 && (j == 1 || j == 2))
            {
                if ((ins_rs (21, j) % 100) < 22) deg = (deg + 5) % 7;
            }
            if (nbars == 8 && b == 7)
            {
                if ((ins_rs (31, 0) % 100) < 50) deg = 4;
            }

            int ov = ins_chordOv.at (b) % 64;
            int shape = 0;
            if (ov > 0)
            {
                deg = ins_mini (6, (ov - 1) % 8);
                shape = (ov - 1) / 8;
            }
            ins_cDeg.at (b) = deg;

            // Chord shape: 0 follows Complexity, 1 triad, 2 seventh, 3 ninth, 4 sus2, 5 sus4, 6 add9, 7 borrowed
            int lvlB = ins_chordLevel;
            int third = 0;
            int fifth = 0;
            int seventh = 0;
            if (shape == 7)
            {
                ins_setBorrowed (b, deg);
                lvlB = 0;
                if (ins_cCnt.at (b) >= 4) lvlB = 1;
                third = ins_cInt.at (b * 5 + 1);
                fifth = ins_cInt.at (b * 5 + 2);
                seventh = ins_cInt.at (b * 5 + 3);
            }
            else
            {
                if (shape == 1)      lvlB = 0;
                else if (shape == 2) lvlB = 1;
                else if (shape == 3) lvlB = 2;
                else if (shape >= 4) lvlB = 0;
                int r0 = ins_scaleSemi (deg);
                int t1 = 2;
                int t3 = 6;
                int cn = 3 + lvlB;
                if (shape == 4)      { t1 = 1; cn = 3; }
                else if (shape == 5) { t1 = 3; cn = 3; }
                else if (shape == 6) { t3 = 8; cn = 4; }
                ins_setTones (b, r0, ins_scaleSemi (deg + t1) - r0, ins_scaleSemi (deg + 4) - r0,
                          ins_scaleSemi (deg + t3) - r0, ins_scaleSemi (deg + 8) - r0, cn);
                third = ins_scaleSemi (deg + 2) - r0;
                fifth = ins_scaleSemi (deg + 4) - r0;
                seventh = ins_scaleSemi (deg + 6) - r0;
            }
            ins_cInfo.at (b) = ins_posMod (ins_pKey + ins_cRoot.at (b), 12) + 16 * third + 256 * fifth + 4096 * seventh
                            + 65536 * lvlB + 262144 * deg + 2097152 * ins_mini (7, shape);
        }

        // Push: which chords arrive an eighth early (song-level, so every instance agrees)
        for (int b = 0; b < 8; ++b)
        {
            int pb = (b + ins_numBars - 1) % ins_maxi (1, ins_numBars);
            ins_pushed.at (b) = 0;
            if (b < ins_numBars && ins_numBars > 1 && ins_pPush > 0 && ins_stepsBar >= 6)
            {
                if (ins_cInfo.at (pb) != ins_cInfo.at (b))
                {
                    if ((ins_rs (41, b) % 100) < ins_pPush) ins_pushed.at (b) = 1;
                }
            }
            // Per-chord choice stored above the chord value: 1 = always ins_pushed, 2 = never
            int ps = ins_chordOv.at (b) / 64;
            if (ps == 1 && b < ins_numBars && ins_numBars > 1 && ins_stepsBar >= 6) ins_pushed.at (b) = 1;
            else if (ps == 2) ins_pushed.at (b) = 0;
        }
    }

    int ins_pushMask()
    {
        int pm = 0;
        for (int b = 0; b < 8; ++b)
        {
            if (ins_pushed.at (b) != 0) pm = pm | (1 << b);
        }
        return pm;
    }

    // Which chord of the list sounds at a given bar and step (Chord Rate: half, normal, double)
    int ins_chordAt (int b, int s)
    {
        if (ins_pRate == 2)
        {
            int h = 0;
            if (s >= ins_stepsBar / 2) h = 1;
            return (2 * b + h) % ins_maxi (1, ins_numBars);
        }
        if (ins_pRate == 0) return (b / 2) % ins_maxi (1, ins_numBars);
        return b % ins_maxi (1, ins_numBars);
    }

    // True when the chord on the downbeat of bar b is anticipated
    bool ins_pushInto (int b)
    {
        int pb = (b + ins_numBars - 1) % ins_maxi (1, ins_numBars);
        int c2 = ins_chordAt (b, 0);
        int c1 = ins_chordAt (pb, ins_stepsBar - 1);
        return c1 != c2 && ins_pushed.at (c2) != 0;
    }

    bool ins_inChord (int semi, int c)
    {
        int pc = ins_posMod (semi - ins_cRoot.at (c), 12);
        for (int k = 0; k < ins_cCnt.at (c); ++k)
        {
            if (ins_posMod (ins_cInt.at (c * 5 + k), 12) == pc) return true;
        }
        return false;
    }

    int ins_nearestChordTone (int si, int c)
    {
        for (int i = 0; i < 7; ++i)
        {
            int o = (i + 1) / 2;
            if ((i % 2) == 0) o = 0 - o;
            if (ins_inChord (ins_scaleSemi (si + o), c)) return si + o;
        }
        return si;
    }

    // Semitones from a note up to the next scale note (1 to 3)
    int ins_stepAbove (int semi)
    {
        for (int d = 1; d <= 3; ++d)
        {
            int p = ins_posMod (semi + d, 12);
            for (int k = 0; k < 7; ++k)
            {
                if (ins_scaleTab.at (ins_pScale * 7 + k) == p) return d;
            }
        }
        return 2;
    }

    // ---- Note helpers ------------------------------------------------------------
    void ins_addNote (int grid, int offs, int len, int pitch, int vel)
    {
        if (ins_nCount >= 512) return;
        int sw = 0;
        if ((grid % 24) == 0 && ! ins_compound)
        {
            int st = (grid / 24) % ins_maxi (1, ins_stepsBar);
            if (ins_pStyle == 7)
            {
                if ((st % 4) >= 2) sw = ins_pSwing * 16 / 100;
            }
            else if ((st % 2) == 1)
            {
                sw = ins_pSwing * 8 / 100;
            }
        }
        int off = ins_clampi (sw + offs, -60, 60);
        ins_nGrid.at (ins_nCount) = grid;
        ins_nOff.at (ins_nCount) = off;
        ins_nTick.at (ins_nCount) = ins_posMod (grid + off, ins_loopTicks);
        ins_nLen.at (ins_nCount) = ins_clampi (len, 1, 1000);
        ins_nPitch.at (ins_nCount) = ins_clampi (pitch, 0, 127);
        ins_nVel.at (ins_nCount) = ins_clampi (vel, 1, 127);
        ins_nCount += 1;
    }

    int ins_humanT (int key)
    {
        int h = ins_pHuman * 5 / 100;
        if (h <= 0) return 0;
        return (ins_rv (201, key) % (2 * h + 1)) - h;
    }

    int ins_humanV (int key)
    {
        int h = ins_pHuman * 18 / 100;
        if (h <= 0) return 0;
        return (ins_rv (202, key) % (2 * h + 1)) - h;
    }

    // Coherent randomness: keyed on the position inside a 2-bar cycle, so it repeats like a groove
    int ins_velDev (int strm, int cyc, int amt)
    {
        if (amt <= 0) return 0;
        // Musical shaping: strong beats vary little, off-beats more, plus a slow
        // rise-and-fall across the bar; kick and snare stay the most stable.
        int s = cyc % 32;
        int wgt = 100;
        if (ins_isBeat (s))        wgt = 35;
        else if ((s % 2) == 0) wgt = 70;
        if (strm == 230 || strm == 231) wgt = wgt / 2;
        int rnd = ((ins_rv (strm, cyc) % 201) - 100) * wgt / 100;
        int sb = ins_maxi (1, ins_stepsBar);
        int ph = (s + (ins_rv (strm + 40, 0) % sb)) % sb;
        int tri = 2 * ph - sb;
        if (tri < 0) tri = 0 - tri;
        tri = tri * 200 / sb - 100;
        return (rnd * 6 + tri * 4) * amt / 2500;
    }

    int ins_durLen (int len, int cyc, int maxLen)
    {
        if (ins_pRDur <= 0) return len;
        int mul = 100 + ((ins_rv (221, cyc) % 201) - 100) * ins_pRDur * 6 / 1000;
        return ins_clampi (len * mul / 100, 4, ins_maxi (4, maxLen));
    }

    // ---- Generators ------------------------------------------------------------
    // Which of the three rhythm variants a bar uses: one main pattern per Part seed,
    // an answer in the second bar about half the time, and a turnaround in every fourth bar.
    int ins_rhVar (int b, int strm)
    {
        int v = ins_rv (strm, 0) % 3;
        if ((b % 2) == 1)
        {
            if ((ins_rv (strm + 1, 0) % 100) < 50) v = (v + 1 + (ins_rv (strm + 1, 1) % 2)) % 3;
        }
        if ((b % 4) == 3)
        {
            if ((ins_rv (strm + 2, 0) % 100) < 35) v = ins_rv (strm + 2, 1) % 3;
        }
        return v;
    }

    // Pulls some hits a sixteenth early; more often as Complexity rises
    int ins_syncopate (int mask, int b, int strm)
    {
        int res = mask;
        for (int s = 2; s < ins_stepsBar; ++s)
        {
            if (((res >> s) & 1) != 0 && ((res >> (s - 1)) & 1) == 0)
            {
                if ((ins_rv (strm, (b % 2) * 32 + s) % 100) < ins_pComplex / 8)
                    res = (res & (0 - 1 - (1 << s))) | (1 << (s - 1));
            }
        }
        return res;
    }

    int ins_voicing (int c, int slot)
    {
        int center = 60 + 12 * ins_pOctave;
        int cnt = ins_cCnt.at (c);
        int np = 0;
        int lo = center - 5;
        for (int k = 0; k < cnt; ++k)
        {
            int pc = ins_posMod (ins_pKey + ins_cRoot.at (c) + ins_cInt.at (c * 5 + k), 12);
            ins_vPit.at (slot * 8 + np) = lo + ins_posMod (pc - lo, 12);
            np += 1;
        }
        int rootPc = ins_posMod (ins_pKey + ins_cRoot.at (c), 12);
        if (ins_pRange >= 34)
        {
            int lowBase = center - 22;
            ins_vPit.at (slot * 8 + np) = lowBase + ins_posMod (rootPc - lowBase, 12);
            np += 1;
        }
        if (ins_pRange >= 67)
        {
            int hi = center + 7;
            ins_vPit.at (slot * 8 + np) = hi + ins_posMod (rootPc - hi, 12);
            np += 1;
        }
        return np;
    }

    void ins_genChords()
    {
        int tier = -1;
        if (ins_pDensity >= 75)      tier = 2;
        else if (ins_pDensity >= 50) tier = 1;
        else if (ins_pDensity >= 25) tier = 0;
        int half = ins_stepsBar / 2;

        for (int b = 0; b < ins_numBars; ++b)
        {
            int nbar = (b + 1) % ins_maxi (1, ins_numBars);
            bool pushNext = ins_pushInto (nbar);
            bool pushedHere = ins_pushInto (b);
            int cA = ins_chordAt (b, 0);
            int cB = ins_chordAt (b, ins_stepsBar - 1);
            int cN = ins_chordAt (nbar, 0);

            int mask = 1;
            if (tier >= 0) mask = ins_expandMask (ins_chordRh.at (ins_rhVar (b, 300) * 96 + ins_pStyle * 3 + tier));
            if (tier >= 0) mask = ins_syncopate (mask, b, 303);
            if (tier >= 1)
            {
                for (int s = 1; s < ins_stepsBar; ++s)
                {
                    if (((mask >> s) & 1) != 0)
                    {
                        if ((ins_rv (30, (b % 2) * 32 + s) % 100) < 12) mask = mask & (0 - 1 - (1 << s));
                    }
                }
            }
            if (mask == 0) mask = 1;

            // A chord change in the middle of the bar is always struck
            if (cB != cA) mask = mask | 1 | (1 << half);

            // A ins_pushed chord is struck an eighth early and tied over the bar line
            int tail = ins_mini (ins_nextHit (mask, 0), ins_stepsBar - 2);
            if (pushNext)   mask = (mask | (1 << (ins_stepsBar - 2))) & (0 - 1 - (1 << (ins_stepsBar - 1)));
            if (pushedHere) mask = mask & (0 - 2);

            int npA = ins_voicing (cA, 0);
            int npB = ins_voicing (cB, 1);
            int npN = ins_voicing (cN, 2);

            for (int s = 0; s < ins_stepsBar; ++s)
            {
                if (((mask >> s) & 1) != 0)
                {
                    int cyc = (b % 2) * 32 + s;
                    bool ant = pushNext && s == ins_stepsBar - 2;
                    int gap = ins_nextHit (mask, s) - s;
                    if (ant) gap = 2 + tail;
                    int len = ins_maxi (6, gap * 24 * ins_pGate / 100);
                    len = ins_durLen (len, cyc, gap * 24);
                    int acc = -8;
                    if (s == 0)          acc = 8;
                    else if (ant)        acc = 6;
                    else if (ins_isBeat (s)) acc = 0;
                    int vel = ins_pVel + acc + ins_humanV (ins_nCount) + ins_velDev (210, cyc, ins_pRVel);
                    int ht = ins_humanT (ins_nCount);
                    int np = npA;
                    int slot = 0;
                    if (s >= half && cB != cA)
                    {
                        np = npB;
                        slot = 1;
                    }
                    if (ant)
                    {
                        np = npN;
                        slot = 2;
                    }
                    for (int i = 0; i < np; ++i)
                        ins_addNote (b * ins_barTicks + s * 24, ht + i * (ins_pHuman / 25), len, ins_vPit.at (slot * 8 + i), vel);
                }
            }
        }
    }

    void ins_genLead()
    {
        int centerSi = 7;
        int basePitch = 60 + 12 * ins_pOctave + ins_keyOff();
        int w = 3 + ins_pRange * 6 / 100;
        bool minorish = ins_isMinorish();

        for (int b = 0; b < ins_numBars; ++b)
        {
            int nbar = (b + 1) % ins_maxi (1, ins_numBars);
            bool pushNext = ins_pushInto (nbar);
            int mId = ins_motifTab.at (b % 8);
            int rk = 0;
            if (mId >= 2 && ins_pComplex > 30) rk = 1;

            int mask = 0;
            for (int s = 0; s < ins_stepsBar; ++s)
            {
                int t = ins_tmpl (s);
                int wt = 0;
                if (t >= 0 && (t % 8) == 0)      wt = 95;
                else if (t >= 0 && (t % 4) == 0) wt = 75;
                else if (t >= 0 && (t % 2) == 0) wt = 55;
                else if (ins_pStyle == 0 || ins_pStyle == 1 || ins_pStyle == 7) wt = ins_pComplex / 5;
                else wt = 14 + ins_pComplex / 4;
                int p = wt * (28 + ins_pDensity) / 100;
                if ((ins_rv (40 + rk, s) % 100) < p) mask = mask | (1 << s);
            }
            if (mask == 0) mask = 1;

            int lastC = ins_chordAt (b, 0);
            int cur = ins_nearestChordTone (centerSi + (ins_rv (70, mId) % 5) - 2, lastC);
            int k = 0;
            for (int s = 0; s < ins_stepsBar; ++s)
            {
                if (((mask >> s) & 1) != 0)
                {
                    int t = ins_tmpl (s);
                    int c = ins_chordAt (b, s);
                    bool strong = (t >= 0 && (t % 8) == 0);
                    if (c != lastC) strong = true;
                    lastC = c;
                    if (k > 0)
                    {
                        if (strong)
                        {
                            cur = ins_nearestChordTone (cur + (ins_rv (50 + mId, k) % 3) - 1, c);
                        }
                        else
                        {
                            int r = ins_rv (60 + mId, k) % 100;
                            int dir = 1;
                            if ((ins_rv (74 + mId, k) & 1) != 0) dir = -1;
                            if (cur > centerSi + w) dir = -1;
                            if (cur < centerSi - w) dir = 1;
                            int leapP = 8 + ins_pComplex / 4;
                            int mv = 1;
                            if (r < leapP)           mv = 2 + (r % 2);
                            else if (r < leapP + 12) mv = 0;
                            cur += dir * mv;
                            if (ins_pComplex < 50 && mv != 0)
                            {
                                int d7 = ins_posMod (cur, 7);
                                bool avoid = false;
                                if (minorish) avoid = (d7 == 1 || d7 == 5);
                                else          avoid = (d7 == 3 || d7 == 6);
                                if (avoid) cur += dir;
                            }
                        }
                    }
                    cur = ins_clampi (cur, centerSi - w - 2, centerSi + w + 2);
                    if (pushNext && s >= ins_stepsBar - 2) cur = ins_nearestChordTone (cur, ins_chordAt (nbar, 0));

                    int cyc = (b % 2) * 32 + s;
                    int gap = ins_nextHit (mask, s) - s;
                    if (gap > 8) gap = 8;
                    int len = ins_maxi (6, gap * 24 * ins_pGate / 100);
                    len = ins_durLen (len, cyc, gap * 24);
                    int acc = 0;
                    if (strong)          acc = 10;
                    else if (ins_isBeat (s)) acc = 2;
                    else                 acc = 0 - (ins_rv (78, b * 32 + s) % 12);
                    ins_addNote (b * ins_barTicks + s * 24, ins_humanT (ins_nCount), len,
                             basePitch + ins_scaleSemi (cur),
                             ins_pVel + acc + ins_humanV (ins_nCount) + ins_velDev (211, cyc, ins_pRVel));
                    k += 1;
                }
            }
        }
    }

    void ins_genBass()
    {
        int lowBase = 36 + 12 * ins_pOctave;
        int nBeats = ins_maxi (1, ins_stepsBar / ins_maxi (1, ins_beatSteps));
        int half = ins_stepsBar / 2;

        for (int b = 0; b < ins_numBars; ++b)
        {
            int nbar = (b + 1) % ins_maxi (1, ins_numBars);
            bool pushNext = ins_pushInto (nbar);
            int cA = ins_chordAt (b, 0);
            int cB = ins_chordAt (b, ins_stepsBar - 1);
            int cN = ins_chordAt (nbar, 0);
            int nextRoot = lowBase + ins_posMod (ins_pKey + ins_cRoot.at (cN), 12);
            int g0 = b * ins_barTicks;

            if (ins_pStyle == 7 && ins_pDensity >= 25)
            {
                // Walking bass: one note per beat
                int beatLen = ins_beatSteps * 24;
                int lastC = -1;
                for (int bt = 0; bt < nBeats; ++bt)
                {
                    int s = bt * ins_beatSteps;
                    int c = ins_chordAt (b, s);
                    int rootP = lowBase + ins_posMod (ins_pKey + ins_cRoot.at (c), 12);
                    int thirdI = ins_cInt.at (c * 5 + 1);
                    int fifthI = ins_cInt.at (c * 5 + 2);
                    int cyc = (b % 2) * 32 + s;
                    int pitch = rootP;
                    int acc = 6;
                    bool fresh = (c != lastC);
                    lastC = c;
                    if (! fresh)
                    {
                        if (bt == nBeats - 1)
                        {
                            acc = -4;
                            pitch = rootP + fifthI;
                            if (nextRoot != rootP)
                            {
                                pitch = nextRoot - 1;
                                if ((ins_rv (83, b) & 1) != 0) pitch = nextRoot + 1;
                            }
                        }
                        else if ((bt % 2) == 1)
                        {
                            acc = -4;
                            pitch = rootP + thirdI;
                            if ((ins_rv (81, b * 8 + bt) % 2) == 0) pitch = rootP + ins_stepAbove (ins_cRoot.at (c));
                        }
                        else
                        {
                            acc = 2;
                            pitch = rootP + fifthI;
                            if ((ins_rv (82, b * 8 + bt) % 3) == 0) pitch = rootP + thirdI;
                        }
                    }
                    int len = ins_durLen (ins_maxi (6, beatLen * ins_pGate / 100), cyc, beatLen);
                    ins_addNote (g0 + s * 24, ins_humanT (ins_nCount), len, pitch,
                             ins_pVel + acc + ins_humanV (ins_nCount) + ins_velDev (212, cyc, ins_pRVel));
                }
                if (ins_pDensity >= 70 && nBeats >= 2)
                {
                    if ((ins_rv (84, b) % 100) < 50)
                        ins_addNote (g0 + beatLen + (ins_beatSteps / 2) * 24, 0, 12,
                                 lowBase + ins_posMod (ins_pKey + ins_cRoot.at (cA), 12), ins_pVel - 34);
                }
            }
            else
            {
                int tier = 0;
                if (ins_pDensity >= 67)      tier = 2;
                else if (ins_pDensity >= 34) tier = 1;
                int mask = ins_expandMask (ins_bassRh.at (ins_rhVar (b, 310) * 96 + ins_pStyle * 3 + tier));
                mask = ins_syncopate (mask, b, 313);
                if (mask == 0) mask = 1;
                if (cB != cA) mask = mask | 1 | (1 << half);
                if (pushNext) mask = (mask | (1 << (ins_stepsBar - 2))) & (0 - 1 - (1 << (ins_stepsBar - 1)));
                int nonRoot = 10 + ins_pComplex / 2;
                int lastC = -1;

                for (int s = 0; s < ins_stepsBar; ++s)
                {
                    if (((mask >> s) & 1) != 0)
                    {
                        int cyc = (b % 2) * 32 + s;
                        int nh = ins_nextHit (mask, s);
                        int c = ins_chordAt (b, s);
                        int rootP = lowBase + ins_posMod (ins_pKey + ins_cRoot.at (c), 12);
                        int thirdI = ins_cInt.at (c * 5 + 1);
                        int fifthI = ins_cInt.at (c * 5 + 2);
                        bool first = (c != lastC);
                        lastC = c;
                        int pitch = rootP;
                        if (! first)
                        {
                            int r = ins_rv (80, cyc) % 100;
                            if (r < nonRoot)
                            {
                                int q = r % 5;
                                if (q < 2)      pitch = rootP + 12;
                                else if (q < 4) pitch = rootP + fifthI;
                                else            pitch = rootP + thirdI;
                            }
                            if (nh == ins_stepsBar && s >= ins_stepsBar - 4 && ins_pComplex > 40 && nextRoot != rootP)
                            {
                                if (ins_pStyle == 4 || ins_pStyle == 7 || ins_pStyle == 8) pitch = nextRoot - 1;
                                else pitch = rootP + fifthI;
                            }
                        }
                        if (pushNext && s == ins_stepsBar - 2) pitch = nextRoot;
                        int len = ins_maxi (6, (nh - s) * 24 * ins_pGate / 100);
                        len = ins_durLen (len, cyc, (nh - s) * 24);
                        int acc = -4;
                        if (ins_isBeat (s)) acc = 6;
                        ins_addNote (g0 + s * 24, ins_humanT (ins_nCount), len, pitch,
                                 ins_pVel + acc + ins_humanV (ins_nCount) + ins_velDev (212, cyc, ins_pRVel));

                        // Ghost (dead) note a sixteenth before the hit, on busier settings
                        if (ins_pComplex > 50 && s > 0 && ! first)
                        {
                            if (((mask >> (s - 1)) & 1) == 0)
                            {
                                if ((ins_rv (85, cyc) % 100) < (ins_pComplex - 50) / 2)
                                    ins_addNote (g0 + (s - 1) * 24, 0, 8, rootP, 28 + (ins_rv (86, cyc) % 12));
                            }
                        }
                    }
                }
            }
        }
    }

    void ins_genArp()
    {
        int cnt = 3 + ins_chordLevel;
        int octs = ins_clampi (1 + ins_pRange / 40, 1, 3);
        int total = ins_maxi (1, cnt * octs);
        int stepLen = 1;
        if (ins_pDensity < 40) stepLen = 2;
        if (ins_pStyle == 7 && ins_pDensity < 70) stepLen = 2;
        int pt = ins_rv (90, 0) % 5;
        int period = ins_maxi (1, 2 * total - 2);
        int baseLen = ins_maxi (4, stepLen * 24 * ins_pGate / 100);

        for (int b = 0; b < ins_numBars; ++b)
        {
            int nbar = (b + 1) % ins_maxi (1, ins_numBars);
            bool pushNext = ins_pushInto (nbar);
            int cN = ins_chordAt (nbar, 0);
            int i = 0;

            for (int s = 0; s < ins_stepsBar; s += stepLen)
            {
                int idx = 0;
                if (pt == 0)      idx = i % total;
                else if (pt == 1) idx = total - 1 - (i % total);
                else if (pt == 2)
                {
                    int ud = i % period;
                    idx = ud;
                    if (ud >= total) idx = period - ud;
                }
                else if (pt == 3) idx = ins_rv (91, i % 8) % total;
                else              idx = ((i / 2) + (i % 2) * 2) % total;

                bool rest = false;
                if (ins_pComplex > 60 && s != 0)
                {
                    if ((ins_rv (92, s) % 100) < (ins_pComplex - 60) / 2) rest = true;
                }
                if (! rest)
                {
                    int cyc = (b % 2) * 32 + s;
                    int c = ins_chordAt (b, s);
                    if (pushNext && s >= ins_stepsBar - 2) c = cN;
                    int rootOff = ins_posMod (ins_keyOff() + ins_cRoot.at (c) + 5, 12) - 5;
                    int k = idx % cnt;
                    int o = idx / cnt;
                    int pitch = 60 + 12 * ins_pOctave + rootOff
                                + ins_cInt.at (c * 5 + (k % ins_maxi (1, ins_cCnt.at (c)))) + 12 * o;
                    int acc = -6;
                    if (ins_isBeat (s)) acc = 8;
                    ins_addNote (b * ins_barTicks + s * 24, ins_humanT (ins_nCount), ins_durLen (baseLen, cyc, stepLen * 24 * 2),
                             pitch, ins_pVel + acc + ins_humanV (ins_nCount) + ins_velDev (213, cyc, ins_pRVel));
                }
                i += 1;
            }
        }
    }

    void ins_genDrums()
    {
        int nb = 2;
        if (ins_numBars == 1) nb = 1;

        for (int cb = 0; cb < 2; ++cb)
        {
            for (int lane = 0; lane < 12; ++lane)
            {
                int base16 = 0;
                if (lane < 8) base16 = ins_drumBase.at (ins_pStyle * 8 + lane);
                if (lane == 3 && ins_pDensity < 20) base16 = base16 & 0x1111;
                int base = ins_expandMask (base16);
                int extra = 0;
                if (lane < 8) extra = ins_expandMask (ins_drumExtra.at (ins_pStyle * 8 + lane));

                // Compound meters: closed hat / ride play the three eighths of each beat
                if (ins_compound && (lane == 3 || lane == 7) && ins_pDensity >= 20)
                {
                    for (int s = 0; s < ins_stepsBar; ++s)
                    {
                        if ((s % 6) == 2)
                        {
                            if (((base >> (s - 2)) & 1) != 0) base = base | (1 << s);
                        }
                    }
                }

                int pe = 0;
                if (lane == 3 || lane == 4 || lane == 7) pe = ins_clampi ((ins_pDensity - 35) * 3 / 2, 0, 95);
                else                                     pe = ins_clampi ((ins_pDensity + ins_pComplex) / 4 - 8, 0, 60);

                int lm = base;
                int g = 0;
                if (lane == 2)
                {
                    if (ins_pDensity >= 60) lm = lm | extra;
                }
                else
                {
                    for (int s = 0; s < ins_stepsBar; ++s)
                    {
                        if (((extra >> s) & 1) != 0)
                        {
                            if ((ins_rv (100 + lane, cb * 32 + s) % 100) < pe)
                            {
                                lm = lm | (1 << s);
                                g = g | (1 << s);
                            }
                        }
                    }
                }

                // Fill on the last beat of the cycle: high tom, mid tom, low tom, with snare hits mixed in.
                // Kept apart from the pattern so it can close the phrase only every 2, 4 or 8 bars.
                int fm = 0;
                if (cb == nb - 1 && ins_pComplex > 50)
                {
                    int f0 = ins_maxi (0, ins_stepsBar - 4);
                    for (int s = f0; s < ins_stepsBar; ++s)
                    {
                        if ((ins_rv (120, s) % 100) < (ins_pComplex - 45))
                        {
                            int fl = 10;
                            if (s - f0 == 2)      fl = 6;
                            else if (s - f0 == 3) fl = 9;
                            if ((ins_rv (121, s) % 100) < 35) fl = 1;
                            if (fl == lane) fm = fm | (1 << s);
                        }
                    }
                }

                if (cb == nb - 1) ins_dFill.at (lane) = fm ^ ((ins_fillEdit.at (lane) & 255) << ins_maxi (0, ins_stepsBar - 8));

                // Pedal hat: closes the open hat an eighth later; in jazz it marks beats 2 and 4
                if (lane == 8)
                {
                    if (ins_pStyle == 7) lm = lm | ins_expandMask (0x1010);
                    else if (ins_pComplex > 30)
                    {
                        int oh = ins_dMask.at (8 + cb);
                        for (int s = 0; s + 2 < ins_stepsBar; ++s)
                        {
                            if (((oh >> s) & 1) != 0) lm = lm | (1 << (s + 2));
                        }
                    }
                }

                // Crash on the downbeat of busy patterns
                if (lane == 11 && cb == 0 && ins_pComplex >= 60 && ins_pStyle != 7 && ins_pStyle != 4) lm = lm | 1;

                // Per-lane density: below 50 thins the lane, above 50 adds hits in musical order
                int ld = ins_laneDens.at (lane);
                if (ld < 50)
                {
                    for (int s = 0; s < ins_stepsBar; ++s)
                    {
                        if (((lm >> s) & 1) != 0)
                        {
                            if ((ins_rv (150 + lane, cb * 32 + s) % 100) >= ld * 2) lm = lm & (0 - 1 - (1 << s));
                        }
                    }
                }
                else if (ld > 50)
                {
                    int boost = (ld - 50) * 2;
                    if (lane == 11)
                    {
                        if (cb == 0 || boost >= 60) lm = lm | 1;
                    }
                    else
                    {
                        for (int s = 0; s < ins_stepsBar; ++s)
                        {
                            if (((lm >> s) & 1) == 0)
                            {
                                int pr = 0;
                                if (lane == 6 || lane == 9 || lane == 10)
                                {
                                    // Toms: end of the phrase first, then end of each bar, then everywhere
                                    int q = (s % ins_maxi (1, ins_beatSteps)) * 4 / ins_maxi (1, ins_beatSteps);
                                    int tl = 10;
                                    if (q == 2)      tl = 6;
                                    else if (q == 3) tl = 9;
                                    if (tl == lane)
                                    {
                                        pr = boost - 80;
                                        if (s >= ins_stepsBar / 2) pr = boost - 60;
                                        if (s >= ins_stepsBar - 4) pr = boost - 30;
                                        if (s >= ins_stepsBar - 4 && cb == nb - 1) pr = boost;
                                    }
                                }
                                else if (((extra >> s) & 1) != 0)
                                {
                                    // The style's own candidate steps come first
                                    pr = boost;
                                }
                                else
                                {
                                    int wgt = 35;
                                    if (ins_isBeat (s))        wgt = 90;
                                    else if ((s % 2) == 0) wgt = 60;
                                    pr = (boost - 30) * wgt / 100;
                                }
                                if (pr > 0)
                                {
                                    if ((ins_rv (160 + lane, cb * 32 + s) % 100) < pr)
                                    {
                                        lm = lm | (1 << s);
                                        if (lane == 1) g = g | (1 << s);
                                    }
                                }
                            }
                        }
                    }
                }

                lm = lm ^ (ins_drumEdit.at (lane * 2 + cb) & 0xffffff);
                ins_dMask.at (lane * 2 + cb) = lm;
                ins_dGhost.at (lane * 2 + cb) = g;
            }

            // One hi-hat sound per step: open hat wins over closed, closed wins over pedal.
            // Hand edits are re-applied afterwards so they always have the last word.
            int e3 = ins_drumEdit.at (6 + cb) & 0xffffff;
            int e8 = ins_drumEdit.at (16 + cb) & 0xffffff;
            int openM = ins_dMask.at (8 + cb);
            int g3 = (ins_dMask.at (6 + cb) ^ e3) & (0 - 1 - openM);
            ins_dMask.at (6 + cb) = g3 ^ e3;
            int closedM = ins_dMask.at (6 + cb);
            int g8 = (ins_dMask.at (16 + cb) ^ e8) & (0 - 1 - (openM | closedM));
            ins_dMask.at (16 + cb) = g8 ^ e8;
        }

        for (int b = 0; b < ins_numBars; ++b)
        {
            int cb = 0;
            if (nb == 2) cb = b % 2;

            for (int lane = 0; lane < 12; ++lane)
            {
                int lm = ins_dMask.at (lane * 2 + cb);
                int g = ins_dGhost.at (lane * 2 + cb);

                int fper = 1;
                if (ins_pFill == 1)      fper = 2;
                else if (ins_pFill == 2) fper = 4;
                else if (ins_pFill == 3) fper = 8;
                if (ins_pFill > 0 && cb == nb - 1)
                {
                    if (((b + 1) % ins_maxi (1, fper)) == 0 || (b == ins_numBars - 1 && ins_numBars < fper)) lm = lm | ins_dFill.at (lane);
                }
                int amt = ins_clampi (ins_pRVel + ins_laneRand.at (lane), 0, 100);

                for (int s = 0; s < ins_stepsBar; ++s)
                {
                    if (((lm >> s) & 1) != 0)
                    {
                        int v = 100;
                        if (lane == 0)      v = 112;
                        else if (lane == 1)
                        {
                            v = 108;
                            if (((g >> s) & 1) != 0) v = 48;
                        }
                        else if (lane == 2) v = 100;
                        else if (lane == 3)
                        {
                            v = 62;
                            if (ins_isBeat (s))        v = 98;
                            else if ((s % 2) == 0) v = 80;
                        }
                        else if (lane == 4) v = 92;
                        else if (lane == 5) v = 78;
                        else if (lane == 6)  v = 96;
                        else if (lane == 8)  v = 68;
                        else if (lane == 9)  v = 100;
                        else if (lane == 10) v = 94;
                        else if (lane == 11) v = 106;
                        else
                        {
                            v = 70;
                            if (ins_isBeat (s)) v = 92;
                        }
                        v = v * ins_pVel / 96 + ins_humanV (ins_nCount) + ins_velDev (230 + lane, cb * 32 + s, amt);
                        int grid = b * ins_barTicks + s * 24;
                        ins_addNote (grid, ins_humanT (ins_nCount), 10, ins_lanePitch.at (lane), v);

                        if (lane == 3 && ins_pStyle == 3 && ins_pComplex > 45)
                        {
                            if ((ins_rv (130, cb * 32 + s) % 100) < (ins_pComplex - 45) / 2)
                                ins_addNote (grid + 12, 0, 8, ins_lanePitch.at (lane), v - 16);
                        }
                    }
                }
            }
        }
    }


    // ---- INSPIRATOR2-DSP: post-stage (voicing, figures, strum, melody rules, ghost notes, mutation) and bar locks ----
    int ins_pLockBars = 0;
    int ins_pInv = 0;
    int ins_pSpread = 0;
    int ins_pStrum = 0;
    int ins_pFig = 0;
    int ins_pGhost = 0;
    int ins_pPull = 0;
    int ins_pLeap = 12;
    int ins_pMut = 0;
    int ins_pDegF = 0;
    bool ins_generated = false;
    int[512] ins_fzGrid;
    int[512] ins_fzOff;
    int[512] ins_fzLen;
    int[512] ins_fzPitch;
    int[512] ins_fzVel;
    int ins_fzCount = 0;
    int ins_fzMode = -1;
    int ins_fzValid = 0;

    void ins_rawAdd (int grid, int off, int len, int pitch, int vel)
    {
        if (ins_nCount >= 512) return;
        int o = ins_clampi (off, -60, 60);
        ins_nGrid.at (ins_nCount) = grid;
        ins_nOff.at (ins_nCount) = o;
        ins_nTick.at (ins_nCount) = ins_posMod (grid + o, ins_loopTicks);
        ins_nLen.at (ins_nCount) = ins_clampi (len, 1, 1000);
        ins_nPitch.at (ins_nCount) = ins_clampi (pitch, 0, 127);
        ins_nVel.at (ins_nCount) = ins_clampi (vel, 1, 127);
        ins_nCount += 1;
    }

    void ins_retick (int i)
    {
        ins_nOff.at (i) = ins_clampi (ins_nOff.at (i), -60, 60);
        ins_nTick.at (i) = ins_posMod (ins_nGrid.at (i) + ins_nOff.at (i), ins_loopTicks);
    }

    // remove notes whose velocity was set to 0
    void ins_compact()
    {
        int w = 0;
        for (int i = 0; i < ins_nCount; ++i)
        {
            if (ins_nVel.at (i) > 0)
            {
                if (w != i)
                {
                    ins_nGrid.at (w) = ins_nGrid.at (i);
                    ins_nOff.at (w) = ins_nOff.at (i);
                    ins_nTick.at (w) = ins_nTick.at (i);
                    ins_nLen.at (w) = ins_nLen.at (i);
                    ins_nPitch.at (w) = ins_nPitch.at (i);
                    ins_nVel.at (w) = ins_nVel.at (i);
                }
                w += 1;
            }
        }
        ins_nCount = w;
    }

    // pitch moved by scale steps (stays in the scale of the key)
    int ins_scaleShift (int pitch, int steps)
    {
        int rel = pitch - 60 - ins_keyOff();
        int best = 0;
        int bd = 1000;
        for (int k = -40; k <= 45; ++k)
        {
            int d = ins_scaleSemi (k) - rel;
            if (d < 0) d = 0 - d;
            if (d < bd) { bd = d; best = k; }
        }
        return ins_clampi (60 + ins_keyOff() + ins_scaleSemi (best + steps), 0, 127);
    }

    int ins_snapChord (int pitch, int c)
    {
        for (int k = 0; k < 7; ++k)
        {
            int d = (k + 1) / 2;
            if ((k % 2) == 1) d = 0 - d;
            if (ins_inChord (pitch + d - ins_keyOff(), c)) return pitch + d;
        }
        return pitch;
    }

    int ins_snapDegree (int pitch, int deg)
    {
        int target = ins_posMod (ins_keyOff() + ins_scaleSemi (deg), 12);
        for (int k = 0; k < 7; ++k)
        {
            if (ins_posMod (pitch + k, 12) == target) return pitch + k;
            if (ins_posMod (pitch - k, 12) == target) return pitch - k;
        }
        return pitch;
    }

    // sort the first n entries of ord by pitch (ascending)
    void ins_sortOrd (int[8]& ord, int n)
    {
        for (int a = 0; a < n - 1; ++a)
        {
            for (int b = a + 1; b < n; ++b)
            {
                if (ins_nPitch.at (ord.at (b)) < ins_nPitch.at (ord.at (a)))
                {
                    int t = ord.at (a);
                    ord.at (a) = ord.at (b);
                    ord.at (b) = t;
                }
            }
        }
    }

    // one chord (n simultaneous notes, entries start..start+n-1)
    void ins_voiceGroup (int start, int n)
    {
        int[8] ord;
        for (int k = 0; k < n; ++k) ord.at (k) = start + k;
        ins_sortOrd (ord, n);

        int inv = ins_minValue (ins_pInv, n - 1);
        for (int k = 0; k < inv; ++k) ins_nPitch.at (ord.at (k)) = ins_clampi (ins_nPitch.at (ord.at (k)) + 12, 0, 127);
        ins_sortOrd (ord, n);

        if (ins_pSpread >= 1 && n >= 3)
        {
            ins_nPitch.at (ord.at (n - 2)) = ins_clampi (ins_nPitch.at (ord.at (n - 2)) - 12, 0, 127);
            if (ins_pSpread >= 2)
            {
                if (n >= 4) ins_nPitch.at (ord.at (n - 4)) = ins_clampi (ins_nPitch.at (ord.at (n - 4)) - 12, 0, 127);
                else        ins_nPitch.at (ord.at (0)) = ins_clampi (ins_nPitch.at (ord.at (0)) - 12, 0, 127);
            }
            ins_sortOrd (ord, n);
        }

        int baseGrid = ins_nGrid.at (start);
        int gl = ins_nLen.at (ord.at (0));
        if (ins_pFig > 0 && n >= 3)
        {
            int[16] seq;
            int m = 0;
            if (ins_pFig == 1)      { for (int k = 0; k < n; ++k) { seq.at (m) = k; m += 1; } }
            else if (ins_pFig == 2) { for (int k = 0; k < n; ++k) { seq.at (m) = n - 1 - k; m += 1; } }
            else if (ins_pFig == 3)
            {
                for (int k = 0; k < n; ++k) { seq.at (m) = k; m += 1; }
                for (int k = n - 2; k >= 1; --k) { seq.at (m) = k; m += 1; }
            }
            else
            {
                seq.at (0) = 0; seq.at (1) = n - 1; seq.at (2) = n / 2; seq.at (3) = n - 1; m = 4;
            }
            int step = ins_clampi ((gl / ins_maxi (1, m) / 12) * 12, 12, 48);
            int slen = ins_maxi (6, step * ins_pGate / 100);
            int[8] pit;
            int[8] vel;
            int[8] off;
            int[8] used;
            for (int k = 0; k < n; ++k)
            {
                pit.at (k) = ins_nPitch.at (ord.at (k));
                vel.at (k) = ins_nVel.at (ord.at (k));
                off.at (k) = ins_nOff.at (ord.at (k));
            }
            int slots = ins_minValue (ins_maxi (m, gl / step), 64);
            for (int j = 0; j < slots; ++j)
            {
                int q = seq.at (j % m);
                int g = baseGrid + j * step;
                if (g < baseGrid + gl && used.at (q) == 0)
                {
                    used.at (q) = 1;
                    int e = ord.at (q);
                    ins_nGrid.at (e) = g;
                    ins_nLen.at (e) = slen;
                    ins_retick (e);
                }
                else if (g < baseGrid + gl)
                {
                    ins_rawAdd (g, off.at (q), slen, pit.at (q), vel.at (q) - (j % 2) * 4);
                }
            }
            // notes that never got a slot (shorter than the chord): silence them
            for (int k = 0; k < n; ++k)
            {
                if (used.at (k) == 0) ins_nVel.at (ord.at (k)) = 0;
            }
        }

        if (ins_pStrum > 0)
        {
            int st = ins_pStrum * 8 / 100;
            for (int k = 0; k < n; ++k)
            {
                ins_nOff.at (ord.at (k)) = ins_nOff.at (ord.at (k)) + k * st;
                ins_retick (ord.at (k));
            }
        }
    }

    int ins_minValue (int a, int b)
    {
        if (a < b) return a;
        return b;
    }

    // bass note on the chord root, two octaves below the chord centre (optionally doubled an octave up)
    void ins_chordBass (int start)
    {
        int g = ins_nGrid.at (start);
        int b = g / ins_maxi (1, ins_barTicks);
        int s = (g % ins_maxi (1, ins_barTicks)) / 24;
        int c = ins_chordAt (b, s);
        int rootPc = ins_posMod (ins_pKey + ins_cRoot.at (c), 12);
        int low = 60 + 12 * ins_pOctave - 24;
        int p = low + ins_posMod (rootPc - low, 12);
        int v = ins_clampi (ins_nVel.at (start) - 8, 1, 127);
        ins_rawAdd (g, ins_nOff.at (start), ins_nLen.at (start), p, v);
        if (ins_pCBass >= 2) ins_rawAdd (g, ins_nOff.at (start), ins_nLen.at (start), p + 12, v - 6);
    }

    void ins_postChords()
    {
        if (ins_pInv == 0 && ins_pSpread == 0 && ins_pStrum == 0 && ins_pFig == 0 && ins_pCBass == 0) return;
        int n0 = ins_nCount;
        int i = 0;
        while (i < n0)
        {
            int j = i;
            while (j + 1 < n0 && ins_nGrid.at (j + 1) == ins_nGrid.at (i)) j += 1;
            int n = j - i + 1;
            if (n > 1 && n <= 8) ins_voiceGroup (i, n);
            if (n >= 1 && ins_pCBass > 0) ins_chordBass (i);
            i = j + 1;
        }
    }

    void ins_postLead()
    {
        int prev = -1;
        for (int i = 0; i < ins_nCount; ++i)
        {
            int g = ins_nGrid.at (i);
            int b = g / ins_maxi (1, ins_barTicks);
            int s = (g % ins_maxi (1, ins_barTicks)) / 24;
            int c = ins_chordAt (b, s);
            int p = ins_nPitch.at (i);
            bool strong = (g % 96) == 0;
            if (ins_pDegF > 0 && ! strong && (ins_rv (320, i) % 100) < 35) p = ins_snapDegree (p, ins_pDegF - 1);
            if ((g % 48) == 0 && (ins_rv (321, i) % 100) < ins_pPull) p = ins_snapChord (p, c);
            if (ins_pLeap < 12 && prev >= 0)
            {
                for (int k = 0; k < 3; ++k)
                {
                    if (p - prev > ins_pLeap) p -= 12;
                    else if (prev - p > ins_pLeap) p += 12;
                }
                if (p - prev > ins_pLeap) p = ins_scaleShift (prev + ins_pLeap, 0);
                if (prev - p > ins_pLeap) p = ins_scaleShift (prev - ins_pLeap, 0);
            }
            p = ins_clampi (p, 0, 127);
            ins_nPitch.at (i) = p;
            prev = p;
        }
    }

    void ins_ghostDrums()
    {
        int sn = ins_lanePitch.at (1);
        int ki = ins_lanePitch.at (0);
        int n0 = ins_nCount;
        for (int b = 0; b < ins_numBars; ++b)
        {
            for (int s = 0; s < ins_stepsBar; ++s)
            {
                if ((s % 4) != 0)
                {
                    int g = b * ins_barTicks + s * 24;
                    bool occ = false;
                    for (int i = 0; i < n0; ++i)
                    {
                        if (ins_nGrid.at (i) == g && (ins_nPitch.at (i) == sn || ins_nPitch.at (i) == ki)) occ = true;
                    }
                    int pr = ins_pGhost * 45 / 100;
                    if ((s % 2) == 0) pr = ins_pGhost * 20 / 100;
                    if (! occ && (ins_rv (310, b * 32 + s) % 100) < pr)
                        ins_addNote (g, ins_humanT (ins_nCount), 8, sn, 14 + (ins_rv (311, b * 32 + s) % 16));
                }
            }
        }
    }

    void ins_ghostBass()
    {
        int n0 = ins_nCount;
        for (int b = 0; b < ins_numBars; ++b)
        {
            for (int s = 0; s < ins_stepsBar; ++s)
            {
                int g = b * ins_barTicks + s * 24;
                bool occ = false;
                int lastG = -1;
                int lastP = -1;
                for (int i = 0; i < n0; ++i)
                {
                    int ng = ins_nGrid.at (i);
                    if (ng >= g && ng < g + 24) occ = true;
                    if (ng < g && ng >= b * ins_barTicks && ng > lastG) { lastG = ng; lastP = ins_nPitch.at (i); }
                }
                int pr = ins_pGhost * 35 / 100;
                if ((s % 2) == 0) pr = ins_pGhost * 12 / 100;
                if (! occ && lastP >= 0 && (ins_rv (312, b * 32 + s) % 100) < pr)
                    ins_addNote (g, ins_humanT (ins_nCount), 10, lastP, 22 + (ins_rv (313, b * 32 + s) % 14));
            }
        }
    }

    void ins_postMutate()
    {
        for (int i = 0; i < ins_nCount; ++i)
        {
            if ((ins_rv (330, i) % 100) < ins_pMut)
            {
                int r = ins_rv (331, i) % 6;
                if (ins_pMode == 4)
                {
                    if (r < 2) ins_nVel.at (i) = 0;
                    else ins_nVel.at (i) = ins_clampi (ins_nVel.at (i) + (ins_rv (332, i) % 31) - 15, 1, 127);
                }
                else if (ins_pMode == 0)
                {
                    ins_nVel.at (i) = ins_clampi (ins_nVel.at (i) + (ins_rv (332, i) % 31) - 15, 1, 127);
                }
                else
                {
                    if (r == 0)      ins_nPitch.at (i) = ins_scaleShift (ins_nPitch.at (i), 1);
                    else if (r == 1) ins_nPitch.at (i) = ins_scaleShift (ins_nPitch.at (i), -1);
                    else if (r == 2) ins_nPitch.at (i) = ins_scaleShift (ins_nPitch.at (i), 2);
                    else if (r == 3) ins_nPitch.at (i) = ins_clampi (ins_nPitch.at (i) + 12 - 24 * (ins_rv (333, i) % 2), 0, 127);
                    else if (r == 4) ins_nVel.at (i) = 0;
                    else             ins_nVel.at (i) = ins_clampi (ins_nVel.at (i) + (ins_rv (332, i) % 31) - 15, 1, 127);
                }
            }
        }
    }

    void ins_postDrumsProb()
    {
        if (ins_pChance < 100)
        {
            for (int i = 0; i < ins_nCount; ++i)
                if ((ins_nGrid.at (i) % 96) != 0 && (ins_rv (380, i) % 100) >= ins_pChance) ins_nVel.at (i) = 0;
        }
        if (ins_pRatchet > 0)
        {
            int n0 = ins_nCount;
            int hp = ins_lanePitch.at (3);
            for (int i = 0; i < n0; ++i)
            {
                if (ins_nVel.at (i) > 0 && ins_nPitch.at (i) == hp && ins_nGrid.at (i) + 12 < ins_loopTicks && (ins_rv (381, i) % 100) < ins_pRatchet)
                {
                    ins_rawAdd (ins_nGrid.at (i) + 12, ins_nOff.at (i), 8, hp, ins_nVel.at (i) - 14);
                    if ((ins_rv (382, i) % 100) < ins_pRatchet / 2 && ins_nGrid.at (i) + 18 < ins_loopTicks)
                        ins_rawAdd (ins_nGrid.at (i) + 18, ins_nOff.at (i), 6, hp, ins_nVel.at (i) - 22);
                }
            }
        }
    }

    void ins_post()
    {
        if (ins_pMode == 0)      ins_postChords();
        else if (ins_pMode == 1) ins_postLead();
        if (ins_pGhost > 0)
        {
            if (ins_pMode == 4)      ins_ghostDrums();
            else if (ins_pMode == 2) ins_ghostBass();
        }
        if (ins_pMode == 4) ins_postDrumsProb();
        if (ins_pMut > 0) ins_postMutate();
        ins_compact();
    }

    // ---- bar locks: locked bars keep the notes they had when they were locked ----
    void ins_fzRemoveBars (int mask)
    {
        int w = 0;
        for (int i = 0; i < ins_fzCount; ++i)
        {
            int b = ins_fzGrid.at (i) / ins_maxi (1, ins_barTicks);
            bool drop = b < 8 && ((mask >> b) & 1) != 0;
            if (! drop)
            {
                ins_fzGrid.at (w) = ins_fzGrid.at (i);
                ins_fzOff.at (w) = ins_fzOff.at (i);
                ins_fzLen.at (w) = ins_fzLen.at (i);
                ins_fzPitch.at (w) = ins_fzPitch.at (i);
                ins_fzVel.at (w) = ins_fzVel.at (i);
                w += 1;
            }
        }
        ins_fzCount = w;
        ins_fzValid = ins_fzValid & (255 - mask);
    }

    event param7129 (float v)
    {
        int nm = ins_clampi (ins_roundi (v), 0, 255);
        int added = nm & (255 - ins_pLockBars);
        int removed = ins_pLockBars & (255 - nm);
        if (ins_fzMode != ins_pMode && added != 0)
        {
            ins_fzCount = 0;
            ins_fzValid = 0;
            ins_fzMode = ins_pMode;
        }
        ins_fzRemoveBars (removed | added);
        if (ins_generated && ins_fzMode == ins_pMode)
        {
            for (int i = 0; i < ins_nCount; ++i)
            {
                int b = ins_nGrid.at (i) / ins_maxi (1, ins_barTicks);
                if (b < 8 && ((added >> b) & 1) != 0 && ins_fzCount < 512)
                {
                    ins_fzGrid.at (ins_fzCount) = ins_nGrid.at (i);
                    ins_fzOff.at (ins_fzCount) = ins_nOff.at (i);
                    ins_fzLen.at (ins_fzCount) = ins_nLen.at (i);
                    ins_fzPitch.at (ins_fzCount) = ins_nPitch.at (i);
                    ins_fzVel.at (ins_fzCount) = ins_nVel.at (i);
                    ins_fzCount += 1;
                }
            }
            ins_fzValid = ins_fzValid | added;
        }
        ins_pLockBars = nm;
        ins_dirty = true;
    }

    void ins_applyLocks()
    {
        if (ins_pLockBars == 0 || ins_fzMode != ins_pMode) return;
        int m = ins_pLockBars & ins_fzValid;
        if (m == 0) return;
        for (int i = 0; i < ins_nCount; ++i)
        {
            int b = ins_nGrid.at (i) / ins_maxi (1, ins_barTicks);
            if (b < 8 && ((m >> b) & 1) != 0) ins_nVel.at (i) = 0;
        }
        ins_compact();
        for (int i = 0; i < ins_fzCount; ++i)
        {
            int b = ins_fzGrid.at (i) / ins_maxi (1, ins_barTicks);
            if (b < ins_numBars && b < 8 && ((m >> b) & 1) != 0)
                ins_rawAdd (ins_fzGrid.at (i), ins_fzOff.at (i), ins_fzLen.at (i), ins_fzPitch.at (i), ins_fzVel.at (i));
        }
    }


    // INSPIRATOR11-DSP marker
    // INSPIRATOR10-DSP marker
    // INSPIRATOR8-DSP marker
    // INSPIRATOR7-DSP marker
    // INSPIRATOR6-DSP marker
    // INSPIRATOR5-DSP marker
    // ---- INSPIRATOR3-DSP: alternative generators ----
    int ins_pGen = 0;
    int ins_pCBass = 0;
    int ins_pChance = 100;
    int ins_pRatchet = 0;
    int ins_pPoly = 0;
    int ins_pGenVar = 0;
    int[343] ins_mkCnt;
    int[64] ins_imDelta;     // deltas (class 0..6) of an imported melody, for the Custom Markov corpus
    int ins_imDeltaCount = 0;
    int[128] ins_lsStr;
    int ins_lsLen = 0;

    int ins_euclid (int k, int n, int rot)
    {
        int m = 0;
        for (int s = 0; s < n; ++s)
        {
            int ix = ins_posMod (s + rot, n);
            if (((ix * k) % n) < k) m = m | (1 << s);
        }
        return m;
    }

    int ins_corpusDelta (int corpus, int i)
    {
        // three built-in "schools", 32 deltas each (class 3 = repeat, 4 = +1 step, 2 = -1 step ...)
        if (corpus == 0)
        {
            int t0 = 0;
            const int[32] pop = (3,4,4,2,3,4,5,3,2,2,4,3,3,5,1,3,4,4,3,2,3,4,2,3,3,5,4,2,1,3,4,3);
            return pop.at (i % 32);
        }
        if (corpus == 1)
        {
            const int[32] mnr = (3,2,3,4,2,3,3,1,4,3,2,2,4,5,3,2,3,4,3,2,4,3,3,2,4,4,2,2,3,5,3,1);
            return mnr.at (i % 32);
        }
        const int[32] jzz = (5,1,4,2,5,0,4,3,1,5,2,4,1,6,0,3,5,2,4,1,5,3,0,4,2,5,1,3,4,2,6,0);
        return jzz.at (i % 32);
    }

    void ins_trainMarkov()
    {
        for (int i = 0; i < 343; ++i) ins_mkCnt.at (i) = 1;
        int corpus = ins_pGenVar % 4;
        int n = 32;
        if (corpus == 3 && ins_imDeltaCount > 3) n = ins_imDeltaCount;
        int d1 = 3;
        int d2 = 3;
        for (int i = 0; i < n * 2; ++i)
        {
            int d = 3;
            if (corpus == 3)
            {
                if (ins_imDeltaCount > 3) d = ins_imDelta.at (i % n);
            }
            else d = ins_corpusDelta (corpus, i);
            ins_mkCnt.at ((d1 * 7 + d2) * 7 + d) += 4;
            d1 = d2;
            d2 = d;
        }
    }

    int ins_markovNext (int d1, int d2, int key)
    {
        int base = (d1 * 7 + d2) * 7;
        int total = 0;
        for (int k = 0; k < 7; ++k) total += ins_mkCnt.at (base + k);
        int r = ins_rv (360, key) % ins_maxi (1, total);
        for (int k = 0; k < 7; ++k)
        {
            r -= ins_mkCnt.at (base + k);
            if (r < 0) return k;
        }
        return 3;
    }

    void ins_buildLSystem()
    {
        int set = ins_pGenVar % 4;
        const int[48] rules = (0,0,1, 1,2,0, 2,0,3, 3,2,4,
                               0,3,1, 2,1,0, 2,0,0, 0,3,4,
                               0,2,1, 1,1,0, 3,2,0, 0,4,4,
                               0,1,0, 1,0,2, 0,3,2, 1,2,4);
        ins_lsLen = 1;
        ins_lsStr.at (0) = ins_rv (350, 0) % 3;
        int[128] tmp;
        for (int it = 0; it < 4; ++it)
        {
            int w = 0;
            for (int i = 0; i < ins_lsLen; ++i)
            {
                int sym = ins_lsStr.at (i);
                for (int j = 0; j < 3; ++j)
                {
                    int r = rules.at (set * 12 + sym * 3 + j);
                    if (r < 4 && w < 128) { tmp.at (w) = r; w += 1; }
                }
            }
            if (w == 0) { tmp.at (0) = 0; w = 1; }
            for (int i = 0; i < w; ++i) ins_lsStr.at (i) = tmp.at (i);
            ins_lsLen = w;
        }
    }

    // symbols: 0 up, 1 down, 2 stay, 3 rest
    int ins_caNext (int row, int rule, int n)
    {
        int nr = 0;
        for (int i = 0; i < n; ++i)
        {
            int l = (row >> ins_posMod (i - 1, n)) & 1;
            int c = (row >> i) & 1;
            int r = (row >> ins_posMod (i + 1, n)) & 1;
            if (((rule >> (l * 4 + c * 2 + r)) & 1) != 0) nr = nr | (1 << i);
        }
        return nr;
    }

    int ins_caRule()
    {
        int v = ins_pGenVar % 4;
        if (v == 0) return 30;
        if (v == 1) return 90;
        if (v == 2) return 110;
        return 150;
    }

    void ins_genAlt (int role)
    {
        int gen = ins_pGen;
        if (role == 4) { ins_genDrumsAlt(); return; }
        int baseP = 60 + 12 * ins_pOctave + ins_keyOff();
        int centerSi = 7;
        int w = 3 + ins_pRange * 6 / 100;
        if (role == 2) { baseP = 36 + 12 * ins_pOctave + ins_keyOff(); centerSi = 0; w = 4; }
        bool minorish = ins_isMinorish();
        int ns = ins_clampi (ins_stepsBar, 1, 31);
        int fullMask = (1 << ns) - 1;
        int caRow = (ins_rv (340, 0) | 5) & fullMask;
        int caRule = ins_caRule();
        if (gen == 2) ins_trainMarkov();
        if (gen == 4) ins_buildLSystem();
        int cur = centerSi;
        int d1 = 3;
        int d2 = 3;
        int kk = 0;
        int walkDir = 1;
        int pc = 1 + (ins_pDensity * (ns - 2)) / 100;
        pc = ins_clampi (pc, 1, ns);

        for (int b = 0; b < ins_numBars; ++b)
        {
            int nbar = (b + 1) % ins_maxi (1, ins_numBars);
            bool pushNext = ins_pushInto (nbar);
            int mask = 0;
            if (gen == 1)
            {
                int rot = ins_pGenVar + (b % 2) * (1 + ins_pGenVar % 3);
                mask = ins_euclid (pc, ns, rot);
            }
            else if (gen == 3)
            {
                caRow = ins_caNext (caRow, caRule, ns);
                if (caRow == 0) caRow = 1 << (ins_rv (341, b) % ns);
                mask = caRow & fullMask;
                // density thins the automaton out
                for (int s = 0; s < ns; ++s)
                {
                    if (((mask >> s) & 1) != 0 && (ins_rv (342, b * 32 + s) % 100) >= 40 + ins_pDensity * 60 / 100)
                        mask = mask & (fullMask - (1 << s));
                }
            }
            else if (gen == 4)
            {
                for (int s = 0; s < ns; ++s)
                {
                    int sym = ins_lsStr.at ((b * ns + s) % ins_maxi (1, ins_lsLen));
                    if (sym != 3 && (ins_rv (343, b * 32 + s) % 100) < 30 + ins_pDensity * 70 / 100) mask = mask | (1 << s);
                }
            }
            else
            {
                for (int s = 0; s < ns; ++s)
                {
                    int t = ins_tmpl (s);
                    int wt = 0;
                    if (t >= 0 && (t % 8) == 0)      wt = 95;
                    else if (t >= 0 && (t % 4) == 0) wt = 75;
                    else if (t >= 0 && (t % 2) == 0) wt = 55;
                    else                             wt = 14 + ins_pComplex / 4;
                    if ((ins_rv (344, b * 32 + s) % 100) < wt * (28 + ins_pDensity) / 100) mask = mask | (1 << s);
                }
            }
            if (mask == 0) mask = 1;

            int lastC = ins_chordAt (b, 0);
            for (int s = 0; s < ns; ++s)
            {
                if (((mask >> s) & 1) != 0)
                {
                    int t = ins_tmpl (s);
                    int c = ins_chordAt (b, s);
                    bool strong = (t >= 0 && (t % 8) == 0);
                    if (c != lastC) strong = true;
                    lastC = c;
                    int pitch = 0;

                    if (gen == 1)
                    {
                        // chord tones, up and down through the chord
                        int cnt = ins_maxi (1, ins_cCnt.at (c));
                        int span = cnt * (1 + ins_pRange / 50);
                        int ix = kk % ins_maxi (1, 2 * span - 2 + (span == 1 ? 1 : 0));
                        if (ix >= span) ix = 2 * span - 2 - ix;
                        int ch = ins_posMod (ins_pKey + ins_cRoot.at (c) + ins_cInt.at (c * 5 + (ix % cnt)), 12);
                        int lo = baseP - 5;
                        pitch = lo + ins_posMod (ch - lo, 12) + 12 * (ix / cnt);
                    }
                    else
                    {
                        int dlt = 0;
                        if (gen == 2)
                        {
                            int dc = ins_markovNext (d1, d2, kk + b * 64);
                            d1 = d2;
                            d2 = dc;
                            dlt = dc - 3;
                        }
                        else if (gen == 3)
                        {
                            int nb = (((caRow >> ins_posMod (s - 1, ns)) & 1) << 2) | (((caRow >> s) & 1) << 1) | ((caRow >> ins_posMod (s + 1, ns)) & 1);
                            int tabd = 0;
                            if (nb == 1 || nb == 5) tabd = 1;
                            else if (nb == 2 || nb == 6) tabd = -1;
                            else if (nb == 3) tabd = 2;
                            else if (nb == 4) tabd = -2;
                            dlt = tabd;
                        }
                        else if (gen == 4)
                        {
                            int sym = ins_lsStr.at ((b * ns + s) % ins_maxi (1, ins_lsLen));
                            if (sym == 0) dlt = 1;
                            else if (sym == 1) dlt = -1;
                        }
                        else if (gen == 6)
                        {
                            // random walk with momentum: keeps its direction 70 % of the time
                            if ((ins_rv (371, kk) % 100) >= 70) walkDir = 0 - walkDir;
                            dlt = walkDir;
                            if ((ins_rv (372, kk) % 100) < 15) dlt = 2 * walkDir;
                            if ((ins_rv (373, kk) % 100) < 12) dlt = 0;
                        }
                        else if (gen == 7)
                        {
                            // 4-note motif, transformed bar by bar: original, reversed, inverted, inverted + reversed
                            int mi = kk % 4;
                            int tr = b % 4;
                            int pos = mi;
                            if (tr == 1 || tr == 3) pos = 3 - mi;
                            int mv = (ins_rv (374, pos) % 7) - 3;
                            if (tr >= 2) mv = 0 - mv;
                            cur = centerSi + mv;
                        }
                        else
                        {
                            dlt = (ins_rv (345, kk) % 5) - 2;
                        }
                        if (kk > 0) cur += dlt;
                        if (cur > centerSi + w) cur = centerSi + w - 1;
                        if (cur < centerSi - w) cur = centerSi - w + 1;
                        if (ins_pComplex < 50 && dlt != 0)
                        {
                            int d7 = ins_posMod (cur, 7);
                            bool avoid = false;
                            if (minorish) avoid = (d7 == 1 || d7 == 5);
                            else          avoid = (d7 == 3 || d7 == 6);
                            if (avoid) cur += dlt;
                        }
                        if (strong) cur = ins_nearestChordTone (cur, c);
                        if (pushNext && s >= ns - 2) cur = ins_nearestChordTone (cur, ins_chordAt (nbar, 0));
                        pitch = baseP + ins_scaleSemi (cur);
                    }

                    int cyc = (b % 2) * 32 + s;
                    int gap = ins_nextHit (mask, s) - s;
                    if (gap > 8) gap = 8;
                    int len = ins_maxi (6, gap * 24 * ins_pGate / 100);
                    len = ins_durLen (len, cyc, gap * 24);
                    int acc = 0;
                    if (strong)              acc = 10;
                    else if (ins_isBeat (s)) acc = 2;
                    else                     acc = 0 - (ins_rv (78, b * 32 + s) % 12);
                    ins_addNote (b * ins_barTicks + s * 24, ins_humanT (ins_nCount), len, pitch,
                                 ins_pVel + acc + ins_humanV (ins_nCount) + ins_velDev (211, cyc, ins_pRVel));
                    kk += 1;
                }
            }
        }
    }

    void ins_genDrumsAlt()
    {
        int ns = ins_clampi (ins_stepsBar, 1, 31);
        int fullMask = (1 << ns) - 1;
        int caRow = (ins_rv (346, 0) | 9) & fullMask;
        int caRule = ins_caRule();
        for (int b = 0; b < ins_numBars; ++b)
        {
            int kick = 0;
            int snare = 0;
            int hat = 0;
            int open = 0;
            int perc = 0;
            int rot = ins_pGenVar;
            if (ins_pGen == 1)
            {
                kick  = ins_euclid (ins_clampi (2 + ins_pDensity * 5 / 100, 2, ns), ns, 0);
                snare = ins_euclid (ins_clampi (2 + ins_pDensity / 50, 2, ns), ns, ns / 4 + (b % 2));
                hat   = ins_euclid (ins_clampi (4 + ins_pDensity * (ns - 4) / 100, 1, ns), ns, rot % 3);
                open  = ins_euclid (ins_clampi (1 + ins_pDensity / 40, 1, ns), ns, ns / 2 + rot % ns);
                perc  = ins_euclid (ins_clampi (1 + ins_pComplex / 20, 1, ns), ns, rot + b);
            }
            else
            {
                caRow = ins_caNext (caRow, caRule, ns);
                if (caRow == 0) caRow = 1 << (ins_rv (347, b) % ns);
                kick  = ins_euclid (4, ns, 0) | (caRow & ins_caNext (caRow, 90, ns) & fullMask);
                snare = ins_euclid (2, ns, ns / 4) ;
                hat   = caRow | ins_euclid (ns / 2, ns, 0);
                open  = ins_caNext (caRow, 30, ns) & ins_caNext (caRow, 110, ns);
                perc  = ins_caNext (ins_caNext (caRow, caRule, ns), 90, ns);
            }
            if (ins_pGen == 1 && ins_pPoly > 0)
            {
                int l1 = 12; int l2 = 5; int l3 = 7;
                if (ins_pPoly == 2) { l1 = 10; l2 = 7; l3 = 9; }
                else if (ins_pPoly == 3) { l1 = 14; l2 = 5; l3 = 11; }
                int e1 = ins_euclid (ins_clampi (3 + ins_pDensity * (l1 - 3) / 100, 1, l1), l1, rot % 3);
                int e2 = ins_euclid (ins_clampi (1 + ins_pDensity / 40, 1, l2), l2, rot % l2);
                int e3 = ins_euclid (ins_clampi (1 + ins_pComplex / 25, 1, l3), l3, rot % l3);
                hat = 0; open = 0; perc = 0;
                for (int s = 0; s < ns; ++s)
                {
                    int gi = b * ns + s;
                    if (((e1 >> (gi % l1)) & 1) != 0) hat = hat | (1 << s);
                    if (((e2 >> (gi % l2)) & 1) != 0) open = open | (1 << s);
                    if (((e3 >> (gi % l3)) & 1) != 0) perc = perc | (1 << s);
                }
            }
            for (int s = 0; s < ns; ++s)
            {
                int g = b * ins_barTicks + s * 24;
                int cyc = (b % 2) * 32 + s;
                bool strong = ins_isBeat (s);
                if (((kick >> s) & 1) != 0)
                    ins_addNote (g, ins_humanT (ins_nCount), 20, ins_lanePitch.at (0), ins_pVel + 14 + ins_humanV (ins_nCount) + ins_velDev (211, cyc, ins_pRVel));
                if (((snare >> s) & 1) != 0 && ((kick >> s) & 1) == 0)
                    ins_addNote (g, ins_humanT (ins_nCount), 20, ins_lanePitch.at (1), ins_pVel + 10 + ins_humanV (ins_nCount) + ins_velDev (212, cyc, ins_pRVel));
                if (((hat >> s) & 1) != 0 && ((open >> s) & 1) == 0)
                {
                    int hv = ins_pVel - 18 + ins_humanV (ins_nCount) + ins_velDev (213, cyc, ins_pRVel);
                    if (strong) hv += 12;
                    ins_addNote (g, ins_humanT (ins_nCount), 12, ins_lanePitch.at (3), hv);
                }
                if (((open >> s) & 1) != 0 && (s % 2) == 1)
                    ins_addNote (g, ins_humanT (ins_nCount), 36, ins_lanePitch.at (4), ins_pVel - 10 + ins_humanV (ins_nCount));
                if (((perc >> s) & 1) != 0 && ins_pComplex > 25 && ((snare >> s) & 1) == 0)
                    ins_addNote (g, ins_humanT (ins_nCount), 16, ins_lanePitch.at (5), ins_pVel - 22 + ins_humanV (ins_nCount));
            }
        }
    }


    // ---- INSPIRATOR4-DSP: imported MIDI pattern ----
    int[512] ins_imGrid;
    int[512] ins_imLen;
    int[512] ins_imPitch;
    int[512] ins_imVel;
    int ins_imCount = 0;
    int ins_imBars = 0;

    int ins_deltaClass (int semis)
    {
        if (semis <= -5) return 0;
        if (semis <= -3) return 1;
        if (semis <= -1) return 2;
        if (semis == 0)  return 3;
        if (semis <= 2)  return 4;
        if (semis <= 4)  return 5;
        return 6;
    }

    event insImport (InsImportChunk c)
    {
        if (c.offset == 0) { ins_imCount = 0; ins_imDeltaCount = 0; }
        ins_imBars = ins_clampi (c.bars, 0, 8);
        for (int i = 0; i < c.count && i < 128; ++i)
        {
            if (ins_imCount < 512)
            {
                int a = ins_roundi (c.data.at (2 * i));
                int b = ins_roundi (c.data.at (2 * i + 1));
                ins_imGrid.at (ins_imCount) = a / 128;
                ins_imPitch.at (ins_imCount) = a % 128;
                ins_imLen.at (ins_imCount) = b / 128;
                ins_imVel.at (ins_imCount) = ins_clampi (b % 128, 1, 127);
                ins_imCount += 1;
            }
        }
        if (c.offset + c.count >= c.total)
        {
            // pitch steps of the melody (lowest voice per onset is good enough) for the Custom Markov corpus
            int prev = -1;
            int lastG = -1;
            for (int i = 0; i < ins_imCount && ins_imDeltaCount < 64; ++i)
            {
                if (ins_imGrid.at (i) != lastG)
                {
                    if (prev >= 0)
                    {
                        ins_imDelta.at (ins_imDeltaCount) = ins_deltaClass (ins_imPitch.at (i) - prev);
                        ins_imDeltaCount += 1;
                    }
                    prev = ins_imPitch.at (i);
                    lastG = ins_imGrid.at (i);
                }
            }
        }
        ins_dirty = true;
    }

    void ins_genImport()
    {
        int shift = 12 * ins_pOctave;
        for (int i = 0; i < ins_imCount; ++i)
        {
            int g = ins_imGrid.at (i);
            if (g >= 0 && g < ins_loopTicks)
            {
                int v = ins_clampi (ins_imVel.at (i) + (ins_pVel - 90) / 2 + ins_humanV (i), 1, 127);
                ins_rawAdd (g, ins_humanT (i), ins_maxi (4, ins_imLen.at (i) * ins_pGate / 100), ins_imPitch.at (i) + shift, v);
            }
        }
    }


    // ---- INSPIRATOR11-DSP: Trance generator family ----
    int ins_tPitchScale (int si)
    {
        return 60 + 12 * ins_pOctave + ins_keyOff() + ins_scaleSemi (si);
    }

    void ins_tNote (int b, int s, int pitch, int len, int acc, int key)
    {
        int cyc = (b % 2) * 32 + s;
        ins_addNote (b * ins_barTicks + s * 24, ins_humanT (ins_nCount), len, pitch,
                     ins_pVel + acc + ins_humanV (ins_nCount) + ins_velDev (214, cyc, ins_pRVel));
    }

    // rhythmic chord plucks
    void ins_genPluck()
    {
        const int[16] pats = (0x4444, 0x5555, 0x4949, 0xFFFF, 0xEEEE, 0x7777, 0xDDDD, 0x1111, 0x2222, 0x6666, 0x0505, 0x5454, 0x1515, 0x0A0A, 0xAAAA, 0x4B4B);
        int ns = ins_clampi (ins_stepsBar, 1, 31);
        int half = ns / 2;
        for (int b = 0; b < ins_numBars; ++b)
        {
            int cA = ins_chordAt (b, 0);
            int cB = ins_chordAt (b, ns - 1);
            int mask = ins_expandMask (pats.at (ins_pGenVar % 16));
            // thin out with Density: low density keeps only every other hit
            for (int s = 1; s < ns; ++s)
                if (((mask >> s) & 1) != 0 && (ins_rv (396, b * 32 + s) % 100) >= 30 + ins_pDensity * 70 / 100) mask = mask & (0 - 1 - (1 << s));
            // the last bar of a 4 bar phrase gets a lift
            if ((b % 4) == 3) mask = mask | (1 << (ns - 2));
            if (cB != cA) mask = mask | (1 << half);
            if (mask == 0) mask = 1;
            int npA = ins_voicing (cA, 0);
            int npB = ins_voicing (cB, 1);
            for (int s = 0; s < ns; ++s)
            {
                if (((mask >> s) & 1) != 0)
                {
                    int slot = 0;
                    int np = npA;
                    if (s >= half && cB != cA) { slot = 1; np = npB; }
                    int gap = ins_nextHit (mask, s) - s;
                    int len = ins_maxi (6, ins_mini (gap, 2) * 24 * ins_pGate / 100);
                    int acc = -4;
                    if (ins_isBeat (s)) acc = 4;
                    for (int i = 0; i < np; ++i)
                        ins_tNote (b, s, ins_vPit.at (slot * 8 + i), len, acc, i);
                }
            }
        }
    }

    // bass lines: rolling / offbeat / gallop / psy, octave figures
    void ins_genTBass()
    {
        int type = ins_pGenVar % 4;
        int opat = ins_pGenVar / 4;
        int ns = ins_clampi (ins_stepsBar, 1, 31);
        int low = 36 + 12 * ins_pOctave;
        for (int b = 0; b < ins_numBars; ++b)
        {
            int k = 0;
            for (int s = 0; s < ns; ++s)
            {
                int q = s % 4;
                bool hit = false;
                if (type == 0 || type == 3) hit = (q != 0);
                else if (type == 1)         hit = (q == 2);
                else                        hit = (q != 1);
                if (hit && (ins_rv (397, b * 32 + s) % 100) >= 55 + ins_pDensity * 45 / 100) hit = false;
                if (hit)
                {
                    int c = ins_chordAt (b, s);
                    int rootPc = ins_posMod (ins_pKey + ins_cRoot.at (c), 12);
                    int p = low + ins_posMod (rootPc - low, 12);
                    int off = 0;
                    int m = k % 4;
                    if (opat == 1)      { if ((k % 2) == 1) off = 12; }
                    else if (opat == 2) { if (m == 2) off = 12; else if (m == 3) off = 7; }
                    else if (opat == 3) { if (m == 1) off = 7; else if (m == 3) off = 12; }
                    else if (type == 3) { if (m == 2) off = 12; }
                    int len = ins_maxi (6, 24 * ins_pGate / 100);
                    if (type == 1) len = ins_maxi (6, 36 * ins_pGate / 100);
                    int acc = (q == 2) ? 8 : 0;
                    ins_tNote (b, s, p + off, len, acc, k);
                    k += 1;
                }
            }
        }
    }

    // arpeggio patterns over the chord tones (index 0-3 = chord tone, +4 = one octave up, +8 = two octaves up)
    void ins_genTArp()
    {
        const int[128] pat = (0,1,2,1,0,1,2,1,  0,2,1,2,0,2,1,2,  0,1,2,5,2,1,0,1,  0,4,1,5,2,6,1,5,
                              0,0,4,4,1,1,5,5,  2,1,0,1,2,1,0,1,  0,1,2,4,5,6,5,4,  0,2,4,2,0,2,4,2,
                              0,4,0,4,2,6,2,6,  0,1,2,1,4,5,6,5,  0,2,1,2,4,6,5,6,  0,0,4,0,0,0,4,0,
                              2,4,6,4,2,4,6,4,  0,4,2,6,1,5,2,6,  0,1,2,0,1,2,0,1,  0,4,8,4,0,4,8,4);
        int ns = ins_clampi (ins_stepsBar, 1, 31);
        int pt = ins_pGenVar % 16;
        int base = 60 + 12 * ins_pOctave - 5;
        for (int b = 0; b < ins_numBars; ++b)
        {
            for (int s = 0; s < ns; ++s)
            {
                if ((ins_rv (398, b * 32 + s) % 100) < 40 + ins_pDensity * 60 / 100)
                {
                    int c = ins_chordAt (b, s);
                    int cnt = ins_maxi (1, ins_cCnt.at (c));
                    int e = pat.at (pt * 8 + (s % 8));
                    int tone = e % 4;
                    int oct = e / 4;
                    if (tone >= cnt) tone = tone % cnt;
                    int pc = ins_posMod (ins_pKey + ins_cRoot.at (c) + ins_cInt.at (c * 5 + tone), 12);
                    int p = base + ins_posMod (pc - base, 12) + 12 * oct;
                    int acc = (s % 4) == 0 ? 8 : ((s % 2) == 0 ? 2 : -4);
                    ins_tNote (b, s, p, ins_maxi (6, 24 * ins_pGate / 100), acc, s);
                }
            }
        }
    }

    // lead hooks: call and response, focus note, micro phrases, acid line
    void ins_genTLead()
    {
        int kind = ins_pGenVar / 4;
        int cellSel = ins_pGenVar % 4;
        int ns = ins_clampi (ins_stepsBar, 1, 31);
        int centerSi = 7;
        int w = 3 + ins_pRange * 6 / 100;
        const int[16] cells = (0,2,1,3,  0,1,0,2,  0,3,2,1,  0,2,4,2);
        int focus = centerSi + (ins_pGenVar % 3) - 1;
        int pc = ins_clampi (3 + ins_pDensity * 5 / 100, 2, ns);
        for (int b = 0; b < ins_numBars; ++b)
        {
            int mask = 0;
            int rot = cellSel + (kind == 1 ? 1 : 0);
            if (kind == 3) mask = (1 << ns) - 1;
            else mask = ins_euclid (pc, ns, rot);
            if (mask == 0) mask = 1;
            bool response = (b % 2) == 1;
            int k = 0;
            for (int s = 0; s < ns; ++s)
            {
                bool on = ((mask >> s) & 1) != 0;
                if (kind == 3 && (ins_rv (399, b * 32 + s) % 100) >= 78) on = false;
                if (on)
                {
                    int c = ins_chordAt (b, s);
                    bool strong = ins_isBeat (s);
                    int si = focus;
                    int extra = 0;
                    int len = ins_maxi (6, 24 * ins_pGate / 100);
                    int acc = strong ? 8 : -2;
                    if (kind == 0)
                    {
                        int d = cells.at (cellSel * 4 + (k % 4));
                        if (response) d = 0 - d;
                        si = focus + d;
                        if (response && ins_nextHit (mask, s) <= s) si = ins_nearestChordTone (focus, c);
                        len = ins_maxi (6, ins_mini (ins_nextHit (mask, s) - s, 4) * 24 * ins_pGate / 100);
                    }
                    else if (kind == 1)
                    {
                        if ((k % 2) == 0) si = focus;
                        else si = centerSi + 1 + (ins_rv (392, b * 8 + k) % 4);
                        if (strong) si = ins_nearestChordTone (si, c);
                    }
                    else if (kind == 2)
                    {
                        const int[3] mc = (0, 2, 1);
                        si = centerSi + mc.at (k % 3) + (b % 2);
                        if (strong) si = ins_nearestChordTone (si, c);
                    }
                    else
                    {
                        si = centerSi - 3 + (ins_rv (395, b * 32 + s) % 7);
                        if ((ins_rv (394, b * 32 + s) % 100) < 20) extra = 12;
                        if ((ins_rv (393, b * 32 + s) % 100) < 25) { acc = 24; len = 40; }
                        else len = 14;
                    }
                    si = ins_clampi (si, centerSi - w - 2, centerSi + w + 2);
                    ins_tNote (b, s, ins_tPitchScale (si) + extra, len, acc, k);
                    k += 1;
                }
            }
        }
    }

    void ins_genTrance (int role)
    {
        if (role == 0)      ins_genPluck();
        else if (role == 1) ins_genTLead();
        else if (role == 2) ins_genTBass();
        else if (role == 3) ins_genTArp();
        else
        {
            int sv = ins_pStyle;
            ins_pStyle = 18;
            ins_genDrums();
            ins_pStyle = sv;
        }
    }

    void ins_regenerate()
    {
        int m9 = ins_clampi (ins_pMode, 0, 4) * 9;
        ins_pComplex = ins_mp.at (m9);
        ins_pDensity = ins_mp.at (m9 + 1);
        ins_pHuman   = ins_mp.at (m9 + 2);
        ins_pOctave  = ins_mp.at (m9 + 3);
        ins_pRange   = ins_mp.at (m9 + 4);
        ins_pGate    = ins_mp.at (m9 + 5);
        ins_pVel     = ins_mp.at (m9 + 6);
        ins_pRVel    = ins_mp.at (m9 + 7);
        ins_pRDur    = ins_mp.at (m9 + 8);

        ins_computeMeter();
        ins_numBars = 1 << ins_clampi (ins_pBarsIdx, 0, 3);
        ins_loopTicks = ins_numBars * ins_barTicks;
        ins_nCount = 0;
        ins_computeChords();

        if (ins_pGen == 8) ins_genTrance (ins_pMode);
        else if (ins_pGen == 5 && ins_imCount > 0) ins_genImport();
        else if (ins_pGen >= 1 && ins_pGen != 5 && ins_pMode >= 1) ins_genAlt (ins_pMode);
        else if (ins_pMode == 0)      ins_genChords();
        else if (ins_pMode == 1) ins_genLead();
        else if (ins_pMode == 2) ins_genBass();
        else if (ins_pMode == 3) ins_genArp();
        else                 ins_genDrums();

        ins_post();
        ins_applyLocks();
        ins_generated = true;

        ins_dirty = false;
        ins_dumpIdx = 0;
        ins_dumpTimer = 0;
    }

    // ---- MIDI output queue (one message per frame) --------------------------------
    void ins_pushMidi (int status, int a, int b)
    {
        if (ins_qCount >= 256) return;
        int w = (ins_qHead + ins_qCount) % 256;
        ins_qS.at (w) = status;
        ins_qA.at (w) = a;
        ins_qB.at (w) = b;
        ins_qCount += 1;
    }

    void ins_allOff()
    {
        for (int i = 0; i < 32; ++i)
        {
            if (ins_aRemain.at (i) > 0)
            {
                ins_pushMidi (0x80, ins_aPitch.at (i), 0);
                ins_aRemain.at (i) = 0;
            }
        }
    }

    void ins_startNote (int pitch, int vel, int len)
    {
        int slot = -1;
        for (int i = 0; i < 32; ++i)
        {
            if (ins_aRemain.at (i) > 0 && ins_aPitch.at (i) == pitch)
            {
                ins_pushMidi (0x80, pitch, 0);
                ins_aRemain.at (i) = 0;
            }
        }
        for (int i = 0; i < 32; ++i)
        {
            if (slot < 0 && ins_aRemain.at (i) <= 0) slot = i;
        }
        if (slot < 0)
        {
            slot = 0;
            ins_pushMidi (0x80, ins_aPitch.at (0), 0);
        }
        ins_pushMidi (0x90, pitch, vel);
        ins_aPitch.at (slot) = pitch;
        ins_aRemain.at (slot) = len;
    }

    void ins_processTick (int t, bool emit)
    {
        for (int i = 0; i < 32; ++i)
        {
            if (ins_aRemain.at (i) > 0)
            {
                ins_aRemain.at (i) = ins_aRemain.at (i) - 1;
                if (ins_aRemain.at (i) == 0) ins_pushMidi (0x80, ins_aPitch.at (i), 0);
            }
        }

        int lt = ins_posMod (t - ins_originOff, ins_loopTicks);

        if (emit)
        {
            for (int n = 0; n < ins_nCount; ++n)
            {
                if (ins_nTick.at (n) == lt)
                {
                    int p = ins_nPitch.at (n);
                    if (ins_pMode != 4) p += ins_transpose;
                    ins_startNote (ins_clampi (p, 0, 127), ins_nVel.at (n), ins_nLen.at (n));
                }
            }
        }

        int st = lt / 24;
        if (st != ins_lastStep)
        {
            ins_lastStep = st;
            insPos <- st;
        }
    }

    int ins_floorTick (float64 p)
    {
        float64 x = p * 96.0;
        int i = int (x);
        if (float64 (i) > x) i -= 1;
        return i;
    }

    void ins_emitDump()
    {
        int total = 24 + 2 * ins_nCount;
        float v = 0.0f;
        if (ins_dumpIdx == 0)       v = 0.0f - float (ins_nCount + 1);
        else if (ins_dumpIdx == 1)  v = float (ins_pMode);
        else if (ins_dumpIdx == 2)  v = float (ins_numBars + 64 * ins_stepsBar + 4096 * ins_beatSteps);
        else if (ins_dumpIdx < 11)  v = float (ins_cInfo.at (ins_dumpIdx - 3));
        else if (ins_dumpIdx == 11) v = float (ins_transpose + 64 + 128 * ins_pushMask() + 32768 * ins_pRate);
        else if (ins_dumpIdx < 24)  v = float (ins_dFill.at (ins_dumpIdx - 12));
        else
        {
            int k = ins_dumpIdx - 24;
            int n = k / 2;
            if ((k % 2) == 0) v = float (ins_nGrid.at (n) * 128 + ins_nPitch.at (n));
            else              v = float (((ins_nOff.at (n) + 64) * 1024 + ins_nLen.at (n)) * 128 + ins_nVel.at (n));
        }
        insDump <- v;
        ins_dumpIdx += 1;
        if (ins_dumpIdx >= total) ins_dumpIdx = -1;
    }

    void ins_setMp (int i, float v, int lo, int hi)
    {
        ins_mp.at (i) = ins_clampi (ins_roundi (v), lo, hi);
        ins_mpSet.at (i) = 1;
        ins_dirty = true;
    }

    void ins_setLane (int lane, float v)
    {
        ins_laneRand.at (lane) = ins_clampi (ins_roundi (v), 0, 100);
        ins_laneSet.at (lane) = 1;
        ins_dirty = true;
    }

    // Hand edits of the fill: 8 steps per lane (the last 8 of the bar), three lanes packed per parameter
    void ins_setFill (int grp, float v)
    {
        int x = ins_clampi (ins_roundi (v), 0, 16777215);
        ins_fillEdit.at (grp * 3) = x & 255;
        ins_fillEdit.at (grp * 3 + 1) = (x >> 8) & 255;
        ins_fillEdit.at (grp * 3 + 2) = (x >> 16) & 255;
        ins_dirty = true;
    }

    void ins_setNote (int lane, float v)
    {
        ins_lanePitch.at (lane) = ins_clampi (ins_roundi (v), 0, 127);
        ins_lanePitchSet.at (lane) = 1;
        ins_dirty = true;
    }

    void ins_setDens (int lane, float v)
    {
        ins_laneDens.at (lane) = ins_clampi (ins_roundi (v), 0, 100);
        ins_laneDensSet.at (lane) = 1;
        ins_dirty = true;
    }

    void ins_setEdit (int i, float v)
    {
        ins_drumEdit.at (i) = ins_clampi (ins_roundi (v), 0, 16777215);
        ins_dirty = true;
    }

    void ins_setChord (int i, float v)
    {
        ins_chordOv.at (i) = ins_clampi (ins_roundi (v), 0, 255);
        ins_dirty = true;
    }

    event param7001  (float v) { ins_pMode = ins_clampi (ins_roundi (v), 0, 4); ins_dirty = true; }
    event param7002  (float v) { ins_pStyle = ins_clampi (ins_roundi (v), 0, 31); ins_dirty = true; }
    event param7003  (float v) { ins_pKey = ins_clampi (ins_roundi (v), 0, 11); ins_dirty = true; }
    event param7004  (float v) { ins_pScale = ins_clampi (ins_roundi (v), 0, 6); ins_dirty = true; }
    event param7005  (float v) { ins_pSong = ins_clampi (ins_roundi (v), 0, 9999); ins_dirty = true; }
    event param7006  (float v) { ins_pPart = ins_clampi (ins_roundi (v), 0, 9999); ins_dirty = true; }
    event param7007  (float v) { ins_pVar = ins_clampi (ins_roundi (v), 0, 99); ins_dirty = true; }
    event param7008  (float v) { ins_pBarsIdx = ins_clampi (ins_roundi (v), 0, 3); ins_dirty = true; }
    event param7009  (float v) { ins_pSwing = ins_clampi (ins_roundi (v), 0, 100); ins_dirty = true; }
    event param7010 (float v)
    {
        int im = ins_clampi (ins_roundi (v), 0, 2);
        if (im != ins_pInMode)
        {
            ins_pInMode = im;
            ins_heldCount = 0;
            ins_allOff();
        }
    }
    // Lock Chords also carries the style the locked progression was written in: lock + 2 * style
    event param7011 (float v)
    {
        int x = ins_clampi (ins_roundi (v), 0, 63);
        ins_pLock = x % 2;
        ins_pChordStyle = ins_clampi (x / 2, 0, 31);
        ins_dirty = true;
    }
    event param7012 (float v) { ins_setChord (0, v); }
    event param7013 (float v) { ins_setChord (1, v); }
    event param7014 (float v) { ins_setChord (2, v); }
    event param7015 (float v) { ins_setChord (3, v); }
    event param7016 (float v) { ins_setChord (4, v); }
    event param7017 (float v) { ins_setChord (5, v); }
    event param7018 (float v) { ins_setChord (6, v); }
    event param7019 (float v) { ins_setChord (7, v); }
    event param7020 (float v) { ins_setEdit (0, v); }
    event param7021 (float v) { ins_setEdit (1, v); }
    event param7022 (float v) { ins_setEdit (2, v); }
    event param7023 (float v) { ins_setEdit (3, v); }
    event param7024 (float v) { ins_setEdit (4, v); }
    event param7025 (float v) { ins_setEdit (5, v); }
    event param7026 (float v) { ins_setEdit (6, v); }
    event param7027 (float v) { ins_setEdit (7, v); }
    event param7028 (float v) { ins_setEdit (8, v); }
    event param7029 (float v) { ins_setEdit (9, v); }
    event param7030 (float v) { ins_setEdit (10, v); }
    event param7031 (float v) { ins_setEdit (11, v); }
    event param7032 (float v) { ins_setEdit (12, v); }
    event param7033 (float v) { ins_setEdit (13, v); }
    event param7034 (float v) { ins_setEdit (14, v); }
    event param7035 (float v) { ins_setEdit (15, v); }
    event param7036 (float v) { ins_setLane (0, v); }
    event param7037 (float v) { ins_setLane (1, v); }
