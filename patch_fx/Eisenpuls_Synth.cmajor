    event lfoShapeLoad (LfoShapeChunk c)
    {
        int m = clamp (c.lfo, 0, 9);

        for (int i = 0; i < 256; ++i)
            lfoTab.at (m * 256 + i) = clamp (c.data.at (i), -1.0f, 1.0f);
    }

    event tempoIn (std::timeline::Tempo t)
    {
        if (t.bpm > 1.0f && t.bpm != hostBpm)
        {
            hostBpm = t.bpm;

            for (int fs = 0; fs < 48; ++fs)
                fxDirty.at (fs) = true;
        }
    }

    // the host jumped / started: lock the effect beat clock to its position
    event positionIn (std::timeline::Position p) { fxBeat = p.quarterNote; ins_position (p.quarterNote, p.barStartQuarterNote); }

    // Mixer EQ handlers: channel 0 (Osc)
    // channel 1 (Sub)
    // channel 2 (Noise)
    // channel 3 (Supersaw)
    // channel 4 (Sampler 1)
    // channel 5 (Sampler 2)
    // channel 6 (Wavetable 1)
    // channel 7 (Wavetable 2)
    // channel 8 (Wavetable 3)
    // Wavetable unison handlers
    // ---------------- VOICES ----------------
    struct SeqS   // MOD-SEQ: state of one sequencer
    {
        float ph;     // position inside the step (0..1)
        float idx;    // current step
        float dir;    // +1 / -1 (ping-pong)
        float v;      // output 0..1 (after glide)
    }

    struct Voice
    {
        int     noteNumber;
        int     stage;        // amp envelope: 0 off, 1 attack, 2 decay/sustain, 3 release
        int     age;
        float   curFreq;
        float   targetFreq;
        float64[8]  synPos;   // sampler read position per slot
        float64[128] wtUPh;   // wavetable unison phases: slot * 16 + unison voice
        float[32]   wtDcS;    // wavetable warp DC blocker: slot * 4 + {xL, yL, xR, yR}
        float[8]    fmPrev;   // last output of every slot (FM source)
        float[8]    tzPh;     // through-zero FM: integrated modulator phase per slot (cycles)
        float[8]    pdPh;     // phase of every slot as seen by the phase distortion matrix (cycles)
        float[8]    fenv;     // filter envelope level per slot
        float[384]  rkS;      // OSCFX-DSP: per oscillator / slot / channel state, 8 floats (held, counter, write pos, lowpass, mod phase)
        float[49152] rkB;     // OSCFX-DSP: comb delay lines (6 x 4 x 2 x 1024)
        int[8]      fstage;   // filter envelope stage per slot
        float[16] menv;       // mod envelope levels
        float64[16] lfoPh;    // per-voice LFO phases (modes Trig / Env)
        float[16] lfoV;       // per-voice LFO outputs
        float[16] lfoAge;     // seconds since note-on, -1 before the first update
        float[16] frqT;       // Freq modulators: seconds since note-on
        float[16] frqV;       // Freq modulators: output (units of 4 octaves)
        SeqS[16]  seqS;       // MOD-SEQ: per-voice sequencers (Retrig on)
        float[16] lfoSh;      // per-voice sample & hold values
        float[16] lfoSm;      // per-voice smoothing state
        int[16]   mstage;     // mod envelope stages (0 off, 1 attack, 2 decay/sustain, 3 release)
        float   env;
        float   penv;
        float   velGain;
        float   velRaw;
        float   modRand;      // per-note random value for the mod matrix
        float[256]  fx;       // filter states: slot * 32 + channel * 16 + stage state
        float[24576] fdl;     // comb filter delay lines: slot * 4096 + channel * 2048 + position
        float[1024] wfs;      // Wavefilter band states: (slot * 2 + channel) * 64 + band * 2 + {ic1, ic2}
        float[512]  wfg;      // Wavefilter band gains in use: (slot * 2 + channel) * 32 + band
        float[512]  wft;      // Wavefilter band gains wanted (recomputed every 8 samples)
        int[16]     wfc;      // Wavefilter sample counters: slot * 2 + channel
        float[4096] phs;      // physical modelling states: slot * 176 + ...; 2048.. unison drift, 2240.. Juno sub counters
        // WG-VOICE-BEGIN
        float[131072] wgd;    // Waveguide source: delay lines, slot * 16384
        float[2048]   wgs;    // Waveguide source: state, slot * 192
        // WG-VOICE-END
        // JP-VOICE-BEGIN
        float[512]    jps;    // JP-8080 source: state, slot * 64
        // JP-VOICE-END
        // GR-VOICE-BEGIN
        float[1024]   grs;    // Granular source: grains, slot * 96
        // GR-VOICE-END
        // AD-VOICE-BEGIN
        float[4096]   ads;    // Additive source: partials, slot * 512
        // AD-VOICE-END
        // DK-VOICE-BEGIN
        float[2048]   dks;    // Modal Drum source: modes, slot * 192
        // DK-VOICE-END
        // SP-VOICE-BEGIN
        float[4096]   sps;    // Spectral source: partials, slot * 512
        // SP-VOICE-END
        // SF-VOICE-BEGIN
        float[1024]   sfl;    // SoundFont source: layers, slot * 96
        // SF-VOICE-END
        int     fdlW;         // comb delay write position
        bool    active;
    }


    Voice[8] voices;

    // LFO state
    float64 flfPhase = 0.0;   // flange filter sweep phase

    // Noise
    int noiseState = 12345;

