    float[64]     fxEnvRel;
    float[64]     fxEnvLv;   // envelope level, stage (0 idle, 1 attack, 2 decay, 3 sustain, 4 release), the note counter it has seen, cutoff coefficient cache
    int[64]       fxEnvSt;
    int[64]       fxEnvSeen;
    float[64]     fxEnvGc;
    float[64]     fxFcS;     // FX-FENV2: smoothed cutoff (Hz) of the filter effect
