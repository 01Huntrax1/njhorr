    // ---------------- WAVETABLE UNISON (per wavetable: voices, detune, random phase) ----------------

    // ---------------- SYNTH SAMPLE LOADER TYPE ----------------
    struct LfoShapeChunk
    {
        int        lfo;
        float[256] data;
    }



    // ---------------- SAMPLE MEMORY TYPE (autosave / restore) ----------------
    // memory index = part * 4 + slot (24 memories)


    // ---------------- STATE ----------------
    float voiceMode    = 0.0f;
    float glideMs      = 0.0f;
    float ampAttack    = 2.0f;
    float ampDecay     = 500.0f;
    float ampSustain   = 0.8f;
    float ampRelease   = 250.0f;
    float velSens      = 0.6f;
    float driveAmt     = 0.1f;
    float panParam     = 0.0f;
    float panL         = 1.0f;
    float panR         = 1.0f;
    float masterLevel  = 0.8f;

    float pitchEgInt   = 0.0f;
    float pitchEgDec   = 150.0f;

    float masterTune   = 0.0f;

    // Pitch split state

    // Synth sample engine state

    // Sampler 2 engine state

    // Dedicated wavetable oscillator state

    // Wavetable 2 oscillator state

    // Wavetable 3 oscillator state

    // Supersaw state

    // Sample memory bank (1 memory x 96000 samples) -- Sampler 1

    // Sampler 2 memory bank (1 memory x 96000 samples)

    // Wavetable memory bank (1 memory x 96000 samples)

    // Wavetable 2 memory bank (1 memory x 96000 samples)

    // Wavetable 3 memory bank (1 memory x 96000 samples)
    // ---------------- FX RACK STATE ----------------
    int[32]       fxType;  // padded to a power of two (cheap index wrap)
    float[32]     fxOn;  // padded to a power of two (cheap index wrap)
    float[32]     fxMix;  // padded to a power of two (cheap index wrap)
    int[32]       fxMode;  // padded to a power of two (cheap index wrap)
    // FX-PEQ: band table (10 values per band, 24 bands per slot, normalised), biquad sections (64 per slot, 5 coefficients, 4 states), combs (4 values per band)
    float[7200]   peqB;
    float[9600]   peqC;
    float[7680]   peqZ;
    int[1920]     peqCh;
    int[32]       peqN;
    float[2880]   peqK;
    int[32]       fxSync;  // FX-SYNC: 0 = free, 1..18 = tempo division (the LFO divisions, one per slot)
    float64       fxBeat = 0.0;     // FX-SYNC: quarter notes, locked to the host position, advanced with the tempo
    float[512]    fxGate;           // FX-SYNC: 24 trance gate patterns x 16 steps
    float[256]    fxP;  // padded to a power of two (cheap index wrap)
    bool[32]      fxDirty;  // padded to a power of two (cheap index wrap)
    int[32]       fxOrder;  // padded to a power of two (cheap index wrap)
    int[32]       fxSeq;  // padded to a power of two (cheap index wrap)
    float[512]    fxD;  // padded to a power of two (cheap index wrap)
    float[2048]   fxF;  // padded to a power of two (cheap index wrap)
    int[1024]      fxI;  // padded to a power of two (cheap index wrap)
    float64[128]  fxPh;  // padded to a power of two (cheap index wrap)
    float[5898240] fxArena;   // 30 slots x 196608 floats
    float[8]      busDcX;  // padded to a power of two (cheap index wrap)
    float[8]      busDcY;  // padded to a power of two (cheap index wrap)
    float         busLevel1 = 1.0f;
    float         busLevel2 = 1.0f;


    // Sample memory manager (autosave) state

    // Extra effects state
    float stereoWidth  = 1.0f;

    // New state
    float driveAlg     = 0.0f;
    float toneAmt      = 0.0f;
    float outGain      = 1.0f;

    // DC blocker state (one-pole high-pass on the final output)
    float dcOn     = 0.0f;
    float dcFreq   = 20.0f;
    float dcXL     = 0.0f;
    float dcXR     = 0.0f;
    float dcYL     = 0.0f;
    float dcYR     = 0.0f;

    // Chorus buffers

    // Flanger buffers

    // Phaser state (4 allpass stages per channel)

    // Tremolo state

    // Reverb pre-delay
    float   synDcXL    = 0.0f;   // synth-bus DC blocker (always on, before the FX)
    float   synDcYL    = 0.0f;
    float   synDcXR    = 0.0f;
    float   synDcYR    = 0.0f;

    // Output tone state
    float   toneStL    = 0.0f;
    float   toneStR    = 0.0f;

    // Reverb state: 8 comb filters (4 left, 4 right) and 4 allpass filters
    int[8]       combLen;
    int[4]       apLen;

    // ---------------- MOD PAGE STATE ----------------
    float[16]   mLfoWave;  // padded to a power of two (cheap index wrap)
    float[16]   mLfoRate;  // padded to a power of two (cheap index wrap)
    float[16]   mLfoSync;  // padded to a power of two (cheap index wrap)
    float[16]   mLfoDiv;  // padded to a power of two (cheap index wrap)
    float       syncBpmOver = 0.0f;   // manual tempo (0 = follow the host)
    float       hostBpm     = 120.0f;
    float[32]   divBeats;             // beats per LFO cycle of every sync division
    float64[16] mLfoPhase;  // padded to a power of two (cheap index wrap)
    float[16]   mLfoSh;  // padded to a power of two (cheap index wrap)
    float[16]   mLfoV;  // padded to a power of two (cheap index wrap)
    float[16]   mLfoMode;     // 0 free (global), 1 trig (per voice, restarts on note-on), 2 env (per voice, one shot)
    float[16]   mLfoDelay;  // padded to a power of two (cheap index wrap)
    float[16]   mLfoRise;  // padded to a power of two (cheap index wrap)
    float[16]   mLfoSmooth;  // padded to a power of two (cheap index wrap)
    float[16]   mLfoStart;  // padded to a power of two (cheap index wrap)
    float[16]   mLfoSm;       // smoothing state of the free-running (global) LFOs
    float[2560] lfoTab;       // drawn shapes, 256 points per LFO
    int         lastVoice = 0;

    float[16]   mEnvA;  // padded to a power of two (cheap index wrap)
    float[16]   mEnvD;  // padded to a power of two (cheap index wrap)
    float[16]   mEnvS;  // padded to a power of two (cheap index wrap)
    float[16]   mEnvR;  // padded to a power of two (cheap index wrap)
    float[16]   envMax;  // padded to a power of two (cheap index wrap)
    float[16]   envMaxNext;  // padded to a power of two (cheap index wrap)

    float[32]   mmSrc;  // padded to a power of two (cheap index wrap)
    int[256]    mmSrcI;  // padded to a power of two (cheap index wrap)
    int[256]    mmDstI;  // padded to a power of two (cheap index wrap)
    float[256]  mmAmt;  // padded to a power of two (cheap index wrap)

    // Freq modulators
    float[2560] frqTab;
    float[16]   frqRate;  // padded to a power of two (cheap index wrap)
    float[16]   frqTrans;  // padded to a power of two (cheap index wrap)
    float[16]   frqRetrig;  // padded to a power of two (cheap index wrap)
    float[16]   frqLoop;  // padded to a power of two (cheap index wrap)
    float[16]   frqGT;        // free running time (s)
    float[16]   frqGV;        // free running value (units of 4 octaves)
    int         frqMask = 0;  // bit m: Freq modulator m is used by the matrix

    float[1024] vmod;  // padded to a power of two (cheap index wrap)
    int[256]    vmodDirty;  // padded to a power of two (cheap index wrap)
