    event param28 (float v) { driveAmt    = v; }
    event param29 (float v)
    {
        float p = clamp (v, -1.0f, 1.0f);
        panParam = p;
        float ang = (p + 1.0f) * 0.25f * float (pi);
        panL = float (cos (ang)) * 1.4142f;
        panR = float (sin (ang)) * 1.4142f;
    }
    event param36 (float v) { masterLevel = v; }

    event param37 (float v) { subLevel    = v; }
