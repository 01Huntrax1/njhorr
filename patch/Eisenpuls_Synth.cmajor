    // ---------------- SYNTH SAMPLE LOADER TYPE ----------------
    struct SynthSampleChunk
    {
        int        offset;
        int        count;
        int        total;
        float[256] data;
    }

    // ---------------- SAMPLE MEMORY TYPE (autosave / restore) ----------------
    // memory index = part * 4 + slot (24 memories)
    struct SampleSave
    {
        int        part;
        int        slot;
        int        offset;
        int        count;
        int        total;
        float[256] data;
    }

    // ---------------- STATE ----------------
    float voiceMode    = 0.0f;
    float glideMs      = 0.0f;
    float osc1Wave     = 0.0f;
    float osc2Wave     = 0.0f;
    float osc1Pitch    = 0.0f;
    float osc2Pitch    = 0.0f;
    float osc2Detune   = 7.0f;
    float oscMix       = 0.5f;
    float oscSync      = 0.0f;
    float ringMod      = 0.0f;
    float filterType   = 0.0f;
    float f1Mix        = 1.0f;
    float f2On         = 0.0f;
    float f2Type       = 1.0f;
    float f2Cutoff     = 4000.0f;
    float f2Res        = 0.25f;
    float f2Drive      = 0.0f;
    float f2Mix        = 1.0f;
    float f2KeyTrack   = 0.0f;
    float f2EgInt      = 0.0f;
    float f2Route      = 0.0f;
    float f2Blend      = 0.5f;
    float cutoffHz     = 4000.0f;
    float resonance    = 0.25f;
    float filterEgInt  = 0.4f;
    float filterEgDec  = 300.0f;
    float keyTrack     = 0.5f;
    float ampAttack    = 2.0f;
    float ampDecay     = 500.0f;
    float ampSustain   = 0.8f;
    float ampRelease   = 250.0f;
    float velSens      = 0.6f;
    float lfoWave      = 0.0f;
    float lfoRate      = 4.0f;
    float lfoPitch     = 0.0f;
    float lfoCutoff    = 0.0f;
    float lfoAmp       = 0.0f;
    float driveAmt     = 0.1f;
    // Per-module bypass state (1 = enabled), independent of saved effect parameters.
    float fxDelayOn    = 1.0f;
    float fxDriveOn    = 1.0f;
    float fxChorusOn   = 1.0f;
    float fxFlangerOn  = 1.0f;
    float fxPhaserOn   = 1.0f;
    float fxReverbOn   = 1.0f;
    float fxTremoloOn  = 1.0f;
    // Reorderable rack state. Slot identity owns its parameters and history; order changes only the route.
    float[20] fxSlotType;
    float[20] fxSlotEnabled;
    float[20] fxSlotOrder;
    float[20] fxSlotA;
    float[20] fxSlotB;
    float[20] fxSlotC;
    float[20] fxSlotD;
    float[20] fxSlotE;
    float[20] fxSlotF;
    float[20] fxSlotVariation;
    float64[20] fxDelayTapePhase;
    float[100] fxFilterIC1L;
    float[100] fxFilterIC2L;
    float[100] fxFilterIC1R;
    float[100] fxFilterIC2R;
    float[100] fxFilterPoleL;
    float[100] fxFilterPoleR;
    float[20] fxFilterFeedbackL;
    float[20] fxFilterFeedbackR;
    float[20] fxSlotFilterMode;

    // Per-slot stereo delay (up to 192000 samples per channel / slot).
    float[3840000] fxDelayBufL;
    float[3840000] fxDelayBufR;
    int[20] fxDelayPos;
    float[20] fxDelayDampL;
    float[20] fxDelayDampR;

    // Per-slot chorus and flanger delay lines.
    float[163840] fxChorusBufL;
    float[163840] fxChorusBufR;
    int[20] fxChorusPos;
    float64[20] fxChorusPhase;
    float[20] fxChorusFbL;
    float[20] fxChorusFbR;
    float[81920] fxFlangerBufL;
    float[81920] fxFlangerBufR;
    int[20] fxFlangerPos;
    float64[20] fxFlangerPhase;
    float[20] fxFlangerFbL;
    float[20] fxFlangerFbR;

    // Per-slot phaser allpass states.
    float[160] fxPhaserZL;
    float[160] fxPhaserZR;
    float64[20] fxPhaserPhase;
    float[20] fxPhaserFbL;
    float[20] fxPhaserFbR;

    // Freeverb-style state per slot: 8 mono combs, 4 allpasses, predelay and DC blockers.
    float[1310720] fxReverbCombBuf;
    int[160] fxReverbCombPos;
    int[160] fxReverbCombLen;
    float[160] fxReverbCombStore;
    float[327680] fxReverbApBuf;
    int[80] fxReverbApPos;
    int[80] fxReverbApLen;
    float[163840] fxReverbPreBuf;
    int[20] fxReverbPrePos;
    float[20] fxReverbInX;
    float[20] fxReverbInY;
