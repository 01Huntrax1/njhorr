    float[6]      busDcY;
    float         busLevel1 = 1.0f;
    float         busLevel2 = 1.0f;


    // Sample memory manager (autosave) state

    // Extra effects state
    float stereoWidth  = 1.0f;

    // New state
    float driveAlg     = 0.0f;
    float toneAmt      = 0.0f;
    float outGain      = 1.0f;

    // DC blocker state (one-pole high-pass on the final output)
    float dcOn     = 0.0f;
    float dcFreq   = 20.0f;
    float dcXL     = 0.0f;
    float dcXR     = 0.0f;
    float dcYL     = 0.0f;
    float dcYR     = 0.0f;

    // Chorus buffers

    // Flanger buffers

    // Phaser state (4 allpass stages per channel)

