    // ---------------- helpers shared by engines 0, 1, 9..12 (group 1) ----------------
    // Svf::Process<LOW_PASS, HIGH_PASS>: returns lp, hp through the reference
    float plG1SvfLpHp (PlSvf& s, float in, float& hpOut)
    {
        float hp = (in - s.r * s.s1 - s.g * s.s1 - s.s2) * s.h;
        float bp = s.g * hp + s.s1;
        s.s1 = s.g * hp + bp;
        float lp = s.g * bp + s.s2;
        s.s2 = s.g * bp + lp;
        hpOut = hp;
        return lp;
    }

    float plG1Sine (float phase)   { return plInterpolateWrap (lut_sine, phase, 512.0f); }

    // InterpolateHermite (table + 1, ...)
    float plG1HermiteOff1 (const float[] table, float index, float size)
    {
        index *= size;
        int   i   = int (index);
        float f   = index - float (i);
        float xm1 = table.at (i);
        float x0  = table.at (i + 1);
        float x1  = table.at (i + 2);
        float x2  = table.at (i + 3);
        float c   = (x1 - xm1) * 0.5f;
        float v   = x0 - x1;
        float w   = c + v;
        float a   = w + v + (x2 - x0) * 0.5f;
        float bn  = w + a;
        return (((a * f) - bn) * f + c) * f + x0;
    }

    // ---------------- plaits/dsp/oscillator/oscillator.h: SLOPE shape, no external FM ----------------
    struct PlG1Osc { float phase; float nextSample; float lpState; float hpState; bool high; float frequency; float pw; }

    void plG1OscInit (PlG1Osc& o)
    {
        o.phase = 0.5f; o.nextSample = 0.0f; o.lpState = 1.0f; o.hpState = 0.0f; o.high = true; o.frequency = 0.001f; o.pw = 0.5f;
    }

    void plG1OscSlope (PlG1Osc& o, bool triangle, float frequency, float pw, float[12]& out)
    {
        frequency = clamp (frequency, 0.000001f, 0.25f);
        pw = clamp (pw, abs (frequency) * 2.0f, 1.0f - 2.0f * abs (frequency));

        float fInc = (frequency - o.frequency) / 12.0f;  float fV = o.frequency;
        float pInc = (pw - o.pw) / 12.0f;                float pV = o.pw;
        float nextSample = o.nextSample;

        for (int n = 0; n < 12; ++n)
        {
            float thisSample = nextSample;
            nextSample = 0.0f;
            fV += fInc;
            float f = fV;
            pV += pInc;
            float p = triangle ? 0.5f : pV;
            o.phase += f;

            float slopeUp   = 1.0f / p;
            float slopeDown = 1.0f / (1.0f - p);

            if (o.high != (o.phase < p))
            {
                float t = (o.phase - p) / f;
                float d = (slopeUp + slopeDown) * f;
                thisSample -= plThisIntegratedBlep (t) * d;
                nextSample -= plNextIntegratedBlep (t) * d;
                o.high = o.phase < p;
            }

            if (o.phase >= 1.0f)
            {
                o.phase -= 1.0f;
                float t = o.phase / f;
                float d = (slopeUp + slopeDown) * f;
                thisSample += plThisIntegratedBlep (t) * d;
                nextSample += plNextIntegratedBlep (t) * d;
                o.high = true;
            }

            nextSample += o.high ? o.phase * slopeUp : 1.0f - (o.phase - p) * slopeDown;
            out.at (n) = 2.0f * thisSample - 1.0f;
        }

        o.frequency = fV; o.pw = pV; o.nextSample = nextSample;
    }

    // ---------------- plaits/dsp/oscillator/sine_oscillator.h: SinePM with a 32 bit phase kept in an int64 ----------------
    float plG1SinePM (int64 phase, float pm)
    {
        phase = (phase + (int64 ((pm + 32.0f) * 67108864.0f) * 64) ) & 4294967295i64;
        int   integral   = int (phase >> 23);
        float fractional = float ((phase & 8388607i64) << 9) / 4294967296.0f;
        float a = lut_sine.at (integral);
        float b = lut_sine.at (integral + 1);
        return a + (b - a) * fractional;
    }

    // Downsampler (4x) as 2 floats of state: head and tail are kept per call by the caller
    const float[4] lut_4x_downsampler_fir =
    (
        2.442415000e-02f, 9.297315000e-02f, 1.671293800e-01f, 2.154733200e-01f
    );

    // ---------------- VariableShapeOscillator::Render for 24 samples (2x oversampled engines) ----------------
    // enableSync / outputPhase are the template flags of the original
    void plG1VsoRender24 (PlVso& o, bool enableSync, bool outputPhase, float masterFrequency, float frequency, float pw,
                      float waveshape, float phaseModAmount, float[24]& out)
    {
        masterFrequency = min (masterFrequency, plMaxFrequency);
        frequency       = min (frequency, plMaxFrequency);

        if (frequency >= 0.25f)
            pw = 0.5f;
        else
            pw = clamp (pw, frequency * 2.0f, 1.0f - 2.0f * frequency);

        float masterInc = (masterFrequency - o.masterFreq) / 24.0f;  float masterV = o.masterFreq;
        float fmInc     = (frequency - o.slaveFreq) / 24.0f;         float fmV     = o.slaveFreq;
        float pwInc     = (pw - o.pw) / 24.0f;                       float pwV     = o.pw;
        float wsInc     = (waveshape - o.waveshape) / 24.0f;         float wsV     = o.waveshape;
        float pmInc     = (phaseModAmount - o.phaseMod) / 24.0f;     float pmV     = o.phaseMod;

        float nextSample = o.nextSample;

        for (int n = 0; n < 24; ++n)
        {
            bool  reset = false;
            bool  transitionDuringReset = false;
            float resetTime = 0.0f;

            float thisSample = nextSample;
            nextSample = 0.0f;

            masterV += masterInc; fmV += fmInc; pwV += pwInc; wsV += wsInc;
            float masterFrequencyN = masterV;
            float slaveFrequency   = fmV;
            float pwN              = pwV;
            float waveshapeN       = wsV;

            float squareAmount   = max (waveshapeN - 0.5f, 0.0f) * 2.0f;
            float triangleAmount = max (1.0f - waveshapeN * 2.0f, 0.0f);
            float slopeUp        = 1.0f / pwN;
            float slopeDown      = 1.0f / (1.0f - pwN);

            if (enableSync)
            {
                o.masterPhase += masterFrequencyN;

                if (o.masterPhase >= 1.0f)
                {
                    o.masterPhase -= 1.0f;
                    resetTime = o.masterPhase / masterFrequencyN;

                    float slavePhaseAtReset = o.slavePhase + (1.0f - resetTime) * slaveFrequency;
                    reset = true;

                    if (slavePhaseAtReset >= 1.0f)
                    {
                        slavePhaseAtReset -= 1.0f;
                        transitionDuringReset = true;
                    }

                    if (! o.high && slavePhaseAtReset >= pwN)
                        transitionDuringReset = true;

                    float value = plVsoNaive (slavePhaseAtReset, pwN, slopeUp, slopeDown, triangleAmount, squareAmount);
                    thisSample -= value * plThisBlep (resetTime);
                    nextSample -= value * plNextBlep (resetTime);
                }
            }
            else if (outputPhase)
            {
                o.masterPhase += masterFrequencyN;

                if (o.masterPhase >= 1.0f)
                    o.masterPhase -= 1.0f;
            }

            o.slavePhase += slaveFrequency;

            while (transitionDuringReset || ! reset)
            {
                if (! o.high)
                {
                    if (o.slavePhase < pwN)
                        break;

                    float t = (o.slavePhase - pwN) / (o.previousPw - pwN + slaveFrequency);
                    float triangleStep = (slopeUp + slopeDown) * slaveFrequency;
                    triangleStep *= triangleAmount;

                    thisSample += squareAmount * plThisBlep (t);
                    nextSample += squareAmount * plNextBlep (t);
                    thisSample -= triangleStep * plThisIntegratedBlep (t);
                    nextSample -= triangleStep * plNextIntegratedBlep (t);
                    o.high = true;
                }

                if (o.high)
                {
                    if (o.slavePhase < 1.0f)
                        break;

                    o.slavePhase -= 1.0f;
                    float t = o.slavePhase / slaveFrequency;
                    float triangleStep = (slopeUp + slopeDown) * slaveFrequency;
                    triangleStep *= triangleAmount;

                    thisSample -= (1.0f - triangleAmount) * plThisBlep (t);
                    nextSample -= (1.0f - triangleAmount) * plNextBlep (t);
                    thisSample += triangleStep * plThisIntegratedBlep (t);
                    nextSample += triangleStep * plNextIntegratedBlep (t);
                    o.high = false;
                }
            }

            if (enableSync && reset)
            {
                o.slavePhase = resetTime * slaveFrequency;
                o.high = false;
            }

            nextSample += plVsoNaive (o.slavePhase, pwN, slopeUp, slopeDown, triangleAmount, squareAmount);
            o.previousPw = pwN;

            if (outputPhase)
            {
                float phasor = o.masterPhase;

                if (enableSync)
                {
                    float w = 4.0f * (1.0f - o.masterPhase) * o.masterPhase;
                    thisSample *= w * (2.0f - w);
                    float p2 = phasor * phasor;
                    phasor += (p2 * p2 - phasor) * abs (pwN - 0.5f) * 2.0f;
                }

                pmV += pmInc;
                out.at (n) = phasor + pmV * thisSample;
            }
            else
            {
                out.at (n) = 2.0f * thisSample - 1.0f;
            }
        }

        o.masterFreq = masterV; o.slaveFreq = fmV; o.pw = pwV; o.waveshape = wsV; o.phaseMod = pmV;
        o.nextSample = nextSample;
    }


