    // New state
    float driveAlg     = 0.0f;
    float toneAmt      = 0.0f;
    float outGain      = 1.0f;

    // DC blocker state (one-pole high-pass on the final output)
    float dcOn     = 0.0f;
    float dcFreq   = 20.0f;
    float dcXL     = 0.0f;
    float dcXR     = 0.0f;
    float dcYL     = 0.0f;
    float dcYR     = 0.0f;

