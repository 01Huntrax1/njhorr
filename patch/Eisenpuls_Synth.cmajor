    // ---------------- engine 9: Waveshaping (plaits/dsp/engine/waveshaping_engine.cc) ----------------
    struct PlWs { PlG1Osc slope; PlG1Osc tri; float prevShape; float prevWf; float prevOvertone; }

    PlWs[48] plWs;

    void plInit_9 (int inst)
    {
        plG1OscInit (plWs.at (inst).slope);
        plG1OscInit (plWs.at (inst).tri);
        plWs.at (inst).prevShape = 0.0f; plWs.at (inst).prevWf = 0.0f; plWs.at (inst).prevOvertone = 0.0f;
    }

    float plWsTame (float f0, float harmonics, float order)
    {
        f0 *= harmonics;
        float maxF = 0.5f / order;
        float maxAmount = clamp (1.0f - (f0 - maxF) / (0.5f - maxF), 0.0f, 1.0f);
        return maxAmount * maxAmount * maxAmount;
    }

    float plWsTable (int t, int i)
    {
        float v = 0.0f;
        if (t == 0) v = float (lut_ws_inverse_tan.at (i));
        else if (t == 1) v = float (lut_ws_inverse_sin.at (i));
        else if (t == 2) v = float (lut_ws_linear.at (i));
        else if (t == 3) v = float (lut_ws_bump.at (i));
        else v = float (lut_ws_double_bump.at (i));
        return v / 32768.0f;
    }

    void plRender_9 (int inst, int trig, float note, float harm, float timb, float morph, float accent)
    {
        float f0 = plNoteToFrequency (note);
        float pw = morph * 0.45f + 0.5f;

        float[12] out;
        float[12] aux;
        plG1OscSlope (plWs.at (inst).slope, false, f0, pw, out);
        plG1OscSlope (plWs.at (inst).tri, true, f0, 0.5f, aux);

        float slope = 3.0f + abs (morph - 0.5f) * 5.0f;
        float shapeAmount = abs (harm - 0.5f) * 2.0f;
        float shapeAtt = plWsTame (f0, slope, 16.0f);
        float wfGain = timb;
        float wfAtt = plWsTame (f0, slope * (3.0f + shapeAmount * shapeAtt * 5.0f), 12.0f);

        float shapeT = 0.5f + (harm - 0.5f) * shapeAtt;
        float wfT = 0.03f + 0.46f * wfGain * wfAtt;
        float ot = timb * (2.0f - timb);
        float otT = ot * (2.0f - ot);

        float shInc = (shapeT - plWs.at (inst).prevShape) / 12.0f;       float shV = plWs.at (inst).prevShape;
        float wfInc = (wfT - plWs.at (inst).prevWf) / 12.0f;             float wfV = plWs.at (inst).prevWf;
        float otInc = (otT - plWs.at (inst).prevOvertone) / 12.0f;       float otV = plWs.at (inst).prevOvertone;

        for (int i = 0; i < 12; ++i)
        {
            shV += shInc;
            float shape = shV * 3.9999f;
            int   si = int (shape);
            float sf = shape - float (si);

            float wsIndex = 127.0f * out.at (i) + 128.0f;
            int   wi = int (wsIndex);
            float wfr = wsIndex - float (wi);
            wi = wi & 255;

            float x0 = plWsTable (si, wi);
            float x1 = plWsTable (si, wi + 1);
            float x = x0 + (x1 - x0) * wfr;
            float y0 = plWsTable (si + 1, wi);
            float y1 = plWsTable (si + 1, wi + 1);
            float y = y0 + (y1 - y0) * wfr;

            float mix = x + (y - x) * sf;
            wfV += wfInc;
            float index = mix * wfV + 0.5f;
            float fold  = plG1HermiteOff1 (lut_fold, index, 512.0f);
            float fold2 = -plG1HermiteOff1 (lut_fold_2, index, 512.0f);

            float sine = plG1Sine (aux.at (i) * 0.25f + 0.5f);
            otV += otInc;
            plOut.at (inst * 12 + i) = fold;
            plAux.at (inst * 12 + i) = sine + (fold2 - sine) * otV;
        }

        plWs.at (inst).prevShape = shV; plWs.at (inst).prevWf = wfV; plWs.at (inst).prevOvertone = otV;
    }


    // ---------------- engine 10: FM (plaits/dsp/engine/fm_engine.cc) ----------------
    struct PlFm
    {
        int64 carrierPhase; int64 modulatorPhase; int64 subPhase;
        float prevCarrierF; float prevModulatorF; float prevAmount; float prevFeedback; float prevSample;
        float subFir; float carrierFir;
    }

    PlFm[48] plFm;

    void plInit_10 (int inst)
    {
        plFm.at (inst).carrierPhase = 0; plFm.at (inst).modulatorPhase = 0; plFm.at (inst).subPhase = 0;
        plFm.at (inst).prevCarrierF = plA0 * 1.0f; plFm.at (inst).prevModulatorF = plA0 * 1.0f;
        plFm.at (inst).prevAmount = 0.0f; plFm.at (inst).prevFeedback = 0.0f; plFm.at (inst).prevSample = 0.0f;
        plFm.at (inst).subFir = 0.0f; plFm.at (inst).carrierFir = 0.0f;
    }

    void plRender_10 (int inst, int trig, float note, float harm, float timb, float morph, float accent)
    {
        note -= 24.0f;
        float ratio = plInterpolate (lut_fm_frequency_quantizer, harm, 128.0f);
        float modNote = note + ratio;
        float targetModF = clamp (plNoteToFrequency (modNote), 0.0f, 0.5f);

        float hf = clamp (1.0f - (modNote - 72.0f) * 0.025f, 0.0f, 1.0f);
        hf *= hf;

        float cfT = plNoteToFrequency (note);
        float amT = 2.0f * timb * timb * hf;
        float fbT = 2.0f * morph - 1.0f;

        float cfInc = (cfT - plFm.at (inst).prevCarrierF) / 12.0f;       float cfV = plFm.at (inst).prevCarrierF;
        float mfInc = (targetModF - plFm.at (inst).prevModulatorF) / 12.0f; float mfV = plFm.at (inst).prevModulatorF;
        float amInc = (amT - plFm.at (inst).prevAmount) / 12.0f;         float amV = plFm.at (inst).prevAmount;
        float fbInc = (fbT - plFm.at (inst).prevFeedback) / 12.0f;       float fbV = plFm.at (inst).prevFeedback;

        float cHead = plFm.at (inst).carrierFir; float cTail = 0.0f;
        float sHead = plFm.at (inst).subFir;     float sTail = 0.0f;
        float prev  = plFm.at (inst).prevSample;
        int64 cph = plFm.at (inst).carrierPhase;
        int64 mph = plFm.at (inst).modulatorPhase;
        int64 sph = plFm.at (inst).subPhase;

        for (int i = 0; i < 12; ++i)
        {
            cfV += cfInc; mfV += mfInc; amV += amInc; fbV += fbInc;
            float amount = amV;
            float feedback = fbV;
            float phaseFb = feedback < 0.0f ? 0.5f * feedback * feedback : 0.0f;
            int64 carrierInc = int64 (4294967296.0f * cfV);
            float modF = mfV;

            for (int j = 0; j < 4; ++j)
            {
                mph = (mph + int64 (4294967296.0f * modF * (1.0f + prev * phaseFb))) & 4294967295i64;
                cph = (cph + carrierInc) & 4294967295i64;
                sph = (sph + (carrierInc >> 1)) & 4294967295i64;
                float modFb = feedback > 0.0f ? 0.25f * feedback * feedback : 0.0f;
                float modulator = plG1SinePM (mph, modFb * prev);
                float carrier = plG1SinePM (cph, amount * modulator);
                float sub = plG1SinePM (sph, amount * carrier * 0.25f);
                prev += 0.05f * (carrier - prev);
                cHead += carrier * lut_4x_downsampler_fir.at (3 - j);  cTail += carrier * lut_4x_downsampler_fir.at (j);
                sHead += sub * lut_4x_downsampler_fir.at (3 - j);      sTail += sub * lut_4x_downsampler_fir.at (j);
            }

            plOut.at (inst * 12 + i) = cHead;  cHead = cTail;  cTail = 0.0f;
            plAux.at (inst * 12 + i) = sHead;  sHead = sTail;  sTail = 0.0f;
        }

        plFm.at (inst).carrierFir = cHead; plFm.at (inst).subFir = sHead; plFm.at (inst).prevSample = prev;
        plFm.at (inst).carrierPhase = cph; plFm.at (inst).modulatorPhase = mph; plFm.at (inst).subPhase = sph;
        plFm.at (inst).prevCarrierF = cfV; plFm.at (inst).prevModulatorF = mfV; plFm.at (inst).prevAmount = amV; plFm.at (inst).prevFeedback = fbV;
    }

    // ---------------- engine 11: Grain / formant (plaits/dsp/engine/grain_engine.cc, grainlet + z oscillators) ----------------
    struct PlGrainlet
    {
        float carrierPhase; float formantPhase; float nextSample;
        float carrierFreq; float formantFreq; float carrierShape; float carrierBleed;
    }

    struct PlZosc
    {
        float carrierPhase; float discPhase; float formantPhase; float nextSample;
        float carrierFreq; float formantFreq; float carrierShape; float mode;
    }

    struct PlGrain { PlGrainlet g0; PlGrainlet g1; PlZosc z; PlOnePole dc0; PlOnePole dc1; }

    PlGrain[48] plGrain;

    void plGrainletInit (PlGrainlet& o)
    {
        o.carrierPhase = 0.0f; o.formantPhase = 0.0f; o.nextSample = 0.0f;
        o.carrierFreq = 0.0f; o.formantFreq = 0.0f; o.carrierShape = 0.0f; o.carrierBleed = 0.0f;
    }

    void plZoscInit (PlZosc& o)
    {
        o.carrierPhase = 0.0f; o.discPhase = 0.0f; o.formantPhase = 0.0f; o.nextSample = 0.0f;
        o.carrierFreq = 0.0f; o.formantFreq = 0.0f; o.carrierShape = 0.0f; o.mode = 0.0f;
    }

    void plInit_11 (int inst)
    {
        plGrainletInit (plGrain.at (inst).g0);
        plGrainletInit (plGrain.at (inst).g1);
        plZoscInit (plGrain.at (inst).z);
        plOnePoleInit (plGrain.at (inst).dc0);
        plOnePoleInit (plGrain.at (inst).dc1);
    }

    float plGrainCarrier (float phase, float shape)
    {
        shape *= 3.0f;
        int   si = int (shape);
        float sf = shape - float (si);
        float t = 1.0f - sf;

        if (si == 0)
        {
            phase = phase * (1.0f + t * t * t * 15.0f);
            if (phase >= 1.0f) phase = 1.0f;
            phase += 0.75f;
        }
        else if (si == 1)
        {
            float bp = 0.001f + 0.499f * t * t * t;
            if (phase < bp) phase *= (0.5f / bp);
            else            phase = 0.5f + (phase - bp) * 0.5f / (1.0f - bp);
            phase += 0.75f;
        }
        else
        {
            t = 1.0f - t;
            phase = 0.25f + phase * (0.5f + t * t * t * 14.5f);
            if (phase >= 0.75f) phase = 0.75f;
        }

        return (plG1Sine (phase) + 1.0f) * 0.25f;
    }

    float plGrainGrainlet (float carrierPhase, float formantPhase, float shape, float bleed)
    {
        float carrier = plGrainCarrier (carrierPhase, shape);
        float formant = plG1Sine (formantPhase);
        return carrier * (formant + bleed) / (1.0f + bleed);
    }

    void plGrainletRender (PlGrainlet& o, float carrierFrequency, float formantFrequency, float carrierShape, float carrierBleed, float[12]& out)
    {
        if (carrierFrequency >= 0.125f) carrierFrequency = 0.125f;
        if (formantFrequency >= 0.25f)  formantFrequency = 0.25f;

        float cfInc = (carrierFrequency - o.carrierFreq) / 12.0f;  float cfV = o.carrierFreq;
        float ffInc = (formantFrequency - o.formantFreq) / 12.0f;  float ffV = o.formantFreq;
        float csInc = (carrierShape - o.carrierShape) / 12.0f;     float csV = o.carrierShape;
        float cbInc = (carrierBleed - o.carrierBleed) / 12.0f;     float cbV = o.carrierBleed;
        float nextSample = o.nextSample;

        for (int n = 0; n < 12; ++n)
        {
            float thisSample = nextSample;
            nextSample = 0.0f;

            cfV += cfInc; ffV += ffInc;
            float f0 = cfV;
            float f1 = ffV;

            o.carrierPhase += f0;
            bool reset = o.carrierPhase >= 1.0f;

            if (reset)
            {
                o.carrierPhase -= 1.0f;
                float resetTime = o.carrierPhase / f0;
                float before = plGrainGrainlet (1.0f, o.formantPhase + (1.0f - resetTime) * f1,
                                                csV + csInc * (1.0f - resetTime), cbV + cbInc * (1.0f - resetTime));
                float after  = plGrainGrainlet (0.0f, 0.0f, csV + csInc, cbV + cbInc);
                float disc = after - before;
                thisSample += disc * plThisBlep (resetTime);
                nextSample += disc * plNextBlep (resetTime);
                o.formantPhase = resetTime * f1;
            }
            else
            {
                o.formantPhase += f1;
                if (o.formantPhase >= 1.0f) o.formantPhase -= 1.0f;
            }

            csV += csInc; cbV += cbInc;
            nextSample += plGrainGrainlet (o.carrierPhase, o.formantPhase, csV, cbV);
            out.at (n) = thisSample;
        }

        o.nextSample = nextSample;
        o.carrierFreq = cfV; o.formantFreq = ffV; o.carrierShape = csV; o.carrierBleed = cbV;
    }

    float plGrainZ (float c, float d, float f, float shape, float mode)
    {
        float rampDown = 0.5f * (1.0f + plG1Sine (0.5f * d + 0.25f));
        float offset = 0.0f;
        float phaseShift = 0.0f;

        if (mode < 0.333f)
        {
            offset = 1.0f;
            phaseShift = 0.25f + mode * 1.50f;
        }
        else if (mode < 0.666f)
        {
            phaseShift = 0.7495f - (mode - 0.33f) * 0.75f;
            offset = -plG1Sine (phaseShift);
        }
        else
        {
            phaseShift = 0.7495f - (mode - 0.33f) * 0.75f;
            offset = 0.001f;
        }

        float disc = plG1Sine (f + phaseShift);
        float contour = 0.0f;

        if (shape < 0.5f)
        {
            shape *= 2.0f;
            if (c >= 0.5f) rampDown *= shape;
            contour = 1.0f + (plG1Sine (c + 0.25f) - 1.0f) * shape;
        }
        else
        {
            contour = plG1Sine (c + shape * 0.5f);
        }

        return (rampDown * (offset + disc) - offset) * contour;
    }

    void plZoscRender (PlZosc& o, float carrierFrequency, float formantFrequency, float carrierShape, float mode, float[12]& out)
    {
        if (carrierFrequency >= 0.125f) carrierFrequency = 0.125f;
        if (formantFrequency >= 0.25f)  formantFrequency = 0.25f;

        float cfInc = (carrierFrequency - o.carrierFreq) / 12.0f;  float cfV = o.carrierFreq;
        float ffInc = (formantFrequency - o.formantFreq) / 12.0f;  float ffV = o.formantFreq;
        float csInc = (carrierShape - o.carrierShape) / 12.0f;     float csV = o.carrierShape;
        float mdInc = (mode - o.mode) / 12.0f;                     float mdV = o.mode;
        float nextSample = o.nextSample;

        for (int n = 0; n < 12; ++n)
        {
            float thisSample = nextSample;
            nextSample = 0.0f;

            cfV += cfInc; ffV += ffInc;
            float f0 = cfV;
            float f1 = ffV;

            o.discPhase += 2.0f * f0;
            o.carrierPhase += f0;
            bool reset = o.discPhase >= 1.0f;

            if (reset)
            {
                o.discPhase -= 1.0f;
                float resetTime = o.discPhase / (2.0f * f0);

                float cBefore = o.carrierPhase >= 1.0f ? 1.0f : 0.5f;
                float cAfter  = o.carrierPhase >= 1.0f ? 0.0f : 0.5f;
                float before = plGrainZ (cBefore, 1.0f, o.formantPhase + (1.0f - resetTime) * f1,
                                         csV + csInc * (1.0f - resetTime), mdV + mdInc * (1.0f - resetTime));
                float after  = plGrainZ (cAfter, 0.0f, 0.0f, csV + csInc, mdV + mdInc);
                float disc = after - before;
                thisSample += disc * plThisBlep (resetTime);
                nextSample += disc * plNextBlep (resetTime);
                o.formantPhase = resetTime * f1;

                if (o.carrierPhase > 1.0f)
                    o.carrierPhase = o.discPhase * 0.5f;
            }
            else
            {
                o.formantPhase += f1;
                if (o.formantPhase >= 1.0f) o.formantPhase -= 1.0f;
            }

            if (o.carrierPhase >= 1.0f) o.carrierPhase -= 1.0f;

            csV += csInc; mdV += mdInc;
            nextSample += plGrainZ (o.carrierPhase, o.discPhase, o.formantPhase, csV, mdV);
            out.at (n) = thisSample;
        }

        o.nextSample = nextSample;
        o.carrierFreq = cfV; o.formantFreq = ffV; o.carrierShape = csV; o.mode = mdV;
    }

    void plRender_11 (int inst, int trig, float note, float harm, float timb, float morph, float accent)
    {
        float root = note;
        float f0 = plNoteToFrequency (root);
        float f1 = plNoteToFrequency (24.0f + 84.0f * timb);
        float ratio = plSemitonesToRatio (-24.0f + 48.0f * harm);
        float bleed = harm < 0.5f ? 1.0f - 2.0f * harm : 0.0f;
        float bleedFixed = bleed * (2.0f - bleed);
        float shape = 0.33f + (morph - 0.33f) * max (1.0f - f0 * 24.0f, 0.0f);

        float[12] out;
        float[12] aux;
        plGrainletRender (plGrain.at (inst).g0, f0, f1, shape, bleedFixed, out);
        plGrainletRender (plGrain.at (inst).g1, f0, f1 * ratio, shape, bleedFixed, aux);

        plOnePoleSetF (plGrain.at (inst).dc0, 3, 0.3f * f0);
        for (int i = 0; i < 12; ++i)
            out.at (i) = plOnePoleHP (plGrain.at (inst).dc0, out.at (i) + aux.at (i));

        float cutoff = plNoteToFrequency (root + 96.0f * timb);
        plZoscRender (plGrain.at (inst).z, f0, cutoff, morph, harm, aux);

        plOnePoleSetF (plGrain.at (inst).dc1, 3, 0.3f * f0);
        for (int i = 0; i < 12; ++i)
        {
            plOut.at (inst * 12 + i) = out.at (i);
            plAux.at (inst * 12 + i) = plOnePoleHP (plGrain.at (inst).dc1, aux.at (i));
        }
    }

    // ---------------- engine 12: Additive (plaits/dsp/engine/additive_engine.cc + harmonic_oscillator.h) ----------------
    struct PlAdd { float[36] amps; float[3] phase; float[3] freq; float[36] oscAmp; }

    PlAdd[48] plAdd;

    void plInit_12 (int inst)
    {
        for (int i = 0; i < 36; ++i) { plAdd.at (inst).amps.at (i) = 0.0f; plAdd.at (inst).oscAmp.at (i) = 0.0f; }
        for (int i = 0; i < 3; ++i)  { plAdd.at (inst).phase.at (i) = 0.0f; plAdd.at (inst).freq.at (i) = 0.0f; }
    }

    int plAddHarmonicIndex (bool organ, int i)
    {
        if (! organ) return i;
        return i == 0 ? 0 : (i == 1 ? 1 : (i == 2 ? 2 : (i == 3 ? 3 : (i == 4 ? 5 : (i == 5 ? 7 : (i == 6 ? 9 : 11))))));
    }

    void plAddUpdateAmplitudes (int inst, float centroid, float slope, float bumps, int base, bool organ, int num)
    {
        float n = float (num) - 1.0f;
        float margin = (1.0f / slope - 1.0f) / (1.0f + bumps);
        float center = centroid * (n + margin) - 0.5f * margin;
        float sum = 0.001f;

        for (int i = 0; i < num; ++i)
        {
            float order = abs (float (i) - center) * slope;
            float gain = 1.0f - order;
            gain += abs (gain);
            gain *= gain;

            float b = 0.25f + order * bumps;
            float bumpFactor = 1.0f + plG1Sine (b);

            gain *= bumpFactor;
            gain *= gain;
            gain *= gain;

            int j = base + plAddHarmonicIndex (organ, i);
            plAdd.at (inst).amps.at (j) += 0.001f * (gain - plAdd.at (inst).amps.at (j));
            sum += plAdd.at (inst).amps.at (j);
        }

        sum = 1.0f / sum;

        for (int i = 0; i < num; ++i)
        {
            int j = base + plAddHarmonicIndex (organ, i);
            plAdd.at (inst).amps.at (j) *= sum;
        }
    }

    // HarmonicOscillator<12>::Render<first>; osc = 0..2, ampBase = offset in amps
    void plAddOscRender (int inst, int osc, int first, float frequency, int ampBase, bool add, float[12]& out)
    {
        if (frequency >= 0.5f) frequency = 0.5f;

        float fInc = (frequency - plAdd.at (inst).freq.at (osc)) / 12.0f;
        float fV = plAdd.at (inst).freq.at (osc);
        float[12] aInc;
        float[12] aV;

        for (int i = 0; i < 12; ++i)
        {
            float f = frequency * float (first + i);
            if (f >= 0.5f) f = 0.5f;
            float target = plAdd.at (inst).amps.at (ampBase + i) * (1.0f - f * 2.0f);
            aV.at (i) = plAdd.at (inst).oscAmp.at (osc * 12 + i);
            aInc.at (i) = (target - aV.at (i)) / 12.0f;
        }

        float phase = plAdd.at (inst).phase.at (osc);

        for (int n = 0; n < 12; ++n)
        {
            fV += fInc;
            phase += fV;
            if (phase >= 1.0f) phase -= 1.0f;

            float twoX = 2.0f * plInterpolate (lut_sine, phase, 512.0f);
            float previous = 0.0f;
            float current = 0.0f;

            if (first == 1)
            {
                previous = 1.0f;
                current = twoX * 0.5f;
            }
            else
            {
                float k = float (first);
                previous = plG1Sine (phase * (k - 1.0f) + 0.25f);
                current = plG1Sine (phase * k);
            }

            float sum = 0.0f;

            for (int i = 0; i < 12; ++i)
            {
                aV.at (i) += aInc.at (i);
                sum += aV.at (i) * current;
                float temp = current;
                current = twoX * current - previous;
                previous = temp;
            }

            if (add) out.at (n) += sum; else out.at (n) = sum;
        }

        plAdd.at (inst).phase.at (osc) = phase;
        plAdd.at (inst).freq.at (osc) = fV;
        for (int i = 0; i < 12; ++i) plAdd.at (inst).oscAmp.at (osc * 12 + i) = aV.at (i);
    }

    void plRender_12 (int inst, int trig, float note, float harm, float timb, float morph, float accent)
    {
        float f0 = plNoteToFrequency (note);
        float centroid = timb;
        float rawBumps = harm;
        float rawSlope = (1.0f - 0.6f * rawBumps) * morph;
        float slope = 0.01f + 1.99f * rawSlope * rawSlope * rawSlope;
        float bumps = 16.0f * rawBumps * rawBumps;

        float[12] out;
        float[12] aux;

        plAddUpdateAmplitudes (inst, centroid, slope, bumps, 0, false, 24);
        plAddOscRender (inst, 0, 1, f0, 0, false, out);
        plAddOscRender (inst, 1, 13, f0, 12, true, out);

        plAddUpdateAmplitudes (inst, centroid, slope, bumps, 24, true, 8);
        plAddOscRender (inst, 2, 1, f0, 24, false, aux);

        for (int i = 0; i < 12; ++i)
        {
            plOut.at (inst * 12 + i) = out.at (i);
            plAux.at (inst * 12 + i) = aux.at (i);
        }
    }

