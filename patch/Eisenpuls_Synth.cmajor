    event frqShapeLoad (LfoShapeChunk c)
    {
        int m = clamp (c.lfo, 0, 9);

        for (int i = 0; i < 256; ++i)
            frqTab.at (m * 256 + i) = clamp (c.data.at (i), 0.0f, 1.0f);
    }

