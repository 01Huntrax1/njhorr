    // ---------------- SYNTH SAMPLE LOADER TYPE ----------------
    struct SynthSampleChunk
    {
        int        offset;
        int        count;
        int        total;
        float[256] data;
    }

    // ---------------- SAMPLE MEMORY TYPE (autosave / restore) ----------------
    // memory index = part * 4 + slot (24 memories)
    struct SampleSave
    {
        int        part;
        int        slot;
        int        offset;
        int        count;
        int        total;
        float[256] data;
    }

    // ---------------- STATE ----------------
    float voiceMode    = 0.0f;
