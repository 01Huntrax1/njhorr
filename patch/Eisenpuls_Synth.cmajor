    // Wavetable unison handlers
    event param436   (float v) { wtUniVoices.at (0) = v; updateWtUni (0); }
    event param437   (float v) { wtUniDetune.at (0) = v; updateWtUni (0); }
    event param438   (float v) { wtUniRand.at (0)   = v; }
    event param439   (float v) { wtUniVoices.at (1) = v; updateWtUni (1); }
    event param440   (float v) { wtUniDetune.at (1) = v; updateWtUni (1); }
    event param441   (float v) { wtUniRand.at (1)   = v; }
    event param442   (float v) { wtUniVoices.at (2) = v; updateWtUni (2); }
    event param443   (float v) { wtUniDetune.at (2) = v; updateWtUni (2); }
    event param444   (float v) { wtUniRand.at (2)   = v; }
    event param445   (float v) { wtPanV.at (0)     = v; updateWtPan (0); }
    event param446   (float v) { wtPhaseV.at (0)   = v; }
    event param447   (float v) { wtUniBlend.at (0) = v; updateWtUni (0); }
    event param448   (float v) { wtUniWidth.at (0) = v; updateWtUni (0); }
    event param449   (float v) { wtUniStyle.at (0) = v; updateWtUni (0); }
    event param450   (float v) { wtWarpM1.at (0)   = v; }
