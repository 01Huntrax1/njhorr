        9.987566083e-01f, 9.988263939e-01f, 9.988922628e-01f, 9.989544348e-01f, 9.990131175e-01f, 9.990685067e-01f, 9.991207871e-01f, 9.991701333e-01f,
        9.992167099e-01f, 9.992606725e-01f, 9.993021676e-01f, 9.993413338e-01f, 9.993783018e-01f, 9.994131950e-01f, 9.994461297e-01f, 9.994772160e-01f,
        9.995065576e-01f, 9.995342523e-01f, 9.995603927e-01f, 9.995850659e-01f, 9.996083544e-01f, 9.996303357e-01f, 9.996510834e-01f, 9.996706665e-01f,
