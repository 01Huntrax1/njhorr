    // ---------------- OSCILLATORS ----------------

    // ---------------- FILTER ----------------

    // ---------------- AMP EG ----------------
    input event float param18 [[ name: "Amp Attack",                   min: 0.0,   max: 2000.0, init: 2.0,   unit: "ms" ]];
    input event float param19 [[ name: "Amp Decay",                    min: 10.0,  max: 4000.0, init: 500.0, unit: "ms" ]];
    input event float param20 [[ name: "Amp Sustain",                  min: 0.0,   max: 1.0,    init: 0.8   ]];
    input event float param21 [[ name: "Amp Release",                  min: 5.0,   max: 4000.0, init: 250.0, unit: "ms" ]];
    input event float param22 [[ name: "Velocity Sens",                min: 0.0,   max: 1.0,    init: 0.6   ]];

    // ---------------- MOD / LFO ----------------

    // ---------------- OUTPUT / FX ----------------
    input event float param28 [[ name: "Drive",                        min: 0.0,   max: 1.0,    init: 0.1   ]];
    input event float param29 [[ name: "Pan",                          min: -1.0,  max: 1.0,    init: 0.0   ]];

    input event float param36 [[ name: "Master Level",                 min: 0.0,   max: 1.0,    init: 0.8   ]];

    // ---------------- SYNTH PARAMETERS ----------------
    input event float param45 [[ name: "Pitch EG Int",                 min: -24.0, max: 24.0,   init: 0.0,   unit: "st" ]];
    input event float param46 [[ name: "Pitch EG Decay",               min: 10.0,  max: 2000.0, init: 150.0, unit: "ms" ]];

    // ---------------- FX / MASTER PARAMETERS ----------------
    input event float param63 [[ name: "Master Tune",                  min: -100.0, max: 100.0, init: 0.0,   unit: "ct" ]];

    // ---------------- SUPERSAW OSCILLATOR ----------------

    // ---------------- SAMPLE MEMORY MANAGER ----------------

    // ---------------- PITCH SPLIT: OCTAVE / FINE ----------------

    // ---------------- SYNTH SAMPLE ENGINE ----------------
    // Plays one of the 24 sample memories as a pitched oscillator (sampler only, no wavetable mode).

    // ---------------- EXTRA EFFECTS ----------------
    input event float param175 [[ name: "Stereo Width",                min: 0.0,   max: 2.0,    init: 1.0   ]];

    // ---------------- MORE EFFECTS + OSCILLATOR VOLUME ----------------
    input event float param189 [[ name: "Output Tone (Dark/Bright)",   min: -1.0,  max: 1.0,    init: 0.0   ]];
    input event float param190 [[ name: "Output Gain",                 min: 0.0,   max: 2.0,    init: 1.0   ]];

    // ---------------- SAMPLER 2 (OWN PAGE, OWN MEMORY BANK OF 8) ----------------

    // ---------------- DEDICATED WAVETABLE OSCILLATOR (own page, volume and memory) ----------------

    // ---------------- DC BLOCKER ----------------
    input event float param221 [[ name: "DC Block",                    min: 0.0,   max: 1.0,    init: 0.0,   step: 1.0 ]];
    input event float param222 [[ name: "DC Block Freq",               min: 5.0,   max: 200.0,  init: 20.0,  unit: "Hz" ]];

    // ---------------- WAVETABLE 2 (OWN MEMORY BANK OF 8) ----------------

