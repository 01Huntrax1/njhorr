    event lfoShapeLoad (LfoShapeChunk c)
    {
        int m = clamp (c.lfo, 0, 9);

        for (int i = 0; i < 256; ++i)
            lfoTab.at (m * 256 + i) = clamp (c.data.at (i), -1.0f, 1.0f);
    }

    event tempoIn (std::timeline::Tempo t) { if (t.bpm > 1.0f) hostBpm = t.bpm; }

    // Mixer EQ handlers: channel 0 (Osc)
    // channel 1 (Sub)
    // channel 2 (Noise)
    // channel 3 (Supersaw)
    // channel 4 (Sampler 1)
    // channel 5 (Sampler 2)
    // channel 6 (Wavetable 1)
    // channel 7 (Wavetable 2)
    // channel 8 (Wavetable 3)
    // Wavetable unison handlers
    // ---------------- VOICES ----------------
    struct Voice
    {
        int     noteNumber;
        int     stage;        // amp envelope: 0 off, 1 attack, 2 decay/sustain, 3 release
        int     age;
        float   curFreq;
        float   targetFreq;
        float64[6]  synPos;   // sampler read position per slot
        float64[42] wtUPh;    // wavetable unison phases: slot * 7 + unison voice
        float[24]   wtDcS;    // wavetable warp DC blocker: slot * 4 + {xL, yL, xR, yR}
        float[6]    fmPrev;   // last output of every slot (FM source)
        float[6]    fenv;     // filter envelope level per slot
        int[6]      fstage;   // filter envelope stage per slot
        float[10] menv;       // mod envelope levels
        float64[10] lfoPh;    // per-voice LFO phases (modes Trig / Env)
        float[10] lfoV;       // per-voice LFO outputs
        float[10] lfoAge;     // seconds since note-on, -1 before the first update
        float[10] lfoSh;      // per-voice sample & hold values
        float[10] lfoSm;      // per-voice smoothing state
        int[10]   mstage;     // mod envelope stages (0 off, 1 attack, 2 decay/sustain, 3 release)
        float   env;
        float   penv;
        float   velGain;
        float   velRaw;
        float   modRand;      // per-note random value for the mod matrix
        float[192]  fx;       // filter states: slot * 32 + channel * 16 + stage state
        float[24576] fdl;     // comb filter delay lines: slot * 4096 + channel * 2048 + position
        int     fdlW;         // comb delay write position
        bool    active;
    }


    Voice[8] voices;

    // LFO state
    float64 flfPhase = 0.0;   // flange filter sweep phase

    // Noise
    int noiseState = 12345;

    // Delay

    // Sample-rate reducer

    // ---------------- INIT ----------------
    void init()
    {
        // LFO sync divisions in beats (quarter notes) per cycle
        divBeats.at (0)  = 32.0f;    divBeats.at (1)  = 16.0f;    divBeats.at (2)  = 8.0f;
        divBeats.at (3)  = 4.0f;     divBeats.at (4)  = 3.0f;     divBeats.at (5)  = 2.0f;
        divBeats.at (6)  = 1.3333f;  divBeats.at (7)  = 1.5f;     divBeats.at (8)  = 1.0f;
        divBeats.at (9)  = 0.6667f;  divBeats.at (10) = 0.75f;    divBeats.at (11) = 0.5f;
        divBeats.at (12) = 0.3333f;  divBeats.at (13) = 0.375f;   divBeats.at (14) = 0.25f;
        divBeats.at (15) = 0.1667f;  divBeats.at (16) = 0.125f;   divBeats.at (17) = 0.0833f;
        for (int ld = 0; ld < 10; ++ld)
            mLfoDiv.at (ld) = 8.0f;

        // slot defaults (the annotated parameter inits) and wavetable unison tables
        for (int io = 0; io < 6; ++io)
        {
            for (int ik = 0; ik < 64; ++ik)
                op.at (io * 64 + ik) = 0.0f;

            op.at (io * 64 + 1)  = 0.0f;
            op.at (io * 64 + 7)  = 1.0f;
            op.at (io * 64 + 11) = 3.0f;
            op.at (io * 64 + 12) = 60.0f;
            op.at (io * 64 + 13) = 1.0f;
            op.at (io * 64 + 14) = 0.25f;
            op.at (io * 64 + 15) = 1.0f;
            op.at (io * 64 + 16) = 0.75f;
            op.at (io * 64 + 19) = 0.5f;
            op.at (io * 64 + 21) = 0.5f;
            op.at (io * 64 + 24) = 8.0f;
            op.at (io * 64 + 25) = 0.5f;
            op.at (io * 64 + 26) = 0.5f;
            op.at (io * 64 + 27) = 0.5f;
            op.at (io * 64 + 30) = 1.0f;
            op.at (io * 64 + 32) = 8000.0f;
            op.at (io * 64 + 33) = 0.25f;
            op.at (io * 64 + 35) = 0.5f;
            op.at (io * 64 + 39) = 300.0f;
            op.at (io * 64 + 41) = 250.0f;
            op.at (io * 64 + 43) = 0.3f;
            op.at (io * 64 + 44) = 1.0f;
            updateWtUni (io);
        }
        op.at (1) = 0.8f;

        // mod page defaults (match the annotated init values)
        for (int mi = 0; mi < 10; ++mi)
        {
            mLfoWave.at (mi)    = 0.0f;
            mLfoRate.at (mi)    = 1.0f;
            mLfoPhase.at (mi)   = 0.0;
            mLfoSh.at (mi)      = 0.0f;
            mLfoV.at (mi)       = 0.0f;
            mEnvA.at (mi)       = 10.0f;
            mEnvD.at (mi)       = 300.0f;
            mEnvS.at (mi)       = 0.5f;
            mEnvR.at (mi)       = 300.0f;
            envMax.at (mi)      = 0.0f;
            envMaxNext.at (mi)  = 0.0f;
            mmSrcI.at (mi)      = 0;
            mmDstI.at (mi)      = 0;
            mmAmt.at (mi)       = 0.0f;
        }

        // reverb delay line lengths (tuned at 44.1 kHz, scaled to the actual sample rate)
        float rs = float (processor.frequency) / 44100.0f;

        combLen.at (0) = clamp (int (1116.0f * rs), 16, 8191);
        combLen.at (1) = clamp (int (1188.0f * rs), 16, 8191);
        combLen.at (2) = clamp (int (1277.0f * rs), 16, 8191);
        combLen.at (3) = clamp (int (1356.0f * rs), 16, 8191);
        combLen.at (4) = clamp (int (1139.0f * rs), 16, 8191);
        combLen.at (5) = clamp (int (1211.0f * rs), 16, 8191);
        combLen.at (6) = clamp (int (1300.0f * rs), 16, 8191);
        combLen.at (7) = clamp (int (1379.0f * rs), 16, 8191);

        apLen.at (0) = clamp (int (556.0f * rs), 16, 4095);
        apLen.at (1) = clamp (int (441.0f * rs), 16, 4095);
        apLen.at (2) = clamp (int (579.0f * rs), 16, 4095);
        apLen.at (3) = clamp (int (464.0f * rs), 16, 4095);

        fxInit();

        for (int lm = 0; lm < 10; ++lm)
            for (int li = 0; li < 256; ++li)
                lfoTab.at (lm * 256 + li) = float (sin (float (twoPi) * float (li) / 256.0f));
    }

    // ================================================================================================================
    // FX RACKS: three racks (Main, Bus 1, Bus 2) of 10 slots; every slot holds any effect and the slots of a rack are
    // processed in the order set by its "FX Order 1-10". Slot s of rack rk is the global slot rk * 10 + s.
    //
    // The slot parameters P1-P6 are normalised 0..1; what they mean depends on the effect type (the UI shows the
    // real names and units). The same table lives in patch/index.js (FX_TYPES), keep both in step:
    //
    //   1 Distortion  mode: Soft Tube Hard Fold Sine Crunch   P1 Drive    P2 Tone       P3 Output
    //   2 Bit Crush                                           P1 Bits     P2 Rate
    //   3 Delay       mode: Digital Tape Dual                 P1 Time     P2 Feedback   P3 Damp       P4 Ping-Pong
    //   4 Chorus      mode: Classic Dimension Vibrato         P1 Rate     P2 Depth      P3 Feedback
    //   5 Flanger                                             P1 Rate     P2 Depth      P3 Feedback
    //   6 Phaser      mode: 2 4 6 8 stages                    P1 Rate     P2 Depth      P3 Feedback
    //   7 Tremolo     mode: Sin Tri Sqr SawDn SawUp           P1 Rate     P2 Depth      P3 Stereo
    //   8 Reverb      mode: Hall Room Plate Cathedral         P1 Size     P2 Damp       P3 Pre-Delay  P4 Width
    //   9 Filter      mode: the 30 types of the Filter page   P1 Cutoff   P2 Reso       P3 Drive
    //  10 EQ                                                  P1 Low      P2 Mid        P3 Mid Freq   P4 High   P5 Mid Q
    //  11 Compressor  mode: Peak RMS                          P1 Thresh   P2 Ratio      P3 Attack     P4 Release  P5 Makeup
    //
    // Every slot has a private 196608-float arena (delay lines etc.), 40 float / 24 int / 4 phase state slots and
    // 16 derived values (fxD, recomputed lazily when a parameter changed).
    // ================================================================================================================

    // log-style mapping of a 0..1 value onto lo..hi
    float fxExpMap (float n, float lo, float hi)
    {
        return lo * float (pow (hi / lo, clamp (n, 0.0f, 1.0f)));
    }

    // Clears the delay lines and filter memories of one slot
    void fxResetSlot (int s)
    {
        int ab = s * 196608;

        for (int i = 0; i < 196608; ++i)
            fxArena.at (ab + i) = 0.0f;

        for (int i = 0; i < 40; ++i)
            fxF.at (s * 40 + i) = 0.0f;

        for (int i = 0; i < 24; ++i)
            fxI.at (s * 24 + i) = 0;

        for (int i = 0; i < 4; ++i)
            fxPh.at (s * 4 + i) = 0.0;
    }

    // Selects the effect of a slot (its memory is cleared only when the type really changes)
    void fxSetType (int s, int t)
    {
        int nt = clamp (t, 0, 11);

        if (nt != fxType.at (s))
        {
            fxType.at (s) = nt;
            fxResetSlot (s);
        }

        fxDirty.at (s) = true;
    }

    // Rebuilds the processing order from the 10 "FX Order" values; an order that is not a permutation of the
    // 10 slots (for example while the UI is still sending the values one by one) is ignored
    void fxRebuildSeq (int rk)
    {
        int[10] used;
        bool    valid = true;
        int     ob    = rk * 10;

        for (int k = 0; k < 10; ++k)
        {
            int s = clamp (fxOrder.at (ob + k), 0, 9);

            if (used.at (s) != 0)
                valid = false;

            used.at (s) = 1;
        }

        if (valid)
        {
            for (int k = 0; k < 10; ++k)
                fxSeq.at (ob + k) = clamp (fxOrder.at (ob + k), 0, 9);
        }
    }

    // RBJ biquad of one EQ band (kind 0 low shelf, 1 peaking bell, 2 high shelf), written to fxD[o .. o+4]
    void fxBiquad (int o, int kind, float gDb, float f, float q)
    {
        float cb0 = 1.0f;
        float cb1 = 0.0f;
        float cb2 = 0.0f;
        float ca1 = 0.0f;
        float ca2 = 0.0f;

        if (abs (gDb) > 0.01f)
        {
            float sr  = float (processor.frequency);
            float ff  = clamp (f, 20.0f, sr * 0.45f);
            float w0  = float (twoPi) * ff / sr;
            float cw  = float (cos (w0));
            float sw  = float (sin (w0));
            float aa  = float (pow (10.0f, gDb / 40.0f));
            float sqA = float (sqrt (aa));

            if (kind == 0)
            {
                float al = sw * 0.5f * 1.4142f;
                float a0 = (aa + 1.0f) + (aa - 1.0f) * cw + 2.0f * sqA * al;
                cb0 = (aa * ((aa + 1.0f) - (aa - 1.0f) * cw + 2.0f * sqA * al)) / a0;
                cb1 = (2.0f * aa * ((aa - 1.0f) - (aa + 1.0f) * cw)) / a0;
                cb2 = (aa * ((aa + 1.0f) - (aa - 1.0f) * cw - 2.0f * sqA * al)) / a0;
                ca1 = (-2.0f * ((aa - 1.0f) + (aa + 1.0f) * cw)) / a0;
                ca2 = ((aa + 1.0f) + (aa - 1.0f) * cw - 2.0f * sqA * al) / a0;
            }
            else if (kind == 2)
            {
                float al = sw * 0.5f * 1.4142f;
                float a0 = (aa + 1.0f) - (aa - 1.0f) * cw + 2.0f * sqA * al;
                cb0 = (aa * ((aa + 1.0f) + (aa - 1.0f) * cw + 2.0f * sqA * al)) / a0;
                cb1 = (-2.0f * aa * ((aa - 1.0f) + (aa + 1.0f) * cw)) / a0;
                cb2 = (aa * ((aa + 1.0f) + (aa - 1.0f) * cw - 2.0f * sqA * al)) / a0;
                ca1 = (2.0f * ((aa - 1.0f) - (aa + 1.0f) * cw)) / a0;
                ca2 = ((aa + 1.0f) - (aa - 1.0f) * cw - 2.0f * sqA * al) / a0;
            }
            else
            {
                float qq = max (q, 0.1f);
                float al = sw / (2.0f * qq);
                float a0 = 1.0f + al / aa;
                cb0 = (1.0f + al * aa) / a0;
                cb1 = (-2.0f * cw) / a0;
                cb2 = (1.0f - al * aa) / a0;
                ca1 = (-2.0f * cw) / a0;
                ca2 = (1.0f - al / aa) / a0;
            }
        }

        fxD.at (o)     = cb0;
        fxD.at (o + 1) = cb1;
        fxD.at (o + 2) = cb2;
        fxD.at (o + 3) = ca1;
        fxD.at (o + 4) = ca2;
    }

    // Turns the normalised slot parameters into the values the effect code needs (runs when a parameter changed)
    void fxDerive (int s)
    {
        int   ty = fxType.at (s);
        int   db = s * 16;
        int   pb = s * 6;
        float sr = float (processor.frequency);
        float dt = float (processor.period);
        float p1 = clamp (fxP.at (pb),     0.0f, 1.0f);
        float p2 = clamp (fxP.at (pb + 1), 0.0f, 1.0f);
        float p3 = clamp (fxP.at (pb + 2), 0.0f, 1.0f);
        float p4 = clamp (fxP.at (pb + 3), 0.0f, 1.0f);
        float p5 = clamp (fxP.at (pb + 4), 0.0f, 1.0f);

        if (ty == 1)
        {
            // distortion: drive, tone low-pass coefficient, output gain
            fxD.at (db)     = p1;
            fxD.at (db + 1) = clamp (float (twoPi) * fxExpMap (p2, 500.0f, 20000.0f) * dt, 0.0f, 1.0f);
            fxD.at (db + 2) = p3 * 2.0f;
        }
        else if (ty == 2)
        {
            // bit crush: bits, hold length, quantiser steps
            fxD.at (db)     = 16.0f - 12.0f * p1;
            fxD.at (db + 1) = 1.0f + rint (p2 * 31.0f);
            fxD.at (db + 2) = float (pow (2.0f, fxD.at (db) - 1.0f));
        }
        else if (ty == 3)
        {
            // delay: time (samples), feedback, damping coefficient, ping-pong
            fxD.at (db)     = clamp (fxExpMap (p1, 10.0f, 1000.0f) * 0.001f * sr, 2.0f, 98000.0f);
            fxD.at (db + 1) = 0.95f * p2;

            float dh = fxExpMap (p3, 500.0f, 18000.0f);
            if (fxMode.at (s) == 1)
                dh = min (dh, 6500.0f);

            fxD.at (db + 2) = clamp (float (twoPi) * dh * dt, 0.0f, 1.0f);
            fxD.at (db + 3) = p4;
        }
        else if (ty == 4)
        {
            fxD.at (db)     = fxExpMap (p1, 0.05f, 5.0f);
            fxD.at (db + 1) = p2;
            fxD.at (db + 2) = 0.9f * p3;
        }
        else if (ty == 5)
        {
            fxD.at (db)     = fxExpMap (p1, 0.05f, 5.0f);
            fxD.at (db + 1) = p2;
            fxD.at (db + 2) = 0.95f * p3;
        }
        else if (ty == 6)
        {
            fxD.at (db)     = fxExpMap (p1, 0.05f, 8.0f);
            fxD.at (db + 1) = p2;
            fxD.at (db + 2) = 0.9f * p3;
        }
        else if (ty == 7)
        {
            fxD.at (db)     = fxExpMap (p1, 0.1f, 20.0f);
            fxD.at (db + 1) = p2;
            fxD.at (db + 2) = p3;
        }
        else if (ty == 8)
        {
            // reverb: feedback, damping, pre-delay (samples), width
            fxD.at (db)     = 0.7f + 0.28f * p1;
            fxD.at (db + 1) = 0.2f + 0.7f * p2;
            fxD.at (db + 2) = clamp (p3 * 0.1f * sr, 0.0f, 8000.0f);
            fxD.at (db + 3) = p4;
        }
        else if (ty == 9)
        {
            // filter: coefficients shared by all 30 types, input drive
            float fc = clamp (fxExpMap (p1, 20.0f, 20000.0f), 20.0f, sr * 0.45f);
            fxD.at (db)     = float (tan (float64 (fc) * pi * processor.period));
            fxD.at (db + 1) = 2.0f - 1.96f * p2;
            fxD.at (db + 2) = p2;
            fxD.at (db + 3) = fc;
            fxD.at (db + 4) = 1.0f + 8.0f * p3;
        }
        else if (ty == 10)
        {
            // EQ: low shelf 100 Hz, mid bell, high shelf 8 kHz
            fxBiquad (db,      0, (p1 - 0.5f) * 24.0f, 100.0f, 0.7f);
            fxBiquad (db + 5,  1, (p2 - 0.5f) * 24.0f, fxExpMap (p3, 200.0f, 5000.0f), fxExpMap (p5, 0.3f, 4.0f));
            fxBiquad (db + 10, 2, (p4 - 0.5f) * 24.0f, 8000.0f, 0.7f);
        }
        else if (ty == 11)
        {
            // compressor: threshold (linear), gain-curve exponent, attack / release coefficients, make-up gain
            float ratio = 1.0f + 19.0f * p2 * p2;
            fxD.at (db)     = float (pow (10.0f, (-60.0f + 60.0f * p1) / 20.0f));
            fxD.at (db + 1) = 1.0f / ratio - 1.0f;
            fxD.at (db + 2) = float (exp (-1.0f / (sr * 0.001f * fxExpMap (p3, 0.1f, 100.0f))));
            fxD.at (db + 3) = float (exp (-1.0f / (sr * 0.001f * fxExpMap (p4, 10.0f, 1000.0f))));
            fxD.at (db + 4) = float (pow (10.0f, 24.0f * p5 / 20.0f));
        }
    }

    // ---------------- one function per effect: returns the processed ("wet") signal ----------------

    float<2> fxDist (int s, float<2> x)
    {
        int   fb = s * 40;
        int   db = s * 16;
        int   al = fxMode.at (s);
        float d  = fxD.at (db);
        float a  = fxD.at (db + 1);
        float g  = fxD.at (db + 2);

        float yl = shapeSigAlg (x[0] * 0.5f, d, al) * 2.0f;
        float yr = shapeSigAlg (x[1] * 0.5f, d, al) * 2.0f;

        float tl = fxF.at (fb)     + a * (yl - fxF.at (fb));
        float tr = fxF.at (fb + 1) + a * (yr - fxF.at (fb + 1));
        fxF.at (fb)     = tl;
        fxF.at (fb + 1) = tr;

        return float<2> (tl * g, tr * g);
    }

    float<2> fxCrush (int s, float<2> x)
    {
        int fb  = s * 40;
        int ib  = s * 24;
        int db  = s * 16;
        int cnt = fxI.at (ib) + 1;

        if (cnt >= int (fxD.at (db + 1)))
        {
            cnt = 0;
            fxF.at (fb)     = x[0];
            fxF.at (fb + 1) = x[1];
        }

        fxI.at (ib) = cnt;

        float yl = fxF.at (fb);
        float yr = fxF.at (fb + 1);

        if (fxD.at (db) < 15.5f)
        {
            float lv = fxD.at (db + 2);
            yl = rint (yl * lv) / lv;
            yr = rint (yr * lv) / lv;
        }

        return float<2> (yl, yr);
    }

    float<2> fxDelay (int s, float<2> x)
    {
        int   fb  = s * 40;
        int   ib  = s * 24;
        int   pb  = s * 4;
        int   db  = s * 16;
        int   ab  = s * 196608;
        float sr  = float (processor.frequency);
        int   dty = fxMode.at (s);

        float target = fxD.at (db);
        float cur    = fxF.at (fb + 2);

        if (fxI.at (ib + 1) == 0)
        {
            cur = target;
            fxI.at (ib + 1) = 1;
        }

        cur += (target - cur) * 0.0005f;
        fxF.at (fb + 2) = cur;

        float tapeMod = 0.0f;
        if (dty == 1)
        {
            float64 t1 = fxPh.at (pb)     + 0.55 * processor.period;
            float64 t2 = fxPh.at (pb + 1) + 6.3  * processor.period;
            if (t1 >= 1.0) t1 -= 1.0;
            if (t2 >= 1.0) t2 -= 1.0;
            fxPh.at (pb)     = t1;
            fxPh.at (pb + 1) = t2;
            tapeMod = (0.0004f * float (sin (float (twoPi) * float (t1))) + 0.00008f * float (sin (float (twoPi) * float (t2)))) * sr;
        }

        int   wp   = fxI.at (ib);
        float rpos = float (wp) - cur - tapeMod;
        if (rpos < 0.0f) rpos += 98304.0f;

        int i0 = clamp (int (rpos), 0, 98303);
        int i1 = i0 + 1;
        if (i1 >= 98304) i1 = 0;
        float fr = rpos - float (i0);

        float dl = fxArena.at (ab + i0)         * (1.0f - fr) + fxArena.at (ab + i1)         * fr;
        float dr = fxArena.at (ab + 98304 + i0) * (1.0f - fr) + fxArena.at (ab + 98304 + i1) * fr;

        float dampA = fxD.at (db + 2);
        float sL = fxF.at (fb)     + dampA * (dl - fxF.at (fb));
        float sR = fxF.at (fb + 1) + dampA * (dr - fxF.at (fb + 1));
        fxF.at (fb)     = sL;
        fxF.at (fb + 1) = sR;

        float ping    = fxD.at (db + 3);
        float fbSameL = sL * (1.0f - ping) + sR * ping;
        float fbSameR = sR * (1.0f - ping) + sL * ping;
        float fbSendL = fbSameL;
        float fbSendR = fbSameR;

        if (dty == 1)
        {
            // tape: saturating feedback path
            fbSendL = softClip (fbSameL * 1.6f) * 0.625f;
            fbSendR = softClip (fbSameR * 1.6f) * 0.625f;
        }

        float fbk = fxD.at (db + 1);
        fxArena.at (ab + wp)         = x[0] + fbSendL * fbk;
        fxArena.at (ab + 98304 + wp) = x[1] + fbSendR * fbk;

        float dl2 = 0.0f;
        float dr2 = 0.0f;
        if (dty == 2)
        {
            // dual: extra tap at half the delay time
            float rpos2 = float (wp) - cur * 0.5f;
            if (rpos2 < 0.0f) rpos2 += 98304.0f;
            int j0 = clamp (int (rpos2), 0, 98303);
            int j1 = j0 + 1;
            if (j1 >= 98304) j1 = 0;
            float jf = rpos2 - float (j0);
            dl2 = (fxArena.at (ab + j0)         * (1.0f - jf) + fxArena.at (ab + j1)         * jf) * 0.6f;
            dr2 = (fxArena.at (ab + 98304 + j0) * (1.0f - jf) + fxArena.at (ab + 98304 + j1) * jf) * 0.6f;
        }

        wp += 1;
        if (wp >= 98304) wp = 0;
        fxI.at (ib) = wp;

        return float<2> (x[0] + dl + dl2, x[1] + dr + dr2);
    }

    float<2> fxChorus (int s, float<2> x)
    {
        int   fb   = s * 40;
        int   ib   = s * 24;
        int   pb   = s * 4;
        int   db   = s * 16;
        int   ab   = s * 196608;
        float sr   = float (processor.frequency);
        int   mode = fxMode.at (s);

        float64 ph = fxPh.at (pb) + float64 (fxD.at (db)) * processor.period;
        if (ph >= 1.0) ph -= 1.0;
        fxPh.at (pb) = ph;

        float chPhL = float (ph);
        float chPhR = chPhL + 0.25f;
        if (chPhR >= 1.0f) chPhR -= 1.0f;

        float chModL = float (sin (float (twoPi) * chPhL));
        float chModR = float (sin (float (twoPi) * chPhR));
        float chBase = 0.011f;
        float chDep  = 0.006f;
        if (mode == 1) { chBase = 0.0065f; chDep = 0.0016f; }
        if (mode == 2) { chBase = 0.007f;  chDep = 0.0045f; }

        float depth = fxD.at (db + 1);
        float chDlyL = (chBase + chDep * depth * chModL) * sr;
        float chDlyR = (chBase + chDep * depth * chModR) * sr;

        int pos = fxI.at (ib);
        fxArena.at (ab + pos)        = x[0] + fxF.at (fb)     * fxD.at (db + 2);
        fxArena.at (ab + 8192 + pos) = x[1] + fxF.at (fb + 1) * fxD.at (db + 2);

        float rdL = float (pos) - chDlyL;
        if (rdL < 0.0f) rdL += 8192.0f;
        float rdR = float (pos) - chDlyR;
        if (rdR < 0.0f) rdR += 8192.0f;

        int l0 = clamp (int (rdL), 0, 8191);
        int l1 = l0 + 1;
        if (l1 >= 8192) l1 = 0;
        int r0 = clamp (int (rdR), 0, 8191);
        int r1 = r0 + 1;
        if (r1 >= 8192) r1 = 0;
        float frL = rdL - float (l0);
        float frR = rdR - float (r0);

        float wetL = fxArena.at (ab + l0)        * (1.0f - frL) + fxArena.at (ab + l1)        * frL;
        float wetR = fxArena.at (ab + 8192 + r0) * (1.0f - frR) + fxArena.at (ab + 8192 + r1) * frR;

        fxF.at (fb)     = wetL;
        fxF.at (fb + 1) = wetR;

        pos += 1;
        if (pos >= 8192) pos = 0;
        fxI.at (ib) = pos;

        // vibrato: pitch modulation only, the wet signal replaces the dry one
        if (mode == 2)
            return float<2> (wetL, wetR);

        return float<2> (x[0] * 0.6f + wetL * 0.7f, x[1] * 0.6f + wetR * 0.7f);
    }

    float<2> fxFlanger (int s, float<2> x)
    {
        int   fb = s * 40;
        int   ib = s * 24;
        int   pb = s * 4;
        int   db = s * 16;
        int   ab = s * 196608;
        float sr = float (processor.frequency);

        float64 ph = fxPh.at (pb) + float64 (fxD.at (db)) * processor.period;
        if (ph >= 1.0) ph -= 1.0;
        fxPh.at (pb) = ph;

        float flMod = 0.5f + 0.5f * float (sin (float (twoPi) * float (ph)));
        float flDly = clamp ((0.0008f + 0.0042f * fxD.at (db + 1) * flMod) * sr, 2.0f, 4000.0f);

        int pos = fxI.at (ib);
        fxArena.at (ab + pos)        = x[0] + fxF.at (fb)     * fxD.at (db + 2);
        fxArena.at (ab + 4096 + pos) = x[1] + fxF.at (fb + 1) * fxD.at (db + 2);

        float rd = float (pos) - flDly;
        if (rd < 0.0f) rd += 4096.0f;
        int f0 = clamp (int (rd), 0, 4095);
        int f1 = f0 + 1;
        if (f1 >= 4096) f1 = 0;
        float fr = rd - float (f0);

        float wetL = fxArena.at (ab + f0)        * (1.0f - fr) + fxArena.at (ab + f1)        * fr;
        float wetR = fxArena.at (ab + 4096 + f0) * (1.0f - fr) + fxArena.at (ab + 4096 + f1) * fr;

        fxF.at (fb)     = wetL;
        fxF.at (fb + 1) = wetR;

        pos += 1;
        if (pos >= 4096) pos = 0;
        fxI.at (ib) = pos;

        return float<2> (x[0] * 0.5f + wetL * 0.6f, x[1] * 0.5f + wetR * 0.6f);
    }

    float<2> fxPhaser (int s, float<2> x)
    {
        int   fb = s * 40;
        int   pb = s * 4;
        int   db = s * 16;
        float sr = float (processor.frequency);

        float64 ph = fxPh.at (pb) + float64 (fxD.at (db)) * processor.period;
        if (ph >= 1.0) ph -= 1.0;
        fxPh.at (pb) = ph;

        float phMod  = 0.5f + 0.5f * float (sin (float (twoPi) * float (ph)));
        float phFreq = clamp (200.0f * float (pow (2.0f, phMod * 4.0f * (0.3f + 0.7f * fxD.at (db + 1)))), 20.0f, sr * 0.45f);
        float phTan  = float (tan (float64 (phFreq) * pi * processor.period));
        float phCoef = (1.0f - phTan) / (1.0f + phTan);

        float xL = x[0] + fxF.at (fb)     * fxD.at (db + 2);
        float xR = x[1] + fxF.at (fb + 1) * fxD.at (db + 2);

        int stages = 2 * (fxMode.at (s) + 1);
        for (int ps = 0; ps < stages; ++ps)
        {
            float yL = phCoef * xL + fxF.at (fb + 2 + ps);
            fxF.at (fb + 2 + ps) = xL - phCoef * yL;
            xL = yL;

            float yR = phCoef * xR + fxF.at (fb + 10 + ps);
            fxF.at (fb + 10 + ps) = xR - phCoef * yR;
            xR = yR;
        }

        fxF.at (fb)     = clamp (xL, -4.0f, 4.0f);
        fxF.at (fb + 1) = clamp (xR, -4.0f, 4.0f);

        return float<2> (x[0] * 0.5f + xL * 0.5f, x[1] * 0.5f + xR * 0.5f);
    }

    float<2> fxTrem (int s, float<2> x)
    {
        int pb = s * 4;
        int db = s * 16;

        float64 ph = fxPh.at (pb) + float64 (fxD.at (db)) * processor.period;
        if (ph >= 1.0) ph -= 1.0;
        fxPh.at (pb) = ph;

        float pL = float (ph);
        float pR = pL + 0.5f * fxD.at (db + 2);
        if (pR >= 1.0f) pR -= 1.0f;

        int   wv = fxMode.at (s);
        float lL = 0.0f;
        float lR = 0.0f;

        if (wv == 0)
        {
            lL = 0.5f - 0.5f * float (sin (float (twoPi) * pL));
            lR = 0.5f - 0.5f * float (sin (float (twoPi) * pR));
        }
        else if (wv == 1)
        {
            lL = abs (2.0f * pL - 1.0f);
            lR = abs (2.0f * pR - 1.0f);
        }
        else if (wv == 2)
        {
            if (pL < 0.5f) lL = 0.0f; else lL = 1.0f;
            if (pR < 0.5f) lR = 0.0f; else lR = 1.0f;
        }
        else if (wv == 3)
        {
            lL = 1.0f - pL;
            lR = 1.0f - pR;
        }
        else
        {
            lL = pL;
            lR = pR;
        }

        float depth = fxD.at (db + 1);
        return float<2> (x[0] * (1.0f - depth * lL), x[1] * (1.0f - depth * lR));
    }

    float<2> fxReverb (int s, float<2> x)
    {
        int   fb = s * 40;
        int   ib = s * 24;
        int   db = s * 16;
        int   ab = s * 196608;
        float dt = float (processor.period);

        float rvFb   = fxD.at (db);
        float rvDamp = fxD.at (db + 1);
        float preS   = fxD.at (db + 2);
        float rvW    = fxD.at (db + 3);

        // DC blocker on the input: a DC offset would be amplified by the comb feedback
        float monoRaw = (x[0] + x[1]) * 0.5f * 0.03f;
        float hpA     = 1.0f - clamp (float (twoPi) * 60.0f * dt, 0.0001f, 0.5f);
        float rvMono  = monoRaw - fxF.at (fb) + hpA * fxF.at (fb + 1);
        fxF.at (fb)     = monoRaw;
        fxF.at (fb + 1) = rvMono;

        int pdPos = fxI.at (ib);
        fxArena.at (ab + 81920 + pdPos) = rvMono;
        float pdRd = float (pdPos) - preS;
        if (pdRd < 0.0f) pdRd += 8192.0f;
        float rvIn = fxArena.at (ab + 81920 + clamp (int (pdRd), 0, 8191));
        pdPos += 1;
        if (pdPos >= 8192) pdPos = 0;
        fxI.at (ib) = pdPos;

        float rvScale = 1.0f;
        float rvFbE   = rvFb;
        float rvDmpE  = rvDamp;
        int   rvTy    = fxMode.at (s);
        if (rvTy == 1) { rvScale = 0.35f; rvFbE = rvFb * 0.88f; }
        if (rvTy == 2) { rvScale = 0.6f;  rvDmpE = rvDamp * 0.45f; }
        if (rvTy == 3) { rvScale = 2.2f;  rvFbE = min (rvFb + 0.01f, 0.985f); }

        float rvL = 0.0f;
        float rvR = 0.0f;

        for (int rc = 0; rc < 8; ++rc)
        {
            int   rp = fxI.at (ib + 1 + rc);
            int   ci = ab + rc * 8192 + rp;
            float rd = fxArena.at (ci);
            float st = rd * (1.0f - rvDmpE) + fxF.at (fb + 6 + rc) * rvDmpE;

            fxF.at (fb + 6 + rc) = st;
            fxArena.at (ci)      = rvIn + st * rvFbE;

            rp += 1;
            int rvCl = clamp (int (float (combLen.at (rc)) * rvScale), 16, 8191);
            if (rp >= rvCl) rp = 0;
            fxI.at (ib + 1 + rc) = rp;

            if (rc < 4) rvL += rd;
            else        rvR += rd;
        }

        for (int ra = 0; ra < 4; ++ra)
        {
            int   ap   = fxI.at (ib + 9 + ra);
            int   ai   = ab + 65536 + ra * 4096 + ap;
            float abuf = fxArena.at (ai);
            float ax   = rvL;
            if (ra >= 2) ax = rvR;

            float ay = abuf - ax;
            fxArena.at (ai) = ax + abuf * 0.5f;

            ap += 1;
            if (ap >= apLen.at (ra)) ap = 0;
            fxI.at (ib + 9 + ra) = ap;

            if (ra < 2) rvL = ay;
            else        rvR = ay;
        }

        float rvMid  = (rvL + rvR) * 0.5f;
        float rvSide = (rvL - rvR) * 0.5f * rvW;
        float rawL   = rvMid + rvSide;
        float rawR   = rvMid - rvSide;

        // DC blocker on the output (removes any offset left in the tail)
        float outA = 1.0f - clamp (float (twoPi) * 8.0f * dt, 0.0001f, 0.5f);
        float oL   = rawL - fxF.at (fb + 2) + outA * fxF.at (fb + 3);
        float oR   = rawR - fxF.at (fb + 4) + outA * fxF.at (fb + 5);
        fxF.at (fb + 2) = rawL;
        fxF.at (fb + 3) = oL;
        fxF.at (fb + 4) = rawR;
        fxF.at (fb + 5) = oR;

        return float<2> (x[0] + oL * 3.0f, x[1] + oR * 3.0f);
    }

    // one channel of a state-variable filter (Cytomic TPT form); fb is the slot's float state base
    // one-pole TPT low-pass stage (state at fxF[idx])
    float fxOnePole (int idx, float x, float g)
    {
        float gg = g / (1.0f + g);
        float st = fxF.at (idx);
        float v  = (x - st) * gg;
        float lp = v + st;
        fxF.at (idx) = lp + v;
        return lp;
    }

    // one TPT state-variable stage (states at fxF[idx], fxF[idx+1]); mode 0 LP, 1 BP, 2 HP, 3 notch, 4 allpass
    float fxSvfStage (int idx, float x, float g, float k, int mode)
    {
        float a1 = 1.0f / (1.0f + g * (g + k));
        float a2 = g * a1;
        float a3 = g * a2;
        float s1 = fxF.at (idx);
        float s2 = fxF.at (idx + 1);
        float v3 = x - s2;
        float v1 = a1 * s1 + a2 * v3;
        float v2 = s2 + a2 * s1 + a3 * v3;

        fxF.at (idx)     = 2.0f * v1 - s1;
        fxF.at (idx + 1) = 2.0f * v2 - s2;

        if (mode == 1) return v1 * k;
        if (mode == 2) return x - k * v1 - v2;
        if (mode == 3) return x - k * v1;
        if (mode == 4) return x - 2.0f * k * v1;
        return v2;
    }

    // the 30 filter types of the Filter page (same maths as the voice filter), on one channel of rack slot s
    float fxFilterX (int s, int ch, float x, float g, float k, float res, float fc, int ft)
    {
        int   b  = s * 40 + ch * 16;
        int   pb = s * 4;
        int   ib = s * 24;
        float sr = float (processor.frequency);

        if (ft == 0)  return fxSvfStage (b + 2, fxSvfStage (b, x, g, k, 0), g, 1.2f, 0);
        if (ft == 1)  return fxSvfStage (b, x, g, k, 0);
        if (ft == 2)  return fxSvfStage (b, x, g, k, 2);
        if (ft == 3)  return fxSvfStage (b, x, g, k, 1);
        if (ft == 4)  return fxOnePole (b, x, g);
        if (ft == 5)  return fxSvfStage (b + 2, fxOnePole (b, x, g), g, k, 0);
        if (ft == 6)  return x - fxOnePole (b, x, g);
        if (ft == 7)  return fxSvfStage (b + 2, x - fxOnePole (b, x, g), g, k, 2);
        if (ft == 8)  return fxSvfStage (b + 2, fxSvfStage (b, x, g, k, 2), g, 1.2f, 2);
        if (ft == 9)  return fxSvfStage (b + 2, fxSvfStage (b, x, g, k, 1), g, k, 1);
        if (ft == 10) return fxSvfStage (b, x, g, k, 3);
        if (ft == 11) return fxSvfStage (b + 2, fxSvfStage (b, x, g, k, 3), g, k, 3);
        if (ft == 12) return x + res * 4.0f * fxSvfStage (b, x, g, 0.6f, 1);
        if (ft == 13) return x + res * 3.0f * fxSvfStage (b, x, g, 1.4f, 0);
        if (ft == 14) return x + res * 3.0f * fxSvfStage (b, x, g, 1.4f, 2);
        if (ft == 15) return fxSvfStage (b, x, g, k, 4);

        if (ft >= 16 && ft <= 18)
        {
            // ladder family: four (three for Acid) one-pole stages with resonance feedback
            float kr = res * 3.9f;
            if (ft == 17) kr = res * 3.2f;
            if (ft == 18) kr = res * 3.6f;

            float y4p = fxF.at (b + 4);
            float u   = softClip (x - kr * y4p);
            float y1  = fxOnePole (b, u, g);
            float y2  = fxOnePole (b + 1, y1, g);
            float y3  = fxOnePole (b + 2, y2, g);

            if (ft == 18)
            {
                fxF.at (b + 4) = y3;
                return y3 * (1.0f + res);
            }

            float y4 = fxOnePole (b + 3, y3, g);
            fxF.at (b + 4) = y4;

            if (ft == 17) return (y3 + y4) * 0.5f;
            return y4 * (1.0f + 0.4f * kr);   // bass makeup for the resonance feedback
        }

        if (ft == 19)
        {
            // dirty low-pass: two saturated 12 dB stages
            float t = fxSvfStage (b, softClip (x * 2.0f), g, k, 0);
            return fxSvfStage (b + 2, softClip (t * 1.5f), g, 1.2f, 0) * 1.3f;
        }

        if (ft == 20 || ft == 21)
        {
            // comb filter (positive / negative feedback), delay = one cycle of the cutoff
            float dly = clamp (sr / max (fc, 20.0f), 2.0f, 2040.0f);
            int   di  = int (dly);
            float fr  = dly - float (di);
            int   w   = fxI.at (ib);
            int   cb  = s * 196608 + ch * 2048;
            int   r0  = (w - di) & 2047;
            int   r1  = (w - di - 1) & 2047;
            float d   = fxArena.at (cb + r0) * (1.0f - fr) + fxArena.at (cb + r1) * fr;
            float fb  = res * 0.97f;
            if (ft == 21) fb = -fb;

            float yc = x + fb * d;
            fxArena.at (cb + w) = yc;
            return yc * 0.7f;
        }

        if (ft >= 24 && ft <= 27)
        {
            // MG Low 6/12/18/24: Moog-style ladder with the output tapped after stage 1/2/3/4
            float kr  = res * 3.9f;
            float y4p = fxF.at (b + 4);
            float u   = softClip (x * 1.2f - kr * y4p);
            float y1  = fxOnePole (b, u, g);
            float y2  = fxOnePole (b + 1, y1, g);
            float y3  = fxOnePole (b + 2, y2, g);
            float y4  = fxOnePole (b + 3, y3, g);
            fxF.at (b + 4) = y4;

            float mk = 1.1f * (1.0f + 0.4f * kr);
            if (ft == 24) return y1 * mk;
            if (ft == 25) return y2 * mk;
            if (ft == 26) return y3 * mk;
            return y4 * mk;
        }

        if (ft == 28 || ft == 29)
        {
            // Flange+ / Flange-: comb filter whose delay is swept by a slow internal LFO
            float sweep = 1.0f + 0.5f * float (sin (fxPh.at (pb) * 2.0 * pi));
            float dly   = clamp (sr / max (fc, 20.0f) * sweep, 2.0f, 2040.0f);
            int   di    = int (dly);
            float fr    = dly - float (di);
            int   w     = fxI.at (ib);
            int   cb    = s * 196608 + ch * 2048;
            int   r0    = (w - di) & 2047;
            int   r1    = (w - di - 1) & 2047;
            float d     = fxArena.at (cb + r0) * (1.0f - fr) + fxArena.at (cb + r1) * fr;
            float fb    = res * 0.95f;
            if (ft == 29) fb = -fb;

            float yc = x + fb * d;
            fxArena.at (cb + w) = yc;
            return yc * 0.7f;
        }

        if (ft == 22)
        {
            // phaser: four all-pass stages with feedback
            float fbk = res * 0.85f;
            float a   = x + fbk * fxF.at (b + 8);

            a = 2.0f * fxOnePole (b,     a, g) - a;
            a = 2.0f * fxOnePole (b + 1, a, g) - a;
            a = 2.0f * fxOnePole (b + 2, a, g) - a;
            a = 2.0f * fxOnePole (b + 3, a, g) - a;

            fxF.at (b + 8) = a;
            return 0.5f * (x + a);
        }

        // 23: vowel / formant filter, cutoff sweeps A-E-I-O-U
        float p  = clamp (float (log (max (fc, 100.0f) / 100.0f)) / float (log (30.0f)), 0.0f, 1.0f) * 4.0f;
        int   v0 = clamp (int (p), 0, 3);
        float vf = p - float (v0);
        float kq = 2.0f - 1.96f * clamp (0.5f + res * 0.45f, 0.0f, 0.98f);
        float acc = 0.0f;

        float f0 = vowelFreq (v0, 0) * (1.0f - vf) + vowelFreq (v0 + 1, 0) * vf;
        float f1 = vowelFreq (v0, 1) * (1.0f - vf) + vowelFreq (v0 + 1, 1) * vf;
        float f2 = vowelFreq (v0, 2) * (1.0f - vf) + vowelFreq (v0 + 1, 2) * vf;

        acc += fxSvfStage (b,     x, float (tan (float64 (f0) * pi / float64 (sr))), kq, 1);
        acc += fxSvfStage (b + 2, x, float (tan (float64 (f1) * pi / float64 (sr))), kq, 1) * 0.7f;
        acc += fxSvfStage (b + 4, x, float (tan (float64 (f2) * pi / float64 (sr))), kq, 1) * 0.5f;

        return acc * 1.4f;
    }

    float<2> fxFilter (int s, float<2> x)
    {
        int   db  = s * 16;
        int   pb  = s * 4;
        int   ib  = s * 24;
        int   ft  = fxMode.at (s);
        float gd  = fxD.at (db + 4);
        float inL = x[0];
        float inR = x[1];

        if (gd > 1.01f)
        {
            inL = softClip (inL * gd);
            inR = softClip (inR * gd);
        }

        float g   = fxD.at (db);
        float k   = fxD.at (db + 1);
        float res = fxD.at (db + 2);
        float fc  = fxD.at (db + 3);

        float yl = fxFilterX (s, 0, inL, g, k, res, fc, ft);
        float yr = fxFilterX (s, 1, inR, g, k, res, fc, ft);

        // comb / flange write position and the flange sweep advance once per sample
        fxI.at (ib) = (fxI.at (ib) + 1) & 2047;
        float64 ph = fxPh.at (pb) + 0.3 * processor.period;
        if (ph >= 1.0) ph -= 1.0;
        fxPh.at (pb) = ph;

        return float<2> (yl, yr);
    }

    float<2> fxEq (int s, float<2> x)
    {
        int   fb = s * 40;
        int   db = s * 16;
        float yl = x[0];
        float yr = x[1];

        for (int b = 0; b < 3; ++b)
        {
            int   ci = db + b * 5;
            int   zi = fb + b * 4;
            float c0 = fxD.at (ci);
            float c1 = fxD.at (ci + 1);
            float c2 = fxD.at (ci + 2);
            float c3 = fxD.at (ci + 3);
            float c4 = fxD.at (ci + 4);

            float xin = yl;
            float yo  = c0 * xin + fxF.at (zi);
            fxF.at (zi)     = c1 * xin - c3 * yo + fxF.at (zi + 1);
            fxF.at (zi + 1) = c2 * xin - c4 * yo;
            yl = yo;

            xin = yr;
            yo  = c0 * xin + fxF.at (zi + 2);
            fxF.at (zi + 2) = c1 * xin - c3 * yo + fxF.at (zi + 3);
            fxF.at (zi + 3) = c2 * xin - c4 * yo;
            yr = yo;
        }

        return float<2> (yl, yr);
    }

    float<2> fxComp (int s, float<2> x)
    {
        int   fb    = s * 40;
        int   db    = s * 16;
        bool  rms   = fxMode.at (s) == 1;
        float th    = max (fxD.at (db), 0.00001f);
        float det   = max (abs (x[0]), abs (x[1]));
        if (rms) det = det * det;

        float env = fxF.at (fb);
        if (det > env) env = fxD.at (db + 2) * env + (1.0f - fxD.at (db + 2)) * det;
        else           env = fxD.at (db + 3) * env + (1.0f - fxD.at (db + 3)) * det;
        fxF.at (fb) = env;

        float lvl = env;
        if (rms) lvl = float (sqrt (env));

        float gain = 1.0f;
        if (lvl > th)
            gain = float (pow (lvl / th, fxD.at (db + 1)));

        return x * (gain * fxD.at (db + 4));
    }

    // One slot: dry/wet mix of the selected effect; empty and bypassed slots pass the signal through untouched
    float<2> fxRunSlot (int s, float<2> x)
    {
        int ty = fxType.at (s);

        if (ty == 0 || fxOn.at (s) < 0.5f)
            return x;

        if (fxDirty.at (s))
        {
            fxDerive (s);
            fxDirty.at (s) = false;
        }

        float<2> y = x;

        if (ty == 1)       y = fxDist   (s, x);
        else if (ty == 2)  y = fxCrush  (s, x);
        else if (ty == 3)  y = fxDelay  (s, x);
        else if (ty == 4)  y = fxChorus (s, x);
        else if (ty == 5)  y = fxFlanger (s, x);
        else if (ty == 6)  y = fxPhaser (s, x);
        else if (ty == 7)  y = fxTrem   (s, x);
        else if (ty == 8)  y = fxReverb (s, x);
        else if (ty == 9)  y = fxFilter (s, x);
        else if (ty == 10) y = fxEq     (s, x);
        else if (ty == 11) y = fxComp   (s, x);

        float mix = clamp (fxMix.at (s), 0.0f, 1.0f);
        return x + (y - x) * mix;
    }

    // The whole rack, in the user's order
    float<2> fxRunRack (int rk, float<2> x)
    {
        float<2> v = x;

        for (int k = 0; k < 10; ++k)
            v = fxRunSlot (rk * 10 + fxSeq.at (rk * 10 + k), v);

        return v;
    }

    // Start-up values of the rack (every slot empty, on, 100 % mix, identity order)
    void fxInit()
    {
        for (int s = 0; s < 30; ++s)
        {
            fxType.at (s)  = 0;
            fxOn.at (s)    = 1.0f;
            fxMix.at (s)   = 1.0f;
            fxMode.at (s)  = 0;
            fxDirty.at (s) = true;
            fxOrder.at (s) = s - (s / 10) * 10;
            fxSeq.at (s)   = s - (s / 10) * 10;

            for (int k = 0; k < 6; ++k)
                fxP.at (s * 6 + k) = 0.5f;
        }
    }

    // ---------------- MIXER EQ HELPERS (processor scope) ----------------

    // ---------------- SAMPLE MEMORY HELPERS (processor scope) ----------------

    // ---------------- SAMPLER 2 MEMORY HELPERS (processor scope) ----------------

    // ---------------- WAVETABLE MEMORY HELPERS (processor scope) ----------------

    // ---------------- WAVETABLE 2 MEMORY HELPERS (processor scope) ----------------

    // ---------------- WAVETABLE 3 MEMORY HELPERS (processor scope) ----------------

    // ---------------- WAVETABLE UNISON HELPERS (processor scope) ----------------

    // Fixed pseudo-random position (-1..1) of a unison voice, used by the Random unison style
    float uniRandPos (int e, int j)
    {
        float s = float (sin (float (j * 7 + e * 13 + 1) * 12.9898f)) * 43758.5453f;
        return 2.0f * (s - float (floor (s))) - 1.0f;
    }

    // Phase warp (modes 1-6) of one warp slot: maps the 0..1 oscillator phase to the table read phase
    float wtWarpPhase (int mode, float amt, float ph)
    {
        if (mode == 1)
            return float (pow (ph, 1.0f + 3.0f * amt));                    // bend +

        if (mode == 2)
            return 1.0f - float (pow (1.0f - ph, 1.0f + 3.0f * amt));      // bend -

        if (mode == 3)
        {
            float x = ph * (1.0f + 7.0f * amt);                           // sync
            return x - float (floor (x));
        }

        if (mode == 4)
        {
            float w = 0.5f - 0.45f * amt;                                 // pulse width
            if (ph < w) return ph * 0.5f / w;
            return 0.5f + (ph - w) * 0.5f / (1.0f - w);
        }

        if (mode == 5)
        {
            float x = ph * (1.0f + amt);                                  // mirror
            if (x > 1.0f) x = 2.0f - x;
            return clamp (x, 0.0f, 1.0f);
        }

        if (mode == 6)
            return ph * (1.0f - amt) + (1.0f - ph) * amt;                 // flip

        return ph;
    }

    // Amplitude warp (modes 7-8) of one warp slot
    float wtWarpAmp (int mode, float amt, float y)
    {
        if (mode == 7)
        {
            float s = 2.0f + (1.0f - amt) * 254.0f;                       // quantize
            return float (floor (y * s + 0.5f)) / s;
        }

        if (mode == 8)
            return y * (1.0f - amt) + amt * float (sin (y * (1.0f + 4.0f * amt) * 1.5708f));   // fold

        return y;
    }

    float nextNoise()
    {
        noiseState = (noiseState * 1103515245 + 12345) & 0x7fffffff;
        return (float (noiseState) / 2147483647.0f) * 2.0f - 1.0f;
    }

    // ---------------- MOD PAGE HELPERS (processor scope) ----------------

    // Advances all 10 mod LFOs by one sample; outputs are bipolar -1..1 in mLfoV
    // LFO frequency of a sync division at the current tempo
    float syncHz (float divIdx)
    {
        float bpm = hostBpm;
        if (syncBpmOver > 1.0f) bpm = syncBpmOver;
        return (bpm / 60.0f) / divBeats.at (clamp (int (divIdx + 0.5f), 0, 17));
    }

    // Reads the drawn shape of LFO m at phase p (0..1); looping shapes interpolate from the last point back to the first
    float lfoTabRead (int m, float p, bool wrapEnd)
    {
        float pos = clamp (p, 0.0f, 1.0f) * 256.0f;
        int   i0  = int (pos);
        float fr  = pos - float (i0);
        int   i1  = i0 + 1;

        if (i0 > 255)
        {
            i0 = 255;
            fr = 0.0f;
        }

        if (i1 > 255)
        {
            if (wrapEnd) i1 = 0;
            else      i1 = 255;
        }

        return lfoTab.at (m * 256 + i0) * (1.0f - fr) + lfoTab.at (m * 256 + i1) * fr;
    }

    // Output of LFO m at phase p: waves 0-5 are the built-in shapes, 6 is the drawn table
    float lfoWaveVal (int m, float p, float sh, bool wrapEnd)
    {
        int w = int (mLfoWave.at (m) + 0.5f);

        if (w == 0)
            return float (sin (float (twoPi) * p));
        if (w == 1)
            return 4.0f * abs (p - 0.5f) - 1.0f;
        if (w == 2)
        {
            if (p < 0.5f) return 1.0f;
            return -1.0f;
        }
        if (w == 3)
            return sh;
        if (w == 4)
            return 2.0f * p - 1.0f;
        if (w == 5)
            return 1.0f - 2.0f * p;

        return lfoTabRead (m, p, wrapEnd);
    }

    // one-pole lag of the Smooth control (0 = off, 1 = about 250 ms)
    float lfoLag (float state, float x, float smooth, float dtv)
    {
        if (smooth <= 0.001f)
            return x;

        return state + (x - state) * (1.0f - float (exp (-dtv / (0.0002f + smooth * 0.25f))));
    }

    float lfoRateHz (int m)
    {
        if (mLfoSync.at (m) > 0.5f)
            return syncHz (mLfoDiv.at (m));

        return mLfoRate.at (m);
    }

    // Free-running (global) LFOs: advances all 10 by one sample
    void updateModLfos (float dtv)
    {
        for (int m = 0; m < 10; ++m)
        {
            float64 np = mLfoPhase.at (m) + float64 (lfoRateHz (m)) * processor.period;
            if (np >= 1.0)
            {
                np -= 1.0;
                mLfoSh.at (m) = nextNoise();
            }
            mLfoPhase.at (m) = np;

            float p = float (np) + mLfoStart.at (m);
            if (p >= 1.0f) p -= 1.0f;

            float val = lfoWaveVal (m, p, mLfoSh.at (m), true);
            mLfoSm.at (m) = lfoLag (mLfoSm.at (m), val, mLfoSmooth.at (m), dtv);
            mLfoV.at (m)  = mLfoSm.at (m);
        }
    }

    // Per-voice LFOs (modes Trig and Env): phase restarts on note-on, Delay / Rise fade the output in, Env stops at the end of the shape
    void updateVoiceLfos (int vi, float dtv)
    {
        for (int m = 0; m < 10; ++m)
        {
            float mode = mLfoMode.at (m);
            if (mode < 0.5f)
                continue;

            bool    oneShot = mode > 1.5f;
            float   age     = voices.at (vi).lfoAge.at (m);
            bool    first   = age < 0.0f;
            float64 np      = voices.at (vi).lfoPh.at (m);

            if (first)
                age = 0.0f;
            else
            {
                age += dtv;
                np  += float64 (lfoRateHz (m)) * processor.period;

                if (np >= 1.0)
                {
                    if (oneShot)
                        np = 1.0;
                    else
                    {
                        np -= 1.0;
                        voices.at (vi).lfoSh.at (m) = nextNoise();
                    }
                }
            }

            voices.at (vi).lfoPh.at (m)  = np;
            voices.at (vi).lfoAge.at (m) = age;

            float p = float (np);
            if (! oneShot)
            {
                p += mLfoStart.at (m);
                if (p >= 1.0f) p -= 1.0f;
            }

            float val  = lfoWaveVal (m, p, voices.at (vi).lfoSh.at (m), ! oneShot);
            float fade = 1.0f;
            float dl   = mLfoDelay.at (m) * 0.001f;
            float rs   = mLfoRise.at (m) * 0.001f;

            if (age < dl)
                fade = 0.0f;
            else if (rs > 0.0001f)
                fade = clamp ((age - dl) / rs, 0.0f, 1.0f);

            val *= fade;

            float st = voices.at (vi).lfoSm.at (m);
            if (first)
                st = val;

            st = lfoLag (st, val, mLfoSmooth.at (m), dtv);
            voices.at (vi).lfoSm.at (m) = st;
            voices.at (vi).lfoV.at (m)  = st;
        }
    }

    // Moves the per-sample maxima of each mod envelope (across voices) into the global slot
    void rollEnvMax()
    {
        for (int m = 0; m < 10; ++m)
        {
            envMax.at (m)     = envMaxNext.at (m);
            envMaxNext.at (m) = 0.0f;
        }
    }

    // Advances the 10 mod envelopes of one voice by one sample
    void updateModEnvs (int vi, float dtv)
    {
        for (int m = 0; m < 10; ++m)
        {
            int   ms = voices.at (vi).mstage.at (m);
            float me = voices.at (vi).menv.at (m);

            if (ms == 1)
            {
                me += dtv / max (mEnvA.at (m) * 0.001f, 0.0005f);
                if (me >= 1.0f)
                {
                    me = 1.0f;
                    ms = 2;
                }
            }
            else if (ms == 2)
            {
                me += (mEnvS.at (m) - me) * clamp (dtv * 5.0f / (max (mEnvD.at (m), 1.0f) * 0.001f), 0.0f, 0.99f);
            }
            else if (ms == 3)
            {
                me -= me * clamp (dtv * 5.0f / (max (mEnvR.at (m), 1.0f) * 0.001f), 0.0f, 0.99f);
            }

            voices.at (vi).menv.at (m)   = me;
            voices.at (vi).mstage.at (m) = ms;

            if (me > envMaxNext.at (m))
                envMaxNext.at (m) = me;
        }
    }

    // Mod source value for a voice (1-10 LFO, 11-20 envelope, 21 velocity, 22 key, 23 random)
    float srcValueVoice (int src, int vi)
    {
        if (src >= 1 && src <= 10)
        {
            if (mLfoMode.at (src - 1) > 0.5f)
                return voices.at (vi).lfoV.at (src - 1);
            return mLfoV.at (src - 1);
        }
        if (src >= 11 && src <= 20)
            return voices.at (vi).menv.at (src - 11);
        if (src == 21)
            return voices.at (vi).velRaw;
        if (src == 22)
            return clamp ((float (voices.at (vi).noteNumber) - 60.0f) / 48.0f, -1.0f, 1.0f);
        if (src == 23)
            return voices.at (vi).modRand;
        return 0.0f;
    }

    // Mod source value for global destinations (envelopes use the loudest voice)
    float srcValueGlobal (int src)
    {
        if (src >= 1 && src <= 10)
        {
            if (mLfoMode.at (src - 1) > 0.5f)
                return voices.at (lastVoice).lfoV.at (src - 1);
            return mLfoV.at (src - 1);
        }
        if (src >= 11 && src <= 20)
            return envMax.at (src - 11);
        if (src == 21)
            return lastVelV;
        if (src == 22)
            return lastKeyV;
        if (src == 23)
            return lastRandV;
        return 0.0f;
    }

    // Sums the matrix for one voice into vmod[dest]
    void computeVoiceMod (int vi)
    {
        for (int d = 0; d < 64; ++d)
            vmod.at (d) = 0.0f;

        for (int s = 0; s < 20; ++s)
        {
            int dd = mmDstI.at (s);
            int ss = mmSrcI.at (s);
            if (dd > 0 && ss > 0)
                vmod.at (dd) += srcValueVoice (ss, vi) * mmAmt.at (s);
        }
    }

    // Sums the matrix for the global (post-voice) destinations into gmod[dest]
    void computeGlobalMod()
    {
        for (int d = 0; d < 64; ++d)
            gmod.at (d) = 0.0f;

        for (int s = 0; s < 20; ++s)
        {
            int dd = mmDstI.at (s);
            int ss = mmSrcI.at (s);
            if (dd > 0 && ss > 0)
                gmod.at (dd) += srcValueGlobal (ss) * mmAmt.at (s);
        }
    }

    // State-variable filter step for one channel (ch 0 = left states, ch 1 = right states)
    // one-pole TPT low-pass stage (state at fx[idx])
    float onePole (int vi, int idx, float x, float g)
    {
        float gg = g / (1.0f + g);
        float s  = voices.at (vi).fx.at (idx);
        float v  = (x - s) * gg;
        float lp = v + s;
        voices.at (vi).fx.at (idx) = lp + v;
        return lp;
    }

    // one TPT state-variable stage (states at fx[idx], fx[idx+1]); mode 0 LP, 1 BP, 2 HP, 3 notch, 4 allpass
    float svfStage (int vi, int idx, float x, float g, float k, int mode)
    {
        float a1 = 1.0f / (1.0f + g * (g + k));
        float a2 = g * a1;
        float a3 = g * a2;
        float s1 = voices.at (vi).fx.at (idx);
        float s2 = voices.at (vi).fx.at (idx + 1);
        float v3 = x - s2;
        float v1 = a1 * s1 + a2 * v3;
        float v2 = s2 + a2 * s1 + a3 * v3;

        voices.at (vi).fx.at (idx)     = 2.0f * v1 - s1;
        voices.at (vi).fx.at (idx + 1) = 2.0f * v2 - s2;

        if (mode == 1) return v1 * k;
        if (mode == 2) return x - k * v1 - v2;
        if (mode == 3) return x - k * v1;
        if (mode == 4) return x - 2.0f * k * v1;
        return v2;
    }

    float softClip (float x)
    {
        return x / (1.0f + abs (x));
    }

    // formant frequency (Hz) of vowel v (0 A, 1 E, 2 I, 3 O, 4 U), formant f (0..2)
    float vowelFreq (int v, int f)
    {
        if (v == 0) { if (f == 0) return 800.0f; if (f == 1) return 1150.0f; return 2900.0f; }
        if (v == 1) { if (f == 0) return 400.0f; if (f == 1) return 1600.0f; return 2700.0f; }
        if (v == 2) { if (f == 0) return 350.0f; if (f == 1) return 1700.0f; return 2700.0f; }
        if (v == 3) { if (f == 0) return 450.0f; if (f == 1) return 800.0f;  return 2830.0f; }
        if (f == 0) return 325.0f;
        if (f == 1) return 700.0f;
        return 2530.0f;
    }

    // Extra filter types (4-29) on one channel of a voice
    float filterStepX (int vi, int ch, int bank, float s, float g, float k, float res, float fc, int ft)
    {
        int   b  = bank * 32 + ch * 16;
        float sr = float (processor.frequency);

        if (ft == 0)  return svfStage (vi, b + 2, svfStage (vi, b, s, g, k, 0), g, 1.2f, 0);
        if (ft == 1)  return svfStage (vi, b, s, g, k, 0);
        if (ft == 2)  return svfStage (vi, b, s, g, k, 2);
        if (ft == 3)  return svfStage (vi, b, s, g, k, 1);
        if (ft == 4)  return onePole (vi, b, s, g);
        if (ft == 5)  return svfStage (vi, b + 2, onePole (vi, b, s, g), g, k, 0);
        if (ft == 6)  return s - onePole (vi, b, s, g);
        if (ft == 7)  return svfStage (vi, b + 2, s - onePole (vi, b, s, g), g, k, 2);
        if (ft == 8)  return svfStage (vi, b + 2, svfStage (vi, b, s, g, k, 2), g, 1.2f, 2);
        if (ft == 9)  return svfStage (vi, b + 2, svfStage (vi, b, s, g, k, 1), g, k, 1);
        if (ft == 10) return svfStage (vi, b, s, g, k, 3);
        if (ft == 11) return svfStage (vi, b + 2, svfStage (vi, b, s, g, k, 3), g, k, 3);
        if (ft == 12) return s + res * 4.0f * svfStage (vi, b, s, g, 0.6f, 1);
        if (ft == 13) return s + res * 3.0f * svfStage (vi, b, s, g, 1.4f, 0);
        if (ft == 14) return s + res * 3.0f * svfStage (vi, b, s, g, 1.4f, 2);
        if (ft == 15) return svfStage (vi, b, s, g, k, 4);

        if (ft >= 16 && ft <= 18)
        {
            // ladder family: four (three for Acid) one-pole stages with resonance feedback
            float kr = res * 3.9f;
            if (ft == 17) kr = res * 3.2f;
            if (ft == 18) kr = res * 3.6f;

            float y4p = voices.at (vi).fx.at (b + 4);
            float u   = softClip (s - kr * y4p);
            float y1  = onePole (vi, b, u, g);
            float y2  = onePole (vi, b + 1, y1, g);
            float y3  = onePole (vi, b + 2, y2, g);

            if (ft == 18)
            {
                voices.at (vi).fx.at (b + 4) = y3;
                return y3 * (1.0f + res);
            }

            float y4 = onePole (vi, b + 3, y3, g);
            voices.at (vi).fx.at (b + 4) = y4;

            if (ft == 17) return (y3 + y4) * 0.5f;
            return y4 * (1.0f + 0.4f * kr);   // bass makeup for the resonance feedback
        }

        if (ft == 19)
        {
            // dirty low-pass: two saturated 12 dB stages
            float t = svfStage (vi, b, softClip (s * 2.0f), g, k, 0);
            return svfStage (vi, b + 2, softClip (t * 1.5f), g, 1.2f, 0) * 1.3f;
        }

        if (ft == 20 || ft == 21)
        {
            // comb filter (positive / negative feedback), delay = one cycle of the cutoff
            float dly = clamp (sr / max (fc, 20.0f), 2.0f, 2040.0f);
            int   di  = int (dly);
            float fr  = dly - float (di);
            int   w   = voices.at (vi).fdlW;
            int   cb  = bank * 4096 + ch * 2048;
            int   r0  = (w - di) & 2047;
            int   r1  = (w - di - 1) & 2047;
            float d   = voices.at (vi).fdl.at (cb + r0) * (1.0f - fr) + voices.at (vi).fdl.at (cb + r1) * fr;
            float fb  = res * 0.97f;
            if (ft == 21) fb = -fb;

            float yc = s + fb * d;
            voices.at (vi).fdl.at (cb + w) = yc;
            return yc * 0.7f;
        }

        if (ft >= 24 && ft <= 27)
        {
            // MG Low 6/12/18/24: Moog-style ladder with the output tapped after stage 1/2/3/4
            float kr  = res * 3.9f;
            float y4p = voices.at (vi).fx.at (b + 4);
            float u   = softClip (s * 1.2f - kr * y4p);
            float y1  = onePole (vi, b, u, g);
            float y2  = onePole (vi, b + 1, y1, g);
            float y3  = onePole (vi, b + 2, y2, g);
            float y4  = onePole (vi, b + 3, y3, g);
            voices.at (vi).fx.at (b + 4) = y4;

            float mk = 1.1f * (1.0f + 0.4f * kr);
            if (ft == 24) return y1 * mk;
            if (ft == 25) return y2 * mk;
            if (ft == 26) return y3 * mk;
            return y4 * mk;
        }

        if (ft == 28 || ft == 29)
        {
            // Flange+ / Flange-: comb filter whose delay is swept by a slow internal LFO
            float sweep = 1.0f + 0.5f * float (sin (flfPhase * 2.0 * pi));
            float dly   = clamp (sr / max (fc, 20.0f) * sweep, 2.0f, 2040.0f);
            int   di    = int (dly);
            float fr    = dly - float (di);
            int   w     = voices.at (vi).fdlW;
            int   cb    = bank * 4096 + ch * 2048;
            int   r0    = (w - di) & 2047;
            int   r1    = (w - di - 1) & 2047;
            float d     = voices.at (vi).fdl.at (cb + r0) * (1.0f - fr) + voices.at (vi).fdl.at (cb + r1) * fr;
            float fb    = res * 0.95f;
            if (ft == 29) fb = -fb;

            float yc = s + fb * d;
            voices.at (vi).fdl.at (cb + w) = yc;
            return yc * 0.7f;
        }

        if (ft == 22)
        {
            // phaser: four all-pass stages with feedback
            float fbk = res * 0.85f;
            float a   = s + fbk * voices.at (vi).fx.at (b + 8);

            a = 2.0f * onePole (vi, b,     a, g) - a;
            a = 2.0f * onePole (vi, b + 1, a, g) - a;
            a = 2.0f * onePole (vi, b + 2, a, g) - a;
            a = 2.0f * onePole (vi, b + 3, a, g) - a;

            voices.at (vi).fx.at (b + 8) = a;
            return 0.5f * (s + a);
        }

        // 23: vowel / formant filter, cutoff sweeps A-E-I-O-U
        float p  = clamp (float (log (max (fc, 100.0f) / 100.0f)) / float (log (30.0f)), 0.0f, 1.0f) * 4.0f;
        int   v0 = clamp (int (p), 0, 3);
        float vf = p - float (v0);
        float kq = 2.0f - 1.96f * clamp (0.5f + res * 0.45f, 0.0f, 0.98f);
        float acc = 0.0f;

        float f0 = vowelFreq (v0, 0) * (1.0f - vf) + vowelFreq (v0 + 1, 0) * vf;
        float f1 = vowelFreq (v0, 1) * (1.0f - vf) + vowelFreq (v0 + 1, 1) * vf;
        float f2 = vowelFreq (v0, 2) * (1.0f - vf) + vowelFreq (v0 + 1, 2) * vf;

        acc += svfStage (vi, b,     s, float (tan (float64 (f0) * pi / float64 (sr))), kq, 1);
        acc += svfStage (vi, b + 2, s, float (tan (float64 (f1) * pi / float64 (sr))), kq, 1) * 0.7f;
        acc += svfStage (vi, b + 4, s, float (tan (float64 (f2) * pi / float64 (sr))), kq, 1) * 0.5f;

        return acc * 1.4f;
    }

    float shapeSig (float x, float d)
    {
        return shapeSigAlg (x, d, int (driveAlg + 0.5f));
    }

    // drive shaper with an explicit algorithm (0 Soft, 1 Tube, 2 Hard, 3 Fold, 4 Sine, 5 Crunch)
    float shapeSigAlg (float x, float d, int al)
    {
        float gd = 1.0f + d * 8.0f;
        float xx = x * gd;
        float y  = xx / (1.0f + abs (xx));

        if (al == 1)
        {
            // tube: asymmetric soft clip, offset removed
            float bias = 0.3f * d;
            float yb   = xx + bias;
            y = yb / (1.0f + abs (yb)) - bias / (1.0f + abs (bias));
        }
        else if (al == 2)
        {
            y = clamp (xx, -0.9f, 0.9f);
        }
        else if (al == 3)
        {
            // wavefold
            y = float (sin (xx * 1.5f)) * 0.8f;
        }
        else if (al == 4)
        {
            y = float (sin (clamp (xx, -1.5708f, 1.5708f)));
        }
        else if (al == 5)
        {
            // crunch: soft clip followed by coarse quantisation
            float lv = 6.0f + (1.0f - d) * 26.0f;
            y = rint (y * lv) / lv;
        }

        return y * (1.0f + d * 0.5f);
    }

    int findFreeVoice()
    {
        int oldest = 0;
        int maxAge = -1;

        for (int i = 0; i < 8; ++i)
        {
            if (! voices.at (i).active) return i;
            if (voices.at (i).age > maxAge)
            {
                maxAge = voices.at (i).age;
                oldest = i;
            }
        }
        return oldest;
    }

    // Wavetable frame size from the 0..4 selector (256 / 512 / 1024 / 2048 / 4096)
    int wtFrameLen (float v)
    {
        int k = clamp (int (v + 0.5f), 0, 4);
        if (k == 0) return 256;
        if (k == 1) return 512;
        if (k == 2) return 1024;
        if (k == 3) return 2048;
        return 4096;
    }

    // ================================================================================================================
    // OSCILLATOR SLOTS: six identical slots. Every slot is a Wavetable, a Sampler or a Plaits engine, followed by its
    // own filter (30 types, own envelope), a distortion, pan / level and an output route (Main / Bus 1 / Bus 2).
    // Any slot can frequency-modulate any other slot (and itself) through the 6x6 FM matrix.
    //
    // Per-slot parameters live in op[]: op[slot * 64 + k]. The k numbers (and the parameter ids 1000 + 64 * slot + k)
    // are defined in tools/osc/layout.py; patch/index.js carries the same table.
    //
    // Mod destinations: 1 Pitch (all) 2 Amp 3 Pan 4 Drive 5 Out Gain, then per slot 6 + 9 * slot + j with
    // j = 0 Pitch 1 Level 2 Pan 3 Position / Harmonics 4 Warp 1 / Timbre 5 Warp 2 / Morph 6 Cutoff 7 Reso 8 Dist Drive
    // ================================================================================================================

    struct BankChunk
    {
        int        bank;
        int        offset;
        int        count;
        int        total;
        float[256] data;
    }

    float[384]    op;
    float[36]     fmAmt;
    bool[6]       fmUsed;

    // wavetable memories (one per slot): 96000 samples cut into equal frames
    bool[6]       wtHas;
    int[6]        wtLen;
    float[576000] wtBuf;
    float[11520]  wtMeans;      // per-frame DC: (slot * 5 + frame size) * 384 + frame
    float[6]      wtMeanAll;

    // sample memories (one per slot)
    bool[6]       smpHas;
    int[6]        smpLen;
    float[576000] smpBuf;

    // wavetable unison (per slot, up to 7 voices)
    int[6]        uniCnt;
    float[42]     uniRatio;
    float[42]     uniCents;
    float[42]     uniGL;
    float[42]     uniGR;

    float opv (int o, int k)
    {
        return op.at (o * 64 + k);
    }

    void opSet (int o, int k, float v)
    {
        op.at (o * 64 + k) = v;

        if (k >= 13 && k <= 17)
            updateWtUni (o);
    }

    void fmSet (int s, int d, float v)
    {
        fmAmt.at (s * 6 + d) = v;

        for (int q = 0; q < 6; ++q)
        {
            bool u = false;
            for (int r = 0; r < 6; ++r)
                if (fmAmt.at (q * 6 + r) != 0.0f) u = true;
            fmUsed.at (q) = u;
        }
    }

    // ---------------- memories ----------------
    void clearWtBank (int o)
    {
        wtHas.at (o) = false;
        wtLen.at (o) = 0;
    }

    void calcWtMeans (int o)
    {
        int   len  = clamp (wtLen.at (o), 1, 96000);
        int   base = o * 96000;
        float tot  = 0.0f;

        for (int i = 0; i < len; ++i)
            tot += wtBuf.at (base + i);

        wtMeanAll.at (o) = tot / float (len);

        int fl = 256;
        for (int k = 0; k < 5; ++k)
        {
            if (fl <= len)
            {
                int nF = min (len / fl, 384);
                for (int f = 0; f < nF; ++f)
                {
                    float s  = 0.0f;
                    int   fo = base + f * fl;
                    for (int i = 0; i < fl; ++i)
                        s += wtBuf.at (fo + i);
                    wtMeans.at ((o * 5 + k) * 384 + f) = s / float (fl);
                }
            }
            fl = fl * 2;
        }
    }

    float wtMeanOf (int o, int fl, int f)
    {
        int k = -1;
        if (fl == 256)       k = 0;
        else if (fl == 512)  k = 1;
        else if (fl == 1024) k = 2;
        else if (fl == 2048) k = 3;
        else if (fl == 4096) k = 4;

        if (k < 0 || fl > wtLen.at (o))
            return wtMeanAll.at (o);

        return wtMeans.at ((o * 5 + k) * 384 + clamp (f, 0, 383));
    }

    event wtBankLoad (BankChunk c)
    {
        int o = clamp (c.bank, 0, 5);

        if (c.total <= 0)
        {
            clearWtBank (o);
            for (int k = 0; k < 8; ++k)
                resetWtUni (k, o);
            return;
        }

        if (c.offset == 0)
            wtHas.at (o) = false;

        int cnt  = clamp (c.count, 0, 256);
        int base = o * 96000;

        for (int i = 0; i < cnt; ++i)
        {
            int pos = c.offset + i;
            if (pos >= 0 && pos < 96000)
                wtBuf.at (base + pos) = c.data.at (i);
        }

        if (c.offset + cnt >= c.total)
        {
            wtLen.at (o) = clamp (c.total, 1, 96000);
            calcWtMeans (o);
            wtHas.at (o) = true;
        }
    }

    event smpBankLoad (BankChunk c)
    {
        int o = clamp (c.bank, 0, 5);

        if (c.total <= 0)
        {
            smpHas.at (o) = false;
            smpLen.at (o) = 0;
            return;
        }

        if (c.offset == 0)
            smpHas.at (o) = false;

        int cnt  = clamp (c.count, 0, 256);
        int base = o * 96000;

        for (int i = 0; i < cnt; ++i)
        {
            int pos = c.offset + i;
            if (pos >= 0 && pos < 96000)
                smpBuf.at (base + pos) = c.data.at (i);
        }

        if (c.offset + cnt >= c.total)
        {
            smpLen.at (o) = clamp (c.total, 1, 96000);
            smpHas.at (o) = true;
        }
    }

    // ---------------- wavetable unison ----------------
    void updateWtUni (int o)
    {
        int   n     = clamp (int (opv (o, 13) + 0.5f), 1, 7);
        float det   = clamp (opv (o, 14), 0.0f, 1.0f);
        float blend = clamp (opv (o, 15), 0.0f, 1.0f);
        float width = clamp (opv (o, 16), 0.0f, 1.0f);
        int   style = clamp (int (opv (o, 17) + 0.5f), 0, 3);

        uniCnt.at (o) = n;

        float powSum = 0.0f;

        for (int j = 0; j < 7; ++j)
        {
            float pos = 0.0f;
            if (n > 1)
                pos = 2.0f * float (j) / float (n - 1) - 1.0f;

            float dpos = pos;
            if (style == 1)      dpos = pos * abs (pos);
            else if (style == 2) dpos = (pos < 0.0f ? -1.0f : 1.0f) * float (sqrt (abs (pos)));
            else if (style == 3 && n > 1) dpos = uniRandPos (o, j);

            float cents = dpos * det * 50.0f;
            uniRatio.at (o * 7 + j) = float (pow (2.0f, cents / 1200.0f));
            uniCents.at (o * 7 + j) = dpos * 50.0f;

            float w = blend + (1.0f - blend) * (1.0f - abs (pos));
            if (j >= n) w = 0.0f;
            powSum += w * w;

            float pp  = pos * width;
            float ang = (pp + 1.0f) * 0.25f * float (pi);
            uniGL.at (o * 7 + j) = w * float (cos (ang)) * 1.4142f;
            uniGR.at (o * 7 + j) = w * float (sin (ang)) * 1.4142f;
        }

        float norm = 1.0f / float (sqrt (max (powSum, 0.01f)));

        for (int j = 0; j < 7; ++j)
        {
            uniGL.at (o * 7 + j) = uniGL.at (o * 7 + j) * norm;
            uniGR.at (o * 7 + j) = uniGR.at (o * 7 + j) * norm;
        }
    }

    void resetWtUni (int vi, int o)
    {
        for (int j = 0; j < 7; ++j)
        {
            float64 rp = float64 (clamp (opv (o, 8), 0.0f, 1.0f));
            if (opv (o, 9) > 0.5f)
                rp = float64 (nextNoise() * 0.5f + 0.5f);

            voices.at (vi).wtUPh.at (o * 7 + j) = rp;
        }
    }

    // wavetable read: frames morph with pos (0..1), phase (0..1) scans one cycle, both linearly interpolated
    float wtRead (int o, float64 phase, float wtPos, int frameLen)
    {
        int   len  = wtLen.at (o);
        int   fl   = clamp (frameLen, 2, max (len, 2));
        int   nF   = max (len / fl, 1);
        float p    = clamp (wtPos, 0.0f, 1.0f) * float (nF - 1);
        int   fa   = clamp (int (p), 0, nF - 1);
        int   fb   = min (fa + 1, nF - 1);
        float ff   = p - float (fa);
        float x    = float (phase) * float (fl);
        int   i0   = clamp (int (x), 0, fl - 1);
        int   i1   = i0 + 1;
        if (i1 >= fl) i1 = 0;
        float fr   = x - float (i0);
        int   base = o * 96000;
        int   top  = base + 95999;

        float a0 = wtBuf.at (clamp (base + fa * fl + i0, base, top));
        float a1 = wtBuf.at (clamp (base + fa * fl + i1, base, top));
        float b0 = wtBuf.at (clamp (base + fb * fl + i0, base, top));
        float b1 = wtBuf.at (clamp (base + fb * fl + i1, base, top));

        float va = a0 * (1.0f - fr) + a1 * fr;
        float vb = b0 * (1.0f - fr) + b1 * fr;
        float dc = wtMeanOf (o, fl, fa) * (1.0f - ff) + wtMeanOf (o, fl, fb) * ff;
        return va * (1.0f - ff) + vb * ff - dc;
    }

    // one step of the wavetable slot o on voice vi; pm = phase modulation in cycles (FM matrix); returns the stereo sum
    float<2> wtStep (int o, int vi, float freq, float pos, int fl, float pm, float a1m, float a2m)
    {
        float sr  = float (processor.frequency);
        int   n   = uniCnt.at (o);
        int   m1  = clamp (int (opv (o, 18) + 0.5f), 0, 8);
        int   m2  = clamp (int (opv (o, 20) + 0.5f), 0, 8);
        float a1  = clamp (opv (o, 19) + a1m * 0.5f, 0.0f, 1.0f);
        float a2  = clamp (opv (o, 21) + a2m * 0.5f, 0.0f, 1.0f);
        float sL  = 0.0f;
        float sR  = 0.0f;

        for (int j = 0; j < n; ++j)
        {
            int     si = o * 7 + j;
            float64 ph = voices.at (vi).wtUPh.at (si);
            float   f  = clamp (freq * uniRatio.at (si), 1.0f, sr * 0.45f);

            float rp = float (ph);
            if (pm != 0.0f)
            {
                rp = rp + pm;
                rp = rp - float (floor (rp));
            }
            if (m1 >= 1 && m1 <= 6) rp = wtWarpPhase (m1, a1, rp);
            if (m2 >= 1 && m2 <= 6) rp = wtWarpPhase (m2, a2, rp);
            float64 rph = float64 (clamp (rp, 0.0f, 0.99999f));

            float y = wtRead (o, rph, pos, fl);

            if (m1 >= 7) y = wtWarpAmp (m1, a1, y);
            if (m2 >= 7) y = wtWarpAmp (m2, a2, y);

            sL += y * uniGL.at (si);
            sR += y * uniGR.at (si);

            ph += float64 (f) * processor.period;
            if (ph >= 1.0) ph -= 1.0;
            voices.at (vi).wtUPh.at (si) = ph;
        }

        // warping changes the average level of the cycle: remove the DC it creates (bypassed without warp)
        int zi = o * 4;

        if (m1 != 0 || m2 != 0)
        {
            float yl = sL - voices.at (vi).wtDcS.at (zi)     + 0.9995f * voices.at (vi).wtDcS.at (zi + 1);
            float yr = sR - voices.at (vi).wtDcS.at (zi + 2) + 0.9995f * voices.at (vi).wtDcS.at (zi + 3);
            voices.at (vi).wtDcS.at (zi)     = sL;
            voices.at (vi).wtDcS.at (zi + 1) = yl;
            voices.at (vi).wtDcS.at (zi + 2) = sR;
            voices.at (vi).wtDcS.at (zi + 3) = yr;
            sL = yl;
            sR = yr;
        }
        else
        {
            voices.at (vi).wtDcS.at (zi)     = 0.0f;
            voices.at (vi).wtDcS.at (zi + 1) = 0.0f;
            voices.at (vi).wtDcS.at (zi + 2) = 0.0f;
            voices.at (vi).wtDcS.at (zi + 3) = 0.0f;
        }

        return float<2> (sL, sR);
    }

    // linear-interpolated sample read
    float smpRead (int o, float64 pos)
    {
        int base = o * 96000;
        int i0   = int (pos);
        float fr = float (pos - float64 (i0));
        int i1   = i0 + 1;
        int len  = smpLen.at (o);
        if (i1 >= len) i1 = i0;
        i0 = clamp (i0, 0, 95999);
        i1 = clamp (i1, 0, 95999);
        return smpBuf.at (base + i0) * (1.0f - fr) + smpBuf.at (base + i1) * fr;
    }

    // one step of the sampler slot o; returns the sample at the current read position and advances it
    float smpStep (int o, int vi, float freq, float curFreq, float pm, float st)
    {
        float sr   = float (processor.frequency);
        int   len  = smpLen.at (o);
        int   sSt  = clamp (int (opv (o, 22) * float (len)), 0, max (len - 1, 0));
        float64 sp = voices.at (vi).synPos.at (o);
        float out  = 0.0f;

        float rate = 1.0f;
        if (opv (o, 7) > 0.5f)
            rate = curFreq / max (float (std::notes::noteToFrequency (int (opv (o, 12) + 0.5f))), 1.0f);
        rate = clamp (rate * float (pow (2.0f, st)), 0.0f, 16.0f);

        float64 rp = sp;
        if (pm != 0.0f)
        {
            rp = sp + float64 (pm * rate * sr / max (freq, 20.0f));
            float64 fl = float64 (len);
            if (rp < 0.0) rp = 0.0;
            if (rp >= fl) rp = fl - 1.0;
        }

        if (int (rp) < len)
            out = smpRead (o, rp);

        sp += float64 (rate);
        if (sp >= float64 (len))
        {
            if (opv (o, 23) > 0.5f)
            {
                sp -= float64 (max (len - sSt, 1));
                if (sp >= float64 (len) || sp < 0.0)
                    sp = float64 (sSt);
            }
        }
        voices.at (vi).synPos.at (o) = sp;
        return out;
    }

    // per-slot distortion (type 1..6 = Soft Tube Hard Fold Sine Crunch)
    float oscDist (float x, int ty, float d, float mix)
    {
        if (ty <= 0 || mix <= 0.0005f)
            return x;

        float y = shapeSigAlg (x, d, ty - 1);
        return x * (1.0f - mix) + y * mix;
    }


    float plaitsStep (int vi, int o, float freq, float pm)
    {
        return 0.0f;
    }

    void plaitsNoteOn (int vi, int o)
    {
    }

    // ---------------- MIDI ----------------
    event midiIn (std::midi::Message msg)
    {
        if (msg.isNoteOn())
        {
            int   nn       = msg.getNoteNumber();
            float vel      = msg.getFloatVelocity();
            float velGainV = (1.0f - velSens) + velSens * vel;
            bool  monoMode = voiceMode > 0.5f;

            int v = 0;
            if (! monoMode) v = findFreeVoice();

            bool wasActive = voices.at (v).active;
            float target = float (std::notes::noteToFrequency (nn));

            voices.at (v).noteNumber = nn;
            voices.at (v).targetFreq = target;

            if (! (monoMode && wasActive))
                voices.at (v).curFreq = target;

            // restart every slot on each non-legato note
            if (! (monoMode && wasActive))
            {
                for (int o = 0; o < 6; ++o)
                {
                    int sLen   = smpLen.at (o);
                    int sStart = clamp (int (opv (o, 22) * float (sLen)), 0, max (sLen - 1, 0));
                    voices.at (v).synPos.at (o) = float64 (sStart);
                    resetWtUni (v, o);
                    plaitsNoteOn (v, o);
                }
            }

            if (! wasActive)
            {
                voices.at (v).env  = 0.0f;
                voices.at (v).fdlW = 0;

                for (int fq = 0; fq < 192; ++fq)
                    voices.at (v).fx.at (fq) = 0.0f;

                for (int fd = 0; fd < 24576; ++fd)
                    voices.at (v).fdl.at (fd) = 0.0f;

                for (int me = 0; me < 10; ++me)
                    voices.at (v).menv.at (me) = 0.0f;

                for (int o = 0; o < 6; ++o)
                    voices.at (v).fmPrev.at (o) = 0.0f;
            }

            voices.at (v).stage = 1;

            for (int o = 0; o < 6; ++o)
            {
                voices.at (v).fstage.at (o) = 1;
                voices.at (v).fenv.at (o)   = opv (o, 38) > 0.5f ? 0.0f : 1.0f;
            }

            for (int ms = 0; ms < 10; ++ms)
                voices.at (v).mstage.at (ms) = 1;

            voices.at (v).penv    = 1.0f;
            voices.at (v).velGain = velGainV;
            voices.at (v).velRaw  = vel;
            voices.at (v).modRand = nextNoise();
            lastVoice = v;

            for (int lm = 0; lm < 10; ++lm)
            {
                voices.at (v).lfoPh.at (lm)  = 0.0;
                voices.at (v).lfoAge.at (lm) = -1.0f;
                voices.at (v).lfoSh.at (lm)  = nextNoise();
                voices.at (v).lfoV.at (lm)   = 0.0f;
            }

            lastVelV  = vel;
            lastKeyV  = clamp ((float (nn) - 60.0f) / 48.0f, -1.0f, 1.0f);
            lastRandV = voices.at (v).modRand;
            voices.at (v).age     = 0;
            voices.at (v).active  = true;
        }
        else if (msg.isNoteOff())
        {
            int nn = msg.getNoteNumber();

            for (int i = 0; i < 8; ++i)
            {
                if (voices.at (i).active && voices.at (i).noteNumber == nn)
                {
                    voices.at (i).stage = 3;

                    for (int o = 0; o < 6; ++o)
                        voices.at (i).fstage.at (o) = 3;

                    for (int mq = 0; mq < 10; ++mq)
                        voices.at (i).mstage.at (mq) = 3;
                }
            }
        }
    }

    // ---------------- AUDIO ----------------
    void main()
    {
        loop
        {
            float dt = float (processor.period);
            float sr = float (processor.frequency);

            flfPhase += 0.3 * processor.period;
            if (flfPhase >= 1.0) flfPhase -= 1.0;

            // ----- mod page: 10 LFOs + global matrix sums -----
            updateModLfos (dt);
            rollEnvMax();
            computeGlobalMod();

            float[3] mixSynthL;
            float[3] mixSynthR;

            for (int i = 0; i < 8; ++i)
            {
                if (! voices.at (i).active) continue;

                voices.at (i).age += 1;

                // glide
                float gc = 1.0f;
                if (glideMs > 0.5f)
                    gc = clamp (dt * 5.0f / (glideMs * 0.001f), 0.0f, 1.0f);
                voices.at (i).curFreq += (voices.at (i).targetFreq - voices.at (i).curFreq) * gc;

                // amp envelope
                int   st = voices.at (i).stage;
                float e  = voices.at (i).env;

                if (st == 1)
                {
                    e += dt / max (ampAttack * 0.001f, 0.0005f);
                    if (e >= 1.0f) { e = 1.0f; st = 2; }
                }
                else if (st == 2)
                {
                    e += (ampSustain - e) * clamp (dt * 5.0f / (max (ampDecay, 1.0f) * 0.001f), 0.0f, 0.99f);
                }
                else
                {
                    e -= e * clamp (dt * 5.0f / (max (ampRelease, 1.0f) * 0.001f), 0.0f, 0.99f);
                    if (e < 0.0003f)
                    {
                        e = 0.0f;
                        voices.at (i).active = false;
                    }
                }
                voices.at (i).env   = e;
                voices.at (i).stage = st;

                // mod envelopes, per-voice LFOs and the matrix sums
                updateModEnvs (i, dt);
                updateVoiceLfos (i, dt);
                computeVoiceMod (i);

                // pitch envelope (+ matrix pitch, +/-12 semitones at full amount)
                voices.at (i).penv -= voices.at (i).penv * clamp (dt * 5.0f / (max (pitchEgDec, 1.0f) * 0.001f), 0.0f, 0.99f);
                float pe     = voices.at (i).penv * pitchEgInt + vmod.at (1) * 12.0f;
                float tuneSt = masterTune * 0.01f;
                float cf     = voices.at (i).curFreq;
                int   nnote  = voices.at (i).noteNumber;

                // FM: every slot is modulated by the previous sample of the slots that feed it
                float[6] fmIn;
                for (int fd = 0; fd < 6; ++fd)
                {
                    float acc = 0.0f;
                    for (int fs = 0; fs < 6; ++fs)
                    {
                        float am = fmAmt.at (fs * 6 + fd);
                        if (am != 0.0f)
                            acc += am * voices.at (i).fmPrev.at (fs);
                    }
                    fmIn.at (fd) = acc;
                }

                float[3] bInL;
                float[3] bInR;

                for (int o = 0; o < 6; ++o)
                {
                    int   ob  = o * 64;
                    int   ty  = int (op.at (ob) + 0.5f);
                    int   dB  = 6 + 9 * o;
                    float lvl = clamp (op.at (ob + 1) + vmod.at (dB + 1), 0.0f, 1.0f);

                    if (lvl <= 0.0005f && ! fmUsed.at (o))
                    {
                        voices.at (i).fmPrev.at (o) = 0.0f;
                        continue;
                    }

                    // ----- source -----
                    float sSemi = op.at (ob + 4) * 12.0f + op.at (ob + 5) + op.at (ob + 6) * 0.01f;
                    float sExp  = (sSemi + pe + tuneSt) / 12.0f + vmod.at (dB);
                    float base  = cf;
                    if (op.at (ob + 7) <= 0.5f)
                        base = float (std::notes::noteToFrequency (int (op.at (ob + 12) + 0.5f)));
                    float freq  = clamp (base * float (pow (2.0f, sExp)), 1.0f, sr * 0.45f);
                    float pm    = fmIn.at (o);

                    float sL = 0.0f;
                    float sR = 0.0f;
                    bool  stereo = false;

                    if (ty == 0)
                    {
                        if (wtHas.at (o) && wtLen.at (o) > 1)
                        {
                            float pos = clamp (op.at (ob + 10) + vmod.at (dB + 3) * 0.5f, 0.0f, 1.0f);
                            float<2> w = wtStep (o, i, freq, pos, wtFrameLen (op.at (ob + 11)), pm, vmod.at (dB + 4), vmod.at (dB + 5));
                            sL = w[0];
                            sR = w[1];
                            stereo = true;
                        }
                    }
                    else if (ty == 1)
                    {
                        if (smpHas.at (o) && smpLen.at (o) > 1)
                        {
                            sL = smpStep (o, i, freq, cf, pm, sExp);
                            sR = sL;
                        }
                    }
                    else
                    {
                        sL = plaitsStep (i, o, freq, pm);
                        sR = sL;
                    }

                    voices.at (i).fmPrev.at (o) = stereo ? (sL + sR) * 0.5f : sL;

                    // ----- filter envelope of the slot -----
                    int   fst = voices.at (i).fstage.at (o);
                    float fe  = voices.at (i).fenv.at (o);
                    if (fst == 1)
                    {
                        fe += dt / max (op.at (ob + 38) * 0.001f, 0.0005f);
                        if (fe >= 1.0f) { fe = 1.0f; fst = 2; }
                    }
                    else if (fst == 2)
                    {
                        fe += (op.at (ob + 40) - fe) * clamp (dt * 5.0f / (max (op.at (ob + 39), 1.0f) * 0.001f), 0.0f, 0.99f);
                    }
                    else
                    {
                        fe -= fe * clamp (dt * 5.0f / (max (op.at (ob + 41), 1.0f) * 0.001f), 0.0f, 0.99f);
                    }
                    voices.at (i).fenv.at (o)   = fe;
                    voices.at (i).fstage.at (o) = fst;

                    if (lvl <= 0.0005f)
                        continue;

                    // ----- filter -----
                    if (op.at (ob + 30) > 0.5f)
                    {
                        float fdrv = clamp (op.at (ob + 34), 0.0f, 1.0f);
                        if (fdrv > 0.001f)
                        {
                            float dg = 1.0f + fdrv * 6.0f;
                            float dm = 1.0f + fdrv * 0.8f;
                            float sdL = sL * dg;
                            float sdR = sR * dg;
                            sL = (sdL / (1.0f + abs (sdL))) * dm;
                            sR = (sdR / (1.0f + abs (sdR))) * dm;
                        }

                        float modExp = op.at (ob + 36) * fe * 4.0f
                                     + op.at (ob + 35) * float (nnote - 60) / 12.0f
                                     + op.at (ob + 37) * (voices.at (i).velRaw - 0.5f) * 4.0f
                                     + vmod.at (dB + 6) * 4.0f;
                        float fc    = clamp (op.at (ob + 32) * float (pow (2.0f, modExp)), 20.0f, sr * 0.45f);
                        float g     = float (tan (float64 (fc) * pi * processor.period));
                        float resE  = clamp (op.at (ob + 33) + vmod.at (dB + 7) * 0.5f, 0.0f, 1.0f);
                        float k     = 2.0f - 1.96f * resE;
                        int   ft    = clamp (int (op.at (ob + 31) + 0.5f), 0, 29);

                        float yL = filterStepX (i, 0, o, sL, g, k, resE, fc, ft);
                        float yR = yL;
                        if (stereo)
                            yR = filterStepX (i, 1, o, sR, g, k, resE, fc, ft);
                        sL = yL;
                        sR = yR;
                    }

                    // ----- distortion -----
                    int dty = int (op.at (ob + 42) + 0.5f);
                    if (dty > 0)
                    {
                        float dd = clamp (op.at (ob + 43) + vmod.at (dB + 8) * 0.5f, 0.0f, 1.0f);
                        float dx = op.at (ob + 44);
                        sL = oscDist (sL, dty, dd, dx);
                        sR = stereo ? oscDist (sR, dty, dd, dx) : sL;
                    }

                    // ----- level, pan, output route -----
                    float pn  = clamp (op.at (ob + 2) + vmod.at (dB + 2), -1.0f, 1.0f);
                    float pa  = (pn + 1.0f) * 0.25f * float (pi);
                    float gL  = float (cos (pa)) * 1.4142f * lvl;
                    float gR  = float (sin (pa)) * 1.4142f * lvl;
                    int   rt  = clamp (int (op.at (ob + 3) + 0.5f), 0, 2);
                    bInL.at (rt) += sL * gL;
                    bInR.at (rt) += sR * gR;
                }

                float a = e * voices.at (i).velGain * clamp (1.0f + vmod.at (2), 0.0f, 2.0f);

                voices.at (i).fdlW = (voices.at (i).fdlW + 1) & 2047;

                for (int mg = 0; mg < 3; ++mg)
                {
                    mixSynthL.at (mg) += bInL.at (mg) * a;
                    mixSynthR.at (mg) += bInR.at (mg) * a;
                }
            }

            // ----- global mod destinations: drive, pan, output gain -----
            float driveEff = clamp (driveAmt + gmod.at (4) * 0.5f, 0.0f, 1.0f);

            float gPanL = panL;
            float gPanR = panR;
            if (abs (gmod.at (3)) > 0.0001f)
            {
                float gp   = clamp (panParam + gmod.at (3), -1.0f, 1.0f);
                float gAng = (gp + 1.0f) * 0.25f * float (pi);
                gPanL = float (cos (gAng)) * 1.4142f;
                gPanR = float (sin (gAng)) * 1.4142f;
            }

            float outGainMod = clamp (1.0f + gmod.at (5), 0.0f, 2.0f);

            // ----- synth drive / soft clip, pan and DC blocker, once per bus -----
            float synDcA = 1.0f - clamp (float (twoPi) * 5.0f * dt, 0.0001f, 0.5f);
            float[3] busInL;
            float[3] busInR;

            for (int bg = 0; bg < 3; ++bg)
            {
                float rawL = shapeSig (mixSynthL.at (bg) * 0.35f, driveEff) * gPanL;
                float rawR = shapeSig (mixSynthR.at (bg) * 0.35f, driveEff) * gPanR;

                // always-on DC blocker (about 5 Hz): asymmetric shapers, ring mod and loaded samples can carry DC
                // that the delay / chorus / flanger / reverb feedback loops would amplify
                float dcL = rawL - busDcX.at (bg * 2)     + synDcA * busDcY.at (bg * 2);
                float dcR = rawR - busDcX.at (bg * 2 + 1) + synDcA * busDcY.at (bg * 2 + 1);
                busDcX.at (bg * 2)     = rawL;
                busDcY.at (bg * 2)     = dcL;
                busDcX.at (bg * 2 + 1) = rawR;
                busDcY.at (bg * 2 + 1) = dcR;
                busInL.at (bg) = dcL * masterLevel;
                busInR.at (bg) = dcR * masterLevel;
            }

            // ----- FX racks: Bus 1 and Bus 2 feed the Main rack, which feeds the output -----
            float<2> bus1 = fxRunRack (1, float<2> (busInL.at (1), busInR.at (1))) * busLevel1;
            float<2> bus2 = fxRunRack (2, float<2> (busInL.at (2), busInR.at (2))) * busLevel2;
            float<2> rack = fxRunRack (0, float<2> (busInL.at (0) + bus1[0] + bus2[0], busInR.at (0) + bus1[1] + bus2[1]));
            float outL = rack[0];
            float outR = rack[1];

            // ----- stereo width (mid/side) -----
            float wdMid  = (outL + outR) * 0.5f;
            float wdSide = (outL - outR) * 0.5f * stereoWidth;
            outL = wdMid + wdSide;
            outR = wdMid - wdSide;

            // ----- output tone (tilt: dark <-> bright) and output gain -----
            float toneA = clamp (float (twoPi) * 1200.0f * dt, 0.0f, 1.0f);
            toneStL += toneA * (outL - toneStL);
            toneStR += toneA * (outR - toneStR);
            float toneHiL = outL - toneStL;
            float toneHiR = outR - toneStR;
            outL = toneStL * (1.0f - 0.6f * toneAmt) + toneHiL * (1.0f + 0.6f * toneAmt);
            outR = toneStR * (1.0f - 0.6f * toneAmt) + toneHiR * (1.0f + 0.6f * toneAmt);
            outL = outL * outGain * outGainMod;
            outR = outR * outGain * outGainMod;

            // ----- DC blocker (one-pole high-pass): always on, corner set by DC Freq when DC Block is on, otherwise 3 Hz -----
            float dcCorner = 3.0f;
            if (dcOn > 0.5f) dcCorner = dcFreq;
            float dcR = 1.0f - clamp (float (twoPi) * dcCorner * dt, 0.0001f, 0.5f);
            float dcInL = outL;
            float dcInR = outR;
            dcYL = dcInL - dcXL + dcR * dcYL;
            dcYR = dcInR - dcXR + dcR * dcYR;
            dcXL = dcInL;
            dcXR = dcInR;
            outL = dcYL;
            outR = dcYR;

            outL = clamp (outL, -1.0f, 1.0f);
            outR = clamp (outR, -1.0f, 1.0f);

            out <- float<2> (outL, outR);
            advance();
        }
    }
}
