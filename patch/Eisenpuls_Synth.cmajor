    event param452   (float v) { wtWarpM2.at (0)   = v; }
    event param453   (float v) { wtWarpA2.at (0)   = v; }
    event param454   (float v) { wtPanV.at (1)     = v; updateWtPan (1); }
    event param455   (float v) { wtPhaseV.at (1)   = v; }
    event param456   (float v) { wtUniBlend.at (1) = v; updateWtUni (1); }
    event param457   (float v) { wtUniWidth.at (1) = v; updateWtUni (1); }
    event param458   (float v) { wtUniStyle.at (1) = v; updateWtUni (1); }
    event param459   (float v) { wtWarpM1.at (1)   = v; }
