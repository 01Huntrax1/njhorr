    float   synDcXL    = 0.0f;   // synth-bus DC blocker (always on, before the FX)
    float   synDcYL    = 0.0f;
    float   synDcXR    = 0.0f;
    float   synDcYR    = 0.0f;

    // Output tone state
    float   toneStL    = 0.0f;
    float   toneStR    = 0.0f;

    // Reverb state: 8 comb filters (4 left, 4 right) and 4 allpass filters
    int[8]       combLen;
    int[4]       apLen;

    // ---------------- MOD PAGE STATE ----------------
    float[10]   mLfoWave;
    float[10]   mLfoRate;
    float[10]   mLfoSync;
    float[10]   mLfoDiv;
    float       syncBpmOver = 0.0f;   // manual tempo (0 = follow the host)
    float       hostBpm     = 120.0f;
    float[18]   divBeats;             // beats per LFO cycle of every sync division
    float64[10] mLfoPhase;
    float[10]   mLfoSh;
    float[10]   mLfoV;
    float[10]   mLfoMode;     // 0 free (global), 1 trig (per voice, restarts on note-on), 2 env (per voice, one shot)
    float[10]   mLfoDelay;
    float[10]   mLfoRise;
    float[10]   mLfoSmooth;
    float[10]   mLfoStart;
    float[10]   mLfoSm;       // smoothing state of the free-running (global) LFOs
    float[2560] lfoTab;       // drawn shapes, 256 points per LFO
    int         lastVoice = 0;

    float[10]   mEnvA;
