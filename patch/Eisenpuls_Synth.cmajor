    // ---------------- WAVETABLE UNISON HELPERS (processor scope) ----------------

    // Fixed pseudo-random position (-1..1) of a unison voice, used by the Random unison style
    float uniRandPos (int e, int j)
    {
        float s = float (sin (float (j * 7 + e * 13 + 1) * 12.9898f)) * 43758.5453f;
        return 2.0f * (s - float (floor (s))) - 1.0f;
    }

    // Recomputes the unison voice count, detune ratios, blend, stereo spread and normalisation of one wavetable engine
    void updateWtUni (int e)
    {
        int   n     = clamp (int (wtUniVoices.at (e) + 0.5f), 1, 7);
        float det   = clamp (wtUniDetune.at (e), 0.0f, 1.0f);
        float blend = clamp (wtUniBlend.at (e), 0.0f, 1.0f);
        float width = clamp (wtUniWidth.at (e), 0.0f, 1.0f);
        int   style = clamp (int (wtUniStyle.at (e) + 0.5f), 0, 3);

        wtUniCnt.at (e) = n;

        float powSum = 0.0f;

        for (int j = 0; j < 7; ++j)
        {
            float pos = 0.0f;
            if (n > 1)
                pos = 2.0f * float (j) / float (n - 1) - 1.0f;

            // detune curve: 0 linear, 1 exponential (outer voices spread further), 2 inverse, 3 random
            float dpos = pos;
            if (style == 1)      dpos = pos * abs (pos);
            else if (style == 2) dpos = (pos < 0.0f ? -1.0f : 1.0f) * float (sqrt (abs (pos)));
            else if (style == 3 && n > 1) dpos = uniRandPos (e, j);

            // outer voices sit up to +/- 50 cents away from the centre at full detune
            float cents = dpos * det * 50.0f;
            wtUniRatio.at (e * 7 + j) = float (pow (2.0f, cents / 1200.0f));
            wtUniCents1.at (e * 7 + j) = dpos * 50.0f;

            // blend: 1 = every voice equal, 0 = only the centre voices are audible
            float w = blend + (1.0f - blend) * (1.0f - abs (pos));
            if (j >= n) w = 0.0f;
            powSum += w * w;

            float pp  = pos * width;
            float ang = (pp + 1.0f) * 0.25f * float (pi);
            wtUniGL.at (e * 7 + j) = w * float (cos (ang)) * 1.4142f;
            wtUniGR.at (e * 7 + j) = w * float (sin (ang)) * 1.4142f;
        }

        float norm = 1.0f / float (sqrt (max (powSum, 0.01f)));

        for (int j = 0; j < 7; ++j)
        {
            wtUniGL.at (e * 7 + j) = wtUniGL.at (e * 7 + j) * norm;
            wtUniGR.at (e * 7 + j) = wtUniGR.at (e * 7 + j) * norm;
        }
    }

    // Equal-power pan gains of one wavetable engine (centre = unity)
    void updateWtPan (int e)
    {
        float ang = (clamp (wtPanV.at (e), -1.0f, 1.0f) + 1.0f) * 0.25f * float (pi);
        wtPanGL.at (e) = float (cos (ang)) * 1.4142f;
        wtPanGR.at (e) = float (sin (ang)) * 1.4142f;
    }

    // Resets the unison phases of one wavetable engine on a voice (start phase, or random when Random Phase is on)
    void resetWtUni (int vi, int e)
    {
        for (int j = 0; j < 7; ++j)
        {
            float64 rp = float64 (clamp (wtPhaseV.at (e), 0.0f, 1.0f));
            if (wtUniRand.at (e) > 0.5f)
                rp = float64 (nextNoise() * 0.5f + 0.5f);

            voices.at (vi).wtUPh.at (e * 7 + j) = rp;
        }
    }

    // Phase warp (modes 1-6) of one warp slot: maps the 0..1 oscillator phase to the table read phase
    float wtWarpPhase (int mode, float amt, float ph)
    {
        if (mode == 1)
            return float (pow (ph, 1.0f + 3.0f * amt));                    // bend +

        if (mode == 2)
            return 1.0f - float (pow (1.0f - ph, 1.0f + 3.0f * amt));      // bend -

        if (mode == 3)
        {
            float x = ph * (1.0f + 7.0f * amt);                           // sync
            return x - float (floor (x));
        }

        if (mode == 4)
        {
            float w = 0.5f - 0.45f * amt;                                 // pulse width
            if (ph < w) return ph * 0.5f / w;
            return 0.5f + (ph - w) * 0.5f / (1.0f - w);
        }

        if (mode == 5)
        {
            float x = ph * (1.0f + amt);                                  // mirror
            if (x > 1.0f) x = 2.0f - x;
            return clamp (x, 0.0f, 1.0f);
        }

        if (mode == 6)
            return ph * (1.0f - amt) + (1.0f - ph) * amt;                 // flip

        return ph;
    }

    // Amplitude warp (modes 7-8) of one warp slot
    float wtWarpAmp (int mode, float amt, float y)
    {
        if (mode == 7)
        {
            float s = 2.0f + (1.0f - amt) * 254.0f;                       // quantize
            return float (floor (y * s + 0.5f)) / s;
        }

        if (mode == 8)
            return y * (1.0f - amt) + amt * float (sin (y * (1.0f + 4.0f * amt) * 1.5708f));   // fold

        return y;
    }

    // One unison step of a wavetable engine for a voice: reads and advances every unison phase (with both warp slots),
    // returns the stereo sum
    float<2> wtUniStep (int e, int vi, float freq, float pos, int fl)
    {
        float sr  = float (processor.frequency);
        int   n   = wtUniCnt.at (e);
        int   m1  = clamp (int (wtWarpM1.at (e) + 0.5f), 0, 8);
        int   m2  = clamp (int (wtWarpM2.at (e) + 0.5f), 0, 8);
        float a1  = clamp (wtWarpA1.at (e) + vmod.at (33 + e * 2) * 0.5f, 0.0f, 1.0f);
        float a2  = clamp (wtWarpA2.at (e) + vmod.at (34 + e * 2) * 0.5f, 0.0f, 1.0f);
        float dm  = vmod.at (39 + e);
        float detM = clamp (wtUniDetune.at (e) + dm * 0.5f, 0.0f, 1.0f);
        float sL  = 0.0f;
        float sR  = 0.0f;

        for (int j = 0; j < n; ++j)
        {
            int     si = e * 7 + j;
            float64 ph = voices.at (vi).wtUPh.at (si);
            float   rat = wtUniRatio.at (si);
            if (abs (dm) > 0.0001f)
                rat = float (pow (2.0f, wtUniCents1.at (si) * detM / 1200.0f));
            float   f  = clamp (freq * rat, 1.0f, sr * 0.45f);

            float rp = float (ph);
            if (m1 >= 1 && m1 <= 6) rp = wtWarpPhase (m1, a1, rp);
            if (m2 >= 1 && m2 <= 6) rp = wtWarpPhase (m2, a2, rp);
            float64 rph = float64 (clamp (rp, 0.0f, 0.99999f));

            float y = 0.0f;
            if (e == 0)      y = wtBankRead  (wtIdx,  rph, pos, fl);
            else if (e == 1) y = wt2BankRead (wt2Idx, rph, pos, fl);
            else             y = wt3BankRead (wt3Idx, rph, pos, fl);

            if (m1 >= 7) y = wtWarpAmp (m1, a1, y);
            if (m2 >= 7) y = wtWarpAmp (m2, a2, y);

            sL += y * wtUniGL.at (si);
            sR += y * wtUniGR.at (si);

            ph += float64 (f) * processor.period;
            if (ph >= 1.0) ph -= 1.0;
            voices.at (vi).wtUPh.at (si) = ph;
        }

        // warping changes the average level of the cycle, so remove any DC it creates (bypassed when no warp is active)
        int zi = e * 4;

        if (m1 != 0 || m2 != 0)
        {
            float yl = sL - voices.at (vi).wtDcS.at (zi)     + 0.9995f * voices.at (vi).wtDcS.at (zi + 1);
            float yr = sR - voices.at (vi).wtDcS.at (zi + 2) + 0.9995f * voices.at (vi).wtDcS.at (zi + 3);
            voices.at (vi).wtDcS.at (zi)     = sL;
            voices.at (vi).wtDcS.at (zi + 1) = yl;
            voices.at (vi).wtDcS.at (zi + 2) = sR;
            voices.at (vi).wtDcS.at (zi + 3) = yr;
            sL = yl;
            sR = yr;
        }
        else
        {
            voices.at (vi).wtDcS.at (zi)     = 0.0f;
            voices.at (vi).wtDcS.at (zi + 1) = 0.0f;
            voices.at (vi).wtDcS.at (zi + 2) = 0.0f;
            voices.at (vi).wtDcS.at (zi + 3) = 0.0f;
        }

        return float<2> (sL, sR);
    }

    // Recomputes supersaw detune ratios, centre/side gains, stereo gains and normalisation
    void updateSuperSaw()
    {
        ssCount    = clamp (int (ssVoices + 0.5f), 1, 7);
        centerGain = 1.0f - 0.7f * ssMix;
        sideGain   = ssMix;

        for (int j = 0; j < 7; ++j)
        {
            ssRatio.at (j) = float (pow (2.0f, ssOff.at (j) * ssDetune * 5.0f / 12.0f));

            float pp  = clamp (ssPos.at (j) * ssSpread, -1.0f, 1.0f);
            float ang = (pp + 1.0f) * 0.25f * float (pi);
            ssGL.at (j) = float (cos (ang)) * 1.4142f;
            ssGR.at (j) = float (sin (ang)) * 1.4142f;
        }

        float powSum = centerGain * centerGain + float (ssCount - 1) * sideGain * sideGain;
        ssNorm = 1.0f / float (sqrt (max (powSum, 0.01f)));
    }

    float nextNoise()
    {
        noiseState = (noiseState * 1103515245 + 12345) & 0x7fffffff;
        return (float (noiseState) / 2147483647.0f) * 2.0f - 1.0f;
    }

    // ---------------- MOD PAGE HELPERS (processor scope) ----------------

    // Advances all 10 mod LFOs by one sample; outputs are bipolar -1..1 in mLfoV
    // LFO frequency of a sync division at the current tempo
    float syncHz (float divIdx)
    {
        float bpm = hostBpm;
        if (syncBpmOver > 1.0f) bpm = syncBpmOver;
        return (bpm / 60.0f) / divBeats.at (clamp (int (divIdx + 0.5f), 0, 17));
    }

    void updateModLfos (float dtv)
    {
        for (int m = 0; m < 10; ++m)
        {
            float mRate = mLfoRate.at (m);
            if (mLfoSync.at (m) > 0.5f)
                mRate = syncHz (mLfoDiv.at (m));

            float64 np = mLfoPhase.at (m) + float64 (mRate) * processor.period;
            if (np >= 1.0)
            {
                np -= 1.0;
                mLfoSh.at (m) = nextNoise();
            }
            mLfoPhase.at (m) = np;

            float p   = float (np);
            int   w   = int (mLfoWave.at (m) + 0.5f);
            float val = 0.0f;

            if (w == 0)
                val = float (sin (float (twoPi) * p));
            else if (w == 1)
                val = 4.0f * abs (p - 0.5f) - 1.0f;
            else if (w == 2)
            {
                if (p < 0.5f) val = 1.0f;
                else          val = -1.0f;
            }
            else if (w == 3)
                val = mLfoSh.at (m);
            else if (w == 4)
                val = 2.0f * p - 1.0f;
            else
                val = 1.0f - 2.0f * p;

            mLfoV.at (m) = val;
        }
    }

    // Moves the per-sample maxima of each mod envelope (across voices) into the global slot
    void rollEnvMax()
    {
        for (int m = 0; m < 10; ++m)
        {
            envMax.at (m)     = envMaxNext.at (m);
            envMaxNext.at (m) = 0.0f;
        }
    }

    // Advances the 10 mod envelopes of one voice by one sample
    void updateModEnvs (int vi, float dtv)
    {
        for (int m = 0; m < 10; ++m)
        {
            int   ms = voices.at (vi).mstage.at (m);
            float me = voices.at (vi).menv.at (m);

            if (ms == 1)
            {
                me += dtv / max (mEnvA.at (m) * 0.001f, 0.0005f);
                if (me >= 1.0f)
                {
                    me = 1.0f;
                    ms = 2;
                }
            }
            else if (ms == 2)
            {
                me += (mEnvS.at (m) - me) * clamp (dtv * 5.0f / (max (mEnvD.at (m), 1.0f) * 0.001f), 0.0f, 0.99f);
            }
            else if (ms == 3)
            {
                me -= me * clamp (dtv * 5.0f / (max (mEnvR.at (m), 1.0f) * 0.001f), 0.0f, 0.99f);
            }

            voices.at (vi).menv.at (m)   = me;
            voices.at (vi).mstage.at (m) = ms;

            if (me > envMaxNext.at (m))
                envMaxNext.at (m) = me;
        }
    }

    // Mod source value for a voice (1-10 LFO, 11-20 envelope, 21 velocity, 22 key, 23 random)
    float srcValueVoice (int src, int vi)
    {
        if (src >= 1 && src <= 10)
            return mLfoV.at (src - 1);
        if (src >= 11 && src <= 20)
            return voices.at (vi).menv.at (src - 11);
        if (src == 21)
            return voices.at (vi).velRaw;
        if (src == 22)
            return clamp ((float (voices.at (vi).noteNumber) - 60.0f) / 48.0f, -1.0f, 1.0f);
        if (src == 23)
            return voices.at (vi).modRand;
        return 0.0f;
    }

    // Mod source value for global destinations (envelopes use the loudest voice)
    float srcValueGlobal (int src)
    {
        if (src >= 1 && src <= 10)
            return mLfoV.at (src - 1);
        if (src >= 11 && src <= 20)
            return envMax.at (src - 11);
        if (src == 21)
            return lastVelV;
        if (src == 22)
            return lastKeyV;
        if (src == 23)
            return lastRandV;
        return 0.0f;
    }

    // Sums the matrix for one voice into vmod[dest]
    void computeVoiceMod (int vi)
    {
        for (int d = 0; d < 46; ++d)
            vmod.at (d) = 0.0f;

        for (int s = 0; s < 20; ++s)
        {
            int dd = mmDstI.at (s);
            int ss = mmSrcI.at (s);
            if (dd > 0 && ss > 0)
                vmod.at (dd) += srcValueVoice (ss, vi) * mmAmt.at (s);
        }
    }

    // Sums the matrix for the global (post-voice) destinations into gmod[dest]
    void computeGlobalMod()
    {
        for (int d = 0; d < 46; ++d)
            gmod.at (d) = 0.0f;

        for (int s = 0; s < 20; ++s)
        {
            int dd = mmDstI.at (s);
            int ss = mmSrcI.at (s);
            if (dd > 0 && ss > 0)
                gmod.at (dd) += srcValueGlobal (ss) * mmAmt.at (s);
        }
    }

    float polyBlep (float t, float dtp)
    {
        if (t < dtp)
        {
            float x = t / dtp;
            return x + x - x * x - 1.0f;
        }
        if (t > 1.0f - dtp)
        {
            float y = (t - 1.0f) / dtp;
            return y * y + y + y + 1.0f;
        }
        return 0.0f;
    }

    float oscWave (int wave, float ph, float dtp, float n, float pw)
    {
        if (wave == 0)
            return 2.0f * ph - 1.0f - polyBlep (ph, dtp);

        if (wave == 1)
        {
            float p2 = ph + 0.5f;
            if (p2 >= 1.0f) p2 -= 1.0f;
            float sq = -1.0f;
            if (ph < 0.5f) sq = 1.0f;
            return sq + polyBlep (ph, dtp) - polyBlep (p2, dtp);
        }

        if (wave == 2)
            return 4.0f * abs (ph - 0.5f) - 1.0f;

        if (wave == 3)
            return float (sin (float (twoPi) * ph));

        if (wave == 4)
            return n;

        float p3 = ph + (1.0f - pw);
        if (p3 >= 1.0f) p3 -= 1.0f;
        float pwv = -1.0f;
        if (ph < pw) pwv = 1.0f;

        // subtract the mean (2*pw - 1) so the pulse stays centred around zero at any width
        return pwv + polyBlep (ph, dtp) - polyBlep (p3, dtp) - (2.0f * pw - 1.0f);
    }

    // One supersaw step for a synth voice: up to 7 detuned PolyBLEP saws, stereo spread
    float<2> superSawStep (int vi, float fBase, float dt, float sr, int n)
    {
        float sumL = 0.0f;
        float sumR = 0.0f;

        for (int j = 0; j < n; ++j)
        {
            float f    = clamp (fBase * ssRatio.at (j), 1.0f, sr * 0.45f);
            float dtp  = clamp (f * dt, 0.00005f, 0.45f);
            float ph   = float (voices.at (vi).ssPhase.at (j));
            float w    = 2.0f * ph - 1.0f - polyBlep (ph, dtp);
            float gain = sideGain;
            if (j == 0) gain = centerGain;
            w = w * gain;

            sumL += w * ssGL.at (j);
            sumR += w * ssGR.at (j);

            float64 np = voices.at (vi).ssPhase.at (j) + float64 (f) * processor.period;
            if (np >= 1.0) np -= 1.0;
            voices.at (vi).ssPhase.at (j) = np;
        }

        return float<2> (sumL * ssNorm, sumR * ssNorm);
    }

    // State-variable filter step for one channel (ch 0 = left states, ch 1 = right states)
    // one-pole TPT low-pass stage (state at fx[idx])
    float onePole (int vi, int idx, float x, float g)
    {
        float gg = g / (1.0f + g);
        float s  = voices.at (vi).fx.at (idx);
        float v  = (x - s) * gg;
        float lp = v + s;
        voices.at (vi).fx.at (idx) = lp + v;
        return lp;
    }

    // one TPT state-variable stage (states at fx[idx], fx[idx+1]); mode 0 LP, 1 BP, 2 HP, 3 notch, 4 allpass
    float svfStage (int vi, int idx, float x, float g, float k, int mode)
    {
        float a1 = 1.0f / (1.0f + g * (g + k));
        float a2 = g * a1;
        float a3 = g * a2;
        float s1 = voices.at (vi).fx.at (idx);
        float s2 = voices.at (vi).fx.at (idx + 1);
        float v3 = x - s2;
        float v1 = a1 * s1 + a2 * v3;
        float v2 = s2 + a2 * s1 + a3 * v3;

        voices.at (vi).fx.at (idx)     = 2.0f * v1 - s1;
        voices.at (vi).fx.at (idx + 1) = 2.0f * v2 - s2;

        if (mode == 1) return v1 * k;
        if (mode == 2) return x - k * v1 - v2;
        if (mode == 3) return x - k * v1;
        if (mode == 4) return x - 2.0f * k * v1;
        return v2;
    }

    float softClip (float x)
    {
        return x / (1.0f + abs (x));
    }

    // formant frequency (Hz) of vowel v (0 A, 1 E, 2 I, 3 O, 4 U), formant f (0..2)
    float vowelFreq (int v, int f)
    {
        if (v == 0) { if (f == 0) return 800.0f; if (f == 1) return 1150.0f; return 2900.0f; }
        if (v == 1) { if (f == 0) return 400.0f; if (f == 1) return 1600.0f; return 2700.0f; }
        if (v == 2) { if (f == 0) return 350.0f; if (f == 1) return 1700.0f; return 2700.0f; }
        if (v == 3) { if (f == 0) return 450.0f; if (f == 1) return 800.0f;  return 2830.0f; }
        if (f == 0) return 325.0f;
        if (f == 1) return 700.0f;
        return 2530.0f;
    }

    // Extra filter types (4-29) on one channel of a voice
    float filterStepX (int vi, int ch, int bank, float s, float g, float k, float res, float fc, int ft)
    {
        int   b  = bank * 32 + ch * 16;
        float sr = float (processor.frequency);

        if (ft == 0)  return svfStage (vi, b + 2, svfStage (vi, b, s, g, k, 0), g, 1.2f, 0);
        if (ft == 1)  return svfStage (vi, b, s, g, k, 0);
        if (ft == 2)  return svfStage (vi, b, s, g, k, 2);
        if (ft == 3)  return svfStage (vi, b, s, g, k, 1);
        if (ft == 4)  return onePole (vi, b, s, g);
        if (ft == 5)  return svfStage (vi, b + 2, onePole (vi, b, s, g), g, k, 0);
        if (ft == 6)  return s - onePole (vi, b, s, g);
        if (ft == 7)  return svfStage (vi, b + 2, s - onePole (vi, b, s, g), g, k, 2);
        if (ft == 8)  return svfStage (vi, b + 2, svfStage (vi, b, s, g, k, 2), g, 1.2f, 2);
        if (ft == 9)  return svfStage (vi, b + 2, svfStage (vi, b, s, g, k, 1), g, k, 1);
        if (ft == 10) return svfStage (vi, b, s, g, k, 3);
        if (ft == 11) return svfStage (vi, b + 2, svfStage (vi, b, s, g, k, 3), g, k, 3);
        if (ft == 12) return s + res * 4.0f * svfStage (vi, b, s, g, 0.6f, 1);
        if (ft == 13) return s + res * 3.0f * svfStage (vi, b, s, g, 1.4f, 0);
        if (ft == 14) return s + res * 3.0f * svfStage (vi, b, s, g, 1.4f, 2);
        if (ft == 15) return svfStage (vi, b, s, g, k, 4);

        if (ft >= 16 && ft <= 18)
        {
            // ladder family: four (three for Acid) one-pole stages with resonance feedback
            float kr = res * 3.9f;
            if (ft == 17) kr = res * 3.2f;
            if (ft == 18) kr = res * 3.6f;

            float y4p = voices.at (vi).fx.at (b + 4);
            float u   = softClip (s - kr * y4p);
            float y1  = onePole (vi, b, u, g);
            float y2  = onePole (vi, b + 1, y1, g);
            float y3  = onePole (vi, b + 2, y2, g);

            if (ft == 18)
            {
                voices.at (vi).fx.at (b + 4) = y3;
                return y3 * (1.0f + res);
            }

            float y4 = onePole (vi, b + 3, y3, g);
            voices.at (vi).fx.at (b + 4) = y4;

            if (ft == 17) return (y3 + y4) * 0.5f;
            return y4 * (1.0f + 0.4f * kr);   // bass makeup for the resonance feedback
        }

        if (ft == 19)
        {
            // dirty low-pass: two saturated 12 dB stages
            float t = svfStage (vi, b, softClip (s * 2.0f), g, k, 0);
            return svfStage (vi, b + 2, softClip (t * 1.5f), g, 1.2f, 0) * 1.3f;
        }

        if (ft == 20 || ft == 21)
        {
            // comb filter (positive / negative feedback), delay = one cycle of the cutoff
            float dly = clamp (sr / max (fc, 20.0f), 2.0f, 2040.0f);
            int   di  = int (dly);
            float fr  = dly - float (di);
            int   w   = voices.at (vi).fdlW;
            int   cb  = bank * 4096 + ch * 2048;
            int   r0  = (w - di) & 2047;
            int   r1  = (w - di - 1) & 2047;
            float d   = voices.at (vi).fdl.at (cb + r0) * (1.0f - fr) + voices.at (vi).fdl.at (cb + r1) * fr;
            float fb  = res * 0.97f;
            if (ft == 21) fb = -fb;

            float yc = s + fb * d;
            voices.at (vi).fdl.at (cb + w) = yc;
            return yc * 0.7f;
        }

        if (ft >= 24 && ft <= 27)
        {
            // MG Low 6/12/18/24: Moog-style ladder with the output tapped after stage 1/2/3/4
            float kr  = res * 3.9f;
            float y4p = voices.at (vi).fx.at (b + 4);
            float u   = softClip (s * 1.2f - kr * y4p);
            float y1  = onePole (vi, b, u, g);
            float y2  = onePole (vi, b + 1, y1, g);
            float y3  = onePole (vi, b + 2, y2, g);
            float y4  = onePole (vi, b + 3, y3, g);
            voices.at (vi).fx.at (b + 4) = y4;

            float mk = 1.1f * (1.0f + 0.4f * kr);
            if (ft == 24) return y1 * mk;
            if (ft == 25) return y2 * mk;
            if (ft == 26) return y3 * mk;
            return y4 * mk;
        }

        if (ft == 28 || ft == 29)
        {
            // Flange+ / Flange-: comb filter whose delay is swept by a slow internal LFO
            float sweep = 1.0f + 0.5f * float (sin (flfPhase * 2.0 * pi));
            float dly   = clamp (sr / max (fc, 20.0f) * sweep, 2.0f, 2040.0f);
            int   di    = int (dly);
            float fr    = dly - float (di);
            int   w     = voices.at (vi).fdlW;
            int   cb    = bank * 4096 + ch * 2048;
            int   r0    = (w - di) & 2047;
            int   r1    = (w - di - 1) & 2047;
            float d     = voices.at (vi).fdl.at (cb + r0) * (1.0f - fr) + voices.at (vi).fdl.at (cb + r1) * fr;
            float fb    = res * 0.95f;
            if (ft == 29) fb = -fb;

            float yc = s + fb * d;
            voices.at (vi).fdl.at (cb + w) = yc;
            return yc * 0.7f;
        }

        if (ft == 22)
        {
            // phaser: four all-pass stages with feedback
            float fbk = res * 0.85f;
            float a   = s + fbk * voices.at (vi).fx.at (b + 8);

            a = 2.0f * onePole (vi, b,     a, g) - a;
            a = 2.0f * onePole (vi, b + 1, a, g) - a;
            a = 2.0f * onePole (vi, b + 2, a, g) - a;
            a = 2.0f * onePole (vi, b + 3, a, g) - a;

            voices.at (vi).fx.at (b + 8) = a;
            return 0.5f * (s + a);
        }

        // 23: vowel / formant filter, cutoff sweeps A-E-I-O-U
        float p  = clamp (float (log (max (fc, 100.0f) / 100.0f)) / float (log (30.0f)), 0.0f, 1.0f) * 4.0f;
        int   v0 = clamp (int (p), 0, 3);
        float vf = p - float (v0);
        float kq = 2.0f - 1.96f * clamp (0.5f + res * 0.45f, 0.0f, 0.98f);
        float acc = 0.0f;

        float f0 = vowelFreq (v0, 0) * (1.0f - vf) + vowelFreq (v0 + 1, 0) * vf;
        float f1 = vowelFreq (v0, 1) * (1.0f - vf) + vowelFreq (v0 + 1, 1) * vf;
        float f2 = vowelFreq (v0, 2) * (1.0f - vf) + vowelFreq (v0 + 1, 2) * vf;

        acc += svfStage (vi, b,     s, float (tan (float64 (f0) * pi / float64 (sr))), kq, 1);
        acc += svfStage (vi, b + 2, s, float (tan (float64 (f1) * pi / float64 (sr))), kq, 1) * 0.7f;
        acc += svfStage (vi, b + 4, s, float (tan (float64 (f2) * pi / float64 (sr))), kq, 1) * 0.5f;

        return acc * 1.4f;
    }

    float filterStep (int vi, int ch, float s, float g, float k, int ft)
    {
        float a1 = 1.0f / (1.0f + g * (g + k));
        float a2 = g * a1;
        float a3 = g * a2;

        float s1a = voices.at (vi).ic1a;
        float s2a = voices.at (vi).ic2a;
        float s1b = voices.at (vi).ic1b;
        float s2b = voices.at (vi).ic2b;

        if (ch == 1)
        {
            s1a = voices.at (vi).ic1c;
            s2a = voices.at (vi).ic2c;
            s1b = voices.at (vi).ic1d;
            s2b = voices.at (vi).ic2d;
        }

        float v3 = s - s2a;
        float v1 = a1 * s1a + a2 * v3;
        float v2 = s2a + a2 * s1a + a3 * v3;
        s1a = 2.0f * v1 - s1a;
        s2a = 2.0f * v2 - s2a;

        float y = v2;
        if (ft == 2)      y = s - k * v1 - v2;
        else if (ft == 3) y = v1 * k;

        if (ft == 0)
        {
            float kb = 1.2f;
            float b1 = 1.0f / (1.0f + g * (g + kb));
            float b2 = g * b1;
            float b3 = g * b2;
            float w3 = v2 - s2b;
            float w1 = b1 * s1b + b2 * w3;
            float w2 = s2b + b2 * s1b + b3 * w3;
            s1b = 2.0f * w1 - s1b;
            s2b = 2.0f * w2 - s2b;
            y = w2;
        }

        if (ch == 1)
        {
            voices.at (vi).ic1c = s1a;
            voices.at (vi).ic2c = s2a;
            voices.at (vi).ic1d = s1b;
            voices.at (vi).ic2d = s2b;
        }
        else
        {
            voices.at (vi).ic1a = s1a;
            voices.at (vi).ic2a = s2a;
            voices.at (vi).ic1b = s1b;
            voices.at (vi).ic2b = s2b;
        }

        return y;
    }

    float shapeSig (float x, float d)
    {
        return shapeSigAlg (x, d, int (driveAlg + 0.5f));
    }

    // drive shaper with an explicit algorithm (0 Soft, 1 Tube, 2 Hard, 3 Fold, 4 Sine, 5 Crunch)
    float shapeSigAlg (float x, float d, int al)
    {
        float gd = 1.0f + d * 8.0f;
        float xx = x * gd;
        float y  = xx / (1.0f + abs (xx));

        if (al == 1)
        {
            // tube: asymmetric soft clip, offset removed
            float bias = 0.3f * d;
            float yb   = xx + bias;
            y = yb / (1.0f + abs (yb)) - bias / (1.0f + abs (bias));
        }
        else if (al == 2)
        {
            y = clamp (xx, -0.9f, 0.9f);
        }
        else if (al == 3)
        {
            // wavefold
            y = float (sin (xx * 1.5f)) * 0.8f;
        }
        else if (al == 4)
        {
            y = float (sin (clamp (xx, -1.5708f, 1.5708f)));
        }
        else if (al == 5)
        {
            // crunch: soft clip followed by coarse quantisation
            float lv = 6.0f + (1.0f - d) * 26.0f;
            y = rint (y * lv) / lv;
        }

        return y * (1.0f + d * 0.5f);
    }

    int findFreeVoice()
    {
        int oldest = 0;
        int maxAge = -1;

        for (int i = 0; i < 8; ++i)
        {
            if (! voices.at (i).active) return i;
            if (voices.at (i).age > maxAge)
            {
                maxAge = voices.at (i).age;
                oldest = i;
            }
        }
        return oldest;
    }

    // Linear-interpolated read from a sampler 1 memory (96000 samples per memory)
    float smpRead (int idx, float64 pos)
    {
        int base = idx * 96000;
        int i0   = int (pos);
        float fr = float (pos - float64 (i0));
        int i1   = i0 + 1;
        int len  = sampleBankV2Length.at (idx);
        if (i1 >= len) i1 = i0;
        i0 = clamp (i0, 0, 95999);
        i1 = clamp (i1, 0, 95999);
        return sampleBankV2Buffer.at (base + i0) * (1.0f - fr) + sampleBankV2Buffer.at (base + i1) * fr;
    }

    // Linear-interpolated read from a sampler 2 memory (96000 samples per memory)
    float s2Read (int idx, float64 pos)
    {
        int base = idx * 96000;
        int i0   = int (pos);
        float fr = float (pos - float64 (i0));
        int i1   = i0 + 1;
        int len  = sampleBank2V2Length.at (idx);
        if (i1 >= len) i1 = i0;
        i0 = clamp (i0, 0, 95999);
        i1 = clamp (i1, 0, 95999);
        return sampleBank2V2Buffer.at (base + i0) * (1.0f - fr) + sampleBank2V2Buffer.at (base + i1) * fr;
    }

    // Wavetable frame size from the 0..4 selector (256 / 512 / 1024 / 2048 / 4096)
    int wtFrameLen (float v)
    {
        int k = clamp (int (v + 0.5f), 0, 4);
        if (k == 0) return 256;
        if (k == 1) return 512;
        if (k == 2) return 1024;
        if (k == 3) return 2048;
        return 4096;
    }

    // Wavetable read from the DEDICATED wavetable memory bank (8 memories x 96000 samples):
    // the memory is split into equal frames; wtPos morphs between frames,
    // phase (0..1) scans one cycle inside the frame (both interpolated linearly)
    float wtBankRead (int idx, float64 phase, float wtPos, int frameLen)
    {
        int   len  = wavetableBankV2Length.at (idx);
        int   fl   = clamp (frameLen, 2, max (len, 2));
        int   nF   = max (len / fl, 1);
        float p    = clamp (wtPos, 0.0f, 1.0f) * float (nF - 1);
        int   fa   = clamp (int (p), 0, nF - 1);
        int   fb   = min (fa + 1, nF - 1);
        float ff   = p - float (fa);
        float x    = float (phase) * float (fl);
        int   i0   = clamp (int (x), 0, fl - 1);
        int   i1   = i0 + 1;
        if (i1 >= fl) i1 = 0;
        float fr   = x - float (i0);
        int   base = idx * 96000;
        int   top  = base + 95999;

        float a0 = wavetableBankV2Buffer.at (clamp (base + fa * fl + i0, base, top));
        float a1 = wavetableBankV2Buffer.at (clamp (base + fa * fl + i1, base, top));
        float b0 = wavetableBankV2Buffer.at (clamp (base + fb * fl + i0, base, top));
        float b1 = wavetableBankV2Buffer.at (clamp (base + fb * fl + i1, base, top));

        float va = a0 * (1.0f - fr) + a1 * fr;
        float vb = b0 * (1.0f - fr) + b1 * fr;
        float dc = wtMeanOf (idx, fl, fa) * (1.0f - ff) + wtMeanOf (idx, fl, fb) * ff;
        return va * (1.0f - ff) + vb * ff - dc;
    }

    // Wavetable 2 read (own memory bank)
    float wt2BankRead (int idx, float64 phase, float wtPos, int frameLen)
    {
        int   len  = wavetableBank2V2Length.at (idx);
        int   fl   = clamp (frameLen, 2, max (len, 2));
        int   nF   = max (len / fl, 1);
        float p    = clamp (wtPos, 0.0f, 1.0f) * float (nF - 1);
        int   fa   = clamp (int (p), 0, nF - 1);
        int   fb   = min (fa + 1, nF - 1);
        float ff   = p - float (fa);
        float x    = float (phase) * float (fl);
        int   i0   = clamp (int (x), 0, fl - 1);
        int   i1   = i0 + 1;
        if (i1 >= fl) i1 = 0;
        float fr   = x - float (i0);
        int   base = idx * 96000;
        int   top  = base + 95999;

        float a0 = wavetableBank2V2Buffer.at (clamp (base + fa * fl + i0, base, top));
        float a1 = wavetableBank2V2Buffer.at (clamp (base + fa * fl + i1, base, top));
        float b0 = wavetableBank2V2Buffer.at (clamp (base + fb * fl + i0, base, top));
        float b1 = wavetableBank2V2Buffer.at (clamp (base + fb * fl + i1, base, top));

        float va = a0 * (1.0f - fr) + a1 * fr;
        float vb = b0 * (1.0f - fr) + b1 * fr;
        float dc = wt2MeanOf (idx, fl, fa) * (1.0f - ff) + wt2MeanOf (idx, fl, fb) * ff;
        return va * (1.0f - ff) + vb * ff - dc;
    }

    // Wavetable 3 read (own memory bank)
    float wt3BankRead (int idx, float64 phase, float wtPos, int frameLen)
    {
        int   len  = wavetableBank3V2Length.at (idx);
        int   fl   = clamp (frameLen, 2, max (len, 2));
        int   nF   = max (len / fl, 1);
        float p    = clamp (wtPos, 0.0f, 1.0f) * float (nF - 1);
        int   fa   = clamp (int (p), 0, nF - 1);
        int   fb   = min (fa + 1, nF - 1);
        float ff   = p - float (fa);
        float x    = float (phase) * float (fl);
        int   i0   = clamp (int (x), 0, fl - 1);
        int   i1   = i0 + 1;
        if (i1 >= fl) i1 = 0;
        float fr   = x - float (i0);
        int   base = idx * 96000;
        int   top  = base + 95999;

        float a0 = wavetableBank3V2Buffer.at (clamp (base + fa * fl + i0, base, top));
        float a1 = wavetableBank3V2Buffer.at (clamp (base + fa * fl + i1, base, top));
        float b0 = wavetableBank3V2Buffer.at (clamp (base + fb * fl + i0, base, top));
        float b1 = wavetableBank3V2Buffer.at (clamp (base + fb * fl + i1, base, top));

        float va = a0 * (1.0f - fr) + a1 * fr;
        float vb = b0 * (1.0f - fr) + b1 * fr;
        float dc = wt3MeanOf (idx, fl, fa) * (1.0f - ff) + wt3MeanOf (idx, fl, fb) * ff;
        return va * (1.0f - ff) + vb * ff - dc;
    }

    // ---------------- SYNTH SAMPLE OSC LOADER ----------------
    // Loads into the memory selected by "Synth Sample Memory" (param154) at the moment the load starts.
    event sampleBankV2Load (SynthSampleChunk c)
    {
        if (c.total <= 0)
        {
            clearSampleBankV2 (synthSmpIdx);
            queueSave (synthSmpIdx);
            return;
        }

        if (c.offset == 0)
        {
            synthLoadIdx = synthSmpIdx;
            beginSampleBankV2 (synthLoadIdx);
        }

        if (writeSampleBankV2Chunk (synthLoadIdx, c.offset, c.count, c.total, c.data))
            queueSave (synthLoadIdx);
    }

    // ---------------- SAMPLER 2 LOADER ----------------
    // Loads into the sampler 2 bank memory selected by "Sample 2 Memory" (param193) at the moment the load starts.
    event sampleBank2V2Load (SynthSampleChunk c)
    {
        if (c.total <= 0)
        {
            clearSampleBank2V2 (synthSmp2Idx);
            return;
        }

        if (c.offset == 0)
        {
            synthLoad2Idx = synthSmp2Idx;
            beginSampleBank2V2 (synthLoad2Idx);
        }

        writeSampleBank2V2Chunk (synthLoad2Idx, c.offset, c.count, c.total, c.data);
    }

    // ---------------- DEDICATED WAVETABLE LOADER ----------------
    // Loads into the memory selected by "Wavetable Memory" (param210) at the moment the load starts.
    event wavetableBankV2Load (SynthSampleChunk c)
    {
        if (c.total <= 0)
        {
            clearWavetableBankV2 (wtIdx);
            return;
        }

        if (c.offset == 0)
        {
            wtLoadIdx = wtIdx;
            beginWavetableBankV2 (wtLoadIdx);
        }

        writeWavetableBankV2Chunk (wtLoadIdx, c.offset, c.count, c.total, c.data);
    }

    // ---------------- WAVETABLE 2 LOADER ----------------
    // Loads into the memory selected by "Wavetable 2 Memory" (param224) at the moment the load starts.
    event wavetableBank2V2Load (SynthSampleChunk c)
    {
        if (c.total <= 0)
        {
            clearWavetableBank2V2 (wt2Idx);
            return;
        }

        if (c.offset == 0)
        {
            wt2LoadIdx = wt2Idx;
            beginWavetableBank2V2 (wt2LoadIdx);
        }

        writeWavetableBank2V2Chunk (wt2LoadIdx, c.offset, c.count, c.total, c.data);
    }

    // ---------------- WAVETABLE 3 LOADER ----------------
    // Loads into the memory selected by "Wavetable 3 Memory" (param236) at the moment the load starts.
    event wavetableBank3V2Load (SynthSampleChunk c)
    {
        if (c.total <= 0)
        {
            clearWavetableBank3V2 (wt3Idx);
            return;
        }

        if (c.offset == 0)
        {
            wt3LoadIdx = wt3Idx;
            beginWavetableBank3V2 (wt3LoadIdx);
        }

        writeWavetableBank3V2Chunk (wt3LoadIdx, c.offset, c.count, c.total, c.data);
    }

    // ---------------- SAMPLE RESTORE HANDLER (from UI persisted state) ----------------
    event sampleBankV2Restore (SampleSave c)
    {
        int ridx = clamp (c.part, 0, 5) * 4 + clamp (c.slot, 0, 3);

        // only memory 1 exists: ignore persisted data of the removed slots
        if (ridx != 0)
            return;

        if (c.total <= 0)
        {
            clearSampleBankV2 (ridx);
            return;
        }

        if (c.offset == 0)
        {
            beginSampleBankV2 (ridx);
            saveQueued.at (ridx) = false;
        }

        writeSampleBankV2Chunk (ridx, c.offset, c.count, c.total, c.data);
    }

    // ---------------- MIDI ----------------
    event midiIn (std::midi::Message msg)
    {
        if (msg.isNoteOn())
        {
            int   nn       = msg.getNoteNumber();
            float vel      = msg.getFloatVelocity();
            float velGainV = (1.0f - velSens) + velSens * vel;
            bool  monoMode = voiceMode > 0.5f;

            int v = 0;
            if (! monoMode) v = findFreeVoice();

            bool wasActive = voices.at (v).active;
            float target = float (std::notes::noteToFrequency (nn));

            voices.at (v).noteNumber = nn;
            voices.at (v).targetFreq = target;

            if (! (monoMode && wasActive))
                voices.at (v).curFreq = target;

            // restart all sample / wavetable engines on every non-legato note
            if (! (monoMode && wasActive))
            {
                int   nsLen   = sampleBankV2Length.at (synthSmpIdx);
                int   nsStart = clamp (int (synthSmpStart * float (nsLen)), 0, max (nsLen - 1, 0));
                voices.at (v).synPos = float64 (nsStart);

                int   ns2Len   = sampleBank2V2Length.at (synthSmp2Idx);
                int   ns2Start = clamp (int (synthSmp2Start * float (ns2Len)), 0, max (ns2Len - 1, 0));
                voices.at (v).synPos2 = float64 (ns2Start);

                resetWtUni (v, 0);
                resetWtUni (v, 1);
                resetWtUni (v, 2);
            }

            if (! wasActive)
            {
                voices.at (v).phase1   = 0.0;
                voices.at (v).phase2   = 0.0;
                voices.at (v).phaseSub = 0.0;
                voices.at (v).env      = 0.0f;
                voices.at (v).ic1a     = 0.0f;
                voices.at (v).ic2a     = 0.0f;
                voices.at (v).ic1b     = 0.0f;
                voices.at (v).ic2b     = 0.0f;
                voices.at (v).ic1c     = 0.0f;
                voices.at (v).ic2c     = 0.0f;
                voices.at (v).ic1d     = 0.0f;
                voices.at (v).ic2d     = 0.0f;
                voices.at (v).fdlW     = 0;

                for (int fq = 0; fq < 64; ++fq)
                    voices.at (v).fx.at (fq) = 0.0f;

                for (int fd = 0; fd < 8192; ++fd)
                    voices.at (v).fdl.at (fd) = 0.0f;

                for (int j = 0; j < 7; ++j)
                {
                    float64 rp = 0.0;
                    if (ssRandPhase > 0.5f) rp = float64 (nextNoise() * 0.5f + 0.5f);
                    voices.at (v).ssPhase.at (j) = rp;
                }

                for (int me = 0; me < 10; ++me)
                    voices.at (v).menv.at (me) = 0.0f;

                for (int zq = 0; zq < 144; ++zq)
                    voices.at (v).eqZ.at (zq) = 0.0f;
            }

            voices.at (v).stage   = 1;
            voices.at (v).fstage  = 1;

            for (int ms = 0; ms < 10; ++ms)
                voices.at (v).mstage.at (ms) = 1;

            if (filterAtk > 0.5f) voices.at (v).fenv = 0.0f;
            else                  voices.at (v).fenv = 1.0f;
            voices.at (v).penv    = 1.0f;
            voices.at (v).velGain = velGainV;
            voices.at (v).velRaw  = vel;
            voices.at (v).modRand = nextNoise();
            lastVelV  = vel;
            lastKeyV  = clamp ((float (nn) - 60.0f) / 48.0f, -1.0f, 1.0f);
            lastRandV = voices.at (v).modRand;
            voices.at (v).age     = 0;
            voices.at (v).active  = true;

            if (lfoKeySync > 0.5f) lfoPhase = 0.0;
        }
        else if (msg.isNoteOff())
        {
            int nn = msg.getNoteNumber();

            for (int i = 0; i < 8; ++i)
            {
                if (voices.at (i).active && voices.at (i).noteNumber == nn)
                {
                    voices.at (i).stage  = 3;
                    voices.at (i).fstage = 3;

                    for (int mq = 0; mq < 10; ++mq)
                        voices.at (i).mstage.at (mq) = 3;
                }
            }
        }
    }

    // ---------------- AUDIO ----------------
    void main()
    {
        loop
        {
            float dt = float (processor.period);
            float sr = float (processor.frequency);

            // ----- LFO -----
            float lfoHz = lfoRate;
            if (lfoSyncOn > 0.5f)
                lfoHz = syncHz (lfoDivIdx);
            lfoPhase += float64 (lfoHz) * processor.period;
            flfPhase += 0.3 * processor.period;
            if (flfPhase >= 1.0) flfPhase -= 1.0;
            if (lfoPhase >= 1.0)
            {
                lfoPhase -= 1.0;
                shValue = nextNoise();
            }
            float lp  = float (lfoPhase);
            int   lw  = int (lfoWave + 0.5f);
            float lfo = 0.0f;
            if (lw == 0)      lfo = float (sin (float (twoPi) * lp));
            else if (lw == 1) lfo = 4.0f * abs (lp - 0.5f) - 1.0f;
            else if (lw == 2) { if (lp < 0.5f) lfo = 1.0f; else lfo = -1.0f; }
            else              lfo = shValue;

            // ----- mod page: 10 LFOs + global matrix sums -----
            updateModLfos (dt);
            rollEnvMax();
            computeGlobalMod();

            float mixSynthL = 0.0f;
            float mixSynthR = 0.0f;

            for (int i = 0; i < 8; ++i)
            {
                if (! voices.at (i).active) continue;

                voices.at (i).age += 1;

                // glide
                float gc = 1.0f;
                if (glideMs > 0.5f)
                    gc = clamp (dt * 5.0f / (glideMs * 0.001f), 0.0f, 1.0f);
                voices.at (i).curFreq += (voices.at (i).targetFreq - voices.at (i).curFreq) * gc;

                // amp envelope
                int   st = voices.at (i).stage;
                float e  = voices.at (i).env;

                if (st == 1)
                {
                    e += dt / max (ampAttack * 0.001f, 0.0005f);
                    if (e >= 1.0f) { e = 1.0f; st = 2; }
                }
                else if (st == 2)
                {
                    e += (ampSustain - e) * clamp (dt * 5.0f / (max (ampDecay, 1.0f) * 0.001f), 0.0f, 0.99f);
                }
                else
                {
                    e -= e * clamp (dt * 5.0f / (max (ampRelease, 1.0f) * 0.001f), 0.0f, 0.99f);
                    if (e < 0.0003f)
                    {
                        e = 0.0f;
                        voices.at (i).active = false;
                    }
                }
                voices.at (i).env   = e;
                voices.at (i).stage = st;

                // filter envelope (attack / decay-sustain / release)
                int   fst = voices.at (i).fstage;
                float fe  = voices.at (i).fenv;
                if (fst == 1)
                {
                    fe += dt / max (filterAtk * 0.001f, 0.0005f);
                    if (fe >= 1.0f) { fe = 1.0f; fst = 2; }
                }
                else if (fst == 2)
                {
                    fe += (filterSus - fe) * clamp (dt * 5.0f / (max (filterEgDec, 1.0f) * 0.001f), 0.0f, 0.99f);
                }
                else
                {
                    fe -= fe * clamp (dt * 5.0f / (max (filterRel, 1.0f) * 0.001f), 0.0f, 0.99f);
                }
                voices.at (i).fenv   = fe;
                voices.at (i).fstage = fst;

                // mod envelopes + per-voice mod matrix sums
                updateModEnvs (i, dt);
                computeVoiceMod (i);

                // per-oscillator level modulation (additive, so a silent oscillator can be faded in by the matrix)
                float subLvl  = clamp (subLevel + vmod.at (13), 0.0f, 1.0f);
                float nsLvl   = clamp (noiseLevel + vmod.at (14), 0.0f, 1.0f);
                float ssLvl   = clamp (ssLevel + vmod.at (16), 0.0f, 1.0f);
                float smpLvl  = clamp (synthSmpLevel + vmod.at (18), 0.0f, 1.0f);
                float smp2Lvl = clamp (synthSmp2Level + vmod.at (20), 0.0f, 1.0f);
                float wtLvl   = clamp (wtLevel + vmod.at (23), 0.0f, 1.0f);
                float wt2Lvl  = clamp (wt2Level + vmod.at (27), 0.0f, 1.0f);
                float wt3Lvl  = clamp (wt3Level + vmod.at (31), 0.0f, 1.0f);

                // pitch envelope (+ matrix pitch modulation, +/-12 semitones at full amount)
                voices.at (i).penv -= voices.at (i).penv * clamp (dt * 5.0f / (max (pitchEgDec, 1.0f) * 0.001f), 0.0f, 0.99f);
                float pe = voices.at (i).penv * pitchEgInt + vmod.at (1) * 12.0f;

                // oscillator frequencies (octave + semitone + fine split)
                float tuneSt = masterTune * 0.01f;
                float e1 = (osc1Pitch + osc1Oct * 12.0f + osc1Fine * 0.01f + pe + tuneSt + vmod.at (11) * 12.0f) / 12.0f + lfo * lfoPitch;
                float e2 = (osc2Pitch + osc2Oct * 12.0f + osc2Detune * 0.01f + pe + tuneSt + vmod.at (12) * 12.0f) / 12.0f + lfo * lfoPitch;
                float f1 = clamp (voices.at (i).curFreq * float (pow (2.0f, e1)), 1.0f, sr * 0.45f);
                float f2 = clamp (voices.at (i).curFreq * float (pow (2.0f, e2)), 1.0f, sr * 0.45f);
                float dtp1 = clamp (f1 * dt, 0.00005f, 0.45f);
                float dtp2 = clamp (f2 * dt, 0.00005f, 0.45f);

                float pwEff = clamp (pulseWidth + lfo * lfoPw * 0.4f + vmod.at (7) * 0.4f, 0.05f, 0.95f);

                float n1 = nextNoise();
                float n2 = nextNoise();
                float n3 = nextNoise();
                float o1 = oscWave (int (osc1Wave + 0.5f), float (voices.at (i).phase1), dtp1, n1, pwEff);
                float o2 = oscWave (int (osc2Wave + 0.5f), float (voices.at (i).phase2), dtp2, n2, pwEff);

                bool wrapped = false;
                voices.at (i).phase1 += float64 (f1) * processor.period;
                if (voices.at (i).phase1 >= 1.0) { voices.at (i).phase1 -= 1.0; wrapped = true; }
                voices.at (i).phase2 += float64 (f2) * processor.period;
                if (voices.at (i).phase2 >= 1.0) voices.at (i).phase2 -= 1.0;
                if (wrapped && oscSync > 0.5f) voices.at (i).phase2 = 0.0;

                voices.at (i).phaseSub += float64 (f1 * 0.5f) * processor.period;
                if (voices.at (i).phaseSub >= 1.0) voices.at (i).phaseSub -= 1.0;
                float subOsc = float (sin (float (twoPi) * float (voices.at (i).phaseSub)));

                // sample engine availability (sampler 1, sampler 2 and the three dedicated wavetables)
                bool smpActive  = (smpLvl > 0.0005f) && sampleBankV2Has.at (synthSmpIdx) && (sampleBankV2Length.at (synthSmpIdx) > 1);
                bool soloS      = smpActive && (synthSmpSolo > 0.5f);
                bool smp2Active = (smp2Lvl > 0.0005f) && sampleBank2V2Has.at (synthSmp2Idx) && (sampleBank2V2Length.at (synthSmp2Idx) > 1);
                bool soloS2     = smp2Active && (synthSmp2Solo > 0.5f);
                bool wtActive   = (wtLvl > 0.0005f) && wavetableBankV2Has.at (wtIdx) && (wavetableBankV2Length.at (wtIdx) > 1);
                bool soloW      = wtActive && (wtSolo > 0.5f);
                bool wt2Active  = (wt2Lvl > 0.0005f) && wavetableBank2V2Has.at (wt2Idx) && (wavetableBank2V2Length.at (wt2Idx) > 1);
                bool soloW2     = wt2Active && (wt2Solo > 0.5f);
                bool wt3Active  = (wt3Lvl > 0.0005f) && wavetableBank3V2Has.at (wt3Idx) && (wavetableBank3V2Length.at (wt3Idx) > 1);
                bool soloW3     = wt3Active && (wt3Solo > 0.5f);
                bool anySolo    = soloS || soloS2 || soloW || soloW2 || soloW3;

                bool ssOn = (ssLvl > 0.0005f) && (! anySolo);

                float oscMixEff = clamp (oscMix + vmod.at (6) * 0.5f, 0.0f, 1.0f);
                float oscMixed = o1 * (1.0f - oscMixEff) + o2 * oscMixEff;
                oscMixed = oscMixed * (1.0f - ringMod) + ringMod * o1 * o2;
                if (ssOn && ssSolo > 0.5f) oscMixed = 0.0f;

                // mixer channel EQ: osc pair, then the osc volume fader
                oscMixed = eqProcess (i, 0, 0, oscMixed);
                oscMixed = oscMixed * oscVolume;

                // mixer channel EQ: sub and noise
                float subS = subOsc;
                if (subLvl > 0.0005f) subS = eqProcess (i, 1, 0, subOsc);
                float nsS = n3;
                if (nsLvl > 0.0005f) nsS = eqProcess (i, 2, 0, n3);

                float sCom = oscMixed + subS * subLvl + nsS * nsLvl;
                if (anySolo) sCom = 0.0f;
                float sL   = sCom;
                float sR   = sCom;

                // ---- supersaw oscillator (stereo) ----
                if (ssOn)
                {
                    float eS    = (ssPitch + ssOct * 12.0f + ssFine * 0.01f + pe + tuneSt + vmod.at (15) * 12.0f) / 12.0f + lfo * lfoPitch;
                    float fBase = voices.at (i).curFreq * float (pow (2.0f, eS));
                    float<2> ssOut = superSawStep (i, fBase, dt, sr, ssCount);
                    float ssEqL = eqProcess (i, 3, 0, ssOut[0]);
                    float ssEqR = eqProcess (i, 3, 1, ssOut[1]);
                    sL += ssEqL * ssLvl;
                    sR += ssEqR * ssLvl;
                }

                // ---- sampler 1 (pitched sample playback) ----
                float smpDry = 0.0f;
                if (smpActive)
                {
                    int     sLen   = sampleBankV2Length.at (synthSmpIdx);
                    int     sStart = clamp (int (synthSmpStart * float (sLen)), 0, max (sLen - 1, 0));
                    float   smpSigS = 0.0f;
                    float   sSt = (synthSmpOct * 12.0f + synthSmpSemi + synthSmpFine * 0.01f + pe + tuneSt + vmod.at (17) * 12.0f) / 12.0f + lfo * lfoPitch;

                    float64 sp = voices.at (i).synPos;

                    if (int (sp) < sLen)
                        smpSigS = eqProcess (i, 4, 0, smpRead (synthSmpIdx, sp)) * smpLvl;

                    float sRate = 1.0f;
                    if (synthSmpTrack > 0.5f)
                        sRate = voices.at (i).curFreq / max (synthSmpRootFreq, 1.0f);

                    sRate = clamp (sRate * float (pow (2.0f, sSt)), 0.0f, 16.0f);

                    sp += float64 (sRate);
                    if (sp >= float64 (sLen))
                    {
                        if (synthSmpLoop > 0.5f)
                        {
                            sp -= float64 (max (sLen - sStart, 1));
                            if (sp >= float64 (sLen) || sp < 0.0)
                                sp = float64 (sStart);
                        }
                    }
                    voices.at (i).synPos = sp;

                    if (synthSmpFilter > 0.5f)
                    {
                        sL += smpSigS;
                        sR += smpSigS;
                    }
                    else
                    {
                        smpDry = smpSigS;
                    }
                }

                // ---- sampler 2 (own memory bank, pitched sample playback) ----
                float smpDry2 = 0.0f;
                if (smp2Active)
                {
                    int     s2LenV   = sampleBank2V2Length.at (synthSmp2Idx);
                    int     s2Start  = clamp (int (synthSmp2Start * float (s2LenV)), 0, max (s2LenV - 1, 0));
                    float   smpSig2  = 0.0f;
                    float   s2St = (synthSmp2Oct * 12.0f + synthSmp2Semi + synthSmp2Fine * 0.01f + pe + tuneSt + vmod.at (19) * 12.0f) / 12.0f + lfo * lfoPitch;

                    float64 sp2 = voices.at (i).synPos2;

                    if (int (sp2) < s2LenV)
                        smpSig2 = eqProcess (i, 5, 0, s2Read (synthSmp2Idx, sp2)) * smp2Lvl;

                    float sRate2 = 1.0f;
                    if (synthSmp2Track > 0.5f)
                        sRate2 = voices.at (i).curFreq / max (synthSmp2RootFreq, 1.0f);

                    sRate2 = clamp (sRate2 * float (pow (2.0f, s2St)), 0.0f, 16.0f);

                    sp2 += float64 (sRate2);
                    if (sp2 >= float64 (s2LenV))
                    {
                        if (synthSmp2Loop > 0.5f)
                        {
                            sp2 -= float64 (max (s2LenV - s2Start, 1));
                            if (sp2 >= float64 (s2LenV) || sp2 < 0.0)
                                sp2 = float64 (s2Start);
                        }
                    }
                    voices.at (i).synPos2 = sp2;

                    if (synthSmp2Filter > 0.5f)
                    {
                        sL += smpSig2;
                        sR += smpSig2;
                    }
                    else
                    {
                        smpDry2 = smpSig2;
                    }
                }

                // ---- dedicated wavetable oscillator (own level, memory bank and controls) ----
                float wtDryL = 0.0f;
                float wtDryR = 0.0f;
                if (wtActive)
                {
                    float wtSt   = (wtOct * 12.0f + wtSemi + wtFine * 0.01f + pe + tuneSt + vmod.at (22) * 12.0f) / 12.0f + lfo * lfoPitch;
                    float wtBase = voices.at (i).curFreq;
                    if (wtTrack <= 0.5f) wtBase = wtRootFreq;
                    float wtFreq = clamp (wtBase * float (pow (2.0f, wtSt)), 1.0f, sr * 0.45f);
                    float wtPosEff = clamp (wtPosAmt + lfo * wtLfoPos * 0.5f + (vmod.at (9) + vmod.at (21)) * 0.5f, 0.0f, 1.0f);

                    float wtGL = wtPanGL.at (0);
                    float wtGR = wtPanGR.at (0);
                    if (abs (vmod.at (24)) > 0.0001f)
                    {
                        float wtPa = (clamp (wtPanV.at (0) + vmod.at (24), -1.0f, 1.0f) + 1.0f) * 0.25f * float (pi);
                        wtGL = float (cos (wtPa)) * 1.4142f;
                        wtGR = float (sin (wtPa)) * 1.4142f;
                    }

                    float<2> wtSte = wtUniStep (0, i, wtFreq, wtPosEff, wtFrameLen (wtSizeSel));
                    float wtSigL = eqProcess (i, 6, 0, wtSte[0]) * wtLvl * wtGL;
                    float wtSigR = eqProcess (i, 6, 1, wtSte[1]) * wtLvl * wtGR;

                    if (wtFilterRt > 0.5f)
                    {
                        sL += wtSigL;
                        sR += wtSigR;
                    }
                    else
                    {
                        wtDryL = wtSigL;
                        wtDryR = wtSigR;
                    }
                }

                // ---- wavetable 2 oscillator (own level, memory bank and controls) ----
                float wt2DryL = 0.0f;
                float wt2DryR = 0.0f;
                if (wt2Active)
                {
                    float wt2St   = (wt2Oct * 12.0f + wt2Semi + wt2Fine * 0.01f + pe + tuneSt + vmod.at (26) * 12.0f) / 12.0f + lfo * lfoPitch;
                    float wt2Base = voices.at (i).curFreq;
                    if (wt2Track <= 0.5f) wt2Base = wt2RootFreq;
                    float wt2Freq = clamp (wt2Base * float (pow (2.0f, wt2St)), 1.0f, sr * 0.45f);
                    float wt2PosEff = clamp (wt2PosAmt + lfo * wt2LfoPos * 0.5f + (vmod.at (9) + vmod.at (25)) * 0.5f, 0.0f, 1.0f);

                    float wt2GL = wtPanGL.at (1);
                    float wt2GR = wtPanGR.at (1);
                    if (abs (vmod.at (28)) > 0.0001f)
                    {
                        float wt2Pa = (clamp (wtPanV.at (1) + vmod.at (28), -1.0f, 1.0f) + 1.0f) * 0.25f * float (pi);
                        wt2GL = float (cos (wt2Pa)) * 1.4142f;
                        wt2GR = float (sin (wt2Pa)) * 1.4142f;
                    }

                    float<2> wt2Ste = wtUniStep (1, i, wt2Freq, wt2PosEff, wtFrameLen (wt2SizeSel));
                    float wt2SigL = eqProcess (i, 7, 0, wt2Ste[0]) * wt2Lvl * wt2GL;
                    float wt2SigR = eqProcess (i, 7, 1, wt2Ste[1]) * wt2Lvl * wt2GR;

                    if (wt2FilterRt > 0.5f)
                    {
                        sL += wt2SigL;
                        sR += wt2SigR;
                    }
                    else
                    {
                        wt2DryL = wt2SigL;
                        wt2DryR = wt2SigR;
                    }
                }

                // ---- wavetable 3 oscillator (own level, memory bank and controls) ----
                float wt3DryL = 0.0f;
                float wt3DryR = 0.0f;
                if (wt3Active)
                {
                    float wt3St   = (wt3Oct * 12.0f + wt3Semi + wt3Fine * 0.01f + pe + tuneSt + vmod.at (30) * 12.0f) / 12.0f + lfo * lfoPitch;
                    float wt3Base = voices.at (i).curFreq;
                    if (wt3Track <= 0.5f) wt3Base = wt3RootFreq;
                    float wt3Freq = clamp (wt3Base * float (pow (2.0f, wt3St)), 1.0f, sr * 0.45f);
                    float wt3PosEff = clamp (wt3PosAmt + lfo * wt3LfoPos * 0.5f + (vmod.at (9) + vmod.at (29)) * 0.5f, 0.0f, 1.0f);

                    float wt3GL = wtPanGL.at (2);
                    float wt3GR = wtPanGR.at (2);
                    if (abs (vmod.at (32)) > 0.0001f)
                    {
                        float wt3Pa = (clamp (wtPanV.at (2) + vmod.at (32), -1.0f, 1.0f) + 1.0f) * 0.25f * float (pi);
                        wt3GL = float (cos (wt3Pa)) * 1.4142f;
                        wt3GR = float (sin (wt3Pa)) * 1.4142f;
                    }

                    float<2> wt3Ste = wtUniStep (2, i, wt3Freq, wt3PosEff, wtFrameLen (wt3SizeSel));
                    float wt3SigL = eqProcess (i, 8, 0, wt3Ste[0]) * wt3Lvl * wt3GL;
                    float wt3SigR = eqProcess (i, 8, 1, wt3Ste[1]) * wt3Lvl * wt3GR;

                    if (wt3FilterRt > 0.5f)
                    {
                        sL += wt3SigL;
                        sR += wt3SigR;
                    }
                    else
                    {
                        wt3DryL = wt3SigL;
                        wt3DryR = wt3SigR;
                    }
                }

                // pre-filter drive
                float sDryL = sL;
                float sDryR = sR;
                if (filterDrive > 0.001f)
                {
                    float dg  = 1.0f + filterDrive * 6.0f;
                    float dm  = 1.0f + filterDrive * 0.8f;
                    float sdL = sL * dg;
                    float sdR = sR * dg;
                    sL = (sdL / (1.0f + abs (sdL))) * dm;
                    sR = (sdR / (1.0f + abs (sdR))) * dm;
                }

                // filter
                float modExp = filterEgInt * voices.at (i).fenv * 4.0f
                             + lfo * lfoCutoff * 3.0f
                             + keyTrack * float (voices.at (i).noteNumber - 60) / 12.0f
                             + filterVel * (voices.at (i).velRaw - 0.5f) * 4.0f
                             + vmod.at (2) * 4.0f;
                float fc = clamp (cutoffHz * float (pow (2.0f, modExp)), 20.0f, sr * 0.45f);
                float g  = float (tan (float64 (fc) * pi * processor.period));
                float resEff = clamp (resonance + vmod.at (3) * 0.5f, 0.0f, 1.0f);
                float k  = 2.0f - 1.96f * resEff;
                int   ft = int (filterType + 0.5f);

                float yL = 0.0f;
                if (ft < 4) yL = filterStep (i, 0, sL, g, k, ft);
                else        yL = filterStepX (i, 0, 0, sL, g, k, resEff, fc, ft);
                float yR = yL;

                if (ssOn)
                {
                    if (ft < 4) yR = filterStep (i, 1, sR, g, k, ft);
                    else        yR = filterStepX (i, 1, 0, sR, g, k, resEff, fc, ft);
                }
                else
                {
                    if (ft >= 4)
                    {
                        for (int fq = 0; fq < 16; ++fq)
                            voices.at (i).fx.at (16 + fq) = voices.at (i).fx.at (fq);
                    }

                    voices.at (i).ic1c = voices.at (i).ic1a;
                    voices.at (i).ic2c = voices.at (i).ic2a;
                    voices.at (i).ic1d = voices.at (i).ic1b;
                    voices.at (i).ic2d = voices.at (i).ic2b;
                }

                // filter 1 dry/wet
                float f1m = clamp (f1Mix, 0.0f, 1.0f);
                if (f1m < 0.999f)
                {
                    yL = sDryL * (1.0f - f1m) + yL * f1m;
                    yR = sDryR * (1.0f - f1m) + yR * f1m;
                }

                // ----- filter 2 (serial after filter 1, or parallel with it) -----
                if (f2On > 0.5f)
                {
                    float modExp2 = f2EgInt * voices.at (i).fenv * 4.0f
                                  + f2KeyTrack * float (voices.at (i).noteNumber - 60) / 12.0f
                                  + vmod.at (42) * 4.0f;
                    float fc2   = clamp (f2Cutoff * float (pow (2.0f, modExp2)), 20.0f, sr * 0.45f);
                    float g2    = float (tan (float64 (fc2) * pi * processor.period));
                    float res2  = clamp (f2Res + vmod.at (43) * 0.5f, 0.0f, 1.0f);
                    float k2    = 2.0f - 1.96f * res2;
                    int   ft2   = clamp (int (f2Type + 0.5f), 0, 29);
                    float drv2  = clamp (f2Drive + vmod.at (44) * 0.5f, 0.0f, 1.0f);
                    float mix2  = clamp (f2Mix + vmod.at (45) * 0.5f, 0.0f, 1.0f);
                    bool  par   = f2Route > 0.5f;

                    float inL = yL;
                    float inR = yR;
                    if (par)
                    {
                        inL = sL;
                        inR = sR;
                    }

                    if (drv2 > 0.001f)
                    {
                        float dg2 = 1.0f + drv2 * 6.0f;
                        float dm2 = 1.0f + drv2 * 0.8f;
                        float dL2 = inL * dg2;
                        float dR2 = inR * dg2;
                        inL = (dL2 / (1.0f + abs (dL2))) * dm2;
                        inR = (dR2 / (1.0f + abs (dR2))) * dm2;
                    }

                    float zL = filterStepX (i, 0, 1, inL, g2, k2, res2, fc2, ft2);
                    float zR = zL;

                    if (ssOn)
                    {
                        zR = filterStepX (i, 1, 1, inR, g2, k2, res2, fc2, ft2);
                    }
                    else
                    {
                        for (int fq = 0; fq < 16; ++fq)
                            voices.at (i).fx.at (48 + fq) = voices.at (i).fx.at (32 + fq);
                    }

                    float dryRefL = yL;
                    float dryRefR = yR;
                    if (par)
                    {
                        dryRefL = sL;
                        dryRefR = sR;
                    }

                    float wL = dryRefL * (1.0f - mix2) + zL * mix2;
                    float wR = dryRefR * (1.0f - mix2) + zR * mix2;

                    if (par)
                    {
                        float bl = clamp (f2Blend, 0.0f, 1.0f);
                        yL = yL * (1.0f - bl) + wL * bl;
                        yR = yR * (1.0f - bl) + wR * bl;
                    }
                    else
                    {
                        yL = wL;
                        yR = wR;
                    }
                }

                voices.at (i).fdlW = (voices.at (i).fdlW + 1) & 2047;

                float a = e * voices.at (i).velGain * (1.0f - lfoAmp * (0.5f - 0.5f * lfo)) * clamp (1.0f + vmod.at (4), 0.0f, 2.0f);
                float dryMono = smpDry + smpDry2;
                mixSynthL += (yL + dryMono + wtDryL + wt2DryL + wt3DryL) * a;
                mixSynthR += (yR + dryMono + wtDryR + wt2DryR + wt3DryR) * a;
            }

            // ----- sample memory manager: stream queued memories out to the UI (autosave) -----
            dumpTimer += 1;
            if (dumpTimer >= 64)
            {
                dumpTimer = 0;

                if (dumpIdx < 0)
                {
                    for (int dq = 0; dq < 1; ++dq)
                    {
                        if (dumpIdx < 0 && saveQueued.at (dq))
                        {
                            dumpIdx = dq;
                            dumpOff = 0;
                            saveQueued.at (dq) = false;
                        }
                    }
                }

                if (dumpIdx >= 0)
                {
                    SampleSave dch;
                    int dlen = sampleBankV2Length.at (dumpIdx);
                    dch.part = dumpIdx / 4;
                    dch.slot = dumpIdx - (dumpIdx / 4) * 4;

                    if ((! sampleBankV2Has.at (dumpIdx)) || dlen <= 0)
                    {
                        dch.offset = 0;
                        dch.count  = 0;
                        dch.total  = 0;
                        sampleBankV2Save <- dch;
                        dumpIdx = -1;
                    }
                    else
                    {
                        int dcnt  = clamp (dlen - dumpOff, 0, 256);
                        int dbase = dumpIdx * 96000 + dumpOff;

                        dch.offset = dumpOff;
                        dch.count  = dcnt;
                        dch.total  = dlen;

                        for (int dm = 0; dm < dcnt; ++dm)
                            dch.data.at (dm) = sampleBankV2Buffer.at (dbase + dm);

                        sampleBankV2Save <- dch;

                        dumpOff += dcnt;
                        if (dumpOff >= dlen || dcnt <= 0)
                            dumpIdx = -1;
                    }
                }
            }

            // ----- global mod destinations: drive, pan, output gain -----
            float driveEff = clamp (driveAmt + gmod.at (8) * 0.5f, 0.0f, 1.0f);

            float gPanL = panL;
            float gPanR = panR;
            if (abs (gmod.at (5)) > 0.0001f)
            {
                float gp   = clamp (panParam + gmod.at (5), -1.0f, 1.0f);
                float gAng = (gp + 1.0f) * 0.25f * float (pi);
                gPanL = float (cos (gAng)) * 1.4142f;
                gPanR = float (sin (gAng)) * 1.4142f;
            }

            float outGainMod = clamp (1.0f + gmod.at (10), 0.0f, 2.0f);

            // ----- synth drive / soft clip -----
            float synthShapedL = shapeSig (mixSynthL * 0.35f, driveEff);
            float synthShapedR = shapeSig (mixSynthR * 0.35f, driveEff);

            float synRawL = synthShapedL * gPanL;
            float synRawR = synthShapedR * gPanR;

            // always-on DC blocker (about 5 Hz) after the drive / pan: asymmetric shapers, ring mod and
            // loaded samples can carry DC that the delay / chorus / flanger / reverb feedback loops would amplify
            float synDcA = 1.0f - clamp (float (twoPi) * 5.0f * dt, 0.0001f, 0.5f);
            float synL   = synRawL - synDcXL + synDcA * synDcYL;
            float synR   = synRawR - synDcXR + synDcA * synDcYR;
            synDcXL = synRawL;
            synDcYL = synL;
            synDcXR = synRawR;
            synDcYR = synR;

            // ----- FX rack (10 slots, user order); the master level sits in front of it -----
            float<2> rack = fxRunRack (float<2> (synL * masterLevel, synR * masterLevel));
            float outL = rack[0];
            float outR = rack[1];

            // ----- stereo width (mid/side) -----
            float wdMid  = (outL + outR) * 0.5f;
            float wdSide = (outL - outR) * 0.5f * stereoWidth;
            outL = wdMid + wdSide;
            outR = wdMid - wdSide;

            // ----- output tone (tilt: dark <-> bright) and output gain -----
            float toneA = clamp (float (twoPi) * 1200.0f * dt, 0.0f, 1.0f);
            toneStL += toneA * (outL - toneStL);
            toneStR += toneA * (outR - toneStR);
            float toneHiL = outL - toneStL;
            float toneHiR = outR - toneStR;
            outL = toneStL * (1.0f - 0.6f * toneAmt) + toneHiL * (1.0f + 0.6f * toneAmt);
            outR = toneStR * (1.0f - 0.6f * toneAmt) + toneHiR * (1.0f + 0.6f * toneAmt);
            outL = outL * outGain * outGainMod;
            outR = outR * outGain * outGainMod;

            // ----- DC blocker (one-pole high-pass): always on, corner set by DC Freq when DC Block is on, otherwise 3 Hz -----
            float dcCorner = 3.0f;
            if (dcOn > 0.5f) dcCorner = dcFreq;
            float dcR = 1.0f - clamp (float (twoPi) * dcCorner * dt, 0.0001f, 0.5f);
            float dcInL = outL;
            float dcInR = outR;
            dcYL = dcInL - dcXL + dcR * dcYL;
            dcYR = dcInR - dcXR + dcR * dcYR;
            dcXL = dcInL;
            dcXR = dcInR;
            outL = dcYL;
            outR = dcYR;

            outL = clamp (outL, -1.0f, 1.0f);
            outR = clamp (outR, -1.0f, 1.0f);

            out <- float<2> (outL, outR);
            advance();
        }
    }
}
