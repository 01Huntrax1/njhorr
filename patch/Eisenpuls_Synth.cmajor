    input event BankChunk eqLoad;        // FX-PEQ: bands of a Parametric EQ slot (bank = global slot 0..29, 240 values)
    input event BankChunk modLoad;       // per-mode edits of the resonators: bank = slot * 3 + set (0 = Physical A, 1 = Physical B, 2 = Resonator stage)  // MODED
    input event BankChunk tblLoad;       // Wavefilter / Wavedistortion tables: bank 0..5 filter table of OSC 1..6, 6..11 shaper table
    input event BankChunk smpBankLoad;

