        9.998041771e-01f, 9.998151678e-01f, 9.998255416e-01f, 9.998353332e-01f, 9.998445753e-01f, 9.998532986e-01f, 9.998615323e-01f, 9.998693039e-01f,
        9.998766393e-01f, 9.998835630e-01f, 9.998900981e-01f, 9.998962664e-01f, 9.999020885e-01f, 9.999075839e-01f, 9.999127708e-01f, 9.999176666e-01f,
        9.999222876e-01f, 9.999266493e-01f, 9.999307661e-01f, 9.999346519e-01f, 9.999383196e-01f, 9.999417815e-01f, 9.999450491e-01f, 9.999481332e-01f,
        9.999510443e-01f, 9.999537919e-01f, 9.999563854e-01f, 9.999588333e-01f, 9.999611438e-01f, 9.999633246e-01f, 9.999653831e-01f, 9.999673260e-01f,
        9.999691598e-01f, 9.999708907e-01f, 9.999725245e-01f, 9.999740666e-01f, 9.999755221e-01f, 9.999768960e-01f, 9.999781927e-01f, 9.999794167e-01f,
        9.999805719e-01f, 9.999816623e-01f, 9.999826915e-01f, 9.999836630e-01f, 9.999845799e-01f, 9.999854454e-01f, 9.999862623e-01f, 9.999870333e-01f,
        9.999877611e-01f, 9.999884480e-01f, 9.999890964e-01f, 9.999897083e-01f, 9.999902860e-01f, 9.999908312e-01f, 9.999913458e-01f, 9.999918315e-01f,
        9.999922900e-01f, 9.999927227e-01f, 9.999931311e-01f, 9.999935167e-01f, 9.999938805e-01f, 9.999942240e-01f, 9.999945482e-01f, 9.999948542e-01f,
        9.999951430e-01f, 9.999954156e-01f, 9.999956729e-01f, 9.999959157e-01f, 9.999961450e-01f, 9.999963613e-01f, 9.999965656e-01f, 9.999967583e-01f,
        9.999969403e-01f, 9.999971120e-01f, 9.999972741e-01f, 9.999974271e-01f, 9.999975715e-01f, 9.999977078e-01f, 9.999978364e-01f, 9.999979579e-01f,
        9.999980725e-01f, 9.999981807e-01f, 9.999982828e-01f, 9.999983792e-01f, 9.999984701e-01f, 9.999985560e-01f, 9.999986370e-01f, 9.999987135e-01f,
        9.999987857e-01f, 9.999988539e-01f, 9.999989182e-01f, 9.999989789e-01f, 9.999990362e-01f, 9.999990903e-01f, 9.999991414e-01f, 9.999991896e-01f,
        9.999992351e-01f, 9.999992780e-01f, 9.999993185e-01f, 9.999993568e-01f, 9.999993929e-01f, 9.999994269e-01f, 9.999994591e-01f, 9.999994895e-01f,
        9.999995181e-01f, 9.999995452e-01f, 9.999995707e-01f, 9.999995948e-01f, 9.999996175e-01f, 9.999996390e-01f, 9.999996593e-01f, 9.999996784e-01f,
        9.999996964e-01f, 9.999997135e-01f, 9.999997296e-01f, 9.999997447e-01f, 9.999997591e-01f, 9.999997726e-01f, 9.999997853e-01f, 9.999997974e-01f,
        9.999998088e-01f, 9.999998195e-01f, 9.999998296e-01f, 9.999998392e-01f, 9.999998482e-01f, 9.999998567e-01f, 9.999998648e-01f, 9.999998724e-01f,
        9.999998795e-01f
    );

    struct PlStrV
    {
        float[1024] line; int wp;           // string delay line
        float[256]  stretch; int swp;       // dispersion all-pass line
        PlSvf damp; PlDcBlocker dc;
        float delay; float dispNoise; float curved; float srcPhase; float out0; float out1;
        PlSvf exc; int remaining;
    }

    struct PlStr
    {
        PlStrV[3] v;
        float[3] f0;
        float[16] fd; int fwp;
        int active;
    }

    PlStr[48] plStr;

    void plStrVInit (PlStrV& s)
    {
        plSvfInit (s.exc);
        s.remaining = 0;
        s.delay = 100.0f;
        for (int i = 0; i < 1024; ++i) s.line.at (i) = 0.0f;
        for (int i = 0; i < 256; ++i)  s.stretch.at (i) = 0.0f;
        s.wp = 0; s.swp = 0;
        plSvfInit (s.damp);
        plDcInit (s.dc, 1.0f - 20.0f / 48000.0f);
        s.dispNoise = 0.0f; s.curved = 0.0f; s.out0 = 0.0f; s.out1 = 0.0f; s.srcPhase = 0.0f;
    }

    void plStrInit (PlStr& d)
    {
        for (int i = 0; i < 3; ++i) { plStrVInit (d.v.at (i)); d.f0.at (i) = 0.01f; }
        d.active = 2;
        for (int i = 0; i < 16; ++i) d.fd.at (i) = 0.0f;
        d.fwp = 0;
    }

    void plInit_19 (int inst)  { plStrInit (plStr.at (inst)); }

    void plStrWrite (PlStrV& s, float x)
    {
        s.line.at (s.wp) = x;
        s.wp = (s.wp - 1 + 1024) % 1024;
    }

    float plStrRead (PlStrV& s, float delay)
    {
        int   di = int (delay);
        float df = delay - float (di);
        float a = s.line.at ((s.wp + di) % 1024);
        float b = s.line.at ((s.wp + di + 1) % 1024);
        return a + (b - a) * df;
    }

    float plStrReadHermite (PlStrV& s, float delay)
    {
        int   di = int (delay);
        float df = delay - float (di);
        int   t  = s.wp + di + 1024;
        float xm1 = s.line.at ((t - 1) % 1024);
        float x0  = s.line.at (t % 1024);
        float x1  = s.line.at ((t + 1) % 1024);
        float x2  = s.line.at ((t + 2) % 1024);
        float c = (x1 - xm1) * 0.5f;
        float v = x0 - x1;
        float w = c + v;
        float a = w + v + (x2 - x0) * 0.5f;
        float bNeg = w + a;
        return (((a * df) - bNeg) * df + c) * df + x0;
    }

    float plStrAllpass (PlStrV& s, float sample, int delay, float coefficient)
    {
        float read = s.stretch.at ((s.swp + delay) % 256);
        float write = sample + coefficient * read;
        s.stretch.at (s.swp) = write;
        s.swp = (s.swp - 1 + 256) % 256;
        return -write * coefficient + read;
    }

    void plStrProcess (int inst, PlStrV& s, float f0, float nonLinearity, float brightness, float damping, float[12]& in, float[12]& out)
    {
        bool dispersion = nonLinearity > 0.0f;
        float nl = dispersion ? nonLinearity : -nonLinearity;

        float delay = 1.0f / f0;
        delay = clamp (delay, 4.0f, 1020.0f);

        float srcRatio = delay * f0;
        if (srcRatio >= 0.9999f)
        {
            s.srcPhase = 1.0f;
            srcRatio = 1.0f;
        }

        float dampingCutoff = min (12.0f + damping * damping * 60.0f + brightness * 24.0f, 84.0f);
        float dampingF = min (f0 * plSemitonesToRatio (dampingCutoff), 0.499f);

        if (damping >= 0.95f)
        {
            float toInfinite = 20.0f * (damping - 0.95f);
            brightness += toInfinite * (1.0f - brightness);
            dampingF += toInfinite * (0.4999f - dampingF);
            dampingCutoff += toInfinite * (128.0f - dampingCutoff);
        }

        plSvfSetFQ (s.damp, 2, dampingF, 0.5f);

        float dampingCompensation = plInterpolate (lut_svf_shift, dampingCutoff, 1.0f);

        float delayTarget = delay * dampingCompensation;
        float delayInc = (delayTarget - s.delay) / 12.0f;
        float delayV = s.delay;

        float stretchPoint = nl * (2.0f - nl) * 0.225f;
        float stretchCorrection = (160.0f / 48000.0f) * delay;
        stretchCorrection = clamp (stretchCorrection, 1.0f, 2.1f);

        float noiseAmountSqrt = nl > 0.75f ? 4.0f * (nl - 0.75f) : 0.0f;
        float noiseAmount = noiseAmountSqrt * noiseAmountSqrt * 0.1f;
        float noiseFilter = 0.06f + 0.94f * brightness * brightness;

        float bridgeCurvingSqrt = nl;
        float bridgeCurving = bridgeCurvingSqrt * bridgeCurvingSqrt * 0.01f;

        float apGain = -0.618f * nl / (0.15f + abs (nl));

        for (int n = 0; n < 12; ++n)
        {
            s.srcPhase += srcRatio;
            if (s.srcPhase > 1.0f)
            {
                s.srcPhase -= 1.0f;

                delayV += delayInc;
                float dl = delayV;
                float x = 0.0f;

                if (dispersion)
                {
                    float noise = plRandFloat (inst) - 0.5f;
                    s.dispNoise += noiseFilter * (noise - s.dispNoise);
                    dl *= 1.0f + s.dispNoise * noiseAmount;
                }
                else
                {
                    dl *= 1.0f - s.curved * bridgeCurving;
                }

                if (dispersion)
                {
                    float apDelay = dl * stretchPoint;
                    float mainDelay = dl - apDelay * (0.408f - stretchPoint * 0.308f) * stretchCorrection;
                    if (apDelay >= 4.0f && mainDelay >= 4.0f)
                    {
                        x = plStrRead (s, mainDelay);
                        x = plStrAllpass (s, x, int (apDelay), apGain);
                    }
                    else
                    {
                        x = plStrReadHermite (s, dl);
                    }
                }
                else
                {
                    x = plStrReadHermite (s, dl);
                }

                if (! dispersion)
                {
                    float value = abs (x) - 0.025f;
                    float sign = x > 0.0f ? 1.0f : -1.5f;
                    s.curved = (abs (value) + value) * sign;
                }

                x += in.at (n);
                x = clamp (x, -20.0f, 20.0f);

                x = plDcProcess (s.dc, x);
                x = plSvfProcess (s.damp, 0, x);
                plStrWrite (s, x);

                s.out1 = s.out0;
                s.out0 = x;
            }

            out.at (n) += s.out1 + (s.out0 - s.out1) * s.srcPhase;
        }

        s.delay = delayV;
    }

    void plStrRender (int inst, PlStr& d, int trig, float note, float harm, float timb, float morph, float accent)
    {
        bool rising = (trig & 1) != 0;

        if (rising)
        {
            // f0_delay_.Read (14)
            d.f0.at (d.active) = d.fd.at ((d.fwp + 14) % 16) + (d.fd.at ((d.fwp + 15) % 16) - d.fd.at ((d.fwp + 14) % 16)) * 0.0f;
            d.active = (d.active + 1) % 3;
        }

        float f0 = plNoteToFrequency (note);
        d.f0.at (d.active) = f0;
        d.fd.at (d.fwp) = f0;
        d.fwp = (d.fwp - 1 + 16) % 16;

        float[12] out;
        float[12] aux;
        float[12] temp;
        for (int i = 0; i < 12; ++i) { out.at (i) = 0.0f; aux.at (i) = 0.0f; }

        float structure  = harm;
        float brightness0 = timb * timb;
        float damping0   = morph;

        for (int vi = 0; vi < 3; ++vi)
        {
            bool trigger = rising && vi == d.active;
            float vf0 = d.f0.at (vi);
            float brightness = brightness0;
            float damping = damping0;

            brightness += 0.25f * accent * (1.0f - brightness);
            damping    += 0.25f * accent * (1.0f - damping);

            if (trigger)
            {
                float range = 72.0f;
                float f = 4.0f * vf0;
                float cutoff = min (f * plSemitonesToRatio ((brightness * (2.0f - brightness) - 0.5f) * range), 0.499f);
                float q = 0.5f;
                d.v.at (vi).remaining = int (1.0f / vf0);
                plSvfSetFQ (d.v.at (vi).exc, 3, cutoff, q);
            }

            if (d.v.at (vi).remaining != 0)
            {
                int noiseSamples = min (d.v.at (vi).remaining, 12);
                d.v.at (vi).remaining -= noiseSamples;
                for (int i = 0; i < 12; ++i)
                    temp.at (i) = i < noiseSamples ? 2.0f * plRandFloat (inst) - 1.0f : 0.0f;
            }
            else
            {
                for (int i = 0; i < 12; ++i) temp.at (i) = 0.0f;
            }

            for (int i = 0; i < 12; ++i) temp.at (i) = plSvfProcess (d.v.at (vi).exc, 0, temp.at (i));
            for (int i = 0; i < 12; ++i) aux.at (i) += temp.at (i);

            float nonLinearity = structure < 0.24f
                ? (structure - 0.24f) * 4.166f
                : (structure > 0.26f ? (structure - 0.26f) * 1.35135f : 0.0f);

            plStrProcess (inst, d.v.at (vi), vf0, nonLinearity, brightness, damping, temp, out);
        }

        for (int i = 0; i < 12; ++i)
        {
            plOut.at (inst * 12 + i) = out.at (i);
            plAux.at (inst * 12 + i) = aux.at (i);
        }
    }

    void plRender_19 (int inst, int trig, float note, float harm, float timb, float morph, float accent)
    {
        plStrRender (inst, plStr.at (inst), trig, note, harm, timb, morph, accent);
    }

    // ---------------- engine 20: Modal resonator (plaits/dsp/engine/modal_engine.cc + physical_modelling/modal_voice, resonator; sustain mode unused) ----------------
    const float[65] lut_stiffness =
    (
        -6.250000000e-02f, -5.859375000e-02f, -5.468750000e-02f, -5.078125000e-02f, -4.687500000e-02f, -4.296875000e-02f, -3.906250000e-02f, -3.515625000e-02f,
        -3.125000000e-02f, -2.734375000e-02f, -2.343750000e-02f, -1.953125000e-02f, -1.562500000e-02f, -1.171875000e-02f, -7.812500000e-03f, -3.906250000e-03f,
        0.000000000e+00f, 0.000000000e+00f, 0.000000000e+00f, 0.000000000e+00f, 1.009582073e-03f, 2.416076364e-03f, 4.002252878e-03f, 5.791066350e-03f,
        7.808404022e-03f, 1.008346028e-02f, 1.264915914e-02f, 1.554263074e-02f, 1.880574864e-02f, 2.248573583e-02f, 2.663584813e-02f, 3.131614488e-02f,
        3.659435812e-02f, 4.254687278e-02f, 4.925983210e-02f, 5.683038428e-02f, 6.536808837e-02f, 7.499649981e-02f, 8.585495846e-02f, 9.810060511e-02f,
        1.119106556e-01f, 1.274849653e-01f, 1.450489216e-01f, 1.648567056e-01f, 1.871949702e-01f, 2.123869891e-01f, 2.407973346e-01f, 2.728371538e-01f,
        3.089701187e-01f, 3.497191360e-01f, 3.956739150e-01f, 4.474995013e-01f, 5.059459012e-01f, 5.718589358e-01f, 6.461924814e-01f, 7.300222738e-01f,
        8.245614757e-01f, 9.311782340e-01f, 1.000037649e+00f, 1.005639154e+00f, 1.048005353e+00f, 1.183990632e+00f, 1.457101344e+00f, 2.000000000e+00f,
        2.000000000e+00f
    );

    struct PlModal
    {
        float harmonicsLp;
        float exS1; float exS2;                 // excitation filter (ResonatorSvf<1>)
        float[24] modeAmplitude;
        float[24] s1; float[24] s2;             // mode filter states
    }

    PlModal[48] plModal;

    void plModalInit (PlModal& d)
    {
        d.harmonicsLp = 0.0f;
        d.exS1 = 0.0f; d.exS2 = 0.0f;
        // CosineOscillator::Init<APPROXIMATE>(0.015)
        float frequency = 0.015f;
        float sign = 16.0f;
        frequency -= 0.25f;
        if (frequency < 0.0f) frequency = -frequency;
        else if (frequency > 0.5f) frequency -= 0.5f;
        else sign = -16.0f;
        float iir = sign * frequency * (1.0f - 2.0f * frequency);
        float y1 = iir * 0.25f;
        float y0 = 0.5f;
        for (int i = 0; i < 24; ++i)
        {
            float temp = y0;
            y0 = iir * y0 - y1;
            y1 = temp;
            d.modeAmplitude.at (i) = (temp + 0.5f) * 0.25f;
            d.s1.at (i) = 0.0f;
            d.s2.at (i) = 0.0f;
        }
    }

    void plInit_20 (int inst)  { plModalInit (plModal.at (inst)); }

    float plModalNthHarmonicCompensation (int n, float stiffness)
    {
        float stretchFactor = 1.0f;
        for (int i = 0; i < n - 1; ++i)
        {
            stretchFactor += stiffness;
            if (stiffness < 0.0f) stiffness *= 0.93f; else stiffness *= 0.98f;
        }
        return 1.0f / stretchFactor;
    }

    void plModalResonator (PlModal& d, float f0, float structure, float brightness, float damping, float[12]& in, float[12]& out)
    {
        float stiffness = plInterpolate (lut_stiffness, structure, 64.0f);
        f0 *= plModalNthHarmonicCompensation (3, stiffness);

        float harmonic = f0;
        float stretchFactor = 1.0f;
        float qSqrt = plSemitonesToRatio (damping * 79.7f);
        float q = 500.0f * qSqrt * qSqrt;
        brightness *= 1.0f - structure * 0.3f;
        brightness *= 1.0f - damping * 0.3f;
        float qLoss = brightness * (2.0f - brightness) * 0.85f + 0.15f;

        float[4] modeQ;
        float[4] modeF;
        float[4] modeA;
        int batchCounter = 0;
        int batch = 0;

        for (int i = 0; i < 24; ++i)
        {
            float modeFrequency = harmonic * stretchFactor;
            if (modeFrequency >= 0.499f) modeFrequency = 0.499f;
            float modeAttenuation = 1.0f - modeFrequency * 2.0f;

            modeF.at (batchCounter) = modeFrequency;
            modeQ.at (batchCounter) = 1.0f + modeFrequency * q;
            modeA.at (batchCounter) = d.modeAmplitude.at (i) * modeAttenuation;
            ++batchCounter;

            if (batchCounter == 4)
            {
                batchCounter = 0;

                float[4] g; float[4] r; float[4] rpg; float[4] h; float[4] st1; float[4] st2;
                for (int k = 0; k < 4; ++k)
                {
                    g.at (k) = plTan (2, modeF.at (k));
                    r.at (k) = 1.0f / modeQ.at (k);
                    h.at (k) = 1.0f / (1.0f + r.at (k) * g.at (k) + g.at (k) * g.at (k));
                    rpg.at (k) = r.at (k) + g.at (k);
                    st1.at (k) = d.s1.at (batch * 4 + k);
                    st2.at (k) = d.s2.at (batch * 4 + k);
                }

                for (int n = 0; n < 12; ++n)
                {
                    float sIn = in.at (n);
                    float sOut = 0.0f;
                    for (int k = 0; k < 4; ++k)
                    {
                        float hp = (sIn - rpg.at (k) * st1.at (k) - st2.at (k)) * h.at (k);
                        float bp = g.at (k) * hp + st1.at (k);
                        st1.at (k) = g.at (k) * hp + bp;
                        float lp = g.at (k) * bp + st2.at (k);
                        st2.at (k) = g.at (k) * bp + lp;
                        sOut += modeA.at (k) * bp;
                    }
                    out.at (n) += sOut;
                }

                for (int k = 0; k < 4; ++k)
                {
                    d.s1.at (batch * 4 + k) = st1.at (k);
                    d.s2.at (batch * 4 + k) = st2.at (k);
                }
                ++batch;
            }

            stretchFactor += stiffness;
            if (stiffness < 0.0f) stiffness *= 0.93f; else stiffness *= 0.98f;
            harmonic += f0;
            q *= qLoss;
        }
    }

    void plModalRender (PlModal& d, int trig, float note, float harm, float timb, float morph, float accent, int inst)
    {
        float[12] out;
        float[12] aux;
        float[12] temp;
        for (int i = 0; i < 12; ++i) { out.at (i) = 0.0f; aux.at (i) = 0.0f; temp.at (i) = 0.0f; }

        d.harmonicsLp += 0.01f * (harm - d.harmonicsLp);

        float f0 = plNoteToFrequency (note);
        float structure  = d.harmonicsLp;
        float brightness = timb;
        float damping    = morph;

        brightness += 0.25f * accent * (1.0f - brightness);
        damping    += 0.25f * accent * (1.0f - damping);

        float range  = 60.0f;
        float f      = 2.0f * f0;
        float cutoff = min (f * plSemitonesToRatio ((brightness * (2.0f - brightness) - 0.5f) * range), 0.499f);
        float q      = 1.5f;

        if ((trig & 1) != 0)
        {
            float attenuation = 1.0f - damping * 0.5f;
            float amplitude = (0.12f + 0.08f * accent) * attenuation;
            temp.at (0) = amplitude * plSemitonesToRatio (cutoff * cutoff * 24.0f) / cutoff;
        }

        // excitation filter, low pass (ResonatorSvf<1>)
        {
            float g = plTan (2, cutoff);
            float r = 1.0f / q;
            float h = 1.0f / (1.0f + r * g + g * g);
            float rpg = r + g;
            float st1 = d.exS1;
            float st2 = d.exS2;
            for (int n = 0; n < 12; ++n)
            {
                float sIn = temp.at (n);
                float hp = (sIn - rpg * st1 - st2) * h;
                float bp = g * hp + st1;
                st1 = g * hp + bp;
                float lp = g * bp + st2;
                st2 = g * bp + lp;
                temp.at (n) = 0.0f + 1.0f * lp;
            }
            d.exS1 = st1;
            d.exS2 = st2;
        }

        for (int i = 0; i < 12; ++i) aux.at (i) += temp.at (i);

        plModalResonator (d, f0, structure, brightness, damping, temp, out);

        for (int i = 0; i < 12; ++i)
        {
            plOut.at (inst * 12 + i) = out.at (i);
            plAux.at (inst * 12 + i) = aux.at (i);
        }
    }

    void plRender_20 (int inst, int trig, float note, float harm, float timb, float morph, float accent)
    {
        plModalRender (plModal.at (inst), trig, note, harm, timb, morph, accent, inst);
    }

    // ---------------- engine 21: Bass drum (plaits/dsp/engine/bass_drum_engine.cc, analog + synthetic bass drum, sustain/unpatched mode unused) ----------------
    struct PlBd
    {
        // analog bass drum
        int   pulseRem; int fmPulseRem; float pulse; float pulseHeight; float pulseLp; float fmPulseLp; float retrigPulse;
        float lpOut; float toneLp; PlSvf res;
        // overdrive
        float odPre; float odPost;
        // synthetic bass drum
        float f0; float phase; float phaseNoise; float fm; float fmLp; float bodyEnv; float bodyEnvLp; float transientEnv; float transientEnvLp;
        float toneLp2; float clickLp; float clickHp; PlSvf clickFilter; float noiseLp; float noiseHp; int bodyEnvPulseWidth; int fmPulseWidth;
    }

    PlBd[48] plBd;

    void plBdInit (PlBd& d)
    {
        d.pulseRem = 0; d.fmPulseRem = 0; d.pulse = 0.0f; d.pulseHeight = 0.0f; d.pulseLp = 0.0f; d.fmPulseLp = 0.0f; d.retrigPulse = 0.0f;
        d.lpOut = 0.0f; d.toneLp = 0.0f;
        plSvfInit (d.res);
        d.odPre = 0.0f; d.odPost = 0.0f;
        d.f0 = 0.0f; d.phase = 0.0f; d.phaseNoise = 0.0f; d.fm = 0.0f; d.fmLp = 0.0f; d.bodyEnv = 0.0f; d.bodyEnvLp = 0.0f;
        d.transientEnv = 0.0f; d.transientEnvLp = 0.0f; d.toneLp2 = 0.0f; d.bodyEnvPulseWidth = 0; d.fmPulseWidth = 0;
        d.clickLp = 0.0f; d.clickHp = 0.0f;
        plSvfInit (d.clickFilter);
        plSvfSetFQ (d.clickFilter, 2, 5000.0f / 48000.0f, 2.0f);
        d.noiseLp = 0.0f; d.noiseHp = 0.0f;
    }

    float plBdDiode (float x)
    {
        if (x >= 0.0f) return x;
        x *= 2.0f;
        return 0.7f * x / (1.0f + abs (x));
    }

    void plBdAnalog (PlBd& d, bool trigger, float accent, float f0, float tone, float decay, float attackFmAmount, float selfFmAmount, float[12]& out)
    {
        float kPulseDecayTime  = 9.599999f;
        float kPulseFilterTime = 4.7999997f;
        float kRetrigPulseDuration = 2400.0f;

        float scale  = 0.001f / f0;
        float q      = 1500.0f * plSemitonesToRatio (decay * 80.0f);
        float toneF  = min (4.0f * f0 * plSemitonesToRatio (tone * 108.0f), 1.0f);
        float exciterLeak = 0.08f * (tone + 0.25f);

        if (trigger)
        {
            d.pulseRem = 48;
            d.fmPulseRem = 288;
            d.pulseHeight = 3.0f + 7.0f * accent;
            d.lpOut = 0.0f;
        }

        for (int i = 0; i < 12; ++i)
        {
            float pulse = 0.0f;
            if (d.pulseRem != 0)
            {
                --d.pulseRem;
                pulse = d.pulseRem != 0 ? d.pulseHeight : d.pulseHeight - 1.0f;
                d.pulse = pulse;
            }
            else
            {
                d.pulse *= 1.0f - 1.0f / kPulseDecayTime;
                pulse = d.pulse;
            }

            d.pulseLp += (1.0f / kPulseFilterTime) * (pulse - d.pulseLp);
            pulse = plBdDiode ((pulse - d.pulseLp) + pulse * 0.044f);

            float fmPulse = 0.0f;
            if (d.fmPulseRem != 0)
            {
                --d.fmPulseRem;
                fmPulse = 1.0f;
                d.retrigPulse = d.fmPulseRem != 0 ? 0.0f : -0.8f;
            }
            else
            {
                d.retrigPulse *= 1.0f - 1.0f / kRetrigPulseDuration;
            }
            d.fmPulseLp += (1.0f / kPulseFilterTime) * (fmPulse - d.fmPulseLp);

            float punch    = 0.7f + plBdDiode (10.0f * d.lpOut - 1.0f);
            float attackFm = d.fmPulseLp * 1.7f * attackFmAmount;
            float selfFm   = punch * 0.08f * selfFmAmount;
            float f = f0 * (1.0f + attackFm + selfFm);
            f = clamp (f, 0.0f, 0.4f);

            plSvfSetFQ (d.res, 3, f, 1.0f + q * f);
            float bp = 0.0f; float lp = 0.0f;
            plG5SvfBpLp (d.res, (pulse - d.retrigPulse * 0.2f) * scale, bp, lp);
            d.lpOut = lp;

            d.toneLp += toneF * ((pulse * exciterLeak + bp) - d.toneLp);
            out.at (i) = d.toneLp;
        }
    }

    void plBdOverdrive (PlBd& d, float drive, float[12]& io)
    {
        float drive2 = drive * drive;
        float preGainA = drive * 0.5f;
        float preGainB = drive2 * drive2 * drive * 24.0f;
        float preGain  = preGainA + (preGainB - preGainA) * drive2;
        float driveSquashed = drive * (2.0f - drive);
        float postGain = 1.0f / plSoftClip (0.33f + driveSquashed * (preGain - 0.33f));

        float preInc  = (preGain - d.odPre) / 12.0f;   float preV  = d.odPre;
        float postInc = (postGain - d.odPost) / 12.0f; float postV = d.odPost;

        for (int i = 0; i < 12; ++i)
        {
            preV += preInc;
            float pre = preV * io.at (i);
            postV += postInc;
            io.at (i) = plSoftClip (pre) * postV;
        }

        d.odPre = preV;
        d.odPost = postV;
    }

    float plBdDistortedSine (float phase, float phaseNoise, float dirtiness)
    {
        phase += phaseNoise * dirtiness;
        phase = phase - float (int (phase));
        float triangle = (phase < 0.5f ? phase : 1.0f - phase) * 4.0f - 1.0f;
        float sine = 2.0f * triangle / (1.0f + abs (triangle));
        float cleanSine = plG5Sine (phase + 0.75f);
        return sine + (1.0f - dirtiness) * (cleanSine - sine);
    }

    float plBdTransistorVca (float s, float gain)
    {
        s = (s - 0.6f) * gain;
        return 3.0f * s / (2.0f + abs (s)) + gain * 0.3f;
    }

    void plBdSynthetic (int inst, PlBd& d, bool trigger, float accent, float f0, float tone, float decay, float dirtiness,
                        float fmEnvelopeAmount, float fmEnvelopeDecay, float[12]& out)
    {
        decay *= decay;
        fmEnvelopeDecay *= fmEnvelopeDecay;

        float f0Inc = (f0 - d.f0) / 12.0f;
        float f0V   = d.f0;

        dirtiness *= max (1.0f - 8.0f * f0, 0.0f);

        float fmDecay = 1.0f - 1.0f / (0.008f * (1.0f + fmEnvelopeDecay * 4.0f) * 48000.0f);
        float bodyEnvDecay = 1.0f - 1.0f / (0.02f * 48000.0f) * plSemitonesToRatio (-decay * 60.0f);
        float transientEnvDecay = 1.0f - 1.0f / (0.005f * 48000.0f);
        float toneF = min (4.0f * f0 * plSemitonesToRatio (tone * 108.0f), 1.0f);
        float transientLevel = tone;

        if (trigger)
        {
            d.fm = 1.0f;
            d.bodyEnv = 0.3f + 0.7f * accent;
            d.transientEnv = d.bodyEnv;
            d.bodyEnvPulseWidth = 48;
            d.fmPulseWidth = 62;
        }

        for (int i = 0; i < 12; ++i)
        {
            d.phaseNoise += 0.002f * ((plRandFloat (inst) - 0.5f) - d.phaseNoise);

            float mix = 0.0f;

            if (d.fmPulseWidth != 0)
            {
                --d.fmPulseWidth;
                d.phase = 0.25f;
            }
            else
            {
                d.fm *= fmDecay;
                float fm = 1.0f + fmEnvelopeAmount * 3.5f * d.fmLp;
                f0V += f0Inc;
                d.phase += min (f0V * fm, 0.5f);
                if (d.phase >= 1.0f) d.phase -= 1.0f;
            }

            if (d.bodyEnvPulseWidth != 0)
            {
                --d.bodyEnvPulseWidth;
            }
            else
            {
                d.bodyEnv *= bodyEnvDecay;
                d.transientEnv *= transientEnvDecay;
            }

            d.bodyEnvLp      += 0.1f * (d.bodyEnv - d.bodyEnvLp);
            d.transientEnvLp += 0.1f * (d.transientEnv - d.transientEnvLp);
            d.fmLp           += 0.1f * (d.fm - d.fmLp);

            float body = plBdDistortedSine (d.phase, d.phaseNoise, dirtiness);

            // click
            float clickIn = d.bodyEnvPulseWidth != 0 ? 0.0f : 1.0f;
            float err = clickIn - d.clickLp;
            d.clickLp += (err > 0.0f ? 0.5f : 0.1f) * err;
            d.clickHp += 0.04f * (d.clickLp - d.clickHp);
            float click = plSvfProcess (d.clickFilter, 0, d.clickLp - d.clickHp);

            // attack noise
            float sample = plRandFloat (inst);
            d.noiseLp += 0.05f * (sample - d.noiseLp);
            d.noiseHp += 0.005f * (d.noiseLp - d.noiseHp);
            float noise = d.noiseLp - d.noiseHp;

            float transient = click + noise;

            mix -= plBdTransistorVca (body, d.bodyEnvLp);
            mix -= transient * d.transientEnvLp * transientLevel;

            d.toneLp2 += toneF * (mix - d.toneLp2);
            out.at (i) = d.toneLp2;
        }

        d.f0 = f0V;
    }

    void plBdRender (int inst, PlBd& d, int trig, float note, float harm, float timb, float morph, float accent)
    {
        float f0 = plNoteToFrequency (note);
        bool  rising = (trig & 1) != 0;

        float attackFmAmount = min (harm * 4.0f, 1.0f);
        float selfFmAmount   = max (min (harm * 4.0f - 1.0f, 1.0f), 0.0f);
        float drive = max (harm * 2.0f - 1.0f, 0.0f) * max (1.0f - 16.0f * f0, 0.0f);

        float[12] a;
        float[12] b;

        plBdAnalog (d, rising, accent, f0, timb, morph, attackFmAmount, selfFmAmount, a);
        plBdOverdrive (d, 0.5f + 0.5f * drive, a);
        plBdSynthetic (inst, d, rising, accent, f0, timb, morph, 0.4f - 0.25f * morph * morph, min (harm * 2.0f, 1.0f), max (harm * 2.0f - 1.0f, 0.0f), b);

        for (int i = 0; i < 12; ++i)
        {
            plOut.at (inst * 12 + i) = a.at (i);
            plAux.at (inst * 12 + i) = b.at (i);
        }
    }

    void plRender_21 (int inst, int trig, float note, float harm, float timb, float morph, float accent)
    {
        plBdRender (inst, plBd.at (inst), trig, note, harm, timb, morph, accent);
    }

    void plInit_21 (int inst)  { plBdInit (plBd.at (inst)); }

    // ---------------- engine 22: Snare drum (plaits/dsp/engine/snare_drum_engine.cc, analog + synthetic snare drum, sustain mode unused) ----------------
    struct PlSn
    {
        // analog snare drum
        int pulseRem; float pulse; float pulseHeight; float pulseLp; float noiseEnvelope; PlSvf[5] res; PlSvf noiseFilter;
        // synthetic snare drum
        float phase0; float phase1; float drumAmplitude; float snareAmplitude; float fm; int holdCounter;
        PlOnePole drumLp; PlOnePole snareHp; PlSvf snareLp;
    }

    PlSn[48] plSn;

    void plSnInit (PlSn& d)
    {
        d.pulseRem = 0; d.pulse = 0.0f; d.pulseHeight = 0.0f; d.pulseLp = 0.0f; d.noiseEnvelope = 0.0f;
        for (int i = 0; i < 5; ++i) plSvfInit (d.res.at (i));
        plSvfInit (d.noiseFilter);
        d.phase0 = 0.0f; d.phase1 = 0.0f; d.drumAmplitude = 0.0f; d.snareAmplitude = 0.0f; d.fm = 0.0f; d.holdCounter = 0;
        plOnePoleInit (d.drumLp);
        plOnePoleInit (d.snareHp);
        plSvfInit (d.snareLp);
    }

    void plInit_22 (int inst)  { plSnInit (plSn.at (inst)); }

    void plSnAnalog (int inst, PlSn& d, bool trigger, float accent, float f0, float tone, float decay, float snappy, float[12]& out)
    {
        float decayXt = decay * (1.0f + decay * (decay - 1.0f));
        float kPulseDecayTime = 4.7999997f;
        float q = 2000.0f * plSemitonesToRatio (decayXt * 84.0f);
        float noiseEnvelopeDecay = 1.0f - 0.0017f * plSemitonesToRatio (-decay * (50.0f + snappy * 10.0f));
        float exciterLeak = snappy * (2.0f - snappy) * 0.1f;

        snappy = snappy * 1.1f - 0.05f;
        snappy = clamp (snappy, 0.0f, 1.0f);

        if (trigger)
        {
            d.pulseRem = 48;
            d.pulseHeight = 3.0f + 7.0f * accent;
            d.noiseEnvelope = 2.0f;
        }

        const float[5] kModeFrequencies = (1.0f, 2.0f, 3.18f, 4.16f, 5.62f);
        float[5] f;
        float[5] gain;

        for (int i = 0; i < 5; ++i)
        {
            f.at (i) = min (f0 * kModeFrequencies.at (i), 0.499f);
            plSvfSetFQ (d.res.at (i), 2, f.at (i), 1.0f + f.at (i) * (i == 0 ? q : q * 0.25f));
        }

        if (tone < 0.666667f)
        {
            tone *= 1.5f;
            gain.at (0) = 1.5f + (1.0f - tone) * (1.0f - tone) * 4.5f;
            gain.at (1) = 2.0f * tone + 0.15f;
            gain.at (2) = 0.0f; gain.at (3) = 0.0f; gain.at (4) = 0.0f;
        }
        else
        {
            tone = (tone - 0.666667f) * 3.0f;
            gain.at (0) = 1.5f - tone * 0.5f;
            gain.at (1) = 2.15f - tone * 0.7f;
            for (int i = 2; i < 5; ++i)
            {
                gain.at (i) = tone;
                tone *= tone;
            }
        }

        float fNoise = f0 * 16.0f;
        fNoise = clamp (fNoise, 0.0f, 0.499f);
        plSvfSetFQ (d.noiseFilter, 2, fNoise, 1.0f + fNoise * 1.5f);

        for (int n = 0; n < 12; ++n)
        {
            float pulse = 0.0f;
            if (d.pulseRem != 0)
            {
                --d.pulseRem;
                pulse = d.pulseRem != 0 ? d.pulseHeight : d.pulseHeight - 1.0f;
                d.pulse = pulse;
            }
            else
            {
                d.pulse *= 1.0f - 1.0f / kPulseDecayTime;
                pulse = d.pulse;
            }

            d.pulseLp += 0.75f * (pulse - d.pulseLp);

            float shell = 0.0f;
            for (int i = 0; i < 5; ++i)
            {
                float excitation = i == 0 ? (pulse - d.pulseLp) + 0.006f * pulse : 0.026f * pulse;
                shell += gain.at (i) * (plSvfProcess (d.res.at (i), 1, excitation) + excitation * exciterLeak);
            }
            shell = plSoftClip (shell);

            float noise = 2.0f * plRandFloat (inst) - 1.0f;
            if (noise < 0.0f) noise = 0.0f;
            d.noiseEnvelope *= noiseEnvelopeDecay;
            noise *= d.noiseEnvelope * snappy * 2.0f;

            noise = plSvfProcess (d.noiseFilter, 1, noise);

            out.at (n) = noise + shell * (1.0f - snappy);
        }
    }

    float plSnDistortedSine (float phase)
    {
        float triangle = (phase < 0.5f ? phase : 1.0f - phase) * 4.0f - 1.3f;
        return 2.0f * triangle / (1.0f + abs (triangle));
    }

    void plSnSynthetic (int inst, PlSn& d, bool trigger, float accent, float f0, float fmAmount, float decay, float snappy, float[12]& out)
    {
        float decayXt = decay * (1.0f + decay * (decay - 1.0f));
        fmAmount *= fmAmount;
        float drumDecay  = 1.0f - 1.0f / (0.015f * 48000.0f) * plSemitonesToRatio (-decayXt * 72.0f - fmAmount * 12.0f + snappy * 7.0f);
        float snareDecay = 1.0f - 1.0f / (0.01f * 48000.0f) * plSemitonesToRatio (-decay * 60.0f - snappy * 7.0f);
        float fmDecay    = 1.0f - 1.0f / (0.007f * 48000.0f);

        snappy = snappy * 1.1f - 0.05f;
        snappy = clamp (snappy, 0.0f, 1.0f);

        float drumLevel  = sqrt (1.0f - snappy);
        float snareLevel = sqrt (snappy);

        float snareFMin = min (10.0f * f0, 0.5f);
        float snareFMax = min (35.0f * f0, 0.5f);

        plOnePoleSetF (d.snareHp, 2, snareFMin);
        plSvfSetFQ (d.snareLp, 2, snareFMax, 0.5f + 2.0f * snappy);
        plOnePoleSetF (d.drumLp, 2, 3.0f * f0);

        if (trigger)
        {
            d.drumAmplitude = 0.3f + 0.7f * accent;
            d.snareAmplitude = d.drumAmplitude;
            d.fm = 1.0f;
            d.phase0 = 0.0f; d.phase1 = 0.0f;
            d.holdCounter = int ((0.04f + decay * 0.03f) * 48000.0f);
        }

        for (int n = 0; n < 12; ++n)
        {
            int size = 11 - n;

            d.drumAmplitude *= (d.drumAmplitude > 0.03f || (size & 1) == 0) ? drumDecay : 1.0f;
            if (d.holdCounter != 0)
                --d.holdCounter;
            else
                d.snareAmplitude *= snareDecay;
            d.fm *= fmDecay;

            float resetNoise = 0.0f;
            float resetNoiseAmount = (0.125f - f0) * 8.0f;
            resetNoiseAmount = clamp (resetNoiseAmount, 0.0f, 1.0f);
            resetNoiseAmount *= resetNoiseAmount;
            resetNoiseAmount *= fmAmount;
            resetNoise += d.phase0 > 0.5f ? -1.0f : 1.0f;
            resetNoise += d.phase1 > 0.5f ? -1.0f : 1.0f;
            resetNoise *= resetNoiseAmount * 0.025f;

            float f = f0 * (1.0f + fmAmount * (4.0f * d.fm));
            d.phase0 += f;
            d.phase1 += f * 1.47f;
            if (resetNoiseAmount > 0.1f)
            {
                if (d.phase0 >= 1.0f + resetNoise) d.phase0 = 1.0f - d.phase0;
                if (d.phase1 >= 1.0f + resetNoise) d.phase1 = 1.0f - d.phase1;
            }
            else
            {
                if (d.phase0 >= 1.0f) d.phase0 -= 1.0f;
                if (d.phase1 >= 1.0f) d.phase1 -= 1.0f;
            }

            float drum = -0.1f;
            drum += plSnDistortedSine (d.phase0) * 0.60f;
            drum += plSnDistortedSine (d.phase1) * 0.25f;
            drum *= d.drumAmplitude * drumLevel;
            drum = plOnePoleLP (d.drumLp, drum);

            float noise = plRandFloat (inst);
            float snare = plSvfProcess (d.snareLp, 0, noise);
            snare = plOnePoleHP (d.snareHp, snare);
            snare = (snare + 0.1f) * (d.snareAmplitude + d.fm) * snareLevel;

            out.at (n) = snare + drum;
        }
    }

    void plSnRender (int inst, PlSn& d, int trig, float note, float harm, float timb, float morph, float accent)
    {
        float f0 = plNoteToFrequency (note);
        bool rising = (trig & 1) != 0;
        float[12] a;
        float[12] b;
        plSnAnalog (inst, d, rising, accent, f0, timb, morph, harm, a);
        plSnSynthetic (inst, d, rising, accent, f0, timb, morph, harm, b);
        for (int i = 0; i < 12; ++i)
        {
            plOut.at (inst * 12 + i) = a.at (i);
            plAux.at (inst * 12 + i) = b.at (i);
        }
    }

    void plRender_22 (int inst, int trig, float note, float harm, float timb, float morph, float accent)
    {
        plSnRender (inst, plSn.at (inst), trig, note, harm, timb, morph, accent);
    }

    // ---------------- engine 23: Hi-hat (plaits/dsp/engine/hi_hat_engine.cc, SquareNoise/SwingVCA + RingModNoise/LinearVCA, sustain mode unused) ----------------
    struct PlHhOsc { float phase; float nextSample; float lpState; float hpState; bool high; float frequency; float pw; }
    struct PlHhV   { float envelope; float noiseClock; float noiseSample; PlSvf col; PlSvf hpf; }
    struct PlHh    { PlHhV h1; PlHhV h2; int64[6] sqPhase; PlHhOsc[6] osc; }

    PlHh[48] plHh;

    void plHhOscInit (PlHhOsc& o)
    {
        o.phase = 0.5f; o.nextSample = 0.0f; o.lpState = 1.0f; o.hpState = 0.0f; o.high = true; o.frequency = 0.001f; o.pw = 0.5f;
    }

    void plHhVInit (PlHhV& v)
    {
        v.envelope = 0.0f; v.noiseClock = 0.0f; v.noiseSample = 0.0f;
        plSvfInit (v.col);
        plSvfInit (v.hpf);
    }

    void plHhInit (PlHh& d)
    {
        plHhVInit (d.h1);
        plHhVInit (d.h2);
        for (int i = 0; i < 6; ++i) { d.sqPhase.at (i) = 0; plHhOscInit (d.osc.at (i)); }
    }

    void plInit_23 (int inst)  { plHhInit (plHh.at (inst)); }

    void plHhSquareNoise (PlHh& d, float f0, float[12]& out)
    {
        const float[6] ratios = (1.0f, 1.304f, 1.466f, 1.787f, 1.932f, 2.536f);
        int64[6] inc;
        int64[6] ph;
        for (int i = 0; i < 6; ++i)
        {
            float f = f0 * ratios.at (i);
            if (f >= 0.499f) f = 0.499f;
            inc.at (i) = int64 (f * 4294967296.0f);
            ph.at (i)  = d.sqPhase.at (i);
        }

        for (int n = 0; n < 12; ++n)
        {
            int noise = 0;
            for (int i = 0; i < 6; ++i)
            {
                ph.at (i) = (ph.at (i) + inc.at (i)) & 4294967295i64;
                noise += int ((ph.at (i) >> 31) & 1);
            }
            out.at (n) = 0.33f * float (noise) - 1.0f;
        }

        for (int i = 0; i < 6; ++i) d.sqPhase.at (i) = ph.at (i);
    }

    // shape 0 = saw, 1 = square (pw 0.5 always); render of plaits::Oscillator without external fm
    void plHhOscRender (PlHhOsc& o, int shape, float frequency, float pw, float[12]& out)
    {
        frequency = clamp (frequency, 0.000001f, 0.25f);
        float lo = abs (frequency) * 2.0f;
        float hi = 1.0f - 2.0f * abs (frequency);
        if (pw < lo) pw = lo; else if (pw > hi) pw = hi;

        float fInc = (frequency - o.frequency) / 12.0f;  float fV = o.frequency;
        float pInc = (pw - o.pw) / 12.0f;                float pV = o.pw;
        float nextSample = o.nextSample;

        for (int n = 0; n < 12; ++n)
        {
            float thisSample = nextSample;
            nextSample = 0.0f;

            fV += fInc;
            float f = fV;
            pV += pInc;
            float p = pV;
            o.phase += f;

            if (shape == 0)
            {
                if (o.phase >= 1.0f)
                {
                    o.phase -= 1.0f;
                    float t = o.phase / f;
                    thisSample -= plThisBlep (t);
                    nextSample -= plNextBlep (t);
                }
                nextSample += o.phase;
                out.at (n) = 2.0f * thisSample - 1.0f;
            }
            else
            {
                if (o.high != (o.phase >= p))
                {
                    float t = (o.phase - p) / f;
                    thisSample += plThisBlep (t);
                    nextSample += plNextBlep (t);
                    o.high = o.phase >= p;
                }
                if (o.phase >= 1.0f)
                {
                    o.phase -= 1.0f;
                    float t = o.phase / f;
                    thisSample -= plThisBlep (t);
                    nextSample -= plNextBlep (t);
                    o.high = false;
                }
                nextSample += o.phase < p ? 0.0f : 1.0f;
                out.at (n) = 2.0f * thisSample - 1.0f;
            }
        }

        o.frequency = fV;
        o.pw = pV;
        o.nextSample = nextSample;
    }

    void plHhRingModNoise (PlHh& d, float f0, float[12]& out)
    {
        float ratio = f0 / (0.01f + f0);
        float[3] fa = (200.0f / 48000.0f * ratio, 510.0f / 48000.0f * ratio, 730.0f / 48000.0f * ratio);
        float[3] fb = (7530.0f / 48000.0f * ratio, 8075.0f / 48000.0f * ratio, 10500.0f / 48000.0f * ratio);
        float[12] t1;
        float[12] t2;

        for (int n = 0; n < 12; ++n) out.at (n) = 0.0f;

        for (int i = 0; i < 3; ++i)
        {
            plHhOscRender (d.osc.at (2 * i), 1, fa.at (i), 0.5f, t1);
            plHhOscRender (d.osc.at (2 * i + 1), 0, fb.at (i), 0.5f, t2);
            for (int n = 0; n < 12; ++n) out.at (n) += t1.at (n) * t2.at (n);
        }
    }

    // kind 0: SwingVCA, resonance, single stage envelope. kind 1: LinearVCA, no resonance, two stage envelope
    void plHhVoice (int inst, PlHhV& v, int kind, bool trigger, float accent, float f0, float tone, float decay, float noisiness, float[12]& out)
    {
        float envelopeDecay = 1.0f - 0.003f * plSemitonesToRatio (-decay * 84.0f);
        float cutDecay      = 1.0f - 0.0025f * plSemitonesToRatio (-decay * 36.0f);

        if (trigger)
            v.envelope = (1.5f + 0.5f * (1.0f - decay)) * (0.3f + 0.7f * accent);

        float cutoff = 150.0f / 48000.0f * plSemitonesToRatio (tone * 72.0f);
        cutoff = clamp (cutoff, 0.0f, 16000.0f / 48000.0f);
        plSvfSetFQ (v.col, 1, cutoff, kind == 0 ? 3.0f + 3.0f * tone : 1.0f);
        for (int i = 0; i < 12; ++i) out.at (i) = plSvfProcess (v.col, 1, out.at (i));

        noisiness *= noisiness;
        float noiseF = f0 * (16.0f + 16.0f * (1.0f - noisiness));
        noiseF = clamp (noiseF, 0.0f, 0.5f);

        for (int i = 0; i < 12; ++i)
        {
            v.noiseClock += noiseF;
            if (v.noiseClock >= 1.0f)
            {
                v.noiseClock -= 1.0f;
                v.noiseSample = plRandFloat (inst) - 0.5f;
            }
            out.at (i) += noisiness * (v.noiseSample - out.at (i));
        }

        for (int i = 0; i < 12; ++i)
        {
            v.envelope *= (v.envelope > 0.5f || kind == 0) ? envelopeDecay : cutDecay;
            float s = out.at (i);
            if (kind == 0)
            {
                s *= s > 0.0f ? 4.0f : 0.1f;
                s = s / (1.0f + abs (s));
                out.at (i) = (s + 0.1f) * v.envelope;
            }
            else
            {
                out.at (i) = s * v.envelope;
            }
        }

        plSvfSetFQ (v.hpf, 1, cutoff, 0.5f);
        for (int i = 0; i < 12; ++i) out.at (i) = plSvfProcess (v.hpf, 3, out.at (i));
    }

    void plHhRender (int inst, PlHh& d, int trig, float note, float harm, float timb, float morph, float accent)
    {
        float f0 = plNoteToFrequency (note);
        bool rising = (trig & 1) != 0;
        float[12] a;
        float[12] b;

        plHhSquareNoise (d, 2.0f * f0, a);
        plHhVoice (inst, d.h1, 0, rising, accent, f0, timb, morph, harm, a);
        plHhRingModNoise (d, 2.0f * f0, b);
        plHhVoice (inst, d.h2, 1, rising, accent, f0, timb, morph, harm, b);

        for (int i = 0; i < 12; ++i)
        {
            plOut.at (inst * 12 + i) = a.at (i);
            plAux.at (inst * 12 + i) = b.at (i);
        }
    }

    void plRender_23 (int inst, int trig, float note, float harm, float timb, float morph, float accent)
    {
        plHhRender (inst, plHh.at (inst), trig, note, harm, timb, morph, accent);
    }

    // ---------------- dispatch ----------------
    void plSilence (int inst) { for (int i = 0; i < 12; ++i) { plOut.at (inst * 12 + i) = 0.0f; plAux.at (inst * 12 + i) = 0.0f; } }
    void plInitEngine (int inst, int eng)
    {
        plRng.at (inst) = 33 + inst;
        plSvfReset (plDummySvf);
        if (false) {}
        else if (eng == 0) plInit_0 (inst);
        else if (eng == 1) plInit_1 (inst);
        else if (eng == 2) plInit_2 (inst);
        else if (eng == 3) plInit_3 (inst);
        else if (eng == 4) plInit_4 (inst);
        else if (eng == 5) plInit_5 (inst);
        else if (eng == 6) plInit_6 (inst);
        else if (eng == 7) plInit_7 (inst);
        else if (eng == 8) plInit_8 (inst);
        else if (eng == 9) plInit_9 (inst);
        else if (eng == 10) plInit_10 (inst);
        else if (eng == 11) plInit_11 (inst);
        else if (eng == 12) plInit_12 (inst);
        else if (eng == 13) plInit_13 (inst);
        else if (eng == 14) plInit_14 (inst);
        else if (eng == 15) plInit_15 (inst);
        else if (eng == 16) plInit_16 (inst);
        else if (eng == 17) plInit_17 (inst);
        else if (eng == 18) plInit_18 (inst);
        else if (eng == 19) plInit_19 (inst);
        else if (eng == 20) plInit_20 (inst);
        else if (eng == 21) plInit_21 (inst);
        else if (eng == 22) plInit_22 (inst);
        else if (eng == 23) plInit_23 (inst);
    }
    void plRenderEngine (int inst, int eng, int trig, float note, float harm, float timb, float morph, float accent)
    {
        if (false) {}
        else if (eng == 0) plRender_0 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 1) plRender_1 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 2) plRender_2 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 3) plRender_3 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 4) plRender_4 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 5) plRender_5 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 6) plRender_6 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 7) plRender_7 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 8) plRender_8 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 9) plRender_9 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 10) plRender_10 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 11) plRender_11 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 12) plRender_12 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 13) plRender_13 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 14) plRender_14 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 15) plRender_15 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 16) plRender_16 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 17) plRender_17 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 18) plRender_18 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 19) plRender_19 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 20) plRender_20 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 21) plRender_21 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 22) plRender_22 (inst, trig, note, harm, timb, morph, accent);
        else if (eng == 23) plRender_23 (inst, trig, note, harm, timb, morph, accent);
        else plSilence (inst);
    }
    const float[24] plGains = (1.0f, 0.7f, 1.0f, 1.0f, 1.0f, 0.7f, 0.8f, 0.5f, 0.8f, 0.7f, 0.6f, 0.7f, 0.8f, 0.6f, 0.8f, -0.7f, -3.0f, -1.0f, -2.0f, -1.0f, -1.0f, 0.8f, 0.8f, 0.8f);

    // engine + post processing of the module (gain, or the limiter for the engines with a negative gain)
    void plRenderBlock (int inst, int eng, int trig, float note, float harm, float timb, float morph, float accent)
    {
        if (plEngine.at (inst) != eng + 1)
        {
            plEngine.at (inst) = eng + 1;
            plLimPeak.at (inst) = 0.5f;
            plInitEngine (inst, eng);
        }

        plRenderEngine (inst, eng, trig, note, harm, timb, morph, accent);

        float g = plGains.at (eng);
        float peak = plLimPeak.at (inst);

        for (int i = 0; i < 12; ++i)
        {
            float s = plOut.at (inst * 12 + i);

            if (g < 0.0f)
            {
                s *= -g;
                float e = abs (s) - peak;
                peak += (e > 0.0f ? 0.05f : 0.00002f) * e;
                float gain = peak <= 1.0f ? 1.0f : 1.0f / peak;
                s = s * gain * 0.8f;
            }
            else
            {
                s *= g;
            }

            plOut.at (inst * 12 + i) = s;
        }

        plLimPeak.at (inst) = peak;
    }

    // Called once per sample by the oscillator slot: plays the rendered block, renders the next one when it is used up.
    // f0 is the oscillator frequency in cycles per sample; pm (phase modulation from the FM matrix) acts as a pitch
    // modulation that is only sampled once per block of 12 samples.
    float plaitsStep (int vi, int o, int eng, float f0, float pm, float harm, float timb, float morph, bool gate)
    {
        int inst = vi * 6 + o;
        int pos  = plPos.at (inst);

        if (pos >= 12)
        {
            float note = 9.0f + 12.0f * log (max (f0, 1.0e-7f) / (plA0 * 0.25f)) / log (2.0f) + clamp (pm, -4.0f, 4.0f) * 12.0f;
            int   trig = plTrigPending.at (inst) + (gate ? 4 : 0);
            plTrigPending.at (inst) = 0;
            plRenderBlock (inst, clamp (eng, 0, 23), trig, note, harm, timb, morph, 0.8f);
            pos = 0;
        }

        plPos.at (inst) = pos + 1;
        return plOut.at (inst * 12 + pos);
    }

    void plaitsNoteOn (int vi, int o)
    {
        int inst = vi * 6 + o;
        plTrigPending.at (inst) = 1;
        plPos.at (inst) = 12;          // render a new block with the trigger right away
    }

    // ---------------- MIDI ----------------
    event midiIn (std::midi::Message msg)
    {
        if (msg.isNoteOn())
        {
            int   nn       = msg.getNoteNumber();
            float vel      = msg.getFloatVelocity();
            float velGainV = (1.0f - velSens) + velSens * vel;
            bool  monoMode = voiceMode > 0.5f;

            int v = 0;
            if (! monoMode) v = findFreeVoice();

            bool wasActive = voices.at (v).active;
            float target = float (std::notes::noteToFrequency (nn));

            voices.at (v).noteNumber = nn;
            voices.at (v).targetFreq = target;

            if (! (monoMode && wasActive))
                voices.at (v).curFreq = target;

            // restart every slot on each non-legato note
            if (! (monoMode && wasActive))
            {
                for (int o = 0; o < 6; ++o)
                {
                    int sLen   = smpLen.at (o);
                    int sStart = clamp (int (opv (o, 22) * float (sLen)), 0, max (sLen - 1, 0));
                    voices.at (v).synPos.at (o) = float64 (sStart);
                    resetWtUni (v, o);
                    plaitsNoteOn (v, o);
                }
            }

            if (! wasActive)
            {
                voices.at (v).env  = 0.0f;
                voices.at (v).fdlW = 0;

                for (int po = 0; po < 6; ++po)
                    voices.at (v).pdPh.at (po) = clamp (op.at (po * 64 + 8), 0.0f, 1.0f);

                for (int fq = 0; fq < 192; ++fq)
                    voices.at (v).fx.at (fq) = 0.0f;

                for (int wq = 0; wq < 384; ++wq)
                    voices.at (v).wfs.at (wq) = 0.0f;

                for (int fd = 0; fd < 24576; ++fd)
                    voices.at (v).fdl.at (fd) = 0.0f;

                for (int me = 0; me < 10; ++me)
                    voices.at (v).menv.at (me) = 0.0f;

                for (int o = 0; o < 6; ++o)
                    voices.at (v).fmPrev.at (o) = 0.0f;
            }

            voices.at (v).stage = 1;

            for (int o = 0; o < 6; ++o)
            {
                voices.at (v).fstage.at (o) = 1;
                voices.at (v).fenv.at (o)   = opv (o, 38) > 0.5f ? 0.0f : 1.0f;
            }

            for (int ms = 0; ms < 10; ++ms)
                voices.at (v).mstage.at (ms) = 1;

            voices.at (v).penv    = 1.0f;
            voices.at (v).velGain = velGainV;
            voices.at (v).velRaw  = vel;
            voices.at (v).modRand = nextNoise();
            lastVoice = v;

            for (int lm = 0; lm < 10; ++lm)
            {
                voices.at (v).lfoPh.at (lm)  = 0.0;
                voices.at (v).lfoAge.at (lm) = -1.0f;
                voices.at (v).lfoSh.at (lm)  = nextNoise();
                voices.at (v).lfoV.at (lm)   = 0.0f;
                voices.at (v).frqT.at (lm)   = 0.0f;
                voices.at (v).frqV.at (lm)   = frqEval (lm, 0.0f);
            }

            lastVelV  = vel;
            lastKeyV  = clamp ((float (nn) - 60.0f) / 48.0f, -1.0f, 1.0f);
            lastRandV = voices.at (v).modRand;
            voices.at (v).age     = 0;
            voices.at (v).active  = true;
        }
        else if (msg.isNoteOff())
        {
            int nn = msg.getNoteNumber();

            for (int i = 0; i < 8; ++i)
            {
                if (voices.at (i).active && voices.at (i).noteNumber == nn)
                {
                    voices.at (i).stage = 3;

                    for (int o = 0; o < 6; ++o)
                        voices.at (i).fstage.at (o) = 3;

                    for (int mq = 0; mq < 10; ++mq)
                        voices.at (i).mstage.at (mq) = 3;
                }
            }
        }
    }

    // ---------------- AUDIO ----------------
    void main()
    {
        loop
        {
            float dt = float (processor.period);
            float sr = float (processor.frequency);

            flfPhase += 0.3 * processor.period;
            if (flfPhase >= 1.0) flfPhase -= 1.0;

            // ----- mod page: 10 LFOs + global matrix sums -----
            wtBuildTick();
            updateModLfos (dt);
            frqMask = 0;
            for (int fs = 0; fs < 20; ++fs)
                if (mmSrcI.at (fs) >= 24 && mmDstI.at (fs) > 0)
                    frqMask |= 1 << (mmSrcI.at (fs) - 24);
            updateFrqGlobal (dt);
            rollEnvMax();
            computeGlobalMod();

            float[3] mixSynthL;
            float[3] mixSynthR;

            for (int i = 0; i < 8; ++i)
            {
                if (! voices.at (i).active) continue;

                voices.at (i).age += 1;

                // glide
                float gc = 1.0f;
                if (glideMs > 0.5f)
                    gc = clamp (dt * 5.0f / (glideMs * 0.001f), 0.0f, 1.0f);
                voices.at (i).curFreq += (voices.at (i).targetFreq - voices.at (i).curFreq) * gc;

                // amp envelope
                int   st = voices.at (i).stage;
                float e  = voices.at (i).env;

                if (st == 1)
                {
                    e += dt / max (ampAttack * 0.001f, 0.0005f);
                    if (e >= 1.0f) { e = 1.0f; st = 2; }
                }
                else if (st == 2)
                {
                    e += (ampSustain - e) * clamp (dt * 5.0f / (max (ampDecay, 1.0f) * 0.001f), 0.0f, 0.99f);
                }
                else
                {
                    e -= e * clamp (dt * 5.0f / (max (ampRelease, 1.0f) * 0.001f), 0.0f, 0.99f);
                    if (e < 0.0003f)
                    {
                        e = 0.0f;
                        voices.at (i).active = false;
                    }
                }
                voices.at (i).env   = e;
                voices.at (i).stage = st;

                // mod envelopes, per-voice LFOs and the matrix sums
                updateModEnvs (i, dt);
                updateVoiceLfos (i, dt);
                updateVoiceFrq (i, dt);
                computeVoiceMod (i);

                // pitch envelope (+ matrix pitch, +/-12 semitones at full amount)
                voices.at (i).penv -= voices.at (i).penv * clamp (dt * 5.0f / (max (pitchEgDec, 1.0f) * 0.001f), 0.0f, 0.99f);
                float pe     = voices.at (i).penv * pitchEgInt + vmod.at (1) * 12.0f;
                float tuneSt = masterTune * 0.01f;
                float cf     = voices.at (i).curFreq;
                int   nnote  = voices.at (i).noteNumber;

                // FM (frequency) and PM (phase): every slot is modulated by the previous sample of the slots that feed it
                float[6] fmIn;
                float[6] pmIn;
                float[6] pdIn;
                for (int fd = 0; fd < 6; ++fd)
                {
                    float acc = 0.0f;
                    float acp = 0.0f;
                    float acd = 0.0f;
                    for (int fs = 0; fs < 6; ++fs)
                    {
                        int   mi = fs * 6 + fd;
                        float am = fmAmt.at (mi);
                        float ap = pmAmt.at (mi);
                        float ad = pdAmt.at (mi);
                        if (vmodMat)   // mod matrix destinations 60.. : FM 60 + n, PM 96 + n, PD 132 + n (+-50% of the range at full amount)
                        {
                            am = clamp (am + vmod.at (60 + mi) * 0.5f, 0.0f, 1.0f);
                            ap = clamp (ap + vmod.at (96 + mi) * 0.5f, 0.0f, 1.0f);
                            ad = clamp (ad + vmod.at (132 + mi) * 0.5f, 0.0f, 1.0f);
                        }
                        if (am != 0.0f)
                            acc += am * voices.at (i).fmPrev.at (fs);
                        if (ap != 0.0f)
                            acp += ap * voices.at (i).fmPrev.at (fs);
                        if (ad != 0.0f)
                            acd += ad * voices.at (i).fmPrev.at (fs);
                    }
                    fmIn.at (fd) = acc;
                    pmIn.at (fd) = acp;
                    pdIn.at (fd) = acd;
                }

                float[3] bInL;
                float[3] bInR;

                for (int o = 0; o < 6; ++o)
                {
                    int   ob  = o * 64;
                    int   ty  = int (op.at (ob) + 0.5f);
                    int   dB  = 6 + 9 * o;
                    float lvl = clamp (op.at (ob + 1) + vmod.at (dB + 1), 0.0f, 1.0f);

                    if (lvl <= 0.0005f && ! fmUsed.at (o) && ! vmodMat)
                    {
                        voices.at (i).fmPrev.at (o) = 0.0f;
                        continue;
                    }

                    // ----- source -----
                    float sSemi = op.at (ob + 4) * 12.0f + op.at (ob + 5) + op.at (ob + 6) * 0.01f;
                    float sExp  = (sSemi + pe + tuneSt) / 12.0f + vmod.at (dB);
                    float base  = cf;
                    if (op.at (ob + 7) <= 0.5f)
                        base = float (std::notes::noteToFrequency (int (op.at (ob + 12) + 0.5f)));
                    if (op.at (ob + 48) > 0.001f)   // Frequency knob: fixed oscillator frequency 20 Hz .. 20 kHz
                        base = 20.0f * float (pow (1000.0f, op.at (ob + 48)));
                    sExp += vmod.at (180 + o) * 4.0f;
                    float fmx   = fmIn.at (o);
                    if (fmx != 0.0f)
                        sExp += clamp (fmx, -2.0f, 2.0f) * 4.0f;   // exponential FM: +-4 octaves at full amount and full scale modulator
                    float freq  = clamp (base * float (pow (2.0f, sExp)), 1.0f, sr * 0.45f);
                    float pm    = pmIn.at (o);

                    // phase distortion: the modulator moves the break point of a two-segment phase warp (identity at 0.5), like the Casio CZ
                    float pdv = pdIn.at (o);
                    float pdPm = 0.0f;
                    {
                        float ph0 = voices.at (i).pdPh.at (o);
                        float ph1 = ph0 + freq / sr;
                        ph1 = ph1 - float (floor (ph1));
                        voices.at (i).pdPh.at (o) = ph1;

                        if (pdv != 0.0f)
                        {
                            float brk = clamp (0.5f - 0.49f * clamp (pdv, -1.0f, 1.0f), 0.01f, 0.99f);
                            float wph = ph0 < brk ? ph0 * 0.5f / brk : 0.5f + (ph0 - brk) * 0.5f / (1.0f - brk);
                            pdPm = wph - ph0;
                        }
                    }

                    float sL = 0.0f;
                    float sR = 0.0f;
                    bool  stereo = false;

                    if (ty == 0)
                    {
                        if (wtHas.at (o) && wtLen.at (o) > 1)
                        {
                            float pos = clamp (op.at (ob + 10) + vmod.at (dB + 3) * 0.5f, 0.0f, 1.0f);
                            float<2> w = wtStep (o, i, freq, pos, wtFrameLen (op.at (ob + 11)), pm + pdPm, vmod.at (dB + 4), vmod.at (dB + 5));
                            sL = w[0];
                            sR = w[1];
                            stereo = true;
                        }
                    }
                    else if (ty == 1)
                    {
                        if (smpHas.at (o) && smpLen.at (o) > 1)
                        {
                            sL = smpStep (o, i, freq, cf, pm + pdPm, sExp);
                            sR = sL;
                        }
                    }
                    else
                    {
                        sL = plaitsStep (i, o, int (op.at (ob + 24) + 0.5f), freq / sr, pm,
                                         clamp (op.at (ob + 25) + vmod.at (dB + 3) * 0.5f, 0.0f, 1.0f),
                                         clamp (op.at (ob + 26) + vmod.at (dB + 4) * 0.5f, 0.0f, 1.0f),
                                         clamp (op.at (ob + 27) + vmod.at (dB + 5) * 0.5f, 0.0f, 1.0f),
                                         voices.at (i).stage <= 2);
                        sR = sL;
                    }

                    // ----- filter envelope of the slot -----
                    int   fst = voices.at (i).fstage.at (o);
                    float fe  = voices.at (i).fenv.at (o);
                    if (fst == 1)
                    {
                        fe += dt / max (op.at (ob + 38) * 0.001f, 0.0005f);
                        if (fe >= 1.0f) { fe = 1.0f; fst = 2; }
                    }
                    else if (fst == 2)
                    {
                        fe += (op.at (ob + 40) - fe) * clamp (dt * 5.0f / (max (op.at (ob + 39), 1.0f) * 0.001f), 0.0f, 0.99f);
                    }
                    else
                    {
                        fe -= fe * clamp (dt * 5.0f / (max (op.at (ob + 41), 1.0f) * 0.001f), 0.0f, 0.99f);
                    }
                    voices.at (i).fenv.at (o)   = fe;
                    voices.at (i).fstage.at (o) = fst;

                    // signal flow per slot: source -> filter -> distortion -> FM / PM matrix and output
                    // (the "Distortion Position" switch puts the distortion before the filter instead)
                    int   dty  = int (op.at (ob + 42) + 0.5f);
                    float dd   = clamp (op.at (ob + 43) + vmod.at (dB + 8) * 0.5f, 0.0f, 1.0f);
                    float dx   = op.at (ob + 44);
                    bool  dPre = op.at (ob + 45) > 0.5f;
                    float dwp  = clamp (op.at (ob + 47) + vmod.at (169 + 2 * o) * 0.5f, 0.0f, 1.0f);

                    // ----- distortion before the filter -----
                    if (dPre && dty > 0)
                    {
                        sL = oscDist (sL, dty, dd, dx, o, dwp);
                        sR = stereo ? oscDist (sR, dty, dd, dx, o, dwp) : sL;
                    }

                    // ----- filter -----
                    if (op.at (ob + 30) > 0.5f)
                    {
                        float fdrv = clamp (op.at (ob + 34), 0.0f, 1.0f);
                        if (fdrv > 0.001f)
                        {
                            float dg = 1.0f + fdrv * 6.0f;
                            float dm = 1.0f + fdrv * 0.8f;
                            float sdL = sL * dg;
                            float sdR = sR * dg;
                            sL = (sdL / (1.0f + abs (sdL))) * dm;
                            sR = (sdR / (1.0f + abs (sdR))) * dm;
                        }

                        float modExp = op.at (ob + 36) * fe * 4.0f
                                     + op.at (ob + 35) * float (nnote - 60) / 12.0f
                                     + op.at (ob + 37) * (voices.at (i).velRaw - 0.5f) * 4.0f
                                     + vmod.at (dB + 6) * 4.0f;
                        float fc    = clamp (op.at (ob + 32) * float (pow (2.0f, modExp)), 20.0f, sr * 0.45f);
                        float g     = float (tan (float64 (fc) * pi * processor.period));
                        float resE  = clamp (op.at (ob + 33) + vmod.at (dB + 7) * 0.5f, 0.0f, 1.0f);
                        float k     = 2.0f - 1.96f * resE;
                        int   ft    = clamp (int (op.at (ob + 31) + 0.5f), 0, 30);

                        float yL = 0.0f;
                        float yR = 0.0f;

                        if (ft >= 30)
                        {
                            float wfp = clamp (op.at (ob + 46) + vmod.at (168 + 2 * o) * 0.5f, 0.0f, 1.0f);
                            yL = wfStep (i, 0, o, sL, fc, resE, wfp);
                            yR = yL;
                            if (stereo)
                                yR = wfStep (i, 1, o, sR, fc, resE, wfp);
                        }
                        else
                        {
                            yL = filterStepX (i, 0, o, sL, g, k, resE, fc, ft);
                            yR = yL;
                            if (stereo)
                                yR = filterStepX (i, 1, o, sR, g, k, resE, fc, ft);
                        }
                        sL = yL;
                        sR = yR;
                    }

                    // ----- distortion after the filter -----
                    if (! dPre && dty > 0)
                    {
                        sL = oscDist (sL, dty, dd, dx, o, dwp);
                        sR = stereo ? oscDist (sR, dty, dd, dx, o, dwp) : sL;
                    }

                    // the matrix modulators are the processed slot outputs (after filter and distortion)
                    voices.at (i).fmPrev.at (o) = stereo ? (sL + sR) * 0.5f : sL;

                    if (lvl <= 0.0005f)
                        continue;

                    // ----- level, pan, output route -----
                    float pn  = clamp (op.at (ob + 2) + vmod.at (dB + 2), -1.0f, 1.0f);
                    float pa  = (pn + 1.0f) * 0.25f * float (pi);
                    float gL  = float (cos (pa)) * 1.4142f * lvl;
                    float gR  = float (sin (pa)) * 1.4142f * lvl;
                    int   rt  = clamp (int (op.at (ob + 3) + 0.5f), 0, 2);
                    bInL.at (rt) += sL * gL;
                    bInR.at (rt) += sR * gR;
                }

                float a = e * voices.at (i).velGain * clamp (1.0f + vmod.at (2), 0.0f, 2.0f);

                voices.at (i).fdlW = (voices.at (i).fdlW + 1) & 2047;

                for (int mg = 0; mg < 3; ++mg)
                {
                    mixSynthL.at (mg) += bInL.at (mg) * a;
                    mixSynthR.at (mg) += bInR.at (mg) * a;
                }
            }

            // ----- global mod destinations: drive, pan, output gain -----
            float driveEff = clamp (driveAmt + gmod.at (4) * 0.5f, 0.0f, 1.0f);

            float gPanL = panL;
            float gPanR = panR;
            if (abs (gmod.at (3)) > 0.0001f)
            {
                float gp   = clamp (panParam + gmod.at (3), -1.0f, 1.0f);
                float gAng = (gp + 1.0f) * 0.25f * float (pi);
                gPanL = float (cos (gAng)) * 1.4142f;
                gPanR = float (sin (gAng)) * 1.4142f;
            }

            float outGainMod = clamp (1.0f + gmod.at (5), 0.0f, 2.0f);

            // ----- synth drive / soft clip, pan and DC blocker, once per bus -----
            float synDcA = 1.0f - clamp (float (twoPi) * 5.0f * dt, 0.0001f, 0.5f);
            float[3] busInL;
            float[3] busInR;

            for (int bg = 0; bg < 3; ++bg)
            {
                float rawL = shapeSig (mixSynthL.at (bg) * 0.35f, driveEff) * gPanL;
                float rawR = shapeSig (mixSynthR.at (bg) * 0.35f, driveEff) * gPanR;

                // always-on DC blocker (about 5 Hz): asymmetric shapers, ring mod and loaded samples can carry DC
                // that the delay / chorus / flanger / reverb feedback loops would amplify
                float dcL = rawL - busDcX.at (bg * 2)     + synDcA * busDcY.at (bg * 2);
                float dcR = rawR - busDcX.at (bg * 2 + 1) + synDcA * busDcY.at (bg * 2 + 1);
                busDcX.at (bg * 2)     = rawL;
                busDcY.at (bg * 2)     = dcL;
                busDcX.at (bg * 2 + 1) = rawR;
                busDcY.at (bg * 2 + 1) = dcR;
                busInL.at (bg) = dcL * masterLevel;
                busInR.at (bg) = dcR * masterLevel;
            }

            // ----- FX racks: Bus 1 and Bus 2 feed the Main rack, which feeds the output -----
            float<2> bus1 = fxRunRack (1, float<2> (busInL.at (1), busInR.at (1))) * busLevel1;
            float<2> bus2 = fxRunRack (2, float<2> (busInL.at (2), busInR.at (2))) * busLevel2;
            float<2> rack = fxRunRack (0, float<2> (busInL.at (0) + bus1[0] + bus2[0], busInR.at (0) + bus1[1] + bus2[1]));
            float outL = rack[0];
            float outR = rack[1];

            // ----- stereo width (mid/side) -----
            float wdMid  = (outL + outR) * 0.5f;
            float wdSide = (outL - outR) * 0.5f * stereoWidth;
            outL = wdMid + wdSide;
            outR = wdMid - wdSide;

            // ----- output tone (tilt: dark <-> bright) and output gain -----
            float toneA = clamp (float (twoPi) * 1200.0f * dt, 0.0f, 1.0f);
            toneStL += toneA * (outL - toneStL);
            toneStR += toneA * (outR - toneStR);
            float toneHiL = outL - toneStL;
            float toneHiR = outR - toneStR;
            outL = toneStL * (1.0f - 0.6f * toneAmt) + toneHiL * (1.0f + 0.6f * toneAmt);
            outR = toneStR * (1.0f - 0.6f * toneAmt) + toneHiR * (1.0f + 0.6f * toneAmt);
            outL = outL * outGain * outGainMod;
            outR = outR * outGain * outGainMod;

            // ----- DC blocker (one-pole high-pass): always on, corner set by DC Freq when DC Block is on, otherwise 3 Hz -----
            float dcCorner = 3.0f;
            if (dcOn > 0.5f) dcCorner = dcFreq;
            float dcR = 1.0f - clamp (float (twoPi) * dcCorner * dt, 0.0001f, 0.5f);
            float dcInL = outL;
            float dcInR = outR;
            dcYL = dcInL - dcXL + dcR * dcYL;
            dcYR = dcInR - dcXR + dcR * dcYR;
            dcXL = dcInL;
            dcXR = dcInR;
            outL = dcYL;
            outR = dcYR;

            outL = clamp (outL, -1.0f, 1.0f);
            outR = clamp (outR, -1.0f, 1.0f);

            out <- float<2> (outL, outR);
            advance();
        }
    }
}
