    event param146 (float v) { autosaveOn  = v; }
    event param147 (float v)
    {
        // "Save All": queue every memory that currently holds a sample
        if (v > 0.5f)
        {
            for (int q = 0; q < 1; ++q)
                if (sampleBankV2Has.at (q))
                    saveQueued.at (q) = true;
        }
    }

    event param148 (float v) { osc1Oct  = float (rint (v)); }
